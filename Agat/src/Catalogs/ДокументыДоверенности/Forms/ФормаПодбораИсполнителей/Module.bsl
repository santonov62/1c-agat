&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Заполняем список из переданных параметров
    Если Параметры.Свойство("СписокСотрудников") Тогда
        // Копируем данные в реквизит формы
        Для Каждого Элемент Из Параметры.СписокСотрудников Цикл
            НовыйЭлемент = СписокСотрудников.Добавить();
            ЗаполнитьЗначенияСвойств(НовыйЭлемент, Элемент);
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаГотово(Команда)
    // Возвращаем измененный список обратно в основную форму
    Закрыть(СписокСотрудников);
КонецПроцедуры
