/////////////////////////////////////////////////////////////////////////////////
// Множественный выбор Сотрудников  // использование стандартной формы ввода
/////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ИсполнителиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    
    // 1. Отменяем стандартное окно справочника
    СтандартнаяОбработка = Ложь;
    
    // 2. Получаем список сотрудников с сервера
    СписокСотрудников = ПолучитьСписокСотрудниковНаСервере();
    
    // 3. Подготавливаем оповещение
    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияОкнаОтметки", ЭтотОбъект, СписокСотрудников);
    
    // 4. ВЫЗОВ СИСТЕМНОГО ОКНА С ГАЛОЧКАМИ
    // Оно откроется в отдельном мини-окне у элемента
    СписокСотрудников.ПоказатьОтметкуЭлементов(Оповещение, "Исполнители");
    
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияОкнаОтметки(Результат, СписокСотрудников) Экспорт
    
    // Если пользователь нажал "Отмена" или закрыл крестиком
    Если Результат = Неопределено Тогда 
        Возврат; 
    КонецЕсли;
    
    // Результат — это тот же СписокСотрудников, но с измененными пометками
    МассивСсылок = Новый Массив;
    Для Каждого ЭлементСписка Из Результат Цикл
        Если ЭлементСписка.Пометка Тогда
            МассивСсылок.Добавить(ЭлементСписка.Значение);
        КонецЕсли;
    КонецЦикла;
    
    // Сохраняем результат
    ОбновитьИсполнителейНаСервере(МассивСсылок);
    
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокСотрудниковНаСервере()
    
    Список = Новый СписокЗначений;
    
    // Получаем сотрудников через быстрый запрос
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Сотрудники.Ссылка КАК Ссылка,
        |	Сотрудники.Наименование КАК Наименование
        |ИЗ
        |	Справочник.Сотрудники КАК Сотрудники
        |ГДЕ
        |	НЕ Сотрудники.ПометкаУдаления
        |УПОРЯДОЧИТЬ ПО
        |	Наименование";
    
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        НовыйЭл = Список.Добавить(Выборка.Ссылка, Выборка.Наименование);
        
        // Сразу ставим галочки тем, кто уже сохранен в ТЧ "СоставИсполнителей"
        Отбор = Новый Структура("Исполнитель", Выборка.Ссылка);
        Если Объект.СоставИсполнителей.НайтиСтроки(Отбор).Количество() > 0 Тогда
            НовыйЭл.Пометка = Истина;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Список;
    
КонецФункции

&НаСервере
Процедура ОбновитьИсполнителейНаСервере(МассивСсылок)
    
    // Синхронизируем ТЧ
    Объект.СоставИсполнителей.Очистить();
    СписокИмен = Новый СписокЗначений;
    
    Для Каждого Ссылка Из МассивСсылок Цикл
        НоваяСтр = Объект.СоставИсполнителей.Добавить();
        НоваяСтр.Исполнитель = Ссылка;
        СписокИмен.Добавить(Строка(Ссылка));
    КонецЦикла;
    
    // Сортируем ФИО для красивого вывода в поле через запятую
    СписокИмен.СортироватьПоПредставлению();
    
    МассивЧистыхИмен = Новый Массив;
    Для Каждого Эл Из СписокИмен Цикл
        МассивЧистыхИмен.Добавить(Эл.Значение);
    КонецЦикла;
    
    Объект.Исполнители = СтрСоединить(МассивЧистыхИмен, ", ");
    
КонецПроцедуры

