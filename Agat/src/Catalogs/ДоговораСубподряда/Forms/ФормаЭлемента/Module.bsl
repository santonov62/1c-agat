////////////////////////////////////////////////////////////////////////////////
// Загрузка файлов ТЧ //////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// Общие модули:                                                              //
//   			РаботаСФайламиСервер:                                         //
//										Процедура ПриСозданииНаСервере 		  //
//              РаботаСФайламиКлиент:                                         //
//                                      Асинх Процедура КомандаДействие       //
//                                      Асинх Процедура КомандаУдалить        //
// Константы:                                                                 //
//              ПутьХранилищаФайлов:                                          //
//                                      Адрес файлового хранилища заданного   //
//                                      пользователем (Администратор)         //
// Реквизиты ТЧ:                                                              //
// 				РасширениеФайла - строка                                      //
//				УникальныйИдентификатор - УникальныйИдентификатор             // 
//                                      Присвоение имени файла в архиве HDD   //
// Реквизиты формы:                                                           //
//          	ПутьХранилища - строка                                        //
//                                      Хранение данных Константы:            //
//										ПутьХранилищаФайлов                   //
// Команды:                                                                   //
//          	КомандаДействие - Асинх Процедура КомандаДействие(Команда)    //
//                                (Присоединение / просомтр файла)			  //
//                                 Тригер - Реквизит ТЧ - РасширениеФайла     //
//          	КомандаУдалить  - Асинх Процедура КомандаУдалить(Команда)     //
// События:                                                                   //
//    	Форма:                                                                //
//				Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)   //
//     	ТЧ:                                                                   //
//      	    Процедура ПриложенияПриАктивизацииСтроки(Элемент)             //
//      	    Процедура РазногласияПриАктивизацииСтроки(Элемент)            //
//      	    Процедура ИсполнениеДоговораПриАктивизацииСтроки(Элемент)     // 
//                                                                            //
// Особенности:                                                               //
//              Присвооение имени выгруженного файла по шаболну:              //
//              РаботаСФайламиКлиент - Функция СформироватьИмяФайлаИзДанных   // 
// шаболн:                                                                    //
//      ("%1_№ %2_от %3%4", Назв, Ном, Дат, ТекущиеДанные.РасширениеФайла)	  //
////////////////////////////////////////////////////////////////////////////////

// =============================================================================
// СИСТЕМНЫЕ СОБЫТИЯ ФОРМЫ
// ============================================================================= 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Формируем массив всех табличных частей, которые поддерживают работу с файлами
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("Приложения");
	МассивТЧ.Добавить("Разногласия");
	МассивТЧ.Добавить("ИсполнениеДоговора");
	МассивТЧ.Добавить("СодержаниеДоговора");
	МассивТЧ.Добавить("Архив");

	// Настраиваем программное условное оформление для отображения иконок (лупа/скрепка) 
	// в колонках ИмяТЧ+"Действие" и ИмяТЧ+"Удалить"
	РаботаСФайламиСервер.НастроитьОформлениеВсехТаблиц(ЭтаФорма, МассивТЧ);
	
	 										/////////////////////////////////////////////////////////////////////////////////
											// Одиночный выбор Сотрудника  // использование стандартной формы ввода
											/////////////////////////////////////////////////////////////////////////////////

											//////////////////////////////////////////////////////////////////////////////// 
											////////////////////////////////////////////////////////////////////////////////
			                                // 1. Наполняем список (как делали ранее)
										    ОбновитьВыпадающийСписокНаСервере();
										    
										    // 2. Убираем системные кнопки "+" и "Показать все" программно
										    Поле = Элементы.ОтветственныйИсполнитель;
										    Поле.РежимВыбораИзСписка = Истина;
										    
										    // Отключаем кнопки создания и расширенного выбора
										    Поле.КнопкаСоздания = Ложь;
										    Поле.КнопкаСпискаВыбора = Истина; // Оставляем только стрелочку вниз
										    
										    // Чтобы список не был шире самого поля
										    Поле.Ширина = 16; 
										    Поле.РастягиватьПоГоризонтали = Ложь;
																						
                                            ////////////////////////////////////////////////////////////////////////////////    	
	
ИтогОплаты = Объект.ИсполнениеДоговора.Итог("СуммаОплаты");
ИтогИсполнения = Объект.ИсполнениеДоговора.Итог("СуммаИсполнения");
ИсполнениеДоговораРазница = ИтогОплаты - ИтогИсполнения;
	
КонецПроцедуры

// =============================================================================
// УНИВЕРСАЛЬНЫЕ КОМАНДЫ (подключены ко всем кнопкам всех ТЧ)
// =============================================================================

&НаКлиенте
Асинх Процедура КомандаДействие(Команда)
	
	// 1. ОПРЕДЕЛЯЕМ ТАБЛИЦУ (самый надежный способ для 8.3.25)
	// Пытаемся найти кнопку по имени команды, если не выходит — берем текущий элемент
	ЭлементКнопка = ЭтаФорма.Элементы.Найти(Команда.Имя);
	Если ЭлементКнопка = Неопределено Тогда
		ЭлементКнопка = ЭтаФорма.ТекущийЭлемент;
	КонецЕсли;
	
	// Вычисляем имя таблицы из имени кнопки (отрезаем хвост "КнопкаДействие")
	ИмяТаблицы = СтрЗаменить(ЭлементКнопка.Имя, "КнопкаДействие", "");
	ЭлементТаблица = ЭтаФорма.Элементы.Найти(ИмяТаблицы);
	
	// 2. БЕЗОПАСНАЯ ПРОВЕРКА
	ТаблицаСуществует = (ЭлементТаблица <> Неопределено И ТипЗнч(ЭлементТаблица) = Тип("ТаблицаФормы"));
	
	Если ТаблицаСуществует Тогда
		// Проверяем наличие данных в самой ТЧ объекта
		Если Объект[ИмяТаблицы].Количество() = 0 Тогда
			ПоказатьОповещениеПользователя("Внимание", , "Таблица пуста!");
			Возврат;
		КонецЕсли;
	Иначе
		// Если по имени кнопки не нашли, выводим ваше сообщение
		ПоказатьОповещениеПользователя("Внимание", , "Выберите строку ТЧ");
		Возврат;
	КонецЕсли;

	// 3. АКТИВАЦИЯ (Принудительно выбираем первую строку, если фокус был в шапке)
	ЭтаФорма.ТекущийЭлемент = ЭлементТаблица;
	
	Если ЭлементТаблица.ТекущиеДанные = Неопределено Тогда
		// Активируем самую первую строку коллекции
		ЭлементТаблица.ТекущаяСтрока = Объект[ИмяТаблицы].ПолучитьИдентификатор();
	КонецЕсли;
	
	ТекущиеДанные = ЭлементТаблица.ТекущиеДанные;
	
	// 4. ВЫПОЛНЕНИЕ (оригинальный рабочий блок)
	Попытка
		Ждать РаботаСФайламиКлиент.ВыполнитьДействиеСФайлом(ЭтаФорма, ТекущиеДанные, ИмяТаблицы);
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
	РаботаСФайламиКлиент.ОбновитьИнтерфейсКнопок(ЭтаФорма, ТекущиеДанные, ИмяТаблицы);
	ЭтаФорма.ОбновитьОтображениеДанных();                 
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура КомандаУдалить(Команда)
	
	ИмяЭлемента = ЭтаФорма.ТекущийЭлемент.Имя;
	ТекущаяТЧ = СтрЗаменить(ИмяЭлемента, "КнопкаУдалить", "");
	ТекущиеДанные = Элементы[ТекущаяТЧ].ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;

	Попытка
		Ждать РаботаСФайламиКлиент.УдалитьФайл(ЭтаФорма, ТекущиеДанные, ТекущаяТЧ);
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
	// ГАРАНТИРОВАННОЕ ОБНОВЛЕНИЕ
	РаботаСФайламиКлиент.ОбновитьИнтерфейсКнопок(ЭтаФорма, ТекущиеДанные, ТекущаяТЧ);
	
	//  Обновить
	ЭтаФорма.ОбновитьОтображениеДанных();                 
	
КонецПроцедуры


