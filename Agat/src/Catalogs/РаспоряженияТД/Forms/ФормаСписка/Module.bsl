&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Получаем путь на сервере один раз
	ПутьХранилищаКлиент = Константы.ПутьХранилищаФайлов.Получить(); 
	
	// 1. Устанавливаем флаг "Только неисполненные" в значение Истина
	ОтборНеИсполненные = Истина;
	
	// 2. Установка дат текущего месяца по умолчанию (если это требуется)
	ДатаНачала    = '00010101' ;  //НачалоМесяца(ТекущаяДата())
	ДатаОкончания = КонецМесяца(ТекущаяДата());
	
    // 3. Настройка выпадающего списка "ОтборТекущийМножественный"
    Поле = Элементы.ОтборТекущийМножественный;
    Поле.РежимВыбораИзСписка = Истина;
    Поле.КнопкаСоздания = Ложь;          // Убираем кнопку "+"
    Поле.КнопкаВыбора = Ложь;            // Убираем кнопку "Показать все"
//    Поле.КнопкаСпискаВыбора = Истина;    // Оставляем стрелочку
    Поле.КнопкаОчистки = Истина;         // Оставляем крестик для очистки
    Поле.РастягиватьПоГоризонтали = Ложь;
    
    // 4. Заполняем список сотрудников
    ЗаполнитьСписокСотрудников();
    
    // 5. Настройка кнопки переключателя
    РежимФильтра = "Ответственный";  // Устанавливаем значение реквизита  Исполнители/Ответственный
    Элементы.КнопкаПереключатель.Картинка = БиблиотекаКартинок.картинка_6;
//    Элементы.КнопкаПереключатель.Подсказка = "Текущий режим: Исполнители";
//    Элементы.ОтборТекущийМножественный.Подсказка = "Выберите исполнителей";
    
    // 6. Применяем фильтры
    ОбновитьФильтрыНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПутьХранилищаНаСервере()
	Возврат Константы.ПутьХранилищаФайлов.Получить();
КонецФункции

