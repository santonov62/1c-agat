///////////////////////////////////////////////////////////////////////////////////////////
// КОМАНДА // переключение между фильтрами Исполнители / Ответственный
///////////////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура КомандаПереключитьФильтр(Команда)
	
    // Сохраняем текущие выбранные значения
    СохраненныеЗначения = Новый СписокЗначений;
    Для Каждого Элемент Из ОтборТекущийМножественный Цикл
        СохраненныеЗначения.Добавить(Элемент.Значение, Элемент.Представление);
    КонецЦикла;
    
    // Переключаем режим
    Если РежимФильтра = "Исполнители" Тогда
        РежимФильтра = "Ответственный";
        Элементы.КнопкаПереключатель.Картинка = БиблиотекаКартинок.картинка_6;
 //       Элементы.КнопкаПереключатель.Подсказка = "Текущий режим: Ответственный";
 //       Элементы.ОтборТекущийМножественный.Подсказка = "Выберите ответственных исполнителей";
    Иначе
        РежимФильтра = "Исполнители";
        Элементы.КнопкаПереключатель.Картинка = БиблиотекаКартинок.картинка_5;
//        Элементы.КнопкаПереключатель.Подсказка = "Текущий режим: Исполнители";
//        Элементы.ОтборТекущийМножественный.Подсказка = "Выберите исполнителей";
    КонецЕсли;
    
    // Восстанавливаем выбранные значения
    ОтборТекущийМножественный.Очистить();
    Для Каждого Элемент Из СохраненныеЗначения Цикл
        ОтборТекущийМножественный.Добавить(Элемент.Значение, Элемент.Представление);
    КонецЦикла;
    
    // Обновляем фильтры и список
    ОбновитьФильтрыНаСервере();
    Элементы.Список.Обновить(); 
		// Обновляем список сотрудников на сервере
    ЗаполнитьСписокСотрудников();
    
	
КонецПроцедуры

