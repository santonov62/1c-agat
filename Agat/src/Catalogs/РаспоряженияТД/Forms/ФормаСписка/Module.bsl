&НаСервере
Функция ПолучитьТекстУсловийОтбора()
    
    Условия = Новый Массив;
    
    Если ЗначениеЗаполнено(ОтборДатаДокумента) Тогда
        Знак = Элементы.КнопкаЗнакДаты.Заголовок;
        Если Знак = "=" Тогда
            Условия.Добавить("НАЧАЛОПЕРИОДА(ДатаДокумента, ДЕНЬ) = &ПарДатаДокумента");
        ИначеЕсли Знак = ">" Тогда
            Условия.Добавить("ДатаДокумента > &ПарДатаДокумента");
        Иначе
            Условия.Добавить("ДатаДокумента < &ПарДатаДокумента");
        КонецЕсли;
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ОтборНомерДокумента) Тогда
        Условия.Добавить("НомерДокумента ПОДОБНО &ПарНомерДокумента");
    КонецЕсли;
    
    Если ОтборКонтроль = 1 Тогда
        Условия.Добавить("Контроль = ИСТИНА");
    ИначеЕсли ОтборКонтроль = 2 Тогда
        Условия.Добавить("Контроль = ЛОЖЬ");
    КонецЕсли;
    
    Если ОтборН = 1 Тогда
        Условия.Добавить("Н = ИСТИНА");
    ИначеЕсли ОтборН = 2 Тогда
        Условия.Добавить("Н = ЛОЖЬ");
    КонецЕсли;
    
    Если ОтборНеИсполненные Тогда
        Условия.Добавить("ДатаИсполнения = &ПустаяДата");
    КонецЕсли;
    
    
    Если ЗначениеЗаполнено(ДатаНачала) И ДатаНачала <> '00010101' Тогда
        Условия.Добавить("СрокИсполнения >= &ДатаНачала");
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания <> '00010101' Тогда
        Условия.Добавить("СрокИсполнения <= &ДатаОкончания");
    КонецЕсли;
    
    Если Условия.Количество() = 0 Тогда
        Возврат "ИСТИНА";
    Иначе
        Возврат СтрСоединить(Условия, " И ");
    КонецЕсли;
    
КонецФункции

// СПИСОК ИСПОНИТЕЛЕЙ // Формирование запроса для получения списка Испонителей для отображения в выпадающем меню выбора (Справочника-Сотрудники реквизит Наименование(ФИО)) 
///////////////////////////////////////////////////////////////////////////////////////////	
///////////////////////////////////////////////////////////////////////////////////////////
//
&НаСервере
Процедура ЗаполнитьСписокСотрудников()
    
    // Очищаем список выбора
    Элементы.ОтборТекущийМножественный.СписокВыбора.Очистить();
    
    // Получаем отфильтрованные записи
    Запрос = Новый Запрос;
    ТекстУсловий = ПолучитьТекстУсловийОтбора();
    
    Если РежимФильтра = "Исполнители" Тогда
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    РаспоряженияТД.Исполнители
            |ИЗ
            |    Справочник.РаспоряженияТД КАК РаспоряженияТД
            |ГДЕ
            |    " + ТекстУсловий;
    Иначе
        Запрос.Текст = 
            "ВЫБРАТЬ РАЗЛИЧНЫЕ
            |    РаспоряженияТД.ОтветственныйИсполнитель КАК Сотрудник
            |ИЗ
            |    Справочник.РаспоряженияТД КАК РаспоряженияТД
            |ГДЕ
            |    " + ТекстУсловий + "
            |    И РаспоряженияТД.ОтветственныйИсполнитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)";
    КонецЕсли;
    
    // Устанавливаем параметры
    УстановитьПараметрыЗапроса(Запрос);
    
    Попытка
        Результат = Запрос.Выполнить();
        Выборка = Результат.Выбрать();
        
        УникальныеСотрудники = Новый Соответствие;
        
        Если РежимФильтра = "Исполнители" Тогда
            // Собираем уникальные ФИО из строк
            Пока Выборка.Следующий() Цикл
                СтрокаИсполнители = Выборка.Исполнители;
                Если НЕ ПустаяСтрока(СтрокаИсполнители) Тогда
                    СтрокаИсполнители = СтрЗаменить(СтрокаИсполнители, ";", ",");
                    МассивФИО = СтрРазделить(СтрокаИсполнители, ",", Ложь);
                    Для Каждого ФИО Из МассивФИО Цикл
                        ФИО = СокрЛП(ФИО);
                        Если НЕ ПустаяСтрока(ФИО) Тогда
                            УникальныеСотрудники.Вставить(ФИО, ФИО);
                        КонецЕсли;
                    КонецЦикла;
                КонецЕсли;
            КонецЦикла;
            
            // Получаем ссылки сотрудников
            Если УникальныеСотрудники.Количество() > 0 Тогда
                ЗапросСотр = Новый Запрос("ВЫБРАТЬ Ссылка, Наименование ИЗ Справочник.Сотрудники ГДЕ ПометкаУдаления = ЛОЖЬ");
                ВыборкаСотр = ЗапросСотр.Выполнить().Выбрать();
                Пока ВыборкаСотр.Следующий() Цикл
                    Если УникальныеСотрудники.Получить(ВыборкаСотр.Наименование) <> Неопределено Тогда
                        Элементы.ОтборТекущийМножественный.СписокВыбора.Добавить(ВыборкаСотр.Ссылка, ВыборкаСотр.Наименование);
                    КонецЕсли;
                КонецЦикла;
            КонецЕсли;
            
        Иначе // Ответственный
            Пока Выборка.Следующий() Цикл
                Если ЗначениеЗаполнено(Выборка.Сотрудник) Тогда
                    УникальныеСотрудники.Вставить(Выборка.Сотрудник, Выборка.Сотрудник);
                КонецЕсли;
            КонецЦикла;
            
            Если УникальныеСотрудники.Количество() > 0 Тогда
                МассивСсылок = Новый Массив;
                Для Каждого КлючЗначение Из УникальныеСотрудники Цикл
                    МассивСсылок.Добавить(КлючЗначение.Ключ);
                КонецЦикла;
                
                ЗапросСотр = Новый Запрос;
                ЗапросСотр.Текст = "ВЫБРАТЬ Ссылка, Наименование ИЗ Справочник.Сотрудники ГДЕ Ссылка В (&Масс)";
                ЗапросСотр.УстановитьПараметр("Масс", МассивСсылок);
                ВыборкаСотр = ЗапросСотр.Выполнить().Выбрать();
                Пока ВыборкаСотр.Следующий() Цикл
                    Элементы.ОтборТекущийМножественный.СписокВыбора.Добавить(ВыборкаСотр.Ссылка, ВыборкаСотр.Наименование);
                КонецЦикла;
            КонецЕсли;
        КонецЕсли;
        
        // Устанавливаем тип значения
        Элементы.ОтборТекущийМножественный.СписокВыбора.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Сотрудники");
        Элементы.ОтборТекущийМножественный.Доступность = (Элементы.ОтборТекущийМножественный.СписокВыбора.Количество() > 0);
        
//        Сообщить("Список сотрудников обновлен, количество: " + Элементы.ОтборТекущийМножественный.СписокВыбора.Количество());
        
    Исключение
//        Сообщить("Ошибка при формировании списка сотрудников: " + ОписаниеОшибки());
//        Сообщить("Текст запроса: " + Запрос.Текст);
    КонецПопытки;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьУсловияОтбора()
    
    Условия = Новый Массив;
    
    // 1. Дата документа
    Если ЗначениеЗаполнено(ОтборДатаДокумента) Тогда
        Знак = Элементы.КнопкаЗнакДаты.Заголовок;
        Если Знак = "=" Тогда
            Условия.Добавить("НАЧАЛОПЕРИОДА(ДатаДокумента, ДЕНЬ) = &ПарДатаДокумента");
        ИначеЕсли Знак = ">" Тогда
            Условия.Добавить("ДатаДокумента > &ПарДатаДокумента");
        ИначеЕсли Знак = "<" Тогда
            Условия.Добавить("ДатаДокумента < &ПарДатаДокумента");
        КонецЕсли;
    КонецЕсли;
    
    // 2. Номер документа
    Если ЗначениеЗаполнено(ОтборНомерДокумента) Тогда
        Условия.Добавить("НомерДокумента ПОДОБНО &ПарНомерДокумента");
    КонецЕсли;
    
    // 3. Контроль
    Если ОтборКонтроль = 1 Тогда
        Условия.Добавить("Контроль = ИСТИНА");
    ИначеЕсли ОтборКонтроль = 2 Тогда
        Условия.Добавить("Контроль = ЛОЖЬ");
    КонецЕсли;
    
    // 4. Н
    Если ОтборН = 1 Тогда
        Условия.Добавить("Н = ИСТИНА");
    ИначеЕсли ОтборН = 2 Тогда
        Условия.Добавить("Н = ЛОЖЬ");
    КонецЕсли;
    
    // 5. Неисполненные - ИСПРАВЛЕНО: используем параметр
    Если ОтборНеИсполненные Тогда
        Условия.Добавить("ДатаИсполнения = &ПустаяДата");
    КонецЕсли;
    
    
    // 8. Период
    Если ЗначениеЗаполнено(ДатаНачала) И ДатаНачала <> '00010101' Тогда
        Условия.Добавить("СрокИсполнения >= &ДатаНачала");
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания <> '00010101' Тогда
        Условия.Добавить("СрокИсполнения <= &ДатаОкончания");
    КонецЕсли;
    
    // Формируем результат
    Если Условия.Количество() = 0 Тогда
        Возврат "ИСТИНА";
    Иначе
        Возврат СтрСоединить(Условия, " И ");
    КонецЕсли;
    
КонецФункции

&НаСервере
Процедура УстановитьПараметрыЗапроса(Запрос)
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	 
    Если ЗначениеЗаполнено(ОтборДатаДокумента) Тогда
        Знак = Элементы.КнопкаЗнакДаты.Заголовок;
        Если Знак = "=" Тогда
            Запрос.УстановитьПараметр("ПарДатаДокумента", НачалоДня(ОтборДатаДокумента));
        ИначеЕсли Знак = ">" Тогда
            Запрос.УстановитьПараметр("ПарДатаДокумента", КонецДня(ОтборДатаДокумента));
        ИначеЕсли Знак = "<" Тогда
            Запрос.УстановитьПараметр("ПарДатаДокумента", НачалоДня(ОтборДатаДокумента));
        КонецЕсли;
    КонецЕсли;
// Номер документа   
    Если ЗначениеЗаполнено(ОтборНомерДокумента) Тогда
        Запрос.УстановитьПараметр("ПарНомерДокумента", "%" + СокрЛП(ОтборНомерДокумента) + "%");
    КонецЕсли;
// Период    
    Если ЗначениеЗаполнено(ДатаНачала) Тогда
        Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ДатаОкончания) Тогда
        Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
    КонецЕсли;
	
///////////////////////////////////////////////////////////////////////////////////////////	
 // Множественный выбор (Исполнители или Ответственные)
    Если ТипЗнч(ОтборТекущийМножественный) = Тип("СписокЗначений") И ОтборТекущийМножественный.Количество() > 0 Тогда
        Если РежимФильтра = "Исполнители" Тогда
            // Для исполнителей - параметры для каждого выбранного сотрудника
            Индекс = 0;
            Для Каждого ЭлементСписка Из ОтборТекущийМножественный Цикл
                Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
                    Индекс = Индекс + 1;
                    ИмяПараметра = "ПарИспМн_" + Формат(Индекс, "ЧГ=0");
                    ТекИмяСотрудника = СокрЛП(ЭлементСписка.Значение.Наименование);
                    Запрос.УстановитьПараметр(ИмяПараметра, "%" + ТекИмяСотрудника + "%");
                КонецЕсли;
            КонецЦикла;
        Иначе
            // Для ответственных - массив ссылок
            МассивСсылок = Новый Массив;
            Для Каждого ЭлементСписка Из ОтборТекущийМножественный Цикл
                Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
                    МассивСсылок.Добавить(ЭлементСписка.Значение);
                КонецЕсли;
            КонецЦикла;
            Если МассивСсылок.Количество() > 0 Тогда
                Запрос.УстановитьПараметр("МассивОтветственных", МассивСсылок);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
  ///////////////////////////////////////////////////////////////////////////////////////////
  
КонецПроцедуры	
///////////////////////////////////////////////////////////////////////////////////////////

// ФИЛЬТР + СЧЕТЧИК // (К / Н/ неисполненный / исполнитель / ОтветственныйИсполнитель / счетчик /ВходящийНомер /  ) 
/////////////////////////////////////////////////////////////////////////////////////////// 
///////////////////////////////////////////////////////////////////////////////////////////
&НаСервере
Процедура ОбновитьФильтрыНаСервере(ОбновлятьСписокСотрудников = Истина, ОбновлятьСчетчик = Истина)
    
    // Очистка настроек списка
    НастройкиСписка = Список.КомпоновщикНастроек.Настройки;
    ОтборСписка = НастройкиСписка.Отбор;
    ОтборСписка.Элементы.Очистить();
    
    // ============ ФОРМИРУЕМ УСЛОВИЯ ДЛЯ СЧЕТЧИКА ============
    УсловияСчетчика = Новый Массив;
    УсловияСчетчика.Добавить("ИСТИНА");
    
    // Создаем запрос для счетчика
    ЗапросСчетчик = Новый Запрос;
    
    // 1. Фильтр по дате документа
    Если ЗначениеЗаполнено(ОтборДатаДокумента) Тогда
        Знак = Элементы.КнопкаЗнакДаты.Заголовок;
        Если Знак = "=" Тогда
            УсловияСчетчика.Добавить("НАЧАЛОПЕРИОДА(ДатаДокумента, ДЕНЬ) = &ПарДатаДокумента");
            ЗапросСчетчик.УстановитьПараметр("ПарДатаДокумента", НачалоДня(ОтборДатаДокумента));
            ДобавитьЭлементОтбора(ОтборСписка, "ДатаДокумента", ОтборДатаДокумента, ВидСравненияКомпоновкиДанных.Равно);
        ИначеЕсли Знак = ">" Тогда
            УсловияСчетчика.Добавить("ДатаДокумента > &ПарДатаДокумента");
            ЗапросСчетчик.УстановитьПараметр("ПарДатаДокумента", КонецДня(ОтборДатаДокумента));
            ДобавитьЭлементОтбора(ОтборСписка, "ДатаДокумента", ОтборДатаДокумента, ВидСравненияКомпоновкиДанных.Больше);
        ИначеЕсли Знак = "<" Тогда
            УсловияСчетчика.Добавить("ДатаДокумента < &ПарДатаДокумента");
            ЗапросСчетчик.УстановитьПараметр("ПарДатаДокумента", НачалоДня(ОтборДатаДокумента));
            ДобавитьЭлементОтбора(ОтборСписка, "ДатаДокумента", ОтборДатаДокумента, ВидСравненияКомпоновкиДанных.Меньше);
        КонецЕсли;
    КонецЕсли;
    
    // 2. Фильтр по номеру документа
    Если ЗначениеЗаполнено(ОтборНомерДокумента) Тогда
        УсловияСчетчика.Добавить("НомерДокумента ПОДОБНО &ПарНомерДокумента");
        ЗапросСчетчик.УстановитьПараметр("ПарНомерДокумента", "%" + СокрЛП(ОтборНомерДокумента) + "%");
        ДобавитьЭлементОтбора(ОтборСписка, "НомерДокумента", ОтборНомерДокумента, ВидСравненияКомпоновкиДанных.Содержит);
    КонецЕсли;
    
    // 3. Фильтр по множественному выбору
    Если ТипЗнч(ОтборТекущийМножественный) = Тип("СписокЗначений") И ОтборТекущийМножественный.Количество() > 0 Тогда
        Если РежимФильтра = "Исполнители" Тогда
            // Для визуального списка
            ГруппаИЛИ = ОтборСписка.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
            ГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
            ГруппаИЛИ.Использование = Истина;
            ГруппаИЛИ.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
            
            // Для запроса счетчика
            МассивУсловий = Новый Массив;
            Индекс = 0;
            
            Для Каждого ЭлементСписка Из ОтборТекущийМножественный Цикл
                Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
                    Индекс = Индекс + 1;
                    ТекИмя = СокрЛП(ЭлементСписка.Значение.Наименование);
                    ИмяПарам = "ПарИсп_" + Индекс;
                    
                    // Визуальный список
                    НовыйОтбор = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
                    НовыйОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Исполнители");
                    НовыйОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
                    НовыйОтбор.ПравоеЗначение = ТекИмя;
                    НовыйОтбор.Использование = Истина;
                    
                    // Запрос счетчика
                    МассивУсловий.Добавить("Исполнители ПОДОБНО &" + ИмяПарам);
                    ЗапросСчетчик.УстановитьПараметр(ИмяПарам, "%" + ТекИмя + "%");
                КонецЕсли;
            КонецЦикла;
            
            Если МассивУсловий.Количество() > 0 Тогда
                УсловияСчетчика.Добавить("(" + СтрСоединить(МассивУсловий, " ИЛИ ") + ")");
            КонецЕсли;
            
        Иначе // РежимФильтра = "Ответственный"
            МассивСсылок = Новый Массив;
            Для Каждого ЭлементСписка Из ОтборТекущийМножественный Цикл
                Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
                    МассивСсылок.Добавить(ЭлементСписка.Значение);
                КонецЕсли;
            КонецЦикла;
            
            Если МассивСсылок.Количество() > 0 Тогда
                ДобавитьЭлементОтбора(ОтборСписка, "ОтветственныйИсполнитель", МассивСсылок, ВидСравненияКомпоновкиДанных.ВСписке);
                УсловияСчетчика.Добавить("ОтветственныйИсполнитель В (&МассивОтветственных)");
                ЗапросСчетчик.УстановитьПараметр("МассивОтветственных", МассивСсылок);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    
    // 4. Контроль
    Если ОтборКонтроль = 1 Тогда
        УсловияСчетчика.Добавить("Контроль = ИСТИНА");
        ДобавитьЭлементОтбора(ОтборСписка, "Контроль", Истина);
    ИначеЕсли ОтборКонтроль = 2 Тогда
        УсловияСчетчика.Добавить("Контроль = ЛОЖЬ");
        ДобавитьЭлементОтбора(ОтборСписка, "Контроль", Ложь);
    КонецЕсли;
    
    // 5. Н
    Если ОтборН = 1 Тогда
        УсловияСчетчика.Добавить("Н = ИСТИНА");
        ДобавитьЭлементОтбора(ОтборСписка, "Н", Истина);
    ИначеЕсли ОтборН = 2 Тогда
        УсловияСчетчика.Добавить("Н = ЛОЖЬ");
        ДобавитьЭлементОтбора(ОтборСписка, "Н", Ложь);
    КонецЕсли;
    
    // 6. Неисполненные
    Если ОтборНеИсполненные Тогда
        УсловияСчетчика.Добавить("ДатаИсполнения = &ПустаяДата");
        ЗапросСчетчик.УстановитьПараметр("ПустаяДата", '00010101');
        ДобавитьЭлементОтбора(ОтборСписка, "ДатаИсполнения", , ВидСравненияКомпоновкиДанных.НеЗаполнено);
    КонецЕсли;
    
    
    // 9. Период
    Если ЗначениеЗаполнено(ДатаНачала) И ДатаНачала <> '00010101' Тогда
        УсловияСчетчика.Добавить("СрокИсполнения >= &ДатаНачала");
        ЗапросСчетчик.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
        ДобавитьЭлементОтбора(ОтборСписка, "СрокИсполнения", НачалоДня(ДатаНачала), ВидСравненияКомпоновкиДанных.БольшеИлиРавно);
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания <> '00010101' Тогда
        УсловияСчетчика.Добавить("СрокИсполнения <= &ДатаОкончания");
        ЗапросСчетчик.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
        ДобавитьЭлементОтбора(ОтборСписка, "СрокИсполнения", КонецДня(ДатаОкончания), ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
    КонецЕсли;
    
    // ============ ВЫПОЛНЯЕМ ЗАПРОС СЧЕТЧИКА ============
    Если ОбновлятьСчетчик Тогда
        ЗапросСчетчик.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(Ссылка) КАК КолВо ИЗ Справочник.РаспоряженияТД ГДЕ " + СтрСоединить(УсловияСчетчика, " И ");
        
        Попытка
            Выборка = ЗапросСчетчик.Выполнить().Выбрать();
            Если Выборка.Следующий() Тогда
                ТекстКоличествоНеисполненных = "" + Формат(Выборка.КолВо, "ЧГ=0") + "";
            Иначе
                ТекстКоличествоНеисполненных = "(0)";
            КонецЕсли;
        Исключение
            ТекстКоличествоНеисполненных = "(ош)";
 //           Сообщить("Ошибка: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    
    // Обновляем список сотрудников ТОЛЬКО когда нужно
    Если ОбновлятьСписокСотрудников Тогда
        ЗаполнитьСписокСотрудников();
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ДобавитьЭлементОтбора(ГруппаОтбора, ИмяПоля, Значение = Неопределено, ВидСравнения = Неопределено)
    НовыйЭлемент = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
    
    Если ВидСравнения = Неопределено Тогда
        НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    Иначе
        НовыйЭлемент.ВидСравнения = ВидСравнения;
    КонецЕсли;
    
    Если Значение <> Неопределено Тогда
        НовыйЭлемент.ПравоеЗначение = Значение;
    КонецЕсли;
    
    НовыйЭлемент.Использование = Истина;
    НовыйЭлемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
    
    Возврат НовыйЭлемент;
КонецФункции
