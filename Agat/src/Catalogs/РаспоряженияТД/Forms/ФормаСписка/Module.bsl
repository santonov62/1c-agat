&НаКлиенте
Процедура ОтборКонтрольНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	// 1. Блокируем открытие стандартного окна выбора (лупу)
	СтандартнаяОбработка = Ложь;
	
	// 2. Вручную переключаем состояния: 0 -> 1 -> 2 -> 0
	ОтборКонтроль = (ОтборКонтроль + 1) % 3;
	
	// 3. Обновляем данные
	ОбновитьФильтрыНаСервере();
	Элементы.Список.Обновить();
		// Обновляем список сотрудников на сервере
    ЗаполнитьСписокСотрудников();
КонецПроцедуры
&НаКлиенте
Процедура ОтборННачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ОтборН = (ОтборН + 1) % 3;
	
	ОбновитьФильтрыНаСервере();
	Элементы.Список.Обновить();
		// Обновляем список сотрудников на сервере
    ЗаполнитьСписокСотрудников();
КонецПроцедуры
&НаКлиенте
Процедура НПриИзменении(Элемент)
	ОбновитьФильтрыНаСервере();  
	
// Это принудительно заставляет таблицу пересчитать строки на экране
    Элементы.Список.Обновить();
		// Обновляем список сотрудников на сервере
    ЗаполнитьСписокСотрудников();
КонецПроцедуры
&НаКлиенте
Процедура КПриИзменении(Элемент)
	ОбновитьФильтрыНаСервере();  
	
// Это принудительно заставляет таблицу пересчитать строки на экране
    Элементы.Список.Обновить();
		// Обновляем список сотрудников на сервере
    ЗаполнитьСписокСотрудников();
КонецПроцедуры

&НаКлиенте
Процедура ОтборНомерДокументаПриИзменении(Элемент)
