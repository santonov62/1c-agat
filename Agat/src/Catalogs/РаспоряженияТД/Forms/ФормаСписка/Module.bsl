// Событие при смене строки: обновляет кнопку на панели (актуально для 2026 г.)
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	КнопкаПанели = Элементы.Найти("КнопкаДействие"); 
	
	Если КнопкаПанели <> Неопределено Тогда
		
		// Проверяем наличие файла по РасширениеФайла
		Если ТекущиеДанные <> Неопределено И НЕ ПустаяСтрока(ТекущиеДанные.РасширениеФайла) Тогда
			// Файл есть — кнопка активна, иконка ПРОСМОТР
			КнопкаПанели.Картинка  = БиблиотекаКартинок.картинка_2; 
			КнопкаПанели.Заголовок = "Просмотреть файл";
			КнопкаПанели.Доступность = Истина;
		Иначе
			// Файла нет — кнопка неактивна
			КнопкаПанели.Картинка  = БиблиотекаКартинок.картинка_1; 
			КнопкаПанели.Заголовок = "Файл отсутствует";
			КнопкаПанели.Доступность = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Команда открытия файла (использует скрытый UUID)
&НаКлиенте
Асинх Процедура КомандаДействие(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено ИЛИ ПустаяСтрока(ТекущиеДанные.РасширениеФайла) Тогда
		Возврат;
	КонецЕсли;

	// Сборка пути: Путь + UUID + Расширение
	// СтрШаблон исключает ошибку "Преобразование к типу Число"
	ПутьВАрхиве = СтрШаблон("%1\%2%3", 
		ПутьХранилищаКлиент, 
		Строка(ТекущиеДанные.УникальныйИдентификатор), 
		ТекущиеДанные.РасширениеФайла);
	
	ФайлИсточник = Новый Файл(ПутьВАрхиве);
	Если НЕ Ждать ФайлИсточник.СуществуетАсинх() Тогда
		ПоказатьПредупреждение(, "Файл не найден в хранилище!");
		Возврат;
	КонецЕсли;

	// Формируем красивое имя: Наименование_Номер_Дата (в формате 24-01-2026)
	СтрДата = Формат(ТекущиеДанные.ДатаДокумента, "ДФ=dd-MM-yyyy");
	
	КрасивоеИмя = СтрШаблон("%1_№ %2_от %3%4", 
		ТекущиеДанные.Наименование, 
		ТекущиеДанные.НомерДокумента, 
		СтрДата, 
		ТекущиеДанные.РасширениеФайла);

	// Очистка от запрещенных символов Windows (\ / : * ? " < > |)
	СимволыЗамены = "\/:*?""<>|";
	Для Поз = 1 По СтрДлина(СимволыЗамены) Цикл
		КрасивоеИмя = СтрЗаменить(КрасивоеИмя, Сред(СимволыЗамены, Поз, 1), "-");
	КонецЦикла;

	// Подготавливаем временную копию и открываем асинхронно
	ПутьОткрытия = КаталогВременныхФайлов() + КрасивоеИмя;
	
	Попытка
		КопироватьФайл(ПутьВАрхиве, ПутьОткрытия);
		Ждать ЗапуститьПриложениеАсинх(ПутьОткрытия); 
	Исключение
		ПоказатьПредупреждение(, "Ошибка открытия. Убедитесь, что файл не занят другим процессом.");
	КонецПопытки;

КонецПроцедуры
