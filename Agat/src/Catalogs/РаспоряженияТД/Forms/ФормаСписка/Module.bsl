///////////////////////////////////////////////////////////////////////////////////////////
// КОМАНДА // КомандаЗнакДаты // КнопкаЗнакДаты // присвоение имени команды ( = ; < ; > )
///////////////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура КомандаЗнакДаты(Команда)
	
	// Считываем текущий заголовок кнопки
	ТекущийЗнак = Элементы.КнопкаЗнакДаты.Заголовок;
	
	// Циклическое переключение: = -> > -> < -> =
	Если ТекущийЗнак = "=" Тогда
		НовыйЗнак = ">";
	ИначеЕсли ТекущийЗнак = ">" Тогда
		НовыйЗнак = "<";
	Иначе
		НовыйЗнак = "=";
	КонецЕсли;
	
	// Устанавливаем новый текст на кнопку
	Элементы.КнопкаЗнакДаты.Заголовок = НовыйЗнак;
	
	// Обновляем фильтры и список
	ОбновитьФильтрыНаСервере();
	Элементы.Список.Обновить();
	
КонецПроцедуры
