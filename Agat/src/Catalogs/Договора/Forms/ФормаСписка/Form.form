    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Тематика</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникДоговора.Ссылка КАК Ссылка,
	СправочникДоговора.НомерРаспоряжения КАК НомерРаспоряжения,
	СправочникДоговора.Тематика КАК Тематика,
	СправочникДоговора.Наименование КАК Наименование,
	СправочникДоговора.Договор КАК Договор,
	СправочникДоговора.Заказчик КАК Заказчик,
	СправочникДоговора.СрокИсполнения КАК СрокИсполнения,
	СправочникДоговора.ДатаИсполнения КАК ДатаИсполнения,
	СправочникДоговора.ДатаЗаключения КАК ДатаЗаключения, 
//	СправочникДоговора.ВыборДиаграммаГанта КАК ВыборДиаграммаГанта,
	ВЫРАЗИТЬ(СправочникДоговора.ВыборДиаграммаГанта КАК БУЛЕВО) КАК ВыборДиаграммаГанта,
	/////////////////////////////////////////////////////////////////////////
	ВЫБОР
		КОГДА СправочникДоговора.Ссылка В
				(ВЫБРАТЬ
					ТЧ.Ссылка
				ИЗ
					Справочник.Договора.ПланГрафик КАК ТЧ
				ГДЕ
					ТЧ.СрокИсполнения &lt;= &amp;ТекущаяДата  // Срок прошел
					И ТЧ.Исполнитель &lt;> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) // Исполнитель заполнен
                    И ТЧ.СрокИсполнения > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)            
					И (ТЧ.ДатаИсполнения ЕСТЬ NULL ИЛИ ТЧ.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	//				И ТЧ.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1)    // Не исполнено
	// 				И (НЕ ТЧ.ДатаИсполнения ЕСТЬ NULL ИЛИ ТЧ.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1))            // И не является пустой (NULL)
					//				И  ТЧ.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) // Гарантированно заполнена
	//				И (ТЧ.Исполнитель &lt;> &quot;&quot; ИЛИ НЕ ТЧ.Исполнитель ЕСТЬ NULL) // Наименование НЕ заполнено
	)
    ТОГДА ИСТИНА
	ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЕстьПросрочка ,
	/////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////
	// ЕстьН: среди &quot;просроченных&quot; записей ПланГрафик с незаполненной
	// ДатаИсполнения - все ли они помечены Н = Истина.
	ВЫБОР
		КОГДА СправочникДоговора.Ссылка В
				(ВЫБРАТЬ
					ТЧ.Ссылка
				ИЗ
					Справочник.Договора.ПланГрафик КАК ТЧ
				ГДЕ
					ТЧ.СрокИсполнения &lt;= &amp;ТекущаяДата
					И ТЧ.Исполнитель &lt;> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
					И ТЧ.СрокИсполнения > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
					И (ТЧ.ДатаИсполнения ЕСТЬ NULL ИЛИ ТЧ.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
					
//					И ТЧ.Н = ИСТИНА )
					
						И НЕ ТЧ.Ссылка В
							(ВЫБРАТЬ
								ТЧН.Ссылка
							ИЗ
								Справочник.Договора.ПланГрафик КАК ТЧН
							ГДЕ
								ТЧН.Ссылка = ТЧ.Ссылка
								И ТЧН.СрокИсполнения &lt;= &amp;ТекущаяДата
							И ТЧН.Исполнитель &lt;> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
								И ТЧН.СрокИсполнения > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
								И (ТЧН.ДатаИсполнения ЕСТЬ NULL ИЛИ ТЧН.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
								И (ТЧН.Н = ЛОЖЬ ИЛИ ТЧН.Н ЕСТЬ NULL)))
    ТОГДА ИСТИНА 
	ИНАЧЕ ЛОЖЬ  
	КОНЕЦ КАК ЕстьН   
	/////////////////////////////////////////////////////////////////////////
	
ИЗ
	Справочник.Договора КАК СправочникДоговора       
	
</queryText>
