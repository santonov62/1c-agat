// В начале модуля формы, до всех процедур
Перем УжеЗаполнено;

// =============================================================================
// ФОРМА СПИСКА СПРАВОЧНИКА "ДОГОВОРА"
// =============================================================================

// =============================================================================
// СЕРВЕРНЫЕ МЕТОДЫ (ИНИЦИАЛИЗАЦИЯ)
// =============================================================================

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    // Параметр динамического списка для подзапроса ЕстьПросрочка
    Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", НачалоДня(ТекущаяДата()));

    // Дата «с» по умолчанию — начало текущего месяца
    ДатаИсполненияС = НачалоМесяца(ТекущаяДата());

    // 1. Устанавливаем флаг "Только неисполненные" в значение Истина
    ТолькоНеИсполненные = Истина;

    // 2. Настройка выпадающего списка "ОтборТематики"
    Поле = Элементы.ТекстОтборТематики;
    Поле.КнопкаСоздания = Ложь;          // Убираем кнопку "+"
    Поле.КнопкаВыбора = Ложь;            // Убираем кнопку "Показать все"
//    Поле.КнопкаОчистки = Истина;         // Оставляем крестик для очистки
//    Поле.РастягиватьПоГоризонтали = Ложь;
	Поле.РежимВыбораИзСписка = Истина;
	
	
    // Инициализируем реквизит
    Если ОтборТематики = Неопределено Тогда
        ОтборТематики = Новый СписокЗначений;
    КонецЕсли;

    // Заполняем список тематик
    ЗаполнитьСписокТематик();

    // Применяем фильтры
    ПрименитьФильтрНаСервере();

    // 3. Настройка выпадающих списков "ДиаграммаГантаТочка1/Точка2/Серия"
    //    (аналогично ТекстОтборТематики - только выбор из готового списка)
    // Точка1, Точка2 и Точка4 настраиваются так же, как Точка3 - только
    // свойствами элемента формы (CreateButton = Ложь, ListChoiceMode = Истина).
    // Программная установка КнопкаСоздания/КнопкаВыбора отсюда убрана:
    // у Точка3 ее нет, а совместно с DropListButton она кнопки не убирала
	    // Списки выбора Точка1/Точка3/Серия наполняются в
    // ЗаполнитьСпискиТочекИСерииДиаграммыГантаНаСервере ниже.
    // Умолчания задаются там же - здесь списки выбора еще пусты
    Если ДиаграммаГантаСерия = Неопределено Тогда
        ДиаграммаГантаСерия = Новый СписокЗначений;
    КонецЕсли;

    Элементы.ДиаграммаГантаСерия.РежимВыбораИзСписка = Истина;
    ЗаполнитьСпискиТочекИСерииДиаграммыГантаНаСервере();



    // Настраиваем как флажок-картинку: колонка ВыборДиаграммаГанта отображается
    // не стандартным флажком, а картинкой, которая переключается по клику
    // (EditMode = "По месту") - Истина -> картинка_4, Ложь -> картинка_3.
КонецПроцедуры


// =============================================================================
// ЗАПОЛНЕНИЕ СПИСКА ТЕМАТИК (ИСПРАВЛЕННЫЙ ЗАПРОС)
// =============================================================================

&НаСервере
Процедура ЗаполнитьСписокТематик()

    Элементы.ТекстОтборТематики.СписокВыбора.Очистить();

    // 1. Собираем уникальные ссылки на тематику, реально используемые в договорах
    //    (дедупликация в памяти BSL через Соответствие - по ссылке, не по строке)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   СправочникДоговора.Тематика КАК Тематика
    |ИЗ
    |   Справочник.Договора КАК СправочникДоговора
    |ГДЕ
    |   СправочникДоговора.Тематика <> ЗНАЧЕНИЕ(Справочник.Тематика.ПустаяСсылка)
    |   И СправочникДоговора.Тематика ЕСТЬ НЕ NULL";

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();

        УникальныеТематики = Новый Соответствие;
        Пока Выборка.Следующий() Цикл
            Если ЗначениеЗаполнено(Выборка.Тематика) Тогда
                УникальныеТематики.Вставить(Выборка.Тематика, Истина);
            КонецЕсли;
        КонецЦикла;

        // 2. Получаем Ссылка+Наименование напрямую из справочника Тематика -
        //    ровно по одной строке на каждую ссылку, без риска задвоения
        Если УникальныеТематики.Количество() > 0 Тогда

            МассивСсылок = Новый Массив;
            Для Каждого КлючЗначение Из УникальныеТематики Цикл
                МассивСсылок.Добавить(КлючЗначение.Ключ);
            КонецЦикла;

            ЗапросТематик = Новый Запрос;
            ЗапросТематик.Текст =
            "ВЫБРАТЬ
            |   Ссылка,
            |   Наименование
            |ИЗ
            |   Справочник.Тематика
            |ГДЕ
            |   Ссылка В (&МассивСсылок)
            |УПОРЯДОЧИТЬ ПО
            |   Наименование";
            ЗапросТематик.УстановитьПараметр("МассивСсылок", МассивСсылок);

            ВыборкаТематик = ЗапросТематик.Выполнить().Выбрать();
            Пока ВыборкаТематик.Следующий() Цикл
                Элементы.ТекстОтборТематики.СписокВыбора.Добавить(ВыборкаТематик.Ссылка, ВыборкаТематик.Наименование);
            КонецЦикла;

        КонецЕсли;

        Элементы.ТекстОтборТематики.СписокВыбора.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Тематика");

    Исключение
        Сообщить("Ошибка при формировании списка тематик: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры


// =============================================================================
// ДИАГРАММА ГАНТА (реквизит ДиаграммаГанта) ПО ТЧ "ПланГрафик" И "Распоряжение"
// =============================================================================
// Архитектура:
//   Точка1 (верхний уровень) - договор (ДиаграммаГанта.УстановитьТочку(Договор)),
//     доступен единственный вариант "Наименование" в СписокВыбора, только если
//     хотя бы у одного договора включена галочка ВыборДиаграммаГанта (колонка
//     СсылкаВыборДиаграммаГанта в списке).
//   Точка2 (дочерний уровень) - тип ТЧ ("Распоряжение"/"ПланГрафик"),
//     УстановитьТочку(УникальныйКлюч, Договор) - ключ обязан быть глобально
//     уникальным по всей диаграмме, поэтому строится как Договор+ИсточникТЧ.
//   Серия - НаименованиеРабот (общая для всех точек, глобально уникальна сама
//     по себе): одновременно и фильтр (если что-то отмечено в СписокВыбора -
//     показываем только отмеченные), и реальное разбиение диаграммы по цвету.
// Если Точка1 не отмечена ("Наименование" не выбрано) - диаграмма пустая.
// Многозначные строковые реквизиты (ExtendedEditMultipleValues) хранят выбор
// как текст, соединённый через запятую - разбирается РазложитьМножественноеЗначение.

&НаСервере
Функция РазложитьМножественноеЗначение(Знач Текст)

    Результат = Новый Массив;

    Если ПустаяСтрока(Текст) Тогда
        Возврат Результат;
    КонецЕсли;

    Для Каждого Часть Из СтрРазделить(Текст, ",", Ложь) Цикл
        Очищено = СокрЛП(Часть);
        Если ЗначениеЗаполнено(Очищено) Тогда
            Результат.Добавить(Очищено);
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьСпискиТочекИСерииДиаграммыГантаНаСервере()

    // --- Точка1: договоры, отмеченные ВыборДиаграммаГанта ---
    ЗаполнитьСписокДоговоровДиаграммыГанта();

    // --- Точка2: два фиксированных варианта - названия табличных частей ---
    Элементы.ДиаграммаГантаТочка2.СписокВыбора.Очистить();
    Элементы.ДиаграммаГантаТочка2.СписокВыбора.Добавить("Распоряжение", "Распоряжение");
    Элементы.ДиаграммаГантаТочка2.СписокВыбора.Добавить("ПланГрафик", "ПланГрафик");

    // По умолчанию отмечены оба варианта
    Если ДиаграммаГантаТочка2 = Неопределено Тогда
        ДиаграммаГантаТочка2 = Новый СписокЗначений;
    КонецЕсли;
    Если ДиаграммаГантаТочка2.Количество() = 0 Тогда
        Для Каждого ЭлементВыбора Из Элементы.ДиаграммаГантаТочка2.СписокВыбора Цикл
            ДиаграммаГантаТочка2.Добавить(ЭлементВыбора.Значение, ЭлементВыбора.Представление);
        КонецЦикла;
    КонецЕсли;

    // Явный тип значений - как у Точка3/Точка4/Серия. Без него платформа
    // не знает, чем ограничен список, и достраивает в меню "Создать"
    // и "Показать все"
    Элементы.ДиаграммаГантаТочка2.СписокВыбора.ТипЗначения = Новый ОписаниеТипов("Строка");

    // --- Точка3: исполнители из обеих ТЧ отмеченных договоров.
    //     Список строится так же, как список тематик: сначала собираем
    //     уникальные ссылки, потом одним запросом берем представления ---
    ЗаполнитьСписокИсполнителейДиаграммыГанта();

    // --- Серия: виды работ (НаименованиеГрафик) отмеченных договоров ---
    ЗаполнитьСписокВидовРаботДиаграммыГанта();

    // --- Точка4: изделия отмеченных договоров ---
    ЗаполнитьСписокИзделийДиаграммыГанта();

КонецПроцедуры

// =============================================================================
// СПИСОК ДОГОВОРОВ ДЛЯ ОТБОРА ДИАГРАММЫ (ДиаграммаГантаТочка1)
// =============================================================================
// В выпадающем списке - наименования договоров с ВыборДиаграммаГанта = Истина,
// то есть ровно те, что участвуют в построении. По умолчанию отмечены все:
// при обновлении списка ранее снятые отметки сохраняются, а вновь появившиеся
// договоры добавляются уже отмеченными
&НаСервере
Процедура ЗаполнитьСписокДоговоровДиаграммыГанта()

    Элементы.ДиаграммаГантаТочка1.СписокВыбора.Очистить();

    // Запоминаем, что пользователь снял вручную, чтобы не отметить это заново
    СнятыеДоговоры = Новый Соответствие;
    Если ДиаграммаГантаТочка1 <> Неопределено Тогда
        Для Каждого ЭлементВыбора Из Элементы.ДиаграммаГантаТочка1.СписокВыбора Цикл
            Если ДиаграммаГантаТочка1.НайтиПоЗначению(ЭлементВыбора.Значение) = Неопределено Тогда
                СнятыеДоговоры.Вставить(ЭлементВыбора.Значение, Истина);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    НовыйВыбор = Новый СписокЗначений;

    Попытка

        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   Договора.Ссылка КАК Ссылка,
        |   Договора.Наименование КАК Наименование        
		|ИЗ
        |   Справочник.Договора КАК Договора
        |ГДЕ
        |   Договора.ВыборДиаграммаГанта = ИСТИНА
        |УПОРЯДОЧИТЬ ПО
        |   Наименование";

        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл

            Элементы.ДиаграммаГантаТочка1.СписокВыбора.Добавить(Выборка.Ссылка,  Выборка.Наименование);   /////, Выборка.НомерРаспоряжения

            Если СнятыеДоговоры.Получить(Выборка.Ссылка) = Неопределено Тогда
                НовыйВыбор.Добавить(Выборка.Ссылка,  Выборка.Наименование);                        /////, Выборка.НомерРаспоряжения
            КонецЕсли;

        КонецЦикла;

        Элементы.ДиаграммаГантаТочка1.СписокВыбора.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Договора");

    Исключение
        Сообщить("Ошибка при формировании списка договоров диаграммы Ганта: " + ОписаниеОшибки());
    КонецПопытки;

    ДиаграммаГантаТочка1 = НовыйВыбор;

КонецПроцедуры

// =============================================================================
// СПИСОК ВИДОВ РАБОТ ДЛЯ ОТБОРА ДИАГРАММЫ (ДиаграммаГантаСерия)
// =============================================================================
// Устроен так же, как список исполнителей: наполняется отдельной процедурой,
// пустой выбор означает "без отбора". Раньше умолчание "отмечены все"
// выставлялось в ПриСозданииНаСервере до наполнения списка выбора,
// то есть не срабатывало вовсе
&НаСервере
Процедура ЗаполнитьСписокВидовРаботДиаграммыГанта()

    Элементы.ДиаграммаГантаСерия.СписокВыбора.Очистить();

    Попытка

        // НаименованиеГрафик - ссылка на Номенклатуру, поэтому сначала
        // собираем уникальные ссылки, а представления берем отдельным
        // запросом: ровно так же устроен список исполнителей (Точка3)
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   ТЧ.НаименованиеГрафик КАК НаименованиеГрафик
        |ИЗ
        |   Справочник.Договора.Распоряжение КАК ТЧ
        |ГДЕ
        |   ТЧ.Ссылка.ВыборДиаграммаГанта = ИСТИНА
        |   И ТЧ.НаименованиеГрафик <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
        |
        |ОБЪЕДИНИТЬ
        |
        |ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   ТЧ2.НаименованиеГрафик
        |ИЗ
        |   Справочник.Договора.ПланГрафик КАК ТЧ2
        |ГДЕ
        |   ТЧ2.Ссылка.ВыборДиаграммаГанта = ИСТИНА
        |   И ТЧ2.НаименованиеГрафик <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";

        Выборка = Запрос.Выполнить().Выбрать();

        УникальныеВидыРабот = Новый Соответствие;
        Пока Выборка.Следующий() Цикл
            Если ЗначениеЗаполнено(Выборка.НаименованиеГрафик) Тогда
                УникальныеВидыРабот.Вставить(Выборка.НаименованиеГрафик, Истина);
            КонецЕсли;
        КонецЦикла;

        Если УникальныеВидыРабот.Количество() > 0 Тогда

            МассивСсылок = Новый Массив;
            Для Каждого КлючЗначение Из УникальныеВидыРабот Цикл
                МассивСсылок.Добавить(КлючЗначение.Ключ);
            КонецЦикла;

            ЗапросНоменклатуры = Новый Запрос;
            ЗапросНоменклатуры.Текст =
            "ВЫБРАТЬ
            |   Ссылка,
            |   Наименование
            |ИЗ
            |   Справочник.Номенклатура
            |ГДЕ
            |   Ссылка В (&МассивСсылок)
            |УПОРЯДОЧИТЬ ПО
            |   Наименование";
            ЗапросНоменклатуры.УстановитьПараметр("МассивСсылок", МассивСсылок);

            ВыборкаНоменклатуры = ЗапросНоменклатуры.Выполнить().Выбрать();
            Пока ВыборкаНоменклатуры.Следующий() Цикл
                Элементы.ДиаграммаГантаСерия.СписокВыбора.Добавить(
                    ВыборкаНоменклатуры.Ссылка, ВыборкаНоменклатуры.Наименование);
            КонецЦикла;

        КонецЕсли;

        // Без явного типа значений список выбора не привязывается к реквизиту
        // типа СписокЗначений, и отметка галочками не работает
        Элементы.ДиаграммаГантаСерия.СписокВыбора.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");

    Исключение
        Сообщить("Ошибка при формировании списка видов работ диаграммы Ганта: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

// =============================================================================
// СПИСОК ИЗДЕЛИЙ ДЛЯ ОТБОРА ДИАГРАММЫ (ДиаграммаГантаТочка4)
// =============================================================================
// Изделие - ссылка на Номенклатуру, поэтому список строится так же, как
// список видов работ: уникальные ссылки из обеих ТЧ, затем представления
// отдельным запросом
&НаСервере
Процедура ЗаполнитьСписокИзделийДиаграммыГанта()

    Элементы.ДиаграммаГантаТочка4.СписокВыбора.Очистить();

    Попытка

        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   ТЧ.Изделие КАК Изделие
        |ИЗ
        |   Справочник.Договора.Распоряжение КАК ТЧ
        |ГДЕ
        |   ТЧ.Ссылка.ВыборДиаграммаГанта = ИСТИНА
        |   И ТЧ.Изделие <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
        |
        |ОБЪЕДИНИТЬ
        |
        |ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   ТЧ2.Изделие
        |ИЗ
        |   Справочник.Договора.ПланГрафик КАК ТЧ2
        |ГДЕ
        |   ТЧ2.Ссылка.ВыборДиаграммаГанта = ИСТИНА
        |   И ТЧ2.Изделие <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";

        Выборка = Запрос.Выполнить().Выбрать();

        УникальныеИзделия = Новый Соответствие;
        Пока Выборка.Следующий() Цикл
            Если ЗначениеЗаполнено(Выборка.Изделие) Тогда
                УникальныеИзделия.Вставить(Выборка.Изделие, Истина);
            КонецЕсли;
        КонецЦикла;

        Если УникальныеИзделия.Количество() > 0 Тогда

            МассивСсылок = Новый Массив;
            Для Каждого КлючЗначение Из УникальныеИзделия Цикл
                МассивСсылок.Добавить(КлючЗначение.Ключ);
            КонецЦикла;

            ЗапросНоменклатуры = Новый Запрос;
            ЗапросНоменклатуры.Текст =
            "ВЫБРАТЬ
            |   Ссылка,
            |   Наименование
            |ИЗ
            |   Справочник.Номенклатура
            |ГДЕ
            |   Ссылка В (&МассивСсылок)
            |УПОРЯДОЧИТЬ ПО
            |   Наименование";
            ЗапросНоменклатуры.УстановитьПараметр("МассивСсылок", МассивСсылок);

            ВыборкаНоменклатуры = ЗапросНоменклатуры.Выполнить().Выбрать();
            Пока ВыборкаНоменклатуры.Следующий() Цикл
                Элементы.ДиаграммаГантаТочка4.СписокВыбора.Добавить(
                    ВыборкаНоменклатуры.Ссылка, ВыборкаНоменклатуры.Наименование);
            КонецЦикла;

        КонецЕсли;

        // Без явного типа значений список выбора не привязывается
        // к реквизиту типа СписокЗначений, и галочки не работают
        Элементы.ДиаграммаГантаТочка4.СписокВыбора.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");

    Исключение
        Сообщить("Ошибка при формировании списка изделий диаграммы Ганта: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

// =============================================================================
// СПИСОК ИСПОЛНИТЕЛЕЙ ДЛЯ ОТБОРА ДИАГРАММЫ (ДиаграммаГантаТочка3)
// =============================================================================
// Строится по тому же принципу, что и список тематик: сначала собираем
// уникальные ссылки из обеих ТЧ отмеченных договоров, затем одним запросом
// получаем представления - без риска задвоения строк
&НаСервере
Процедура ЗаполнитьСписокИсполнителейДиаграммыГанта()

    Элементы.ДиаграммаГантаТочка3.СписокВыбора.Очистить();

    Попытка

        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   ТЧ.Исполнитель КАК Исполнитель
        |ИЗ
        |   Справочник.Договора.Распоряжение КАК ТЧ
        |ГДЕ
        |   ТЧ.Ссылка.ВыборДиаграммаГанта = ИСТИНА
        |   И ТЧ.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
        |
        |ОБЪЕДИНИТЬ
        |
        |ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   ТЧ2.Исполнитель
        |ИЗ
        |   Справочник.Договора.ПланГрафик КАК ТЧ2
        |ГДЕ
        |   ТЧ2.Ссылка.ВыборДиаграммаГанта = ИСТИНА
        |   И ТЧ2.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)";

        Выборка = Запрос.Выполнить().Выбрать();

        УникальныеИсполнители = Новый Соответствие;
        Пока Выборка.Следующий() Цикл
            Если ЗначениеЗаполнено(Выборка.Исполнитель) Тогда
                УникальныеИсполнители.Вставить(Выборка.Исполнитель, Истина);
            КонецЕсли;
        КонецЦикла;

        Если УникальныеИсполнители.Количество() > 0 Тогда

            МассивСсылок = Новый Массив;
            Для Каждого КлючЗначение Из УникальныеИсполнители Цикл
                МассивСсылок.Добавить(КлючЗначение.Ключ);
            КонецЦикла;

            ЗапросСотрудников = Новый Запрос;
            ЗапросСотрудников.Текст =
            "ВЫБРАТЬ
            |   Ссылка,
            |   Наименование
            |ИЗ
            |   Справочник.Сотрудники
            |ГДЕ
            |   Ссылка В (&МассивСсылок)
            |УПОРЯДОЧИТЬ ПО
            |   Наименование";
            ЗапросСотрудников.УстановитьПараметр("МассивСсылок", МассивСсылок);

            ВыборкаСотрудников = ЗапросСотрудников.Выполнить().Выбрать();
            Пока ВыборкаСотрудников.Следующий() Цикл
                Элементы.ДиаграммаГантаТочка3.СписокВыбора.Добавить(
                    ВыборкаСотрудников.Ссылка, ВыборкаСотрудников.Наименование);
            КонецЦикла;

        КонецЕсли;

        Элементы.ДиаграммаГантаТочка3.СписокВыбора.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Сотрудники");

    Исключение
        Сообщить("Ошибка при формировании списка исполнителей диаграммы Ганта: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДиаграммуГантаНаСервере()

    ДиаграммаГанта.Очистить();
    ДиаграммаГанта.АвтоУстановкаТекстаТочек = Ложь;
    ДиаграммаГанта.АвтоУстановкаТекстаСерий = Ложь;

    // ДиаграммаГантаТочка1 в отборе не участвует: состав договоров задается
    // исключительно реквизитом справочника ВыборДиаграммаГанта

    Если ДиаграммаГантаТочка2 = Неопределено Тогда
        ПоказыватьРаспоряжение = Ложь;
        ПоказыватьПланГрафик   = Ложь;
    Иначе
        ПоказыватьРаспоряжение = (ДиаграммаГантаТочка2.НайтиПоЗначению("Распоряжение") <> Неопределено);
        ПоказыватьПланГрафик   = (ДиаграммаГантаТочка2.НайтиПоЗначению("ПланГрафик") <> Неопределено);
    КонецЕсли;

    Если НЕ ПоказыватьРаспоряжение И НЕ ПоказыватьПланГрафик Тогда
        Возврат;
    КонецЕсли;

    // --- Отбор по состоянию исполнения. Аналог ЗаписиОтображениеСостав
    //     в ОтчетИД: Истина - только незакрытые задачи, Ложь - все записи ---
    // Условия собираются в рантайме, поэтому БЕЗ символа "|":
    // он срезается компилятором только в литерале исходного кода,
    // а здесь попал бы в текст запроса как обычный символ
    УсловиеПоДатеИсполнения = ?(ДиаграммаГантаТочка1Все,
        Символы.ПС + "   И ТЧ.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1)", "");

    // --- Отбор по исполнителю (ДиаграммаГантаТочка3) ---
    МассивИсполнителей = Новый Массив;
    Если ДиаграммаГантаТочка3 <> Неопределено Тогда
        Для Каждого ЭлементСписка Из ДиаграммаГантаТочка3 Цикл
            Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
                МассивИсполнителей.Добавить(ЭлементСписка.Значение);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    УсловиеПоИсполнителю = ?(МассивИсполнителей.Количество() > 0,
        Символы.ПС + "   И ТЧ.Исполнитель В (&МассивИсполнителей)", "");

    // --- Отбор по видам работ (ДиаграммаГантаСерия) ---
    МассивВидовРабот = Новый Массив;
    Если ДиаграммаГантаСерия <> Неопределено Тогда
        Для Каждого ЭлементСписка Из ДиаграммаГантаСерия Цикл
            Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
                МассивВидовРабот.Добавить(ЭлементСписка.Значение);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    УсловиеПоВидамРабот = ?(МассивВидовРабот.Количество() > 0,
        Символы.ПС + "   И ТЧ.НаименованиеГрафик В (&МассивВидовРабот)", "");

    // --- Отбор по изделиям (ДиаграммаГантаТочка4) ---
    МассивИзделий = Новый Массив;
    Если ДиаграммаГантаТочка4 <> Неопределено Тогда
        Для Каждого ЭлементСписка Из ДиаграммаГантаТочка4 Цикл
            Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
                МассивИзделий.Добавить(ЭлементСписка.Значение);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    УсловиеПоИзделиям = ?(МассивИзделий.Количество() > 0,
        Символы.ПС + "   И ТЧ.Изделие В (&МассивИзделий)", "");

    // --- Отбор по договорам (ДиаграммаГантаТочка1). Список отмечен полностью
    //     по умолчанию, снятие отметки исключает договор из построения.
    //     Пустой выбор при непустом списке - строить нечего ---
    МассивДоговоров = Новый Массив;
    Если ДиаграммаГантаТочка1 <> Неопределено Тогда
        Для Каждого ЭлементСписка Из ДиаграммаГантаТочка1 Цикл
            Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
                МассивДоговоров.Добавить(ЭлементСписка.Значение);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Если МассивДоговоров.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    УсловиеПоДоговорам = Символы.ПС + "   И ТЧ.Ссылка В (&МассивДоговоров)";

    // --- Формируем объединённый запрос ---
    ТекстыЗапросов = Новый Массив;

    Если ПоказыватьРаспоряжение Тогда
        ТекстыЗапросов.Добавить(
        "ВЫБРАТЬ
        |   ТЧ.Ссылка КАК Договор,
        |   ТЧ.Ссылка.Наименование КАК НаименованиеДоговора,
        |   ""Распоряжение"" КАК ИсточникТЧ,
        |   ТЧ.НаименованиеГрафик КАК НаименованиеГрафик,
        |   ТЧ.ДатаНачала КАК ДатаНачала,
        |   ТЧ.СрокИсполнения КАК СрокИсполнения,
        |   ТЧ.ДатаИсполнения КАК ДатаИсполнения,
        |   ТЧ.Н КАК Н,
        |   ТЧ.НаименованиеРабот КАК НаименованиеРабот,
        |   ПРЕДСТАВЛЕНИЕ(ТЧ.Изделие) КАК Изделие,
        |   ТЧ.Исполнитель КАК Исполнитель,
        |   ТЧ.КлючСтроки КАК КлючСтроки,
        |   ТЧ.НомерСтроки КАК НомерСтроки
        |ИЗ
        |   Справочник.Договора.Распоряжение КАК ТЧ
        |ГДЕ
        |   ТЧ.Ссылка.ВыборДиаграммаГанта = ИСТИНА"
        + УсловиеПоДатеИсполнения + УсловиеПоИсполнителю + УсловиеПоВидамРабот + УсловиеПоИзделиям + УсловиеПоДоговорам);
    КонецЕсли;

    Если ПоказыватьПланГрафик Тогда
        ТекстыЗапросов.Добавить(
        // Псевдонимы нужны и здесь: при снятом "Распоряжение" эта ветка
        // остается единственной, и УПОРЯДОЧИТЬ ПО обращается к ее именам
        "ВЫБРАТЬ
        |   ТЧ.Ссылка КАК Договор,
        |   ТЧ.Ссылка.Наименование КАК НаименованиеДоговора,
        |   ""ПланГрафик"" КАК ИсточникТЧ,
        |   ТЧ.НаименованиеГрафик КАК НаименованиеГрафик,
        |   ТЧ.ДатаНачала КАК ДатаНачала,
        |   ТЧ.СрокИсполнения КАК СрокИсполнения,
        |   ТЧ.ДатаИсполнения КАК ДатаИсполнения,
        |   ТЧ.Н КАК Н,
        |   ТЧ.НаименованиеРабот КАК НаименованиеРабот,
        |   ПРЕДСТАВЛЕНИЕ(ТЧ.Изделие) КАК Изделие,
        |   ТЧ.Исполнитель КАК Исполнитель,
        |   ТЧ.КлючСтроки КАК КлючСтроки,
        |   ТЧ.НомерСтроки КАК НомерСтроки
        |ИЗ
        |   Справочник.Договора.ПланГрафик КАК ТЧ
        |ГДЕ
        |   ТЧ.Ссылка.ВыборДиаграммаГанта = ИСТИНА"
        + УсловиеПоДатеИсполнения + УсловиеПоИсполнителю + УсловиеПоВидамРабот + УсловиеПоИзделиям + УсловиеПоДоговорам);
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст = СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС)
        // По Изделие не упорядочиваем: это ПРЕДСТАВЛЕНИЕ ссылки, а по нему
        // упорядочивание в объединении недопустимо. Группировка по изделиям
        // выполняется в памяти, порядок строк для нее не важен
        + Символы.ПС + "УПОРЯДОЧИТЬ ПО НаименованиеДоговора, ИсточникТЧ, НомерСтроки";

    Если МассивИсполнителей.Количество() > 0 Тогда
        Запрос.УстановитьПараметр("МассивИсполнителей", МассивИсполнителей);
    КонецЕсли;

    Если МассивВидовРабот.Количество() > 0 Тогда
        Запрос.УстановитьПараметр("МассивВидовРабот", МассивВидовРабот);
    КонецЕсли;

    Если МассивИзделий.Количество() > 0 Тогда
        Запрос.УстановитьПараметр("МассивИзделий", МассивИзделий);
    КонецЕсли;

    Запрос.УстановитьПараметр("МассивДоговоров", МассивДоговоров);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Сообщить("Ошибка при формировании диаграммы Ганта: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    // ============================================================
    // ПЕРВЫЙ ПРОХОД: собираем данные и уникальные ключи
    // ============================================================
    // ДанныеСтрок: Ключ - КлючИзделие, Значение - МАССИВ записей (Соответствие
    // на каждую запись), а не одна запись! У одного изделия может быть
    // несколько работ (несколько строк ТЧ) - все они должны попасть на
    // Точка3 отдельными сериями/интервалами, иначе лишние строки молча
    // теряются (была именно эта ошибка - хранилась только первая строка).
    ДанныеСтрок = Новый Соответствие;
    УникальныеДоговоры = Новый Соответствие; // Ключ: КлючДоговора, Значение: Договор
    УникальныеТЧ = Новый Соответствие;      // Ключ: КлючТЧ, Значение: ИсточникТЧ
    УникальныеИзделия = Новый Соответствие; // Ключ: КлючИзделие, Значение: Изделие

    Пока Выборка.Следующий() Цикл
        Если НЕ ЗначениеЗаполнено(Выборка.СрокИсполнения) Тогда
            Продолжить;
        КонецЕсли;

        НаименованиеРабот = СокрЛП(Выборка.НаименованиеРабот);
        // Ссылка на Номенклатуру, а не строка - СокрЛП здесь неприменим
        НаименованиеГрафик = Выборка.НаименованиеГрафик;

        // Отбор по видам работ выполняется в запросе (УсловиеПоВидамРабот),
        // как и отбор по исполнителям

        КлючДоговора = Строка(Выборка.Договор.УникальныйИдентификатор());
        КлючТЧ = КлючДоговора + "_" + Выборка.ИсточникТЧ;
        Изделие = СокрЛП(Выборка.Изделие);
        КлючИзделие = КлючТЧ + "_" + Изделие;

        // Сохраняем данные строки в МАССИВ записей этого изделия (а не
        // перезаписываем/пропускаем, если запись уже была) - для второго прохода
        ДанныеСтроки = Новый Соответствие;
        ДанныеСтроки.Вставить("Договор", Выборка.Договор);   		/////Выборка.НомерРаспоряжения,
		ДанныеСтроки.Вставить("НаименованиеДоговора", Выборка.НаименованиеДоговора);
        ДанныеСтроки.Вставить("ИсточникТЧ", Выборка.ИсточникТЧ);
        ДанныеСтроки.Вставить("Изделие", Изделие);
        ДанныеСтроки.Вставить("НаименованиеРабот", НаименованиеРабот);
        ДанныеСтроки.Вставить("НаименованиеГрафик", НаименованиеГрафик);
        ДанныеСтроки.Вставить("ДатаНачала", Выборка.ДатаНачала);
        ДанныеСтроки.Вставить("СрокИсполнения", Выборка.СрокИсполнения);
        ДанныеСтроки.Вставить("ДатаИсполнения", Выборка.ДатаИсполнения);
        ДанныеСтроки.Вставить("Н", Выборка.Н);
        ДанныеСтроки.Вставить("Исполнитель", Выборка.Исполнитель);
        ДанныеСтроки.Вставить("КлючСтроки", Выборка.КлючСтроки);
        ДанныеСтроки.Вставить("НомерСтроки", Выборка.НомерСтроки);

        МассивЗаписейИзделия = ДанныеСтрок[КлючИзделие];
        Если МассивЗаписейИзделия = Неопределено Тогда
            МассивЗаписейИзделия = Новый Массив;
            ДанныеСтрок.Вставить(КлючИзделие, МассивЗаписейИзделия);
        КонецЕсли;
        МассивЗаписейИзделия.Добавить(ДанныеСтроки);

        // Собираем уникальные договоры
        Если УникальныеДоговоры[КлючДоговора] = Неопределено Тогда
            УникальныеДоговоры.Вставить(КлючДоговора, Выборка.Договор);
        КонецЕсли;
        
        // Собираем уникальные ТЧ
        Если УникальныеТЧ[КлючТЧ] = Неопределено Тогда
            УникальныеТЧ.Вставить(КлючТЧ, Выборка.ИсточникТЧ);
        КонецЕсли;
        
        // Собираем уникальные изделия
        Если УникальныеИзделия[КлючИзделие] = Неопределено Тогда
            УникальныеИзделия.Вставить(КлючИзделие, Изделие);
        КонецЕсли;
    КонецЦикла;

    Если ДанныеСтрок.Количество() = 0 Тогда
        Возврат; // Нет данных для отображения
    КонецЕсли;

    // ============================================================
    // ВТОРОЙ ПРОХОД: создаем точки и интервалы
    // ============================================================
    
    // Серия ровно одна, как в ОтчетИД: диаграмма отводит каждой серии точки
    // отдельную полосу, поэтому число серий = высота строки. Одна серия ->
    // строка занимает ровно одну строку, а бар просрочки ложится на ту же
    // строку, что и сама работа. Состояние передается цветом интервала
    СерияРабот = ДиаграммаГанта.УстановитьСерию("Работы");
    СерияРабот.Текст = "Работы";

    ТекущаяДатаГанта = НачалоДня(ТекущаяДата());

    // Вертикальная отметка текущей даты. Фоновый интервал рисуется позади
    // баров на всю высоту области построения, поэтому дает именно линию,
    // а не полосу в отдельной строке. Отдельного свойства "линия текущей
    // даты" у диаграммы Ганта нет
    ОтметитьТекущуюДатуНаДиаграмме();

    // 1. Точка1 - договоры: черный фон, белый жирный текст
    Для каждого Элемент Из УникальныеДоговоры Цикл
        КлючДоговора = Элемент.Ключ;
        Договор = Элемент.Значение;

        ТочкаДоговора = ДиаграммаГанта.УстановитьТочку(КлючДоговора);
        ТочкаДоговора.Текст = Договор.Наименование;
        ТочкаДоговора.Расшифровка = Договор;

        ОформитьТочкуГантаСписка(ТочкаДоговора, Новый Цвет(0, 0, 0),
            Новый Цвет(255, 255, 255), Новый Шрифт(, , Истина));
    КонецЦикла;

    // 2. Точка2 - вид ОРД (Распоряжение / ПланГрафик): светло-серый фон
    Для каждого Элемент Из УникальныеТЧ Цикл
        КлючТЧ = Элемент.Ключ;
        ИсточникТЧ = Элемент.Значение;

        ПозицияПодчеркивания = СтрНайти(КлючТЧ, "_");
        КлючДоговора = Лев(КлючТЧ, ПозицияПодчеркивания - 1);

        ТочкаТЧ = ДиаграммаГанта.УстановитьТочку(КлючТЧ, КлючДоговора);
        ТочкаТЧ.Текст = ИсточникТЧ;

        ОформитьТочкуГантаСписка(ТочкаТЧ, Новый Цвет(217, 217, 217), Неопределено, Неопределено);
    КонецЦикла;

    // 3. Изделия и работы. Первая работа изделия ложится на точку изделия,
    //    остальные становятся подчиненными точками - так же, как строится
    //    дерево детализации в ОтчетИД
    СчетчикРабот = 0;

    Для каждого Элемент Из УникальныеИзделия Цикл
        КлючИзделие = Элемент.Ключ;
        Изделие = Элемент.Значение;

        ПозицияПоследнегоПодчеркивания = СтрНайти(КлючИзделие, "_", НаправлениеПоиска.СКонца);
        КлючТЧ = Лев(КлючИзделие, ПозицияПоследнегоПодчеркивания - 1);

        МассивЗаписейИзделия = ДанныеСтрок[КлючИзделие];
        Если МассивЗаписейИзделия = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        ПерваяЗапись = Истина;

        Для Каждого ДанныеСтроки Из МассивЗаписейИзделия Цикл

            ТекстРаботы = ?(ЗначениеЗаполнено(Изделие), Изделие, "");   // Без изделия
            Если ЗначениеЗаполнено(ДанныеСтроки["НаименованиеРабот"]) Тогда
                ТекстРаботы = ТекстРаботы + " | " + ДанныеСтроки["НаименованиеРабот"];
            КонецЕсли;

            Если ПерваяЗапись Тогда
                КлючТочкиРаботы = КлючИзделие;
                КлючРодителя    = КлючТЧ;
                ПерваяЗапись    = Ложь;
            Иначе
                СчетчикРабот = СчетчикРабот + 1;
                КлючТочкиРаботы = КлючИзделие + "_" + Формат(СчетчикРабот, "ЧГ=0");
                КлючРодителя    = КлючИзделие;
            КонецЕсли;

            ТочкаРаботы = ДиаграммаГанта.УстановитьТочку(КлючТочкиРаботы, КлючРодителя);
            ТочкаРаботы.Текст = ТекстРаботы;
            ТочкаРаботы.Расшифровка = ДанныеСтроки["Договор"];

            // Границы бара: 00:01 - 23:59 дня срока, если дата начала не задана
            Срок = ВремяКонцаДняГанта(ДанныеСтроки["СрокИсполнения"]);
            Начало = ?(ЗначениеЗаполнено(ДанныеСтроки["ДатаНачала"]),
                НачалоДня(ДанныеСтроки["ДатаНачала"]),
                ВремяНачалаДняГанта(ДанныеСтроки["СрокИсполнения"]));
            Если Начало > Срок Тогда
                Начало = ВремяНачалаДняГанта(ДанныеСтроки["СрокИсполнения"]);
            КонецЕсли;

            ДатаИсполнения = ДанныеСтроки["ДатаИсполнения"];
            СрокНаступил   = НачалоДня(ДанныеСтроки["СрокИсполнения"]) < ТекущаяДатаГанта;

            Если ЗначениеЗаполнено(ДатаИсполнения) Тогда
                Просрочено = НачалоДня(ДатаИсполнения) > НачалоДня(ДанныеСтроки["СрокИсполнения"]);
                КонецБара  = ?(Просрочено, ВремяКонцаДняГанта(ДатаИсполнения), Срок);
            Иначе
                Просрочено = СрокНаступил;
                КонецБара  = ?(Просрочено, ВремяКонцаДняГанта(ТекущаяДатаГанта), Срок);
            КонецЕсли;

            // Цвет основного бара по состоянию задачи
            Если ЗначениеЗаполнено(ДатаИсполнения) Тогда
                ЦветОсновного = Новый Цвет(160, 255, 160);   // исполнено
            ИначеЕсли Просрочено Тогда
                ЦветОсновного = Новый Цвет(240, 240, 240);   // не исполнено, срок прошел
            Иначе
                ЦветОсновного = Новый Цвет(220, 220, 220);   // в стадии исполнения
            КонецЕсли;

            Подсказка = ТекстРаботы
                + ?(ЗначениеЗаполнено(ДанныеСтроки["НаименованиеДоговора"]), Символы.ПС + "Договор: " + ДанныеСтроки["НаименованиеДоговора"], "")
                + Символы.ПС + "Вид ОРД: " + ДанныеСтроки["ИсточникТЧ"]
                + ?(ЗначениеЗаполнено(ДанныеСтроки["НаименованиеГрафик"]), Символы.ПС + "Вид работ: " + Строка(ДанныеСтроки["НаименованиеГрафик"]), "")
                + ?(ЗначениеЗаполнено(ДанныеСтроки["Исполнитель"]), Символы.ПС + "Исполнитель: " + Строка(ДанныеСтроки["Исполнитель"]), "")
                + Символы.ПС + "Срок исполнения: " + Формат(ДанныеСтроки["СрокИсполнения"], "ДФ=dd.MM.yyyy")
                + ?(ЗначениеЗаполнено(ДатаИсполнения), Символы.ПС + "Дата исполнения: " + Формат(ДатаИсполнения, "ДФ=dd.MM.yyyy"), "");

            ЗначениеРабот = ДиаграммаГанта.ПолучитьЗначение(ТочкаРаботы, СерияРабот);

            // Основной бар - от даты начала до срока исполнения
            ДобавитьИнтервалГантаСписка(ЗначениеРабот, Начало, Срок, Подсказка, ЦветОсновного);

            // Хвост просрочки - той же серией и на той же строке.
            // Начало сдвинуто на секунду за срок: интервалы с общей границей
            // диаграмма считает пересекающимися и разносит по разным полосам
            Если Просрочено И (Срок + 1) < КонецБара Тогда
                ЦветХвоста = ?(ДанныеСтроки["Н"] = Истина,
                    Новый Цвет(215, 234, 255), Новый Цвет(255, 183, 192));
                ДобавитьИнтервалГантаСписка(ЗначениеРабот, Срок + 1, КонецБара, Подсказка, ЦветХвоста);
            КонецЕсли;

        КонецЦикла;
    КонецЦикла;
	
//////////////////////////////////////////////////////////////////////////////////////////////	
    // Разворачиваем ВСЕ точки: Очистить() уничтожает их, и после
    // перестроения дерево вернулось бы к состоянию по умолчанию,
    // то есть выглядело бы свернутым
    Для Индекс = 0 По ДиаграммаГанта.Точки.Количество() - 1 Цикл
        Попытка
            ДиаграммаГанта.РазвернутьТочку(ДиаграммаГанта.Точки[Индекс], Истина);
        Исключение
            // Точка без подчиненных - разворачивать нечего
        КонецПопытки;
	КонецЦикла; 
	
//////////////////////////////////////////////////////////////////////////////////////////////
// разворачивание Точка1, Точка2. Точка3 - Не разворачивать (свренуть) // НЕ РАБОТАЕТ	
//////////////////////////////////////////////////////////////////////////////////////////////
// Шаг 1. Разворачиваем всё дерево: Очистить() уничтожает точки, и после
// перестроения дерево вернулось бы к состоянию по умолчанию, то есть
// выглядело бы свернутым. Заодно коллекция Точки наполняется подчиненными
// узлами - без этого шага до уровня Точка2 просто не добраться

//Для Индекс = 0 По ДиаграммаГанта.Точки.Количество() - 1 Цикл
//    Попытка
//        ДиаграммаГанта.РазвернутьТочку(ДиаграммаГанта.Точки[Индекс], Истина);
//    Исключение
        // Точка без подчиненных - разворачивать нечего
//    КонецПопытки;
//КонецЦикла;

// Шаг 2. Сворачиваем обратно уровень Точка3 и глубже.
// Точка1 и Точка2 остаются развернутыми

//УровеньРаскрытия = 1; // 0 - Точка1, 1 - Точка2, 2 - Точка3

//КоличествоТочек = ДиаграммаГанта.Точки.Количество();
//Для Счетчик = 1 По КоличествоТочек Цикл

    // Идём с конца: сначала самые глубокие узлы, чтобы сворачивание
    // родителя не ломало индексы еще не обработанных точек
//    Точка = ДиаграммаГанта.Точки[КоличествоТочек - Счетчик];

//    УровеньТекущейТочки = 0;
//    Родитель = Точка.Родитель;
//    Пока Родитель <> Неопределено Цикл
//        УровеньТекущейТочки = УровеньТекущейТочки + 1;
//        Родитель = Родитель.Родитель;
//    КонецЦикла;

//    Если УровеньТекущейТочки > УровеньРаскрытия Тогда
//        Попытка
//            ДиаграммаГанта.СвернутьТочку(Точка);
//        Исключение
            // Точка без подчиненных - сворачивать нечего
//        КонецПопытки;
//    КонецЕсли;

//КонецЦикла;
//////////////////////////////////////////////////////////////////////////////////////////////

КонецПроцедуры

// =============================================================================
// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ ОФОРМЛЕНИЯ ДИАГРАММЫ
// =============================================================================
// Набор свойств оформления у точки зависит от версии платформы,
// поэтому каждое присваивание защищено отдельно: недоступное свойство
// пропускается и не ломает построение

// Отметка текущей даты красной вертикальной линией.
// Фоновые интервалы диаграммы Ганта рисуются позади баров на всю высоту
// области построения - это единственный способ получить сплошную
// вертикальную линию, не занимая отдельную строку и не увеличивая
// высоту существующих
&НаСервере
Процедура ОтметитьТекущуюДатуНаДиаграмме()

    ТекущийДень = НачалоДня(ТекущаяДата());

    Попытка

        ФоновыйИнтервал = ДиаграммаГанта.Метки.Добавить();
        ФоновыйИнтервал.Начало = ТекущийДень;
        ФоновыйИнтервал.Конец  = ТекущийДень + 60;   // минута - тонкая полоса
        ФоновыйИнтервал.Цвет   = Новый Цвет(255, 0, 0);

        Попытка ФоновыйИнтервал.Текст = "Текущая дата"; Исключение КонецПопытки;

        Возврат;

    Исключение
 //       ТекстОшибки = ОписаниеОшибки();
    КонецПопытки;

    // ВРЕМЕННАЯ ДИАГНОСТИКА.
    // Имя коллекции фоновых интервалов подобрать не удалось - выводим
    // фактическую ошибку и перечень доступных членов объекта, чтобы
    // задать линию точно. После выяснения имени этот блок удалить
//    Описание = "Диаграмма Ганта: линия текущей даты не построена."
//        + Символы.ПС + ТекстОшибки;

    Попытка Описание = Описание + Символы.ПС + "ФоновыеИнтервалы: " + Строка(ТипЗнч(ДиаграммаГанта.ФоновыеИнтервалы)); Исключение КонецПопытки;
    Попытка Описание = Описание + Символы.ПС + "ИнтервалыФона: "    + Строка(ТипЗнч(ДиаграммаГанта.ИнтервалыФона));    Исключение КонецПопытки;
    Попытка Описание = Описание + Символы.ПС + "ФоновыеЗначения: "  + Строка(ТипЗнч(ДиаграммаГанта.ФоновыеЗначения));  Исключение КонецПопытки;
    Попытка Описание = Описание + Символы.ПС + "ОбластьПостроения: " + Строка(ТипЗнч(ДиаграммаГанта.ОбластьПостроения)); Исключение КонецПопытки;
    Попытка Описание = Описание + Символы.ПС + "ШкалаВремени: "     + Строка(ТипЗнч(ДиаграммаГанта.ОбластьПостроения.ШкалаВремени)); Исключение КонецПопытки;
    Попытка Описание = Описание + Символы.ПС + "ЛинииШкалы: "       + Строка(ТипЗнч(ДиаграммаГанта.ОбластьПостроения.ЛинииШкалы)); Исключение КонецПопытки;
    Попытка Описание = Описание + Символы.ПС + "ЦветШкалы: "        + Строка(ТипЗнч(ДиаграммаГанта.ОбластьПостроения.ЦветШкалы)); Исключение КонецПопытки;

//    Сообщить(Описание);

КонецПроцедуры

&НаСервере
Процедура ОформитьТочкуГантаСписка(Точка, ЦветФона, ЦветТекста, Шрифт)

    Если ЦветФона <> Неопределено Тогда
        Попытка Точка.ЦветФона = ЦветФона; Исключение КонецПопытки;
        Попытка Точка.Цвет     = ЦветФона; Исключение КонецПопытки;
    КонецЕсли;

    Если ЦветТекста <> Неопределено Тогда
        Попытка Точка.ЦветТекста = ЦветТекста; Исключение КонецПопытки;
    КонецЕсли;

    Если Шрифт <> Неопределено Тогда
        Попытка Точка.Шрифт = Шрифт; Исключение КонецПопытки;
    КонецЕсли;

КонецПроцедуры

// Текст интервала не заполняем: он рисуется внутри полосы и увеличивает
// ее высоту. Вся информация уходит в подсказку и в подпись точки
&НаСервере
Процедура ДобавитьИнтервалГантаСписка(ЗначениеГанта, Начало, Конец, Подсказка, Цвет)

    Интервал = ЗначениеГанта.Добавить();
    Интервал.Начало = Начало;
    Интервал.Конец  = Конец;

    Попытка Интервал.Текст = ""; Исключение КонецПопытки;
    Попытка Интервал.Подсказка = Подсказка; Исключение КонецПопытки;
    Попытка Интервал.Цвет = Цвет; Исключение КонецПопытки;

КонецПроцедуры

// Границы дня для интервалов: 00:01 и 23:59
&НаСервере
Функция ВремяНачалаДняГанта(ЗначениеДаты)

    Возврат Дата(Год(ЗначениеДаты), Месяц(ЗначениеДаты), День(ЗначениеДаты), 0, 1, 0);

КонецФункции

&НаСервере
Функция ВремяКонцаДняГанта(ЗначениеДаты)

    Возврат Дата(Год(ЗначениеДаты), Месяц(ЗначениеДаты), День(ЗначениеДаты), 23, 59, 0);

КонецФункции

// =============================================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ ЗАПРОСА
// =============================================================================

&НаСервере
Функция ПолучитьБазовыйТекстЗапроса()
    Возврат
    "ВЫБРАТЬ
    |   СправочникДоговора.Ссылка                КАК Ссылка,
    |   СправочникДоговора.НомерРаспоряжения     КАК НомерРаспоряжения,
    |   СправочникДоговора.Тематика              КАК Тематика,
    |   СправочникДоговора.Наименование          КАК Наименование,
    |   СправочникДоговора.Договор               КАК Договор,
    |   СправочникДоговора.Заказчик              КАК Заказчик,
    |   СправочникДоговора.СрокИсполнения        КАК СрокИсполнения,
    |   СправочникДоговора.ДатаИсполнения        КАК ДатаИсполнения,
    |   СправочникДоговора.ДатаЗаключения        КАК ДатаЗаключения,
	   |   СправочникДоговора.ВыборДиаграммаГанта   КАК ВыборДиаграммаГанта,
	
    |   ВЫБОР
    |       КОГДА СправочникДоговора.Ссылка В
    |           (ВЫБРАТЬ ТЧ.Ссылка
    |            ИЗ Справочник.Договора.ПланГрафик КАК ТЧ
    |            ГДЕ ТЧ.СрокИсполнения <= &ТекущаяДата
    |              И ТЧ.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
    |              И ТЧ.СрокИсполнения > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
    |              И (ТЧ.ДатаИсполнения ЕСТЬ NULL
    |                 ИЛИ ТЧ.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)))
    |       ТОГДА ИСТИНА
    |       ИНАЧЕ ЛОЖЬ
    |   КОНЕЦ КАК ЕстьПросрочка ,
	
	
    |   ВЫБОР
    |       КОГДА СправочникДоговора.Ссылка В
    |           (ВЫБРАТЬ ТЧ.Ссылка
    |            ИЗ Справочник.Договора.ПланГрафик КАК ТЧ
    |            ГДЕ ТЧ.СрокИсполнения <= &ТекущаяДата
    |              И ТЧ.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
    |              И ТЧ.СрокИсполнения > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
    |              И (ТЧ.ДатаИсполнения ЕСТЬ NULL
    |                 ИЛИ ТЧ.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
    |              И ТЧ.Н = ИСТИНА)
    |       ТОГДА ИСТИНА
    |       ИНАЧЕ ЛОЖЬ
    |   КОНЕЦ КАК ЕстьН
	
	
    |ИЗ
    |   Справочник.Договора КАК СправочникДоговора";
КонецФункции

&НаСервере
Функция ПодготовитьСтрокуПодобия(Знач Стр)
    Стр = СтрЗаменить(Стр, "~", "~~");
    Стр = СтрЗаменить(Стр, "%", "~%");
    Стр = СтрЗаменить(Стр, "_", "~_");
    Возврат "%" + Стр + "%";
КонецФункции

&НаСервере
Функция СобратьТекстФильтра(Условия)
    Если Условия.Количество() = 0 Тогда
        Возврат "";
    КонецЕсли;
    ТекстГДЕ = "";
    Для Каждого Условие Из Условия Цикл
        Если ТекстГДЕ = "" Тогда
            ТекстГДЕ = Символы.ПС + "ГДЕ " + Условие;
        Иначе
            ТекстГДЕ = ТекстГДЕ + Символы.ПС + "    И " + Условие;
        КонецЕсли;
    КонецЦикла;
    Возврат ТекстГДЕ;
КонецФункции


// =============================================================================
// СБОР УСЛОВИЙ ФИЛЬТРА
// =============================================================================

&НаСервере
Функция СобратьУсловияФильтра(ПараметрыЗапроса,
    ПсевдонимТаблицы = "СправочникДоговора")

    Т       = ПсевдонимТаблицы;
    Условия = Новый Массив;

    // ── Только неисполненные ──────────────────────────────────────────────
    Если ТолькоНеИсполненные Тогда
        Условия.Добавить(Т + ".ДатаИсполнения = ДАТАВРЕМЯ(1,1,1,0,0,0)");
    КонецЕсли;

    // ── ДатаИсполнения С ──────────────────────────────────────────────────
    Если ЗначениеЗаполнено(ДатаИсполненияС) Тогда
        Условия.Добавить("(" + Т + ".ДатаИсполнения = ДАТАВРЕМЯ(1,1,1,0,0,0)"
            + " ИЛИ " + Т + ".ДатаИсполнения >= &ФДатаИспС)");
        ПараметрыЗапроса.Вставить("ФДатаИспС", НачалоДня(ДатаИсполненияС));
    КонецЕсли;

    // ── ДатаИсполнения По ─────────────────────────────────────────────────
    Если ЗначениеЗаполнено(ДатаИсполненияПо) Тогда
        Условия.Добавить("(" + Т + ".ДатаИсполнения = ДАТАВРЕМЯ(1,1,1,0,0,0)"
            + " ИЛИ " + Т + ".ДатаИсполнения <= &ФДатаИспПо)");
        ПараметрыЗапроса.Вставить("ФДатаИспПо", КонецДня(ДатаИсполненияПо));
    КонецЕсли;

    // ── Наименование ──────────────────────────────────────────────────────
    Если ЗначениеЗаполнено(ФильтрНаименование) Тогда
        Условия.Добавить(Т + ".Наименование ПОДОБНО &ФНаименование СПЕЦСИМВОЛ ""~""");
        ПараметрыЗапроса.Вставить("ФНаименование",
            ПодготовитьСтрокуПодобия(ФильтрНаименование));
    КонецЕсли;

    // ── Полное наименование ───────────────────────────────────────────────
    Если ЗначениеЗаполнено(ФильтрПолноеНаименование) Тогда
        Условия.Добавить(Т + ".ПолноеНаименованиеПредметаДоговора"
            + " ПОДОБНО &ФПолноеНаименование СПЕЦСИМВОЛ ""~""");
        ПараметрыЗапроса.Вставить("ФПолноеНаименование",
            ПодготовитьСтрокуПодобия(ФильтрПолноеНаименование));
    КонецЕсли;

    // ── Номер распоряжения ────────────────────────────────────────────────
    Если ЗначениеЗаполнено(ФильтрНомерРаспоряжения) Тогда
        Условия.Добавить(Т + ".НомерРаспоряжения ПОДОБНО &ФНомерРасп СПЕЦСИМВОЛ ""~""");
        ПараметрыЗапроса.Вставить("ФНомерРасп",
            ПодготовитьСтрокуПодобия(ФильтрНомерРаспоряжения));
    КонецЕсли;

    // ── Договор ───────────────────────────────────────────────────────────
    Если ЗначениеЗаполнено(ФильтрДоговор) Тогда
        Условия.Добавить(Т + ".Договор ПОДОБНО &ФДоговор СПЕЦСИМВОЛ ""~""");
        ПараметрыЗапроса.Вставить("ФДоговор",
            ПодготовитьСтрокуПодобия(ФильтрДоговор));
    КонецЕсли;

    // ── Заказчик ──────────────────────────────────────────────────────────
   		Если ЗначениеЗаполнено(ФильтрЗаказчик) Тогда
		    Условия.Добавить(Т + ".Заказчик.Наименование"
		        + " ПОДОБНО &ФЗаказчик СПЕЦСИМВОЛ ""~""");
		    ПараметрыЗапроса.Вставить("ФЗаказчик",
		        ПодготовитьСтрокуПодобия(ФильтрЗаказчик));
		КонецЕсли;

    // ── СрокИсполнения С ──────────────────────────────────────────────────
    Если ЗначениеЗаполнено(СрокИсполненияС) Тогда
        Условия.Добавить(Т + ".СрокИсполнения >= &ФСрокС");
        ПараметрыЗапроса.Вставить("ФСрокС", НачалоДня(СрокИсполненияС));
    КонецЕсли;

    // ── СрокИсполнения По ─────────────────────────────────────────────────
    Если ЗначениеЗаполнено(СрокИсполненияПо) Тогда
        Условия.Добавить(Т + ".СрокИсполнения <= &ФСрокПо");
        ПараметрыЗапроса.Вставить("ФСрокПо", КонецДня(СрокИсполненияПо));
    КонецЕсли;
    
    // ── Тематика (множественный выбор) ───────────────────────────────────
    Если ТипЗнч(ОтборТематики) = Тип("СписокЗначений") И ОтборТематики.Количество() > 0 Тогда
        // Собираем массив строк тематик
        МассивТематик = Новый Массив;
        Для Каждого ЭлементСписка Из ОтборТематики Цикл
             Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
                МассивТематик.Добавить(ЭлементСписка.Значение);
            КонецЕсли;
        КонецЦикла;
        
        Если МассивТематик.Количество() > 0 Тогда
            Условия.Добавить("СправочникДоговора.Тематика В (&МассивТематик)");
            ПараметрыЗапроса.Вставить("МассивТематик", МассивТематик);
        КонецЕсли;
    КонецЕсли;

    Возврат Условия;

КонецФункции


// =============================================================================
// ОСНОВНЫЕ СЕРВЕРНЫЕ ПРОЦЕДУРЫ
// =============================================================================

&НаСервере
Процедура ПрименитьФильтрНаСервере()

    ПараметрыЗапроса = Новый Структура;
    Условия          = СобратьУсловияФильтра(ПараметрыЗапроса);

    // Перестраиваем текст запроса динамического списка
    Список.ТекстЗапроса = ПолучитьБазовыйТекстЗапроса()
        + СобратьТекстФильтра(Условия);

    Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",
        НачалоДня(ТекущаяДата()));

    Для Каждого Пара Из ПараметрыЗапроса Цикл
        Список.Параметры.УстановитьЗначениеПараметра(Пара.Ключ, Пара.Значение);
    КонецЦикла;

    ОбновитьСчетчикиНаСервере();

КонецПроцедуры


// =============================================================================
// ОБНОВЛЕНИЕ СЧЕТЧИКОВ
// =============================================================================

&НаСервере
Процедура ОбновитьСчетчикиНаСервере()

    Тек         = ТекущаяДата();
    КМес        = КонецМесяца(Тек);
    ТекДата     = НачалоДня(Тек);
    ДатаСчетчик = ?(ЗначениеЗаполнено(ДатаИсполненияС),
        НачалоДня(ДатаИсполненияС), НачалоМесяца(Тек));

    ПараметрыЗапроса = Новый Структура;
    Условия          = СобратьУсловияФильтра(ПараметрыЗапроса);

    ТекстВнутреннего =
    "ВЫБРАТЬ
    |   СправочникДоговора.ДатаИсполнения КАК ДатаИсполнения,
    |   ВЫБОР
    |       КОГДА СправочникДоговора.Ссылка В
    |           (ВЫБРАТЬ ТЧ.Ссылка
    |            ИЗ Справочник.Договора.ПланГрафик КАК ТЧ
    |            ГДЕ ТЧ.СрокИсполнения <= &ТекущаяДата
    |              И ТЧ.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
    |              И ТЧ.СрокИсполнения > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
    |              И (ТЧ.ДатаИсполнения ЕСТЬ NULL
    |                 ИЛИ ТЧ.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)))
    |       ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ
    |   КОНЕЦ КАК ЕстьПросрочка
    |ИЗ Справочник.Договора КАК СправочникДоговора"
    + СобратьТекстФильтра(Условия);

    ТекстЗапроса =
    "ВЫБРАТЬ
    |   СУММА(ВЫБОР КОГДА
    |       Вн.ДатаИсполнения = ДАТАВРЕМЯ(1,1,1,0,0,0)
    |       ИЛИ Вн.ДатаИсполнения <= &КонецМесяца
    |       ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК КолВсего,
    |   СУММА(ВЫБОР КОГДА
    |       (Вн.ДатаИсполнения = ДАТАВРЕМЯ(1,1,1,0,0,0)
    |           ИЛИ (Вн.ДатаИсполнения >= &ДатаСчетчик
    |               И Вн.ДатаИсполнения <= &КонецМесяца))
    |       И Вн.ЕстьПросрочка = ИСТИНА
    |       ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК КолКрасных,
    |   СУММА(ВЫБОР КОГДА
    |       (Вн.ДатаИсполнения = ДАТАВРЕМЯ(1,1,1,0,0,0)
    |           ИЛИ (Вн.ДатаИсполнения >= &ДатаСчетчик
    |               И Вн.ДатаИсполнения <= &КонецМесяца))
    |       И Вн.ЕстьПросрочка = ЛОЖЬ
    |       ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК КолЧерных
    |ИЗ (" + ТекстВнутреннего + ") КАК Вн";

    Запрос = Новый Запрос(ТекстЗапроса);
    Запрос.УстановитьПараметр("ТекущаяДата", ТекДата);
    Запрос.УстановитьПараметр("КонецМесяца", КМес);
    Запрос.УстановитьПараметр("ДатаСчетчик", ДатаСчетчик);
    
    Для Каждого Пара Из ПараметрыЗапроса Цикл
        Запрос.УстановитьПараметр(Пара.Ключ, Пара.Значение);
    КонецЦикла;

    КолВсего = 0; КолКрасных = 0; КолЧерных = 0;
    Попытка
        Рез = Запрос.Выполнить().Выгрузить();
        Если Рез.Количество() > 0 Тогда
            КолВсего   = ?(Рез[0].КолВсего   = Null, 0, Рез[0].КолВсего);
            КолКрасных = ?(Рез[0].КолКрасных = Null, 0, Рез[0].КолКрасных);
            КолЧерных  = ?(Рез[0].КолЧерных  = Null, 0, Рез[0].КолЧерных);
        КонецЕсли;
    Исключение
        Сообщить("Ошибка обновления счётчиков: " + ОписаниеОшибки());
    КонецПопытки;
    
    Процент = ?(КолВсего > 0, Окр(КолЧерных / КолВсего * 100, 1), 0);

    Элементы.НадписьВсего.Заголовок   = Строка(КолВсего);
    Элементы.НадписьКрасных.Заголовок = Строка(КолКрасных);
    Элементы.НадписьЧерных.Заголовок  = Строка(КолЧерных);
    Элементы.НадписьПроцент.Заголовок = ?(Процент = Неопределено ИЛИ Процент = Null, "0%", Строка(Процент) + "%");

КонецПроцедуры


// =============================================================================
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ (КЛИЕНТ)
// =============================================================================

&НаКлиенте
Процедура ОтборТематикиПриИзменении(Элемент)
	 // При изменении тематики обновляем фильтры
    ПрименитьФильтрНаСервере();
    Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрИзменён(Элемент)
	// Любой другой фильтр - полное обновление
    ПрименитьФильтрНаСервере();
    Элементы.Список.Обновить();
	// Обновляем список тематик
    ЗаполнитьСписокТематикНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокТематикНаСервере()
    ЗаполнитьСписокТематик();
КонецПроцедуры

// =============================================================================
// ОБРАБОТЧИКИ ДИАГРАММЫ ГАНТА (КЛИЕНТ)
// =============================================================================

&НаКлиенте
Процедура КомандаДиаграммаГанта(Команда)
	НовоеСостояние = НЕ Элементы.ГруппаДиаграммаГанта.Видимость;
	Элементы.ГруппаДиаграммаГанта.Видимость = НовоеСостояние;
//	Элементы.ВыборДиаграммаГанта.Видимость = НовоеСостояние;
Элементы.ГруппаСписок.Видимость = Не НовоеСостояние;
 Элементы.ГруппаФильтр.Видимость = Не НовоеСостояние;
Элементы.ФормаКомандаДиаграммаГанта.Заголовок = "Диаграмма Ганта";
Элементы.ФормаКомандаДиаграммаГанта.Картинка = БиблиотекаКартинок.ОбщаяКартинка6;
	// Показываем диаграмму - значит ее надо построить. Раньше команда
	// только переключала видимость, и при первом открытии область
	// оставалась пустой: построение выполнялось лишь при изменении
	// отметок ВыборДиаграммаГанта
	Если НовоеСостояние Тогда
		ДиаграммаГантаТочка1Все = Истина;
		ЗаполнитьСпискиТочекИСерииДиаграммыГантаНаСервере();
		ОбновитьДиаграммуГантаНаСервере();
		
		
		Элементы.ФормаКомандаДиаграммаГанта.Заголовок = "Список Договоров";
		Элементы.ФормаКомандаДиаграммаГанта.Картинка = БиблиотекаКартинок.ОбщаяКартинка3;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыборДиаграммаГантаПриИзменении(Элемент)
	// Изменился состав отмеченных договоров - переформировываем списки выбора
	// (Точка1/Серия зависят от того, что сейчас отмечено) и саму диаграмму
	ЗаполнитьСпискиТочекИСерииДиаграммыГантаНаСервере();
	ОбновитьДиаграммуГантаНаСервере();
КонецПроцедуры

// Обработчик события "Нажатие" картинки в колонке ВыборДиаграммаГанта.
// СтандартнаяОбработка отключается, чтобы платформа не пыталась сама
// циклически переключать ЗначенияКартинок - значение реквизита меняем
// и записываем на сервере сами, поэтому картинка в колонке всегда
// соответствует реальному значению в базе (Истина -> картинка_1,
// Ложь -> картинка_2, см. Элементы.ВыборДиаграммаГанта.ЗначенияКартинок
// в ПриСозданииНаСервере).
&НаКлиенте
Процедура ВыборДиаграммаГантаНажатие(Элемент, ДанныеСтроки, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(ДанныеСтроки.Ссылка);

	// Записываем на сервере новое значение (инверсию текущего) реквизита
	// ВыборДиаграммаГанта у договора, по картинке которого кликнули
	ПереключитьВыборДиаграммаГантаНаСервере(МассивСсылок);

	// Перечитываем строку списка - картинка обновится автоматически,
	// так как берётся из ЗначенияКартинок по актуальному значению реквизита
	Элементы.Список.Обновить();

	// Состав отмеченных договоров изменился - переформировываем списки выбора
	// диаграммы Ганта (Точка1/Серия) и саму диаграмму
	ЗаполнитьСпискиТочекИСерииДиаграммыГантаНаСервере();
	ОбновитьДиаграммуГантаНаСервере();

КонецПроцедуры

// Команда панели: переключает признак "Выбор диаграмма Ганта" (реквизит
// ВыборДиаграммаГанта справочника Договора) у выделенных в списке строк.
// Если выделена одна строка - работает как обычный переключатель (Истина <-> Ложь).
// Если выделено несколько строк - ориентируется на состояние первой из них
// (все выделенные приводятся к противоположному ей значению).
&НаКлиенте
Процедура КомандаПереключитьВыборДиаграммаГанта(Команда)

	МассивВыделенных = Элементы.Список.ВыделенныеСтроки;

	Если МассивВыделенных = Неопределено ИЛИ МассивВыделенных.Количество() = 0 Тогда
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			ПоказатьПредупреждение(, "Выберите договор (или несколько договоров) в списке.");
			Возврат;
		КонецЕсли;
		МассивВыделенных = Новый Массив;
		МассивВыделенных.Добавить(ТекущиеДанные.Ссылка);
	КонецЕсли;

	ПереключитьВыборДиаграммаГантаНаСервере(МассивВыделенных);

	Элементы.Список.Обновить();

	// Состав отмеченных договоров изменился - переформировываем списки выбора
	// диаграммы Ганта и саму диаграмму, как и при ручном изменении флажка
	ЗаполнитьСпискиТочекИСерииДиаграммыГантаНаСервере();
	ОбновитьДиаграммуГантаНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПереключитьВыборДиаграммаГантаНаСервере(МассивСсылок)

	Если МассивСсылок = Неопределено ИЛИ МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Ориентируемся на текущее значение флага у первой выделенной ссылки:
	// приводим все выделенные строки к противоположному значению.
	// Обращение к реквизиту через ссылку (без ПолучитьОбъект) - обычное
	// чтение простого реквизита, доступно на сервере.
	НовоеЗначение = Истина;
	Попытка
		НовоеЗначение = НЕ МассивСсылок[0].ВыборДиаграммаГанта;
	Исключение
		НовоеЗначение = Истина;
	КонецПопытки;

	Для Каждого ТекущаяСсылка Из МассивСсылок Цикл

		Если ТекущаяСсылка = Неопределено ИЛИ ТекущаяСсылка.Пустая() Тогда
			Продолжить;
		КонецЕсли;

		ОбъектДоговора = ТекущаяСсылка.ПолучитьОбъект();
		Если ОбъектДоговора = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ОбъектДоговора.ВыборДиаграммаГанта <> НовоеЗначение Тогда
			ОбъектДоговора.ВыборДиаграммаГанта = НовоеЗначение;
			Попытка
				ОбъектДоговора.Записать();
			Исключение
				Сообщить("Не удалось изменить признак «Выбор диаграмма Ганта» у "
					+ Строка(ТекущаяСсылка) + ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДиаграммаГантаТочка1ПриИзменении(Элемент)
	ОбновитьДиаграммуГантаНаСервере();
