&НаКлиенте
Процедура ЗагрузитьИзExcel(Команда)
    Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Excel (*.xlsx;*.xlsm;*.xls)|*.xlsx;*.xlsm;*.xls";
    Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

    Если ВыбранныеФайлы = Неопределено Тогда Возврат; КонецЕсли;

    ЭтаФорма.ПутьКФайлу = ?(ТипЗнч(ВыбранныеФайлы) = Тип("Массив"),
        ВыбранныеФайлы[0], ВыбранныеФайлы);

    СписокПолей = Новый СписокЗначений;
    СписокПолей.Добавить("Вид",                                "Вид");
    СписокПолей.Добавить("НомерРаспоряжения",                  "Номер распоряжения");
    СписокПолей.Добавить("Тематика",                           "Тематика");
    СписокПолей.Добавить("Договор",                            "Договор");
    СписокПолей.Добавить("ДатаЗаключения",                     "Дата заключения");
    СписокПолей.Добавить("Наименование",                       "Сокращённое наименование");
    СписокПолей.Добавить("ПолноеНаименованиеПредметаДоговора", "Полное наименование");
    СписокПолей.Добавить("Заказчик",                           "Заказчик");
    СписокПолей.Добавить("СрокИсполнения",                     "Срок исполнения");
    СписокПолей.Добавить("ДатаИсполнения",                     "Дата исполнения");
    СписокПолей.Добавить("Примечание",                         "Примечание");
    СписокПолей.Добавить("ЦенаДоговора",                       "Цена договора");
    СписокПолей.Добавить("ОтветственныйИсполнитель",           "Ответственный исполнитель");

    ПараметрыДиалога = Новый Структура;
    ПараметрыДиалога.Вставить("СписокПолей",    СписокПолей);
    ПараметрыДиалога.Вставить("СписокЛистов",   ЗагрузкаДанныхСервер.ПолучитьСписокЛистов(ЭтаФорма.ПутьКФайлу));
    ПараметрыДиалога.Вставить("ИмяСправочника", "Договора");

    ОповещениеЗакрытия = Новый ОписаниеОповещения("ПослеНастройки", ЭтотОбъект);
    ОткрытьФорму(
        "ОбщаяФорма.ДиалогНастройкиКолонок",
        ПараметрыДиалога,
        ЭтотОбъект,
        Истина,
        , ,
        ОповещениеЗакрытия,
        РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс
    );

КонецПроцедуры

&НаКлиенте
Процедура ПослеНастройки(Результат, ДополнительныеПараметры) Экспорт

    Если Результат = Неопределено Тогда Возврат; КонецЕсли;

    Попытка
        Лог = ЗагрузкаДанныхСервер.ЗагрузитьДанные(
            Неопределено,
            ЭтаФорма.ПутьКФайлу,
            Результат.НастройкиКолонок,
            Результат.СтартоваяСтрока,
            Результат.КонечнаяСтрока,
            Результат.ИмяСправочника,
            Результат.ИмяЛиста
        );
        Элементы.Список.Обновить();
        ПоказатьОповещениеПользователя("Загрузка завершена", , "Успешно: " + Лог.Успешно);
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры