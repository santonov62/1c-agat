		// Чтобы список не был шире самого поля
//		Поле.Ширина = 10; 
		Поле.РастягиватьПоГоризонтали = Ложь;																						
        ////////////////////////////////////////////////////////////////////////////////		
		
		
		
			// 2. Убираем системные кнопки "+" и "Показать все" программно
			Поле2 = Элементы.Тематика;
	//		Поле2.РежимВыбораИзСписка = Истина;
											    
			// Отключаем кнопки создания и расширенного выбора
			Поле2.КнопкаСоздания = Ложь;
			Поле2.КнопкаСпискаВыбора = Истина; // Оставляем только стрелочку вниз
										    
																					
        ////////////////////////////////////////////////////////////////////////////////	
		
		
		
		
////////////////////////////////////////////////////////////////////////////////
// Получение Имени ТЧ мз ОбщейФормы КонтрольИД		
////////////////////////////////////////////////////////////////////////////////
	// Оставляем только логику переключения
