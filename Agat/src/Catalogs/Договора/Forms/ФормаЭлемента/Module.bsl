 &НаКлиенте
Процедура ПланГрафикПередУдалением(Элемент, Отказ)
	ТекущаяСтр = Элементы.ПланГрафик.ТекущиеДанные;
	Если ТекущаяСтр <> Неопределено Тогда
		УдалитьИсполнителейПоКлючуНаСервере(ТекущаяСтр.КлючСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьИсполнителейПоКлючуНаСервере(КлючСвязи)
	СтрокиДляУдаления = Объект.СоставИсполнителей.НайтиСтроки(Новый Структура("КлючСтроки", КлючСвязи));
	Для Каждого Стр Из СтрокиДляУдаления Цикл
		Объект.СоставИсполнителей.Удалить(Стр);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПустыеКлючиНаСервере()
	
	// Используем те же типы, что и в вашем коде работы с файлами
	ПустойИД = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	
	// Проходим по основной таблице (например, Распоряжение)
	Для Каждого СтрТЧ Из Объект.Распоряжение Цикл
		
		// Проверяем КлючСтроки (именно тот реквизит, который мы создали для отчета)
		Если СтрТЧ.КлючСтроки = ПустойИД Или СтрТЧ.КлючСтроки = Неопределено Тогда
			
			// ПРИСВАИВАЕМ ТАК ЖЕ, КАК В КОДЕ С ФАЙЛАМИ
			СтрТЧ.КлючСтроки = Новый УникальныйИдентификатор;
			
			// Теперь ищем исполнителей в ТЧ "СоставИсполнителей"
			// Чтобы связать их с этой строкой
			Для Каждого СтрСостав Из Объект.СоставИсполнителей Цикл
				
				// Если у исполнителя в составе ключ пустой И ФИО совпадает с этой строкой
				Если СтрСостав.КлючСтроки = ПустойИД 
				   И Найти(СтрТЧ.Исполнитель, СокрЛП(Строка(СтрСостав.Сотрудник))) > 0 Тогда
					
					СтрСостав.КлючСтроки = СтрТЧ.КлючСтроки;
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// Повторяем для ПланГрафик
	Для Каждого СтрП Из Объект.ПланГрафик Цикл
		Если СтрП.КлючСтроки = ПустойИД Или СтрП.КлючСтроки = Неопределено Тогда
			СтрП.КлючСтроки = Новый УникальныйИдентификатор;
			
			Для Каждого СтрСостав Из Объект.СоставИсполнителей Цикл
				Если СтрСостав.КлючСтроки = ПустойИД 
				   И Найти(СтрП.Исполнитель, СокрЛП(Строка(СтрСостав.Сотрудник))) > 0 Тогда
					СтрСостав.КлючСтроки = СтрП.КлючСтроки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры


