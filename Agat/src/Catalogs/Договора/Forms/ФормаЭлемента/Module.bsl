//////////////////////////////////////////////////////////////////////////////////////////////
// ДИАГРАММА ГАНТА (страница ГруппаДиаграммаГанта) ПО ТЧ "ПланГрафик" И "Распоряжение"       //
//////////////////////////////////////////////////////////////////////////////////////////////
// Полный аналог диаграммы формы списка справочника Договора, но по одному договору -
// текущему элементу. Данные берутся не запросом (там отбор шел по реквизиту
// ВыборДиаграммаГанта нескольких договоров), а прямо из ТЧ объекта формы: так диаграмма
// показывает в том числе еще не записанные изменения ТЧ.
//
// Уровни точек (как в форме списка):
//   Точка1 - договор (черный фон, белый жирный текст),
//   Точка2 - вид ОРД: "Распоряжение" / "ПланГрафик" (светло-серый фон),
//   ниже   - изделия и работы: первая работа изделия ложится на точку изделия,
//            остальные становятся подчиненными точками.
// Серия ровно одна ("Работы"): диаграмма отводит каждой серии точки отдельную полосу,
// поэтому одна серия = одна строка, а состояние задачи передается цветом интервала.
//
// Группа отбора ГруппаТочки - аналог одноименной группы формы списка:
//   Точка1Все - только неисполненные (незаполненная ДатаИсполнения),
//   Точка2    - вид ОРД, Точка3 - исполнитель, Точка4 - изделие,
//   Серия     - вид работ (НаименованиеГрафик).
// Отбор по договору (Точка1 формы списка) здесь не нужен: договор всего один.
// Пустой список значений в любом отборе означает "без отбора".
//////////////////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ИнициализироватьДиаграммуГантаНаСервере()

	// Поля отбора работают только как выбор из готового списка - так же,
	// как одноименные поля формы списка
	Элементы.ДиаграммаГантаТочка2.РежимВыбораИзСписка = Истина;
	Элементы.ДиаграммаГантаТочка3.РежимВыбораИзСписка = Истина;
	Элементы.ДиаграммаГантаТочка4.РежимВыбораИзСписка = Истина;
	Элементы.ДиаграммаГантаСерия.РежимВыбораИзСписка  = Истина;   

	// Умолчание формы списка: показываем только незакрытые задачи
	ДиаграммаГантаТочка1Все = Истина;

	ОбновитьОтборыИДиаграммуГантаНаСервере();   
	 
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборыИДиаграммуГантаНаСервере()

	ЗаполнитьСпискиОтбораДиаграммыГанта();
	ОбновитьДиаграммуГантаНаСервере();

КонецПроцедуры

// =============================================================================
// СПИСКИ ВЫБОРА ОТБОРОВ (ГруппаТочки)
// =============================================================================
// Наполняются по всем строкам обеих ТЧ, без учета остальных отборов - иначе
// снятое значение исчезало бы из списка и вернуть его было бы нечем

&НаСервере
Процедура ЗаполнитьСпискиОтбораДиаграммыГанта()

	// --- Точка2: два фиксированных варианта - названия табличных частей ---
	Элементы.ДиаграммаГантаТочка2.СписокВыбора.Очистить();
	Элементы.ДиаграммаГантаТочка2.СписокВыбора.Добавить("Распоряжение", "Распоряжение");
	Элементы.ДиаграммаГантаТочка2.СписокВыбора.Добавить("ПланГрафик", "ПланГрафик");

	// Явный тип значений: без него платформа достраивает в меню поля
	// пункты "Создать" и "Показать все"
	Элементы.ДиаграммаГантаТочка2.СписокВыбора.ТипЗначения = Новый ОписаниеТипов("Строка");

	Если ДиаграммаГантаТочка2 = Неопределено Тогда
		ДиаграммаГантаТочка2 = Новый СписокЗначений;
	КонецЕсли;

	// По умолчанию отмечены оба варианта
	Если ДиаграммаГантаТочка2.Количество() = 0 Тогда
		Для Каждого ЭлементВыбора Из Элементы.ДиаграммаГантаТочка2.СписокВыбора Цикл
			ДиаграммаГантаТочка2.Добавить(ЭлементВыбора.Значение, ЭлементВыбора.Представление);
		КонецЦикла;
	КонецЕсли;

	// --- Точка3 (исполнители), Точка4 (изделия), Серия (виды работ) ---
	Строки = ДанныеДиаграммыГанта(Ложь);

	ДиаграммаГантаТочка3 = ЗаполнитьСписокВыбораГанта(Элементы.ДиаграммаГантаТочка3,
		ДиаграммаГантаТочка3, ЗначенияКолонкиГанта(Строки, "Исполнитель"),
		"СправочникСсылка.Сотрудники");

	ДиаграммаГантаТочка4 = ЗаполнитьСписокВыбораГанта(Элементы.ДиаграммаГантаТочка4,
		ДиаграммаГантаТочка4, ЗначенияКолонкиГанта(Строки, "Изделие"),
		"СправочникСсылка.Номенклатура");

	ДиаграммаГантаСерия = ЗаполнитьСписокВыбораГанта(Элементы.ДиаграммаГантаСерия,
		ДиаграммаГантаСерия, ЗначенияКолонкиГанта(Строки, "НаименованиеГрафик"),
		"СправочникСсылка.Номенклатура");

КонецПроцедуры

// Уникальные заполненные значения колонки в порядке появления в ТЧ
&НаСервере
Функция ЗначенияКолонкиГанта(Строки, ИмяКолонки)

	Результат = Новый Массив;
	Учтенные  = Новый Соответствие;

	Для Каждого СтрокаДанных Из Строки Цикл

		Значение = СтрокаДанных[ИмяКолонки];
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;

		Если Учтенные[Значение] = Неопределено Тогда
			Учтенные.Вставить(Значение, Истина);
			Результат.Добавить(Значение);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Наполняет список выбора поля и возвращает новое значение отбора: из прежнего
// выбора остаются только значения, которые еще есть в ТЧ
&НаСервере
Функция ЗаполнитьСписокВыбораГанта(Поле, ТекущийВыбор, МассивЗначений, ИмяТипа)

	Поле.СписокВыбора.Очистить();

	Упорядоченные = Новый СписокЗначений;
	Для Каждого Значение Из МассивЗначений Цикл
		Упорядоченные.Добавить(Значение, СокрЛП(Строка(Значение)));
	КонецЦикла;
	Упорядоченные.СортироватьПоПредставлению();

	Для Каждого ЭлементСписка Из Упорядоченные Цикл
		Поле.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

	// Без явного типа значений список выбора не привязывается к реквизиту
	// типа СписокЗначений, и отметка галочками не работает
	Поле.СписокВыбора.ТипЗначения = Новый ОписаниеТипов(ИмяТипа);

	НовыйВыбор = Новый СписокЗначений;
	Если ТекущийВыбор <> Неопределено Тогда
		Для Каждого ЭлементВыбора Из ТекущийВыбор Цикл
			Найденный = Поле.СписокВыбора.НайтиПоЗначению(ЭлементВыбора.Значение);
			Если Найденный <> Неопределено Тогда
				НовыйВыбор.Добавить(Найденный.Значение, Найденный.Представление);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат НовыйВыбор;

КонецФункции

// =============================================================================
// ДАННЫЕ ТАБЛИЧНЫХ ЧАСТЕЙ ДЛЯ ДИАГРАММЫ
// =============================================================================
// ПрименятьОтборы = Ложь - все строки обеих ТЧ (для наполнения списков выбора),
// Истина - строки с учетом отборов группы ГруппаТочки (для построения диаграммы)

&НаСервере
Функция ДанныеДиаграммыГанта(ПрименятьОтборы = Истина)

	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("ИсточникТЧ");
	Строки.Колонки.Добавить("Изделие");
	Строки.Колонки.Добавить("НаименованиеГрафик");
	Строки.Колонки.Добавить("НаименованиеРабот");
	Строки.Колонки.Добавить("Исполнитель");
	Строки.Колонки.Добавить("ДатаНачала");
	Строки.Колонки.Добавить("СрокИсполнения");
	Строки.Колонки.Добавить("ДатаИсполнения");
	Строки.Колонки.Добавить("Н");

	ОтборИсточников   = ЗначенияОтбораГанта(ДиаграммаГантаТочка2);
	ОтборИсполнителей = ЗначенияОтбораГанта(ДиаграммаГантаТочка3);
	ОтборИзделий      = ЗначенияОтбораГанта(ДиаграммаГантаТочка4);
	ОтборВидовРабот   = ЗначенияОтбораГанта(ДиаграммаГантаСерия);

	ИменаТЧ = Новый Массив;
	ИменаТЧ.Добавить("Распоряжение");
	ИменаТЧ.Добавить("ПланГрафик");

	Для Каждого ИмяТЧ Из ИменаТЧ Цикл

		// Отбор по виду ОРД (Точка2): ни одного отмеченного варианта - показывать нечего
		Если ПрименятьОтборы И ОтборИсточников.Найти(ИмяТЧ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаТЧ Из Объект[ИмяТЧ] Цикл

			Если ПрименятьОтборы Тогда

				// Без срока исполнения интервал построить не из чего
				Если НЕ ЗначениеЗаполнено(СтрокаТЧ.СрокИсполнения) Тогда
					Продолжить;
				КонецЕсли;

				// Только незакрытые задачи
				Если ДиаграммаГантаТочка1Все И ЗначениеЗаполнено(СтрокаТЧ.ДатаИсполнения) Тогда
					Продолжить;
				КонецЕсли;

				Если ОтборИсполнителей.Количество() > 0
					И ОтборИсполнителей.Найти(СтрокаТЧ.Исполнитель) = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				Если ОтборИзделий.Количество() > 0
					И ОтборИзделий.Найти(СтрокаТЧ.Изделие) = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				Если ОтборВидовРабот.Количество() > 0
					И ОтборВидовРабот.Найти(СтрокаТЧ.НаименованиеГрафик) = Неопределено Тогда
					Продолжить;
				КонецЕсли;

			КонецЕсли;

			НоваяСтрока = Строки.Добавить();
			НоваяСтрока.ИсточникТЧ         = ИмяТЧ;
			НоваяСтрока.Изделие            = СтрокаТЧ.Изделие;
			НоваяСтрока.НаименованиеГрафик = СтрокаТЧ.НаименованиеГрафик;
			НоваяСтрока.НаименованиеРабот  = СокрЛП(СтрокаТЧ.НаименованиеРабот);
			НоваяСтрока.Исполнитель        = СтрокаТЧ.Исполнитель;
			НоваяСтрока.ДатаНачала         = СтрокаТЧ.ДатаНачала;
			НоваяСтрока.СрокИсполнения     = СтрокаТЧ.СрокИсполнения;
			НоваяСтрока.ДатаИсполнения     = СтрокаТЧ.ДатаИсполнения;
			НоваяСтрока.Н                  = СтрокаТЧ.Н;

		КонецЦикла;

	КонецЦикла;

	Возврат Строки;

КонецФункции

// Заполненные значения отбора массивом. Пустой массив - отбор не задан
&НаСервере
Функция ЗначенияОтбораГанта(Отбор)

	Результат = Новый Массив;

	Если Отбор = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ЭлементСписка Из Отбор Цикл
		Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			Результат.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// =============================================================================
// ПОСТРОЕНИЕ ДИАГРАММЫ
// =============================================================================

&НаСервере
Процедура ОбновитьДиаграммуГантаНаСервере()

	ДиаграммаГанта.Очистить();
	ДиаграммаГанта.АвтоУстановкаТекстаТочек = Ложь;
	ДиаграммаГанта.АвтоУстановкаТекстаСерий = Ложь;

	Строки = ДанныеДиаграммыГанта(Истина);
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Серия ровно одна: число серий = высота строки диаграммы, поэтому бар
	// просрочки ложится на ту же строку, что и сама работа
	СерияРабот = ДиаграммаГанта.УстановитьСерию("Работы");
	СерияРабот.Текст = "Работы";

	ТекущаяДатаГанта = НачалоДня(ТекущаяДата());

	// Вертикальная отметка текущей даты
	ОтметитьТекущуюДатуНаДиаграмме();

	// --- Точка1: договор ---
	КлючДоговора = "Договор";
	ТочкаДоговора = ДиаграммаГанта.УстановитьТочку(КлючДоговора);
	ТочкаДоговора.Текст = ?(ЗначениеЗаполнено(Объект.Наименование),
		Объект.Наименование, "Договор (новый)");
	ТочкаДоговора.Расшифровка = Объект.Ссылка;

	ОформитьТочкуГанта(ТочкаДоговора, Новый Цвет(0, 0, 0),
		Новый Цвет(255, 255, 255), Новый Шрифт(, , Истина));

	// --- Группировка строк: вид ОРД -> изделие, в порядке следования строк ТЧ ---
	ПорядокТЧ       = Новый Массив;       // ключи точек вида ОРД
	ПорядокИзделий  = Новый Массив;       // ключи точек изделий
	ЗаписиИзделий   = Новый Соответствие; // КлючИзделия -> массив строк
	РодителиИзделий = Новый Соответствие; // КлючИзделия -> КлючТЧ (родительская точка)

	Для Каждого СтрокаДанных Из Строки Цикл

		КлючТЧ = КлючДоговора + "_" + СтрокаДанных.ИсточникТЧ;
		Если ПорядокТЧ.Найти(КлючТЧ) = Неопределено Тогда

			ПорядокТЧ.Добавить(КлючТЧ);

			ТочкаТЧ = ДиаграммаГанта.УстановитьТочку(КлючТЧ, КлючДоговора);
			ТочкаТЧ.Текст = СтрокаДанных.ИсточникТЧ;

			ОформитьТочкуГанта(ТочкаТЧ, Новый Цвет(217, 217, 217), Неопределено, Неопределено);

		КонецЕсли;

		ИзделиеПредставление = ?(ЗначениеЗаполнено(СтрокаДанных.Изделие),
			СокрЛП(Строка(СтрокаДанных.Изделие)), "");
		КлючИзделия = КлючТЧ + "_" + ИзделиеПредставление;

		ЗаписиИзделия = ЗаписиИзделий[КлючИзделия];
		Если ЗаписиИзделия = Неопределено Тогда
			ЗаписиИзделия = Новый Массив;
			ЗаписиИзделий.Вставить(КлючИзделия, ЗаписиИзделия);
			// Родителя запоминаем, а не вычисляем разбором ключа: наименование
			// изделия может содержать символ-разделитель "_"
			РодителиИзделий.Вставить(КлючИзделия, КлючТЧ);
			ПорядокИзделий.Добавить(КлючИзделия);
		КонецЕсли;
		ЗаписиИзделия.Добавить(СтрокаДанных);

	КонецЦикла;

	// --- Изделия и работы. Первая работа изделия ложится на точку изделия,
	//     остальные становятся подчиненными точками ---
	СчетчикРабот = 0;

	Для Каждого КлючИзделия Из ПорядокИзделий Цикл

		КлючТЧ = РодителиИзделий[КлючИзделия];

		ПерваяЗапись = Истина;

		Для Каждого СтрокаДанных Из ЗаписиИзделий[КлючИзделия] Цикл

			ИзделиеПредставление = ?(ЗначениеЗаполнено(СтрокаДанных.Изделие),
				СокрЛП(Строка(СтрокаДанных.Изделие)), "");

			ТекстРаботы = ИзделиеПредставление;   // Без изделия - только наименование работ
			Если ЗначениеЗаполнено(СтрокаДанных.НаименованиеРабот) Тогда
				ТекстРаботы = ?(ПустаяСтрока(ТекстРаботы), "", ТекстРаботы + " | ")
					+ СтрокаДанных.НаименованиеРабот;
			КонецЕсли;

			Если ПерваяЗапись Тогда
				КлючТочкиРаботы = КлючИзделия;
				КлючРодителя    = КлючТЧ;
				ПерваяЗапись    = Ложь;
			Иначе
				СчетчикРабот    = СчетчикРабот + 1;
				КлючТочкиРаботы = КлючИзделия + "_" + Формат(СчетчикРабот, "ЧГ=0");
				КлючРодителя    = КлючИзделия;
			КонецЕсли;

			ТочкаРаботы = ДиаграммаГанта.УстановитьТочку(КлючТочкиРаботы, КлючРодителя);
			ТочкаРаботы.Текст = ТекстРаботы;
			ТочкаРаботы.Расшифровка = Объект.Ссылка;

			// Границы бара: 00:01 - 23:59 дня срока, если дата начала не задана
			Срок = ВремяКонцаДняГанта(СтрокаДанных.СрокИсполнения);
			Начало = ?(ЗначениеЗаполнено(СтрокаДанных.ДатаНачала),
				НачалоДня(СтрокаДанных.ДатаНачала),
				ВремяНачалаДняГанта(СтрокаДанных.СрокИсполнения));
			Если Начало > Срок Тогда
				Начало = ВремяНачалаДняГанта(СтрокаДанных.СрокИсполнения);
			КонецЕсли;

			ДатаИсполнения = СтрокаДанных.ДатаИсполнения;
			СрокНаступил   = НачалоДня(СтрокаДанных.СрокИсполнения) < ТекущаяДатаГанта;

			Если ЗначениеЗаполнено(ДатаИсполнения) Тогда
				Просрочено = НачалоДня(ДатаИсполнения) > НачалоДня(СтрокаДанных.СрокИсполнения);
				КонецБара  = ?(Просрочено, ВремяКонцаДняГанта(ДатаИсполнения), Срок);
			Иначе
				Просрочено = СрокНаступил;
				КонецБара  = ?(Просрочено, ВремяКонцаДняГанта(ТекущаяДатаГанта), Срок);
			КонецЕсли;

			// Цвет основного бара по состоянию задачи
			Если ЗначениеЗаполнено(ДатаИсполнения) Тогда
				ЦветОсновного = Новый Цвет(160, 255, 160);   // исполнено
			ИначеЕсли Просрочено Тогда
				ЦветОсновного = Новый Цвет(240, 240, 240);   // не исполнено, срок прошел
			Иначе
				ЦветОсновного = Новый Цвет(220, 220, 220);   // в стадии исполнения
			КонецЕсли;

			Подсказка = ТекстРаботы
				+ ?(ЗначениеЗаполнено(Объект.Наименование), Символы.ПС + "Договор: " + Объект.Наименование, "")
				+ Символы.ПС + "Вид ОРД: " + СтрокаДанных.ИсточникТЧ
				+ ?(ЗначениеЗаполнено(СтрокаДанных.НаименованиеГрафик), Символы.ПС + "Вид работ: " + Строка(СтрокаДанных.НаименованиеГрафик), "")
				+ ?(ЗначениеЗаполнено(СтрокаДанных.Исполнитель), Символы.ПС + "Исполнитель: " + Строка(СтрокаДанных.Исполнитель), "")
				+ Символы.ПС + "Срок исполнения: " + Формат(СтрокаДанных.СрокИсполнения, "ДФ=dd.MM.yyyy")
				+ ?(ЗначениеЗаполнено(ДатаИсполнения), Символы.ПС + "Дата исполнения: " + Формат(ДатаИсполнения, "ДФ=dd.MM.yyyy"), "");

			ЗначениеРабот = ДиаграммаГанта.ПолучитьЗначение(ТочкаРаботы, СерияРабот);

			// Основной бар - от даты начала до срока исполнения
			ДобавитьИнтервалГанта(ЗначениеРабот, Начало, Срок, Подсказка, ЦветОсновного);

			// Хвост просрочки - той же серией и на той же строке. Начало сдвинуто
			// на секунду за срок: интервалы с общей границей диаграмма считает
			// пересекающимися и разносит по разным полосам
			Если Просрочено И (Срок + 1) < КонецБара Тогда
				ЦветХвоста = ?(СтрокаДанных.Н = Истина,
					Новый Цвет(215, 234, 255), Новый Цвет(255, 183, 192));
				ДобавитьИнтервалГанта(ЗначениеРабот, Срок + 1, КонецБара, Подсказка, ЦветХвоста);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	// Разворачиваем все точки: Очистить() уничтожает их, и после перестроения
	// дерево вернулось бы к состоянию по умолчанию, то есть выглядело бы свернутым
	Для Индекс = 0 По ДиаграммаГанта.Точки.Количество() - 1 Цикл
		Попытка
			ДиаграммаГанта.РазвернутьТочку(ДиаграммаГанта.Точки[Индекс], Истина);
		Исключение
			// Точка без подчиненных - разворачивать нечего
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// =============================================================================
// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ ОФОРМЛЕНИЯ ДИАГРАММЫ
// =============================================================================
// Набор свойств оформления у точки зависит от версии платформы, поэтому каждое
// присваивание защищено отдельно: недоступное свойство пропускается
// и не ломает построение

// Отметка текущей даты красной вертикальной линией. Фоновые интервалы рисуются
// позади баров на всю высоту области построения - это единственный способ
// получить сплошную вертикальную линию, не занимая отдельную строку
&НаСервере
Процедура ОтметитьТекущуюДатуНаДиаграмме()

	ТекущийДень = НачалоДня(ТекущаяДата());

	Попытка
		ФоновыйИнтервал = ДиаграммаГанта.Метки.Добавить(ТекущийДень, ТекущийДень + 60);                      //ДиаграммаГанта.Метки
//		ФоновыйИнтервал.Начало = ТекущийДень;
//		ФоновыйИнтервал.Конец  = ТекущийДень + 60;   // минута - тонкая полоса
		ФоновыйИнтервал.Цвет   = Новый Цвет(255, 0, 0);

		Попытка ФоновыйИнтервал.Текст = "Текущая дата"; Исключение КонецПопытки;
	Исключение
		// Коллекция фоновых интервалов недоступна - строим диаграмму без отметки
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОформитьТочкуГанта(Точка, ЦветФона, ЦветТекста, Шрифт)

	Если ЦветФона <> Неопределено Тогда
		Попытка Точка.ЦветФона = ЦветФона; Исключение КонецПопытки;
		Попытка Точка.Цвет     = ЦветФона; Исключение КонецПопытки;
	КонецЕсли;

	Если ЦветТекста <> Неопределено Тогда
		Попытка Точка.ЦветТекста = ЦветТекста; Исключение КонецПопытки;
	КонецЕсли;

	Если Шрифт <> Неопределено Тогда
		Попытка Точка.Шрифт = Шрифт; Исключение КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Текст интервала не заполняем: он рисуется внутри полосы и увеличивает
// ее высоту. Вся информация уходит в подсказку и в подпись точки
&НаСервере
Процедура ДобавитьИнтервалГанта(ЗначениеГанта, Начало, Конец, Подсказка, Цвет)

	Интервал = ЗначениеГанта.Добавить();
	Интервал.Начало = Начало;
	Интервал.Конец  = Конец;

	Попытка Интервал.Текст = ""; Исключение КонецПопытки;
	Попытка Интервал.Подсказка = Подсказка; Исключение КонецПопытки;
	Попытка Интервал.Цвет = Цвет; Исключение КонецПопытки;

КонецПроцедуры

// Границы дня для интервалов: 00:01 и 23:59
&НаСервере
Функция ВремяНачалаДняГанта(ЗначениеДаты)

	Возврат Дата(Год(ЗначениеДаты), Месяц(ЗначениеДаты), День(ЗначениеДаты), 0, 1, 0);

КонецФункции

&НаСервере
Функция ВремяКонцаДняГанта(ЗначениеДаты)

	Возврат Дата(Год(ЗначениеДаты), Месяц(ЗначениеДаты), День(ЗначениеДаты), 23, 59, 0);

КонецФункции

