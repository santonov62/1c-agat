 //  ТЧ   // ДиалогНастройкиКолонок и Общим модулем ЗагрузкаДанныхСервер
 /////////////////////////////////////////////////////////////////////////////////////////// 
 ///////////////////////////////////////////////////////////////////////////////////////////
 &НаКлиенте
 Процедура ЗагрузитьИзExcel(Команда)
	 
//	 ИмяЭлемента = ЭтаФорма.ТекущийЭлемент.Имя; 
	// Определяем имя текущей табличной части
//	ТекущийЭлемент = ЭтаФорма.ТекущийЭлемент;
//	ИмяТекущейТЧ = СтрЗаменить(ИмяЭлемента, "КомандаИзExcel", "");///
	
	// Проверяем, что имя ТЧ не пустое
//	Если ПустаяСтрока(ИмяТекущейТЧ) Тогда
//		Возврат;
//	КонецЕсли;

// 1. Выбор файла
// выбор/открытие файла Excel	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Excel файлы (*.xlsx;*.xlsm;*.xls)|*.xlsx;*.xlsm;*.xls";
	Диалог.Показать(Оповещение); 
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда Возврат; КонецЕсли;
	
//=====================================================================================	
	// Определяем текущий элемент формы
    ТекущийЭлемент = ЭтаФорма.ТекущийЭлемент;
    Если ТекущийЭлемент = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Получаем имя табличной части из имени элемента
    // Например, если элемент называется "Распоряжение", то имя ТЧ = "Распоряжение"
    ИмяТекущейТЧ = ТекущийЭлемент.Имя;
//=====================================================================================		
	ПутьКФайлу = ВыбранныеФайлы[0];
	
// 2. Определение полей (Шапка и ТЧ текущего договора)
	// Создаем СписокПолей для заполнения в зависимости от ТЧ
	СписокПолей = Новый СписокЗначений;	
	// Реквизиты для отображения в форме Выбора
	// ОПРЕДЕЛЯЕМ КОНКРЕТНЫЕ РЕКВИЗИТЫ ДЛЯ ЗАПОЛНЕНИЯ в коде
	// Создаем список полей для заполнения в зависимости от ТЧ
	Если ИмяТекущейТЧ = "Распоряжение" Тогда
		СписокПолей.Добавить("Распоряжение.НаименованиеРабот", "Наименование Работ");
		СписокПолей.Добавить("Распоряжение.Исполнитель",       "Исполнитель");
		СписокПолей.Добавить("Распоряжение.ДатаНачала",        "Дата Начала");
		СписокПолей.Добавить("Распоряжение.СрокИсполнения",    "Срок Исполнения");
		СписокПолей.Добавить("Распоряжение.ДатаИсполнения",    "Дата Исполнения");
		СписокПолей.Добавить("Распоряжение.Примечание", 	      "Примечание");
	ИначеЕсли ИмяТекущейТЧ = "ПланГрафик" Тогда
		СписокПолей.Добавить("ПланГрафик.НаименованиеРабот",         "Наименование Работ");
		СписокПолей.Добавить("ПланГрафик.Исполнитель",     "Исполнитель");
		СписокПолей.Добавить("ПланГрафик.ДатаНачала",        "Дата Начала");
		СписокПолей.Добавить("ПланГрафик.СрокИсполнения",     "СрокИсполнения");
		СписокПолей.Добавить("ПланГрафик.ДатаИсполнения",            "Дата Исполнения");
		СписокПолей.Добавить("ПланГрафик.Примечание",       "Примечание");
	ИначеЕсли ИмяТекущейТЧ = "СодержаниеДоговора" Тогда	
		 СписокПолей.Добавить("СодержаниеДоговора.НомерПунктаДоговора",         "№ пункта");
		 СписокПолей.Добавить("СодержаниеДоговора.Содержание",         "Содержание"); 
		 СписокПолей.Добавить("СодержаниеДоговора.Примечание",         "Примечание");
	КонецЕсли;
	
//////////////////////////////////////////////////////////////////////////////

// 3. Подготовка параметров для формы настройки
	ПараметрыДиалога = Новый Структура;
	ПараметрыДиалога.Вставить("СписокПолей",    СписокПолей);
	ПараметрыДиалога.Вставить("СписокЛистов",   ЗагрузкаДанныхСервер.ПолучитьСписокЛистов(ПутьКФайлу));
	ПараметрыДиалога.Вставить("ИмяСправочника", "Договора");
    ПараметрыДиалога.Вставить("ИмяТЧ", ИмяТекущейТЧ); // Передаем имя ТЧ
	ПараметрыДиалога.Вставить("ПутьКФайлу", ПутьКФайлу);
	
	// Открытие ОТДЕЛЬНОГО БЛОКИРУЮЩЕГО ОКНА
	ОповещениеЗакрытия = Новый ОписаниеОповещения("ПослеНастройки", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ДиалогНастройкиКолонок", 
	             ПараметрыДиалога, 
	             ЭтотОбъект, 
	             Истина, // Уникальность
	             , 
	             , 
	             ОповещениеЗакрытия, 
	             РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура ПослеНастройки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	     // 1. Очищаем ТЧ перед загрузкой, чтобы не дублировать данные
//    Объект.Распоряжение.Очистить(); 

	Попытка
		// 2. Вызываем сервер.
		// ПЕРЕДАЕМ Объект (ДанныеФормыСтруктура), чтобы сервер заполнил текущую форму
		ДанныеЛога  = ЗагрузкаДанныхСервер.ЗагрузитьДанные(
		    Объект.Ссылка,               // 1. Приемник  ПЕРЕДАЕМ ССЫЛКУ
		    Результат.ПутьКФайлу,        // 2. Путь
		    Результат.НастройкиКолонок,  // 3. Настройки
		    Результат.СтартоваяСтрока,   // 4. Старт
		    Результат.КонечнаяСтрока,    // 5. Конец
		    "Договора",                  // 6. ИмяСпр
		    Результат.ИмяЛиста           // 7. ЛистИмя
//			 СтатистикаЗагрузки           // Добавим 8-й параметр для возврата лога
		);

		// После загрузки на сервере, нужно обновить данные в форме
		ОповеститьОбИзменении(Объект.Ссылка); 
		Модифицированность = Ложь; // Чтобы не спрашивал о сохранении, если данные уже в базе
		Прочитать(); // Перечитывает данные из базы в форму


            ПоказатьОповещениеПользователя("Загрузка завершена", , "Успешно: " + ДанныеЛога.Успешно);
		
	Исключение
		Сообщить("Ошибка при загрузке: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

