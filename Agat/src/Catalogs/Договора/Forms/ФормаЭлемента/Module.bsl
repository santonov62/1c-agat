 &НаСервере
Процедура ОбновитьВыпадающийСписокНаСервере()
	
	// Получаем элемент формы
	ПолеСписка = Элементы.ОтветственныйИсполнитель;
	ПолеСписка.СписокВыбора.Очистить();
	     	
	// Запрос к базе
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Ссылка,
		|	Сотрудники.Наименование КАК ФИО
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	НЕ Сотрудники.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	ФИО";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// Добавляем в коллекцию СписокВыбора элемента формы
		ПолеСписка.СписокВыбора.Добавить(Выборка.Ссылка, Выборка.ФИО);
	КонецЦикла;
	
КонецПроцедуры

