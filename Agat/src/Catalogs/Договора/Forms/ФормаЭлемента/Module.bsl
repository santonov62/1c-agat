&НаСервере
Функция ЗагрузитьДанныеИзExcelНаСервере(СсылкаНаОбъект, ПутьКФайлу, НастройкиКолонок, СтартоваяСтрока, КонечнаяСтрока, ИмяТЧ, ИмяЛиста)
	
	КоличествоЗагруженных = 0;
	СтрокаЗаполнена = Ложь;
	ИмяРеквизита = "";
	
//============================================================	
// ОТЛАДКА - выводим полученные параметры
	ЗаписьЖурналаРегистрации("Загрузка Excel", УровеньЖурналаРегистрации.Информация, , , 
		"Путь: " + ПутьКФайлу + 
		", ИмяТЧ: " + ИмяТЧ + 
		", ИмяЛиста: " + ИмяЛиста +
		", Стартовая строка: " + СтартоваяСтрока +
		", Конечная строка: " + КонечнаяСтрока);
	
	// ОТЛАДКА - выводим настройки колонок (ИСПРАВЛЕНО)
	Для Каждого Колонка Из НастройкиКолонок Цикл
		ЗаписьЖурналаРегистрации("Настройка колонки", УровеньЖурналаРегистрации.Информация, , , 
			"Номер колонки Excel: " + Строка(Колонка));
	КонецЦикла; 
	
	// ПОДРОБНАЯ ОТЛАДКА
	ЗаписьЖурналаРегистрации("Excel загрузка - Шаг1", УровеньЖурналаРегистрации.Информация, , , 
		"Начало загрузки. Путь: " + ПутьКФайлу + ", ИмяТЧ: " + ИмяТЧ + ", ИмяЛиста: " + ИмяЛиста);
//============================================================	
	
	// Получаем объект справочника
	ОбъектСправочника = СсылкаНаОбъект.ПолучитьОбъект();
	
	Если ОбъектСправочника = Неопределено Тогда
		ЗаписьЖурналаРегистрации("Excel загрузка - Ошибка", УровеньЖурналаРегистрации.Ошибка, , , "Объект справочника не получен");
		Возврат 0;
	КонецЕсли;
	
//============================================================	
	ЗаписьЖурналаРегистрации("Excel загрузка - Шаг2", УровеньЖурналаРегистрации.Информация, , , "Объект справочника получен");
	
	// Проверяем существование табличной части
	Попытка
		ТЧ = ОбъектСправочника[ИмяТЧ];
		ЗаписьЖурналаРегистрации("Табличная часть найдена", УровеньЖурналаРегистрации.Информация);
	Исключение
		ЗаписьЖурналаРегистрации("Ошибка", УровеньЖурналаРегистрации.Ошибка, , , "Табличная часть '" + ИмяТЧ + "' не найдена!");
		Возврат 0;
	КонецПопытки;
//============================================================	
	
	// Создаем COM-объект Excel
	Попытка
		
		ЗаписьЖурналаРегистрации("Excel загрузка - Шаг4", УровеньЖурналаРегистрации.Информация, , , "Создание COM-объекта Excel");
		
		Excel = Новый COMОбъект("Excel.Application");
		Excel.DisplayAlerts = Ложь;
		Excel.Visible = Ложь;
		
		ЗаписьЖурналаРегистрации("Excel загрузка - Шаг5", УровеньЖурналаРегистрации.Информация, , , "Открытие файла: " + ПутьКФайлу);
		
		Книга = Excel.Workbooks.Open(ПутьКФайлу);
		Лист = Книга.Worksheets(ИмяЛиста);
		
		ЗаписьЖурналаРегистрации("Excel загрузка - Шаг6", УровеньЖурналаРегистрации.Информация, , , "Файл открыт, лист: " + ИмяЛиста);
		
		// Определяем диапазон для чтения
		Если КонечнаяСтрока = 0 Или КонечнаяСтрока < СтартоваяСтрока Тогда
			ПоследняяСтрока = Лист.UsedRange.Rows.Count;
			КонечнаяСтрока = ПоследняяСтрока;
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации("Диапазон Excel", УровеньЖурналаРегистрации.Информация, , , 
			"Строки с " + СтартоваяСтрока + " по " + КонечнаяСтрока);
		
		// Очищаем табличную часть
//		ОбъектСправочника[ИмяТЧ].Очистить();

		// Список реквизитов ТЧ в нужном порядке
		СписокРеквизитов = Новый Массив;
		СписокРеквизитов.Добавить("НаименованиеРабот");
		СписокРеквизитов.Добавить("Исполнитель");
		СписокРеквизитов.Добавить("ДатаНачала");
		СписокРеквизитов.Добавить("СрокИсполнения");
		СписокРеквизитов.Добавить("ДатаИсполнения");
		СписокРеквизитов.Добавить("Примечание");
		
		ЗаписьЖурналаРегистрации("Excel загрузка - Шаг8", УровеньЖурналаРегистрации.Информация, , , 
			"Количество настроек колонок: " + НастройкиКолонок.Количество());

		// Читаем данные и заполняем табличную часть
		Для НомерСтроки = СтартоваяСтрока По КонечнаяСтрока Цикл
			НоваяСтрока = ОбъектСправочника[ИмяТЧ].Добавить();
			СтрокаЗаполнена = Ложь;
			
			Для Индекс = 0 По НастройкиКолонок.Количество() - 1 Цикл
				// Получаем номер колонки из настроек
				ЭлементНастройки = НастройкиКолонок[Индекс];
				
				НомерКолонки = 0;
				Если ТипЗнч(ЭлементНастройки) = Тип("Число") Тогда
					НомерКолонки = ЭлементНастройки;
				ИначеЕсли ТипЗнч(ЭлементНастройки) = Тип("СписокЗначений") Тогда
					НомерКолонки = ЭлементНастройки.Значение;
				Иначе
					НомерКолонки = ЭлементНастройки;
				КонецЕсли;
				
				Если НомерКолонки <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				// Получаем имя реквизита из списка по индексу
				Если Индекс < СписокРеквизитов.Количество() Тогда
					ИмяРеквизита = СписокРеквизитов[Индекс];
				Иначе
					Продолжить;
				КонецЕсли;
				
				// Читаем значение из Excel
				Значение = Лист.Cells(НомерСтроки, НомерКолонки).Value;
				
				Если Значение = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаЗаполнена = Истина;
				
				// Заполняем реквизит в зависимости от типа
				Если ИмяРеквизита = "Исполнитель" Тогда
					// Поиск сотрудника по наименованию
					НайденныйСотрудник = Справочники.Сотрудники.НайтиПоНаименованию(СокрЛП(Строка(Значение)));
					Если НайденныйСотрудник <> Справочники.Сотрудники.ПустаяСсылка() Тогда
						НоваяСтрока[ИмяРеквизита] = НайденныйСотрудник;
					КонецЕсли;
				ИначеЕсли ИмяРеквизита = "ДатаНачала" Или ИмяРеквизита = "СрокИсполнения" Или ИмяРеквизита = "ДатаИсполнения" Тогда
					// Преобразуем в дату
					Попытка
						Если ТипЗнч(Значение) = Тип("Дата") Тогда
							НоваяСтрока[ИмяРеквизита] = Значение;
						Иначе
							НоваяСтрока[ИмяРеквизита] = Дата(Строка(Значение));
						КонецЕсли;
					Исключение
						// Если не удалось преобразовать, оставляем пустым
					КонецПопытки;
				Иначе
					НоваяСтрока[ИмяРеквизита] = СокрЛП(Строка(Значение));
				КонецЕсли;
			КонецЦикла;
			
			Если СтрокаЗаполнена Тогда
				КоличествоЗагруженных = КоличествоЗагруженных + 1;
			Иначе
				// Удаляем пустую строку
				ОбъектСправочника[ИмяТЧ].Удалить(НоваяСтрока);
			КонецЕсли;
		КонецЦикла;
		
		// Закрываем Excel
		Книга.Close();
		Excel.Quit();
		
		// Записываем объект
		ОбъектСправочника.Записать();
		
		ЗаписьЖурналаРегистрации("Загрузка завершена", УровеньЖурналаРегистрации.Информация, , , 
			"Загружено строк: " + КоличествоЗагруженных);
		
	Исключение
		ЗаписьЖурналаРегистрации("Ошибка при загрузке из Excel", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		Сообщить("Ошибка при загрузке из Excel: " + ОписаниеОшибки());
		Возврат 0;
	КонецПопытки; 
	
	Возврат КоличествоЗагруженных;
	
КонецФункции
&НаКлиенте
Процедура ОбновитьФормуНаКлиенте(ИмяТЧ, КоличествоЗагруженных)
	
	// Обновляем табличную часть на форме
	Если ИмяТЧ = "Распоряжение" Тогда
		Элементы.Распоряжение.Обновить();
	ИначеЕсли ИмяТЧ = "ПланГрафик" Тогда
		Элементы.ПланГрафик.Обновить(); 
	ИначеЕсли ИмяТЧ = "СодержаниеДоговора" Тогда
		Элементы.СодержаниеДоговора.Обновить(); 	
	КонецЕсли;
	
	ПоказатьОповещениеПользователя("Загрузка завершена", , "Успешно загружено: " + КоличествоЗагруженных + " строк");
	
КонецПроцедуры 

