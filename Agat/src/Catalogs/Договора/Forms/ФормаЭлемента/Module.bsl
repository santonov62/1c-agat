&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
////////////////////////////////////////////////////////////////////////////////
// Логика поиска строки в ТЧ по переданному идентификатору КлючСтроки из ОбщейФормы ОтчетИД
////////////////////////////////////////////////////////////////////////////////
// 1. Переключаем закладку
	ИмяТЧ = "";
	Если Параметры.Свойство("ИмяActiveТЧ", ИмяТЧ) Тогда
		Попытка
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["Группа" + ИмяТЧ];
		Исключение
		КонецПопытки;
	КонецЕсли;

	// 2. ПЕРЕХОД К СТРОКЕ
	// В ПриОткрытии таблица еще не выведена, и установленная здесь ТекущаяСтрока
	// сбрасывается при отрисовке формы - именно поэтому переход не работал.
	// Запоминаем параметры и позиционируемся отложенно, после отрисовки
	КлючПоиска = Неопределено;
	Если Параметры.Свойство("КлючСтрокиДляПерехода", КлючПоиска) И ЗначениеЗаполнено(ИмяТЧ) Тогда

		// ПРИНУДИТЕЛЬНОЕ ПРЕОБРАЗОВАНИЕ ТИПА (если пришла строка вместо UUID)
		Если ТипЗнч(КлючПоиска) = Тип("Строка") Тогда
			Попытка
				КлючПоиска = Новый УникальныйИдентификатор(КлючПоиска);
			Исключение
				// Если это не валидный UUID, поиск не сработает
			КонецПопытки;
		КонецЕсли;

		Если ЗначениеЗаполнено(КлючПоиска) Тогда
			ИмяТЧДляПерехода  = ИмяТЧ;
			КлючСтрокиПерехода = КлючПоиска;
			// Интервал меньше секунды допустим только с однократным вызовом
			ПодключитьОбработчикОжидания("ПерейтиКСтрокеТабличнойЧасти", 0.1, Истина);
		КонецЕсли;

	КонецЕсли;
 ////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

 КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Отложенное позиционирование на строке ТЧ.                                  //
// Вызывается обработчиком ожидания из ПриОткрытии, когда таблица уже выведена //
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ПерейтиКСтрокеТабличнойЧасти()

	Если Не ЗначениеЗаполнено(ИмяТЧДляПерехода) Или Не ЗначениеЗаполнено(КлючСтрокиПерехода) Тогда
		Возврат;
	КонецЕсли;

	ЭлементТаблицы = Элементы.Найти(ИмяТЧДляПерехода);
	Если ЭлементТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Ищем в данных ТЧ объекта
	Отбор = Новый Структура("КлючСтроки", КлючСтрокиПерехода);
	НайденныеСтроки = Объект[ИмяТЧДляПерехода].НайтиСтроки(Отбор);

	Если НайденныеСтроки.Количество() = 0 Тогда
		// Ключ в форме договора не найден
		Возврат;
	КонецЕсли;

	// ПОЛУЧАЕМ ИДЕНТИФИКАТОР СТРОКИ ФОРМЫ (это число)
	ИдентификаторСтроки = НайденныеСтроки[0].ПолучитьИдентификатор();

	// Устанавливаем текущую строку, прокручиваем к ней и ставим фокус
	ЭлементТаблицы.ТекущаяСтрока = ИдентификаторСтроки;
	ЭлементТаблицы.ПоказатьСтроку(ИдентификаторСтроки);
	ЭтаФорма.ТекущийЭлемент = ЭлементТаблицы;

КонецПроцедуры




////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////


// =============================================================================
// УНИВЕРСАЛЬНЫЕ КОМАНДЫ (подключены ко всем кнопкам всех ТЧ)
// =============================================================================

&НаКлиенте
Асинх Процедура КомандаДействие(Команда)
	
	// 1. ОПРЕДЕЛЯЕМ ТАБЛИЦУ (самый надежный способ для 8.3.25)
	// Пытаемся найти кнопку по имени команды, если не выходит — берем текущий элемент
	ЭлементКнопка = ЭтаФорма.Элементы.Найти(Команда.Имя);
	Если ЭлементКнопка = Неопределено Тогда
		ЭлементКнопка = ЭтаФорма.ТекущийЭлемент;
	КонецЕсли;
	
	// Вычисляем имя таблицы из имени кнопки (отрезаем хвост "КнопкаДействие")
	ИмяТаблицы = СтрЗаменить(ЭлементКнопка.Имя, "КнопкаДействие", "");
	ЭлементТаблица = ЭтаФорма.Элементы.Найти(ИмяТаблицы);
	
	// 2. БЕЗОПАСНАЯ ПРОВЕРКА
	ТаблицаСуществует = (ЭлементТаблица <> Неопределено И ТипЗнч(ЭлементТаблица) = Тип("ТаблицаФормы"));
	
	Если ТаблицаСуществует Тогда
		// Проверяем наличие данных в самой ТЧ объекта
		Если Объект[ИмяТаблицы].Количество() = 0 Тогда
			ПоказатьОповещениеПользователя("Внимание", , "Таблица пуста!");
			Возврат;
		КонецЕсли;
	Иначе
		// Если по имени кнопки не нашли, выводим ваше сообщение
		ПоказатьОповещениеПользователя("Внимание", , "Выберите строку ТЧ");
		Возврат;
	КонецЕсли;

	// 3. АКТИВАЦИЯ (Принудительно выбираем первую строку, если фокус был в шапке)
	ЭтаФорма.ТекущийЭлемент = ЭлементТаблица;
	
	Если ЭлементТаблица.ТекущиеДанные = Неопределено Тогда
		// Активируем самую первую строку коллекции
		ЭлементТаблица.ТекущаяСтрока = Объект[ИмяТаблицы].ПолучитьИдентификатор();
	КонецЕсли;
	
	ТекущиеДанные = ЭлементТаблица.ТекущиеДанные;
	
	// 4. ВЫПОЛНЕНИЕ (оригинальный рабочий блок)
	Попытка
		Ждать РаботаСФайламиКлиент.ВыполнитьДействиеСФайлом(ЭтаФорма, ТекущиеДанные, ИмяТаблицы);
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
	РаботаСФайламиКлиент.ОбновитьИнтерфейсКнопок(ЭтаФорма, ТекущиеДанные, ИмяТаблицы);
	ЭтаФорма.ОбновитьОтображениеДанных();                 
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура КомандаУдалить(Команда)
	
	ИмяЭлемента = ЭтаФорма.ТекущийЭлемент.Имя;
	ТекущаяТЧ = СтрЗаменить(ИмяЭлемента, "КнопкаУдалить", "");
	ТекущиеДанные = Элементы[ТекущаяТЧ].ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	
// Получение параметров справочника для передачи в регистр свдений РегистрУдаленияФайлов	
//////////////////////////////////////////////////////////////////////////	
	// Получаем данные справочника через серверную функцию
	ДанныеСправочника = ПолучитьДанныеСправочникаНаСервере(Объект.Ссылка);
	
	ИмяСправочника = ДанныеСправочника.ИмяСправочника;
	НаименованиеЭлемента = ДанныеСправочника.Наименование;
	СсылкаНаОбъект = ДанныеСправочника.Ссылка;
	
	// Получаем имя пользователя (если есть реквизит Сотрудник)
	ИмяПользователя = "Система";
//	Если ЗначениеЗаполнено(ТекущиеДанные.Исполнитель) Тогда
//		ИмяПользователя = ПолучитьИмяСотрудникаНаСервере(ТекущиеДанные.Исполнитель);
//		Иначе
//	КонецЕсли;
//////////////////////////////////////////////////////////////////////////


	Попытка
		Ждать РаботаСФайламиКлиент.УдалитьФайл(
		ЭтаФорма, 
		ТекущиеДанные, 
		ТекущаяТЧ, 
			ИмяСправочника,           //
			НаименованиеЭлемента,     //
			СсылкаНаОбъект,           //
			ИмяПользователя           //
		);		
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
	// ОБНОВЛЕНИЕ состояние кнопок (сделает "Удалить" недоступной)
	РаботаСФайламиКлиент.ОбновитьИнтерфейсКнопок(ЭтаФорма, ТекущиеДанные, ТекущаяТЧ);
	
	//  Обновить
	ЭтаФорма.ОбновитьОтображениеДанных();                 
	
КонецПроцедуры

    ////////////////////////////////////////////////////////////////////////////////
    // Получение данных на сервере для КомандаУдалить 
	// для передачи в регистр сведений РегистрУдаленияФайлов
	////////////////////////////////////////////////////////////////////////////////
	
	&НаСервере
	Функция ПолучитьДанныеСправочникаНаСервере(СсылкаНаОбъект)
		
		Результат = Новый Структура;
		Результат.Вставить("ИмяСправочника", "");
		Результат.Вставить("Наименование", "");
		Результат.Вставить("Ссылка", "");
		
		Если СсылкаНаОбъект = Неопределено Или СсылкаНаОбъект.Пустая() Тогда
			Возврат Результат;
		КонецЕсли;
		
		Попытка
			// На сервере Метаданные() доступны
			МетаОбъекта = СсылкаНаОбъект.Метаданные();
			Результат.ИмяСправочника = МетаОбъекта.Синоним;
			Результат.Наименование = СсылкаНаОбъект.Наименование;
			Результат.Ссылка = Строка(СсылкаНаОбъект);
		Исключение
			// Если ошибка, заполняем как можем
			Результат.ИмяСправочника = "ДоговораТ";
			Результат.Наименование = СсылкаНаОбъект.Наименование;
			Результат.Ссылка = Строка(СсылкаНаОбъект);
		КонецПопытки;
		
		Возврат Результат;
		
	КонецФункции
	
		&НаСервере
	Функция ПолучитьИмяСотрудникаНаСервере(СсылкаНаСотрудника)
		
		Если СсылкаНаСотрудника = Неопределено Или СсылкаНаСотрудника.Пустая() Тогда
			Возврат "Система";
		КонецЕсли;
		
		Попытка
			Возврат СсылкаНаСотрудника.Наименование;
		Исключение
			Возврат "Система";
		КонецПопытки;
		
	КонецФункции
	
