&НаКлиенте
Процедура ОткрытьФормуПодбораИсполнителей(Элемент)
	
	// 1. Получаем таблицу и текущую строку
	ИмяТаблицы = Элемент.Родитель.Имя;
	ТекущаяСтрока = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда 
		Возврат;
	КонецЕсли;

	// 2. ГЕНЕРАЦИЯ КЛЮЧА (если он пустой)
	ПустойИД = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Если ТекущаяСтрока.КлючСтроки = ПустойИД Тогда
		ТекущаяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;

	// 3. ПОДГОТОВКА СТРУКТУРЫ (Контейнера)
	// ВАЖНО: Мы создаем переменную 'КонтейнерПараметров' и передаем её в Оповещение
	КонтейнерПараметров = Новый Структура;
	КонтейнерПараметров.Вставить("ИмяТаблицы",   ИмяТаблицы);
	КонтейнерПараметров.Вставить("ИмяРеквизита", "Исполнитель");
	КонтейнерПараметров.Вставить("КлючСтроки",   ТекущаяСтрока.КлючСтроки);

	// 4. ПОЛУЧЕНИЕ СПИСКА СОТРУДНИКОВ
	СписокДляВыбора = ПолучитьСписокСотрудниковДляВыбораНаСервере();
	
	// Пометка уже выбранных
	Если ЗначениеЗаполнено(ТекущаяСтрока.Исполнитель) Тогда
		Для Каждого ЭлементСписка Из СписокДляВыбора Цикл
			Если Найти(ТекущаяСтрока.Исполнитель, СокрЛП(ЭлементСписка.Представление)) > 0 Тогда
				ЭлементСписка.Пометка = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// 5. ВЫЗОВ ОКНА
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияОкнаМножественногоВыбора", ЭтотОбъект, КонтейнерПараметров);
	СписокДляВыбора.ПоказатьОтметкуЭлементов(Оповещение, "Выберите исполнителей");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияОкнаМножественногоВыбора(РезультатСписком, Контейнер) Экспорт
	
	Если РезультатСписком = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ТекущаяСтрока = Элементы[Контейнер.ИмяТаблицы].ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	РезультатСтрокой = "";
	МассивВыбранных = Новый Массив;
	
	Для Каждого ЭлементСписка Из РезультатСписком Цикл
		Если ЭлементСписка.Пометка Тогда 
			РезультатСтрокой = РезультатСтрокой + ?(ПустаяСтрока(РезультатСтрокой), "", ", ") + ЭлементСписка.Представление;
			МассивВыбранных.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	// Записываем в реквизит формы
	ТекущаяСтрока[Контейнер.ИмяРеквизита] = РезультатСтрокой;
	
	// Вызываем вашу серверную процедуру записи в ТЧ
	ЗаписатьИсполнителейВТЧСостав(Контейнер.КлючСтроки, МассивВыбранных);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИсполнителейВТЧСостав(КлючСвязи, МассивСотрудников)
    // 1. Удаляем старые связи
    Отбор = Новый Структура("КлючСтроки", КлючСвязи);
    СтрокиДляУдаления = Объект.СоставИсполнителей.НайтиСтроки(Отбор);
    Для Каждого Стр Из СтрокиДляУдаления Цикл
        Объект.СоставИсполнителей.Удалить(Стр);
    КонецЦикла;
    
    // 2. Записываем новые связи
    Для Каждого Сотрудник Из МассивСотрудников Цикл
        НоваяЗапись = Объект.СоставИсполнителей.Добавить();
        НоваяЗапись.КлючСтроки = КлючСвязи;
        НоваяЗапись.Сотрудник  = Сотрудник;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокСотрудниковДляВыбораНаСервере()
	Список = Новый СписокЗначений;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Наименование ИЗ Справочник.Сотрудники УПОРЯДОЧИТЬ ПО Наименование");
	Выборка = Запрос.Выполнить().Выбрать(); // Замените на .Выполнить(), если используется стандарт
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;
	Возврат Список;
КонецФункции

