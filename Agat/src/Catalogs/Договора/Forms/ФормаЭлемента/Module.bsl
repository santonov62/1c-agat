////////////////////////////////////////////////////////////////////////////////	
////////////////////////////////////////////////////////////////////////////////
	
ИтогОплаты = Объект.ИсполнениеДоговора.Итог("СуммаОплаты");
ИтогИсполнения = Объект.ИсполнениеДоговора.Итог("СуммаИсполнения");
ИсполнениеДоговораРазница = ИтогОплаты - ИтогИсполнения;

	// Диаграмма Ганта по ТЧ "Распоряжение" и "ПланГрафик" (страница ГруппаДиаграммаГанта)
	ИнициализироватьДиаграммуГантаНаСервере();
	
	
