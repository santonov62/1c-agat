// Генерируем уникальные ключи для новых строк
//////////////////////////////////////////////////////////////////////////////////////////////
// В МОДУЛЕ ОБЪЕКТА (не в форме!)
Процедура ПередЗаписью(Отказ)
	
	// Создаем пустой идентификатор для сравнения
	ПустойИД = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	
	// Обрабатываем ТЧ Распоряжение
	Для Каждого Стр Из Распоряжение Цикл
		// Проверяем: если значение пустое или равно "нулевому" ИД
		Если Стр.КлючСтроки = Неопределено Или Стр.КлючСтроки = ПустойИД Тогда
			Стр.КлючСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
	
	// Обрабатываем ТЧ ПланГрафик
	Для Каждого Стр Из ПланГрафик Цикл
		Если Стр.КлючСтроки = Неопределено Или Стр.КлючСтроки = ПустойИД Тогда
			Стр.КлючСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
//////////////////////////////////////////////////////////////////////////////////////////////
 