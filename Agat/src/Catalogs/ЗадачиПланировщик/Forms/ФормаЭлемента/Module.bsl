// =============================================================================
// СИСТЕМНЫЕ СОБЫТИЯ ФОРМЫ
// =============================================================================

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// 1. Для формы элемента без ТЧ условное оформление таблиц не требуется.
	// Метод НастроитьОформлениеВсехТаблиц здесь не нужен и может вызвать ошибку.
	
	// 2. Устанавливаем доступность кнопок при открытии карточки.
	// В справочнике без ТЧ префикс (имя ТЧ) передаем пустой "".
//	ОбновитьДоступностьКнопокНаСервере();
	
	// Формируем массив всех табличных частей, которые поддерживают работу с файлами
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("Приложения");  
	МассивТЧ.Добавить("ЭтапыИсполнения");
	
	// Настраиваем программное условное оформление для отображения иконок (лупа/скрепка) 
	// в колонках ИмяТЧ+"Действие" и ИмяТЧ+"Удалить"
	РаботаСФайламиСервер.НастроитьОформлениеВсехТаблиц(ЭтаФорма, МассивТЧ);
										
КонецПроцедуры
 
// =============================================================================
// УНИВЕРСАЛЬНЫЕ КОМАНДЫ 
// =============================================================================

&НаКлиенте
Асинх Процедура КомандаДействие(Команда)
	
	// 1. ОПРЕДЕЛЯЕМ КОНТЕКСТ (таблица или шапка)
	ТекущийЭлемент = ЭтаФорма.ТекущийЭлемент;
	ТипТекущегоЭлемента = ТипЗнч(ТекущийЭлемент);
	
	// Проверяем, находимся ли мы в табличной части
	ЭтоТаблица = (ТипТекущегоЭлемента = Тип("ТаблицаФормы"));
	
	// 2. ЛОГИКА ДЛЯ ТАБЛИЦЫ
	Если ЭтоТаблица Тогда
		ИмяТаблицы = ТекущийЭлемент.Имя;
		
		Если Объект[ИмяТаблицы].Количество() = 0 Тогда
			ПоказатьОповещениеПользователя("Внимание", , "Таблица пуста!");
			Возврат;
		КонецЕсли;
		
		Если ТекущийЭлемент.ТекущиеДанные = Неопределено Тогда
			ТекущийЭлемент.ТекущаяСтрока = Объект[ИмяТаблицы].ПолучитьИдентификатор();
		КонецЕсли;
		
		ТекущиеДанные = ТекущийЭлемент.ТекущиеДанные;
		
	// 3. ЛОГИКА ДЛЯ ШАПКИ (вне таблицы)
	// Работает как при наличии файла, так и при его отсутствии
	Иначе
		ТекущиеДанные = Объект;
		ИмяТаблицы = ""; // Пустая строка показывает, что это шапка
	КонецЕсли;
	
	// 4. ВЫПОЛНЕНИЕ
	Попытка
		Ждать РаботаСФайламиКлиент.ВыполнитьДействиеСФайлом(ЭтаФорма, ТекущиеДанные, ИмяТаблицы);
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
	РаботаСФайламиКлиент.ОбновитьИнтерфейсКнопок(ЭтаФорма, ТекущиеДанные, ИмяТаблицы);
	ЭтаФорма.ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура КомандаУдалить(Команда)
	
	ТекущийЭлемент = ЭтаФорма.ТекущийЭлемент;
	ТипТекущегоЭлемента = ТипЗнч(ТекущийЭлемент);
	ЭтоТаблица = (ТипТекущегоЭлемента = Тип("ТаблицаФормы"));
	
	// 1. ЛОГИКА ДЛЯ ТАБЛИЦЫ
	Если ЭтоТаблица Тогда
		ИмяТаблицы = ТекущийЭлемент.Имя;
		ТекущиеДанные = ТекущийЭлемент.ТекущиеДанные;
		
		Если ТекущиеДанные = Неопределено Тогда 
			Возврат; 
		КонецЕсли;
		
	// 2. ЛОГИКА ДЛЯ ШАПКИ (вне таблицы)
	Иначе
		// Если файла нет - нечего удалять
		Если НЕ ЗначениеЗаполнено(Объект.РасширениеФайла) Тогда 
			ПоказатьОповещениеПользователя("Внимание", , "Нет загруженного файла");
			Возврат; 
		КонецЕсли;
		
		ТекущиеДанные = Объект;
		ИмяТаблицы = "";
	КонецЕсли;
	
	// 3. ПОЛУЧЕНИЕ ПАРАМЕТРОВ
	ДанныеСправочника = ПолучитьДанныеСправочникаНаСервере(Объект.Ссылка);
	
	ИмяСправочника = ДанныеСправочника.ИмяСправочника;
	НаименованиеЭлемента = ДанныеСправочника.Наименование;
	СсылкаНаОбъект = ДанныеСправочника.Ссылка;
	
	ИмяПользователя = "Система";
	Если ЗначениеЗаполнено(Объект.ОтветственныйИсполнитель) Тогда
		ИмяПользователя = ПолучитьИмяСотрудникаНаСервере(Объект.ОтветственныйИсполнитель);
	КонецЕсли;
	
	// 4. УДАЛЕНИЕ
	Попытка
		Ждать РаботаСФайламиКлиент.УдалитьФайл(
				ЭтаФорма, 
				ТекущиеДанные, 
				ИмяТаблицы, 
				ИмяСправочника,
				НаименованиеЭлемента,
				СсылкаНаОбъект,
				ИмяПользователя
		);
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
	РаботаСФайламиКлиент.ОбновитьИнтерфейсКнопок(ЭтаФорма, ТекущиеДанные, ИмяТаблицы);
	ЭтаФорма.ОбновитьОтображениеДанных();
	
КонецПроцедуры

    ////////////////////////////////////////////////////////////////////////////////
    // Получение данных на сервере для КомандаУдалить 
	// для передачи в регистр сведений РегистрУдаленияФайлов
	////////////////////////////////////////////////////////////////////////////////
	
	&НаСервере
	Функция ПолучитьДанныеСправочникаНаСервере(СсылкаНаОбъект)
		
		Результат = Новый Структура;
		Результат.Вставить("ИмяСправочника", "");
		Результат.Вставить("Наименование", "");
		Результат.Вставить("Ссылка", "");
		
		Если СсылкаНаОбъект = Неопределено Или СсылкаНаОбъект.Пустая() Тогда
			Возврат Результат;
		КонецЕсли;
		
		Попытка
			// На сервере Метаданные() доступны
			МетаОбъекта = СсылкаНаОбъект.Метаданные();
			Результат.ИмяСправочника = МетаОбъекта.Синоним;
			Результат.Наименование = СсылкаНаОбъект.Наименование;
			Результат.Ссылка = Строка(СсылкаНаОбъект);
		Исключение
			// Если ошибка, заполняем как можем
			Результат.ИмяСправочника = "ЗадачиПланировщик-";
			Результат.Наименование = СсылкаНаОбъект.Наименование;
			Результат.Ссылка = Строка(СсылкаНаОбъект);
		КонецПопытки;
		
		Возврат Результат;
		
	КонецФункции
	
		&НаСервере
	Функция ПолучитьИмяСотрудникаНаСервере(СсылкаНаСотрудника)
		
		Если СсылкаНаСотрудника = Неопределено Или СсылкаНаСотрудника.Пустая() Тогда
			Возврат "Система";
		КонецЕсли;
		
		Попытка
			Возврат СсылкаНаСотрудника.Наименование;
		Исключение
			Возврат "Система";
		КонецПопытки;
		
	КонецФункции
	
     ////////////////////////////////////////////////////////////////////////////////


 
// =============================================================================
// ОБРАБОТЧИКИ АКТИВИЗАЦИИ СТРОК (Обновление кнопок при перемещении курсора)
// =============================================================================

&НаКлиенте
Процедура ПриложенияПриАктивизацииСтроки(Элемент)
	РаботаСФайламиКлиент.ОбновитьИнтерфейсКнопок(ЭтаФорма, Элемент.ТекущиеДанные, "Приложения"); 
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыИсполненияПриАктивизацииСтроки(Элемент)
	РаботаСФайламиКлиент.ОбновитьИнтерфейсКнопок(ЭтаФорма, Элемент.ТекущиеДанные, "ЭтапыИсполнения"); 
КонецПроцедуры



//////////////////////////////////////////////////////////////////////////////////////////////
// Отображение  ГруппаНаименование
//////////////////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура КомандаСкрытьСодержание(Команда)
	
	// Получаем элемент группы
	Группа1 = Элементы.ГруппаНаименование;
	Группа2 = Элементы.ГруппаОснование;
	Группа3 = Элементы.ГруппаИсполнитель;
					   
	// Находим кнопку на форме, которая связана с этой командой
	Кнопка = Элементы.КомандаСкрытьГруппаНаименование; // Это элемент кнопки, а не команда
	
	Если Группа1.Видимость Тогда
		// Если группа видима - скрываем её
        Группа1.Видимость = Ложь;
		Группа2.Видимость = Ложь;
		Группа3.Видимость = Ложь;

		// Меняем иконку кнопки (например, на "Скрыть" или любую другую)
		Элементы.КомандаСкрытьГруппаНаименование.Картинка = БиблиотекаКартинок.Стрелки;
		// Меняем подсказку для кнопки
//		Кнопка.Подсказка = "Показать содержание договора";
	Иначе
		// Если группа скрыта - показываем её
		Группа1.Видимость = Истина;
		Группа2.Видимость = Истина;
		Группа3.Видимость = Истина;

		// Меняем иконку кнопки (исходную)
		Элементы.КомандаСкрытьГруппаНаименование.Картинка = БиблиотекаКартинок.Стрелки;
		// Меняем подсказку
//		Кнопка.Подсказка = "Скрыть содержание договора";
	КонецЕсли;

КонецПроцедуры



