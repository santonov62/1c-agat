Процедура ПриОткрытии(Отказ)
	// Подтягиваем путь на клиент, если он не заполнился
	Если ПустаяСтрока(ПутьХранилищаКлиент) Тогда
		ПутьХранилищаКлиент = ПолучитьПутьХранилищаНаСервере();
	КонецЕсли;
