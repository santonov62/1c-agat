// ФИЛЬТР + СЧЕТЧИК /////////////////////////////////////////////////////////////////////// 
&НаСервере
Процедура ОбновитьФильтрыНаСервере(ОбновлятьСчетчик = Истина)
    
    // Проверяем, что Список существует
    Если Список = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Очистка настроек списка
    НастройкиСписка = Список.КомпоновщикНастроек.Настройки;
    ОтборСписка = НастройкиСписка.Отбор;
    ОтборСписка.Элементы.Очистить();
    
    // ============ ФОРМИРУЕМ УСЛОВИЯ ДЛЯ СЧЕТЧИКА ============
    УсловияСчетчика = Новый Массив;
    УсловияСчетчика.Добавить("ИСТИНА");
    
    // Создаем запрос для счетчика
    ЗапросСчетчик = Новый Запрос;
    
    // Устанавливаем параметр текущей даты
    ТекущаяДатаСервер = ТекущаяДата();
    ЗапросСчетчик.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСервер);
    
    // 1. Фильтр по дате документа
    Если ЗначениеЗаполнено(ДатаНачала) Тогда
        УсловияСчетчика.Добавить("ДатаДокумента >= &ПарДатаДокумента");
        ЗапросСчетчик.УстановитьПараметр("ПарДатаДокумента", НачалоДня(ДатаНачала));
        ДобавитьЭлементОтбора(ОтборСписка, "ДатаДокумента", НачалоДня(ДатаНачала), ВидСравненияКомпоновкиДанных.БольшеИлиРавно);
    КонецЕсли;
    
    // 2. Фильтр по номеру документа
    Если ЗначениеЗаполнено(ОтборНомерДокумента) Тогда
        УсловияСчетчика.Добавить("НомерДокумента ПОДОБНО &ПарНомерДокумента");
        ЗапросСчетчик.УстановитьПараметр("ПарНомерДокумента", "%" + СокрЛП(ОтборНомерДокумента) + "%");
        ДобавитьЭлементОтбора(ОтборСписка, "НомерДокумента", ОтборНомерДокумента, ВидСравненияКомпоновкиДанных.Содержит);
    КонецЕсли;
    
    // 3. Фильтр по наименованию (частичное совпадение)
    Если ЗначениеЗаполнено(ОтборНаименование) Тогда
        УсловияСчетчика.Добавить("Наименование ПОДОБНО &ПарНаименование");
        ЗапросСчетчик.УстановитьПараметр("ПарНаименование", "%" + СокрЛП(ОтборНаименование) + "%");
        ДобавитьЭлементОтбора(ОтборСписка, "Наименование", ОтборНаименование, ВидСравненияКомпоновкиДанных.Содержит);
    КонецЕсли;
    
    // 4. Фильтр по полному наименованию (частичное совпадение)
    Если ЗначениеЗаполнено(ОтборПолноеНаименование) Тогда
        УсловияСчетчика.Добавить("ПолноеНаименование ПОДОБНО &ПарПолноеНаименование");
        ЗапросСчетчик.УстановитьПараметр("ПарПолноеНаименование", "%" + СокрЛП(ОтборПолноеНаименование) + "%");
        ДобавитьЭлементОтбора(ОтборСписка, "ПолноеНаименование", ОтборПолноеНаименование, ВидСравненияКомпоновкиДанных.Содержит);
    КонецЕсли;
    
    // 5. Н
    Если ОтборН = ИСТИНА Тогда
        УсловияСчетчика.Добавить("Н = ИСТИНА");
        ДобавитьЭлементОтбора(ОтборСписка, "Н", Истина); 
//==============================================================		
		ДобавитьЭлементОтбора(ОтборСписка, "СрокДействия", ТекущаяДатаСервер, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
        УсловияСчетчика.Добавить("СрокДействия <= &ТекущаяДата");
 //==============================================================
		//   ИначеЕсли ОтборН = Ложь Тогда
  //       УсловияСчетчика.Добавить("Н = ЛОЖЬ");
  //       ДобавитьЭлементОтбора(ОтборСписка, "Н", Ложь);
    КонецЕсли;
    
    // 6. Действующие (ИСПРАВЛЕНО)
    Если ОтборДействующие = ИСТИНА Тогда
//        ДобавитьЭлементОтбора(ОтборСписка, "СрокДействия", ТекущаяДатаСервер, ВидСравненияКомпоновкиДанных.БольшеИлиРавно);
 //       УсловияСчетчика.Добавить("СрокДействия >= &ТекущаяДата");
//==============================================================
УсловияСчетчика.Добавить("Н = ЛОЖЬ");
ДобавитьЭлементОтбора(ОтборСписка, "Н", Ложь);
//==============================================================
    ИначеЕсли ОтборДействующие = Ложь Тогда
 //       ДобавитьЭлементОтбора(ОтборСписка, "СрокДействия", '00010101', ВидСравненияКомпоновкиДанных.БольшеИлиРавно);
 //       УсловияСчетчика.Добавить("СрокДействия > &ПустаяДата");
//		ЗапросСчетчик.УстановитьПараметр("ПустаяДата", '00010101');
    КонецЕсли;
    
    // 7. Период
    Если ЗначениеЗаполнено(ДатаНачала) И ДатаНачала <> '00010101' Тогда
        УсловияСчетчика.Добавить("ДатаДокумента >= &ДатаНачала");
        ЗапросСчетчик.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
        // Уже добавили отбор выше, не дублируем
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания <> '00010101' Тогда
        УсловияСчетчика.Добавить("СрокДействия <= &ДатаОкончания");
        ЗапросСчетчик.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
        ДобавитьЭлементОтбора(ОтборСписка, "СрокДействия", КонецДня(ДатаОкончания), ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
    КонецЕсли;
    
    // ============ ВЫПОЛНЯЕМ ЗАПРОС СЧЕТЧИКА ============
    Если ОбновлятьСчетчик Тогда
        // Удаляем первое условие "ИСТИНА", если есть другие условия
        Если УсловияСчетчика.Количество() > 1 И УсловияСчетчика[0] = "ИСТИНА" Тогда
            УсловияСчетчика.Удалить(0);
        КонецЕсли;
        
        // Формируем текст запроса
        Если УсловияСчетчика.Количество() = 0 Тогда
            ТекстЗапроса = "ВЫБРАТЬ КОЛИЧЕСТВО(Ссылка) КАК КолВо ИЗ Справочник.ЛокальныеАкты";
        Иначе
            ТекстЗапроса = "ВЫБРАТЬ КОЛИЧЕСТВО(Ссылка) КАК КолВо ИЗ Справочник.ЛокальныеАкты ГДЕ " + СтрСоединить(УсловияСчетчика, " И ");
        КонецЕсли;
        
        ЗапросСчетчик.Текст = ТекстЗапроса;
        
        Попытка
            Выборка = ЗапросСчетчик.Выполнить().Выбрать();
            Если Выборка.Следующий() Тогда
                ТекстКоличествоОтобаженных = "" + Формат(Выборка.КолВо, "ЧГ=0") + "";
            Иначе
                ТекстКоличествоОтобаженных = "(0)";
            КонецЕсли;
        Исключение
            ТекстКоличествоОтобаженных = "(ош)";
            Сообщить("Ошибка запроса счетчика: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    
КонецПроцедуры
&НаСервере
Функция ДобавитьЭлементОтбора(ГруппаОтбора, ИмяПоля, Значение = Неопределено, ВидСравнения = Неопределено)
    НовыйЭлемент = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
    
    Если ВидСравнения = Неопределено Тогда
        НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    Иначе
        НовыйЭлемент.ВидСравнения = ВидСравнения;
    КонецЕсли;
    
    Если Значение <> Неопределено Тогда
        НовыйЭлемент.ПравоеЗначение = Значение;
    КонецЕсли;
    
    НовыйЭлемент.Использование = Истина;
    НовыйЭлемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
    
    Возврат НовыйЭлемент;
КонецФункции
