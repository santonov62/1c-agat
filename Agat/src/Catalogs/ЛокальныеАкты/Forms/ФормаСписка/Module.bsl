&НаСервере
Функция ПолучитьУсловияОтбора()
    
    Условия = Новый Массив;
    
    // 1. Дата документа
    Если ЗначениеЗаполнено(ДатаНачала) Тогда
        Условия.Добавить("ДатаДокумента > &ПарДатаНачала");
    КонецЕсли;
    
    // 2. Номер документа
    Если ЗначениеЗаполнено(ОтборНомерДокумента) Тогда
        Условия.Добавить("НомерДокумента ПОДОБНО &ПарНомерДокумента");
    КонецЕсли;
    
    // 3. Наименование (частичное совпадение)
    Если ЗначениеЗаполнено(ОтборНаименование) Тогда
        Условия.Добавить("Наименование ПОДОБНО &ПарНаименование");
    КонецЕсли;
    
    // 4. Полное наименование (частичное совпадение)
    Если ЗначениеЗаполнено(ОтборПолноеНаименование) Тогда
        Условия.Добавить("ПолноеНаименование ПОДОБНО &ПарПолноеНаименование");
    КонецЕсли;
    
    // 5. ОтборДействующие
    Если ОтборДействующие = ИСТИНА Тогда
        Условия.Добавить("СрокДействия <= КонецДня(ТекущаяДата())");
    ИначеЕсли ОтборДействующие = ЛОЖЬ Тогда
        Условия.Добавить("СрокДействия = '00010101'");
    КонецЕсли;

    // 6. Н (Не действует)
    Если ОтборН = ИСТИНА Тогда
        Условия.Добавить("Н = ИСТИНА");
    ИначеЕсли ОтборН = ЛОЖЬ Тогда
        Условия.Добавить("Н = ЛОЖЬ");
    КонецЕсли;
  
    // 7. Период
    Если ЗначениеЗаполнено(ДатаНачала) И ДатаНачала <> '00010101' Тогда
        Условия.Добавить("СрокИсполнения >= &ДатаНачала");
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания <> '00010101' Тогда
        Условия.Добавить("СрокДействия <= &ДатаОкончания");
    КонецЕсли;
    
    // Формируем результат
    Если Условия.Количество() = 0 Тогда
        Возврат "ИСТИНА";
    Иначе
        Возврат СтрСоединить(Условия, " И ");
    КонецЕсли;
    
КонецФункции

&НаСервере
Процедура УстановитьПараметрыЗапроса(Запрос)
    // определение пустой даты	
    Запрос.УстановитьПараметр("ПустаяДата", '00010101');
    
    // ДатаНачала
    Если ЗначениеЗаполнено(ДатаНачала) Тогда
        Запрос.УстановитьПараметр("ПарДатаДокумента", НачалоДня(ДатаНачала));
        Запрос.УстановитьПараметр("ПарДатаНачала", НачалоДня(ДатаНачала));
    КонецЕсли;
    
    // Номер документа   
    Если ЗначениеЗаполнено(ОтборНомерДокумента) Тогда
        Запрос.УстановитьПараметр("ПарНомерДокумента", "%" + СокрЛП(ОтборНомерДокумента) + "%");
    КонецЕсли;
    
    // Наименование (частичное совпадение)
    Если ЗначениеЗаполнено(ОтборНаименование) Тогда
        Запрос.УстановитьПараметр("ПарНаименование", "%" + СокрЛП(ОтборНаименование) + "%");
    КонецЕсли;
    
    // Полное наименование (частичное совпадение)
    Если ЗначениеЗаполнено(ОтборПолноеНаименование) Тогда
        Запрос.УстановитьПараметр("ПарПолноеНаименование", "%" + СокрЛП(ОтборПолноеНаименование) + "%");
    КонецЕсли;
    
    // Период    
    Если ЗначениеЗаполнено(ДатаНачала) Тогда
        Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ДатаОкончания) Тогда
        Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
    КонецЕсли;
  
КонецПроцедуры	
