		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Договора.Тематика КАК Тематика,
	Договора.НомерРаспоряжения КАК НомерРаспоряжения,
	Договора.Договор КАК Договор,
	Договора.Наименование КАК Наименование,
	Договора.Заказчик КАК Заказчик,
	Договора.Распоряжение.(
		Ссылка КАК Ссылка,
		НаименованиеРабот КАК НаименованиеРабот,
		Исполнитель КАК Исполнитель,
		ДатаНачала КАК ДатаНачала,
		СрокИсполнения КАК СрокИсполнения,
		ДатаИсполнения КАК ДатаИсполнения,
		Примечание КАК Примечание
	) КАК Распоряжение,
	Договора.ПланГрафик.(
		Ссылка КАК Ссылка,
		НаименованиеРабот КАК НаименованиеРабот,
		Исполнитель КАК Исполнитель,
		ДатаНачала КАК ДатаНачала,
		СрокИсполнения КАК СрокИсполнения,
		ДатаИсполнения КАК ДатаИсполнения,
		Примечание КАК Примечание
	) КАК ПланГрафик
ИЗ
	Справочник.Договора КАК Договора


УПОРЯДОЧИТЬ ПО
	НомерРаспоряжения</query>
