&НаСервере
Функция ПолучитьТаблицуРаспоряжений(ИмяСправочника, МассивСотрудников, ПарамДатаС, ПарамДатаПо, УсловиеПоДатеИсполнения, УсловиеПоКонтролю, УсловиеПоН, УсловиеПоДатам)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Спр.Ссылка,
	|	Спр.Контроль,
	|	Спр.Наименование,
	|	Спр.Н,
	|	Спр.НомерДокумента,
	|	Спр.ДатаДокумента,
	|	Спр.ОтветственныйИсполнитель,
	|	ПРЕДСТАВЛЕНИЕ(Спр.ОтветственныйИсполнитель) КАК ИсполнительФИО,
	|	Спр.Исполнители,
	|	Спр.СрокИсполнения,
	|	Спр.ДатаИсполнения,
	|	Спр.Примечание,
	|	Спр.РеквизитыДокументаПодтверждающегоИсполнение КАК РеквизитыДокументаПодтверждающегоИсполнение
	|ИЗ Справочник." + ИмяСправочника + " КАК Спр
	|ГДЕ
	|	Спр.ОтветственныйИсполнитель В (&МассивСотрудников)
	|	" + УсловиеПоДатеИсполнения + "
	|	" + УсловиеПоКонтролю + "
	|	" + УсловиеПоН + "
	|	" + УсловиеПоДатам + "

//	|	И Спр.СрокИсполнения МЕЖДУ &ДатаС И &ДатаПо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Спр.СрокИсполнения"
	;
	
	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	Запрос.УстановитьПараметр("ДатаС", ПарамДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ПарамДатаПо);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции


&НаСервере
Процедура ЗаполнитьДетализациюРаспоряженийНаСервере(МассивСотрудников)
	
	// 1. Очищаем таблицы перед заполнением
	ТаблицаРаспоряженияГД.Очистить();
	ТаблицаРаспоряженияТД.Очистить();
	
	// 2. Проверка наличия сотрудников
	Если МассивСотрудников = Неопределено ИЛИ МассивСотрудников.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// 3. Подготовка параметров дат
	ПарамДатаС = ?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), '00010101');
	ПарамДатаПо = ?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), '39991231');
	
	// 4. Формируем условие отбора по дате исполнения в зависимости от переключателя
	УсловиеПоДатеИсполнения = "";
	Если ЗаписиОтображениеСостав Тогда
		УсловиеПоДатеИсполнения = "И Спр.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1)";
	Иначе
		УсловиеПоДатеИсполнения = "";
	КонецЕсли;
	
	
///////////////////////////////////////////////////////////////////////	
	  // Формируем условие по датам (СрокИсполнения ИЛИ ДатаИсполнения в диапазоне ИЛИ ДатаИсполнения пустая)
	Если ЗначениеЗаполнено(ДатаС) И ЗначениеЗаполнено(ДатаПо) Тогда
		УсловиеПоДатам = 
			"И ((Спр.СрокИсполнения МЕЖДУ &ДатаС И &ДатаПо)	ИЛИ (Спр.ДатаИсполнения МЕЖДУ &ДатаС И &ДатаПо)	ИЛИ (Спр.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1) И Спр.СрокИсполнения <= &ДатаПо))"; 
	ИначеЕсли ЗначениеЗаполнено(ДатаС) И Не ЗначениеЗаполнено(ДатаПо) Тогда
		УсловиеПоДатам = 
			"И ((Спр.СрокИсполнения >= &ДатаС) ИЛИ (Спр.ДатаИсполнения >= &ДатаС)	ИЛИ (Спр.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1) И Спр.СрокИсполнения <= &ДатаПо))";           			
	ИначеЕсли Не ЗначениеЗаполнено(ДатаС) И ЗначениеЗаполнено(ДатаПо) Тогда
		УсловиеПоДатам = 
			"И ((Спр.СрокИсполнения <= &ДатаПо)	ИЛИ (Спр.ДатаИсполнения <= &ДатаПо) ИЛИ (Спр.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1) И Спр.СрокИсполнения <= &ДатаПо))";
		
	Иначе
		УсловиеПоДатам = "";
	КонецЕсли;
 ///////////////////////////////////////////////////////////////////////

	                                                                         	
	// 5. Формируем условие отбора по контролю
	УсловиеПоКонтролю = "";
	Если ФильтрТолькоКонтроль Тогда
		УсловиеПоКонтролю = "И Спр.Контроль = ИСТИНА";
	Иначе
		УсловиеПоКонтролю = "";
	КонецЕсли;
	
	// Получаем условие фильтра по Н для Спр
	УсловиеПоН = ПолучитьУсловиеФильтраПоН("Спр");
	
	// 6. Выполняем запросы и загружаем результаты
	Попытка
		ТаблицаРаспоряженияГД.Загрузить(ПолучитьТаблицуРаспоряжений("РаспоряженияГД", МассивСотрудников, ПарамДатаС, ПарамДатаПо, УсловиеПоДатеИсполнения, УсловиеПоКонтролю, УсловиеПоН, УсловиеПоДатам));
	Исключение
		Сообщить("Ошибка при загрузке распоряжений ГД: " + ОписаниеОшибки());
	КонецПопытки;
	
	Попытка
		ТаблицаРаспоряженияТД.Загрузить(ПолучитьТаблицуРаспоряжений("РаспоряженияТД", МассивСотрудников, ПарамДатаС, ПарамДатаПо, УсловиеПоДатеИсполнения, УсловиеПоКонтролю, УсловиеПоН, УсловиеПоДатам));
	Исключение
		Сообщить("Ошибка при загрузке распоряжений ТД: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры



