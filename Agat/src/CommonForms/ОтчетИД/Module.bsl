&НаСервере
Функция СформироватьСтрокуИзФлажков()
	
	Результат = "";
	
	Если ИспользоватьДоговора Тогда
		Результат = "Договора";
	КонецЕсли;
	
	Если ИспользоватьРаспоряженияГД Тогда
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + ",";
		КонецЕсли;
		Результат = Результат + "РаспоряженияГД";
	КонецЕсли;
	
	Если ИспользоватьРаспоряженияТД Тогда
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + ",";
		КонецЕсли;
		Результат = Результат + "РаспоряженияТД";
	КонецЕсли;
	
	Если ИспользоватьВнутренниеДокументы Тогда
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + ",";
		КонецЕсли;
		Результат = Результат + "ВнутренниеДокументы";
	КонецЕсли;
	
	Если ИспользоватьИсходящиеДокументы Тогда
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + ",";
		КонецЕсли;
		Результат = Результат + "ИсходящиеДокументы";
	КонецЕсли;
	
	Если ИспользоватьВходящиеДокументы Тогда
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + ",";
		КонецЕсли;
		Результат = Результат + "ВходящиеДокументы";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


