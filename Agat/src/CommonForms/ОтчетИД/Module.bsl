//						 СтрокаИзделие.ИсполнителиСтрокой = СтрокаИзделие.ИсполнителиСтрокой + ", " + СтрТЗ.ИсполнительФИО;
//					КонецЕсли;					
					///////////////////////////////////////////////////////////////////////
					///////////////////////////////////////////////////////////////////////
			КонецЕсли;
			
//		Иначе
			// Изделие пустое — пишем работу напрямую в ТипЗаписи (без группировки)
//			РаботаБезИзделия = СтрокаТип.Строки.Добавить();
//			РаботаБезИзделия.НаименованиеРабот = СтрТЗ.НаименованиеРабот;
//			РаботаБезИзделия.СрокИсполнения    = СтрТЗ.СрокИсполнения;
//			РаботаБезИзделия.СсылкаНаДоговор   = СтрТЗ.Договор;
//		КонецЕсли;
		    
		
	КонецЦикла;
	// 4. Возврат данных на форму
	ЗначениеВРеквизитФормы(ДеревоОбъект, "ТаблицаДетализация");

	// 5. Перестраиваем ДиаграммаГанта по тем же строкам, что попали в ДетализацияДоговоров
	ЗаполнитьДиаграммуГантаНаСервере();

КонецПроцедуры


///////////////////////////////////////////////////////////////////////
// ДиаграммаГанта (страница ГруппаДиаграммаГанта)                     //
// Заполняется строками, отображенными в ДетализацияДоговоров,        //
// т.е. по уже примененному фильтру (сотрудники, ДатаС/ДатаПо,        //
// ФильтрПоН, ЗаписиОтображениеСостав, СтрокаПоискаДетализации).      //
// Источник - готовое дерево ТаблицаДетализация, поэтому диаграмма    //
// всегда синхронна с деревом договоров.                              //
///////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ЗаполнитьДиаграммуГантаНаСервере()

	// Обновление намеренно НЕ отключаем. При Обновление = Ложь дерево точек
	// и область баров перестают синхронизироваться: список выглядит
	// свернутым, а бары рисуются как для развернутого дерева.
	// В рабочем построении диаграммы в форме списка договоров
	// это свойство тоже не используется
	ДиаграммаГанта.Очистить();

	// Соответствие точек строкам дерева - для перехода в форму договора
	СоответствиеТочекГанта.Очистить();

	// Тексты точек и серий задаем сами
	ДиаграммаГанта.АвтоУстановкаТекстаТочек = Ложь;
	ДиаграммаГанта.АвтоУстановкаТекстаСерий = Ложь;

	// Окантовка интервалов. Свойство булево: цвет окантовки платформой
	// не настраивается, линия всегда тонкая черная
	ДиаграммаГанта.Окантовка = Ложь;

	// Серия ровно одна. Диаграмма Ганта отводит каждой серии точки
	// отдельную полосу, поэтому число серий = высота строки точки.
	// Одна серия -> любая строка занимает ровно 1 строку, а интервал
	// просрочки рисуется на одной строке со своей работой.
	// Различие план/факт/просрочка передается цветом интервала
	СерияРабот = ДиаграммаГанта.УстановитьСерию("Работы");
	СерияРабот.Текст = "Работы";

	ДеревоОбъект = РеквизитФормыВЗначение("ТаблицаДетализация", Тип("ДеревоЗначений"));

	// Общие параметры построения: серия, счетчик точек, текущая дата.
	// Структура передается по ссылке - СчетчикТочек накапливается по всему обходу
	ПараметрыПостроения = Новый Структура;
	ПараметрыПостроения.Вставить("СерияРабот",   СерияРабот);
	ПараметрыПостроения.Вставить("ТекущаяДата",  НачалоДня(ТекущаяДата()));
	ПараметрыПостроения.Вставить("СчетчикТочек", 0);

	// Цвета задаем через Новый Цвет(R, G, B), а не через WebЦвета:
	// русские имена цветов в WebЦвета зависят от версии платформы.
	// Основной бар (ДатаНачала - СрокИсполнения) красится по заполненности
	// ДатаИсполнения, хвост просрочки - по реквизиту Н
	ПараметрыПостроения.Вставить("ЦветНеИсполнено", Новый Цвет(240, 240, 240));
	ПараметрыПостроения.Вставить("ЦветВРаботе",     Новый Цвет(220, 220, 220));
	ПараметрыПостроения.Вставить("ЦветИсполнено",   Новый Цвет(160, 255, 160));
	ПараметрыПостроения.Вставить("ЦветПросрочка",   Новый Цвет(255, 183, 192));
	ПараметрыПостроения.Вставить("ЦветПросрочкаН",  Новый Цвет(215, 234, 255));

	// Оформление строк-группировок в таблице диаграммы:
	// Точка1 (уровень "Договор")    - черный фон, белый жирный текст
	// Точка2 (уровень "Тип записи") - светло-серый фон
	ПараметрыПостроения.Вставить("ФонТочка1",    Новый Цвет(0, 0, 0));
	ПараметрыПостроения.Вставить("ТекстТочка1",  Новый Цвет(255, 255, 255));
	ПараметрыПостроения.Вставить("ШрифтТочка1",  Новый Шрифт(, , Истина));
	ПараметрыПостроения.Вставить("ФонТочка2",    Новый Цвет(217, 217, 217));

	// Контекст верхних уровней дерева (Договор / Тип записи) для подписи точки
	Контекст = Новый Структура("НомерРаспоряжения, Договор, ТипЗаписи", "", Неопределено, "");

	ДобавитьСтрокиВДиаграммуГанта(ДеревоОбъект.Строки, Контекст, ПараметрыПостроения, "");

	// Разворачиваем ВСЕ точки, а не только верхний уровень: Очистить()
	// уничтожает точки, и после перестроения дерево вернулось бы к
	// состоянию по умолчанию, то есть выглядело бы свернутым.
	// Обход всей коллекции гарантирует, что обновление диаграммы
	// не сворачивает список ни при каких условиях.
	// Для точек без подчиненных вызов безрезультатен - гасим его
	Для Индекс = 0 По ДиаграммаГанта.Точки.Количество() - 1 Цикл
		Попытка
			ДиаграммаГанта.РазвернутьТочку(ДиаграммаГанта.Точки[Индекс], Истина);
		Исключение
			// Точка без подчиненных - разворачивать нечего
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

///////////////////////////////////////////////////////////////////////
// Рекурсивный обход дерева детализации и добавление точек диаграммы. //
// Строки дерева делятся на два вида:                                 //
//  - группировки (КлючСтроки и СрокИсполнения пустые):               //
//      с заполненным НомерРаспоряжения - уровень "Договор",          //
//      с пустым НомерРаспоряжения      - уровень "Тип записи";       //
//    для них строится сводная точка по дочерним работам;             //
//  - строки работ (заполнен СрокИсполнения) - обычная точка.         //
// Точка группировки добавляется до своих дочерних строк и передает им //
// свой ключ как родительский - так строится иерархия точек диаграммы, //
// которая и дает возможность сворачивать группировки                  //
///////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ДобавитьСтрокиВДиаграммуГанта(СтрокиДерева, Контекст, ПараметрыПостроения, КлючРодителя)

	Для Каждого Стр Из СтрокиДерева Цикл

		// Копия контекста для этой ветки
		КонтекстВетки = Новый Структура("НомерРаспоряжения, Договор, ТипЗаписи",
			Контекст.НомерРаспоряжения, Контекст.Договор, Контекст.ТипЗаписи);

		Если ЗначениеЗаполнено(Стр.НомерРаспоряжения) Тогда
			КонтекстВетки.НомерРаспоряжения = Стр.НомерРаспоряжения;
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Договор) Тогда
			КонтекстВетки.Договор = Стр.Договор;
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ТипЗаписи) Тогда
			КонтекстВетки.ТипЗаписи = Стр.ТипЗаписи;
		КонецЕсли;

		Если ЗначениеЗаполнено(Стр.СрокИсполнения) Тогда
			КлючТекущейТочки = ДобавитьТочкуДиаграммыГанта(Стр, КонтекстВетки, ПараметрыПостроения, КлючРодителя);
		Иначе
			КлючТекущейТочки = ДобавитьСводнуюТочкуДиаграммыГанта(Стр, ПараметрыПостроения, КлючРодителя);
		КонецЕсли;

		// Строка отсеяна отбором - ее дети подчиняются текущему родителю,
		// чтобы не потеряться и не образовать разрыв в иерархии
		Если ПустаяСтрока(КлючТекущейТочки) Тогда
			КлючТекущейТочки = КлючРодителя;
		КонецЕсли;

		Если Стр.Строки.Количество() > 0 Тогда
			ДобавитьСтрокиВДиаграммуГанта(Стр.Строки, КонтекстВетки, ПараметрыПостроения, КлючТекущейТочки);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

///////////////////////////////////////////////////////////////////////
// Точка уровня группировки (Договор / Тип записи).                   //
// Это строка-заголовок: интервалы в нее не добавляются, поэтому      //
// бар не рисуется, а высота строки остается равной 1 строке          //
///////////////////////////////////////////////////////////////////////

&НаСервере
Функция ДобавитьСводнуюТочкуДиаграммыГанта(Стр, ПараметрыПостроения, КлючРодителя)

	// Вся группа отсеяна отбором или в ней нет работ со сроком - точку не выводим
	Если Не ЕстьРаботыВПоддеревеГанта(Стр.Строки) Тогда
		Возврат "";
	КонецЕсли;

	// Подпись и оформление зависят от уровня группировки:
	// заполненный НомерРаспоряжения - Точка1, пустой - Точка2
	Если ЗначениеЗаполнено(Стр.НомерРаспоряжения) Тогда
		ТекстТочки = "№ " + СокрЛП(Стр.НомерРаспоряжения)
			+ ?(ЗначениеЗаполнено(Стр.Договор), " | " + Строка(Стр.Договор), "");
		ЦветФона   = ПараметрыПостроения.ФонТочка1;
		ЦветТекста = ПараметрыПостроения.ТекстТочка1;
		ШрифтТочки = ПараметрыПостроения.ШрифтТочка1;
	ИначеЕсли ЗначениеЗаполнено(Стр.ТипЗаписи) Тогда
		ТекстТочки = СокрЛП(Стр.ТипЗаписи);
		ЦветФона   = ПараметрыПостроения.ФонТочка2;
		ЦветТекста = Неопределено;
		ШрифтТочки = Неопределено;
	Иначе
		ТекстТочки = "Без наименования";
		ЦветФона   = ПараметрыПостроения.ФонТочка2;
		ЦветТекста = Неопределено;
		ШрифтТочки = Неопределено;
	КонецЕсли;

	// Ссылка на договор есть на обоих уровнях группировки:
	// на уровне "Договор" - в Договор, на уровне "Тип записи" - в СсылкаНаДоговор
	ДоговорПерехода = ?(ЗначениеЗаполнено(Стр.Договор), Стр.Договор, Стр.СсылкаНаДоговор);

	ДанныеТочки = ДобавитьТочкуГанта(ПараметрыПостроения, ТекстТочки, КлючРодителя,
		ДоговорПерехода, ПолучитьИмяТЧПоТипуЗаписи(Стр.ТипЗаписи), Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));

	ОформитьТочкуГанта(ДанныеТочки.Точка, ЦветФона, ЦветТекста, ШрифтТочки);

	Возврат ДанныеТочки.Ключ;

КонецФункции

///////////////////////////////////////////////////////////////////////
// Оформление строки-группировки в таблице диаграммы.                 //
// Набор свойств оформления у точки диаграммы зависит от версии        //
// платформы, поэтому каждое присваивание защищено отдельно:           //
// недоступное свойство пропускается и не ломает построение.           //
// Применяется только к точкам-группировкам, у которых нет интервалов, //
// поэтому раскрасить бары работ этим нельзя                          //
///////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ОформитьТочкуГанта(Точка, ЦветФона, ЦветТекста, Шрифт = Неопределено)

	Если ЦветФона <> Неопределено Тогда
		Попытка Точка.ЦветФона = ЦветФона; Исключение КонецПопытки;
		Попытка Точка.Цвет     = ЦветФона; Исключение КонецПопытки;
	КонецЕсли;

	Если ЦветТекста <> Неопределено Тогда
		Попытка Точка.ЦветТекста = ЦветТекста; Исключение КонецПопытки;
	КонецЕсли;

	Если Шрифт <> Неопределено Тогда
		Попытка Точка.Шрифт = Шрифт; Исключение КонецПопытки;
	КонецЕсли;

КонецПроцедуры

///////////////////////////////////////////////////////////////////////
// Есть ли в поддереве группировки хоть одна работа, прошедшая отбор  //
///////////////////////////////////////////////////////////////////////

&НаСервере
Функция ЕстьРаботыВПоддеревеГанта(СтрокиДерева)

	Для Каждого Стр Из СтрокиДерева Цикл

		Если ЗначениеЗаполнено(Стр.СрокИсполнения) И СтрокаПроходитОтборДиаграммыГанта(Стр) Тогда
			Возврат Истина;
		КонецЕсли;

		Если Стр.Строки.Количество() > 0 И ЕстьРаботыВПоддеревеГанта(Стр.Строки) Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

///////////////////////////////////////////////////////////////////////
// Добавление одной задачи в ДиаграммаГанта                           //
///////////////////////////////////////////////////////////////////////

&НаСервере
Функция ДобавитьТочкуДиаграммыГанта(Стр, Контекст, ПараметрыПостроения, КлючРодителя)

	Если Не СтрокаПроходитОтборДиаграммыГанта(Стр) Тогда
		Возврат "";
	КонецЕсли;

	ГраницыЗадачи = ПолучитьГраницыЗадачиГанта(Стр, ПараметрыПостроения.ТекущаяДата);
	Начало = ГраницыЗадачи.Начало;
	Срок   = ГраницыЗадачи.Срок;

	// Подпись точки: изделие / наименование работ.
	// Номер распоряжения и тип записи уже показаны точками группировок
	ЧастиТекста = Новый Массив;
	Если ЗначениеЗаполнено(Стр.Изделие) Тогда
		ЧастиТекста.Добавить(СокрЛП(Стр.Изделие));
	КонецЕсли;
	Если ЗначениеЗаполнено(Стр.НаименованиеРабот) Тогда
		ЧастиТекста.Добавить(СокрЛП(Стр.НаименованиеРабот));
	КонецЕсли;
	ТекстТочки = СтрСоединить(ЧастиТекста, " | ");
	Если ПустаяСтрока(ТекстТочки) Тогда
		ТекстТочки = "Без наименования";
	КонецЕсли;

	ДанныеТочки = ДобавитьТочкуГанта(ПараметрыПостроения, ТекстТочки, КлючРодителя,
		Контекст.Договор, ПолучитьИмяТЧПоТипуЗаписи(Контекст.ТипЗаписи), Стр.КлючСтроки);
	Точка = ДанныеТочки.Точка;

	Подсказка = ТекстТочки
		+ ?(ЗначениеЗаполнено(Контекст.НомерРаспоряжения), Символы.ПС + "Распоряжение № " + СокрЛП(Контекст.НомерРаспоряжения), "")
		+ ?(ЗначениеЗаполнено(Контекст.Договор), Символы.ПС + "Договор: " + Строка(Контекст.Договор), "")
		+ ?(ЗначениеЗаполнено(Контекст.ТипЗаписи), Символы.ПС + "Тип записи: " + СокрЛП(Контекст.ТипЗаписи), "")
		+ ?(ЗначениеЗаполнено(Стр.ИсполнителиСтрокой), Символы.ПС + "Исполнитель: " + СокрЛП(Стр.ИсполнителиСтрокой), "")
		+ Символы.ПС + "Срок исполнения: " + Формат(Стр.СрокИсполнения, "ДФ=dd.MM.yyyy")
		+ ?(ЗначениеЗаполнено(Стр.ДатаИсполнения), Символы.ПС + "Дата исполнения: " + Формат(Стр.ДатаИсполнения, "ДФ=dd.MM.yyyy"), "")
		+ ?(ЗначениеЗаполнено(Стр.Примечание), Символы.ПС + "Примечание: " + СокрЛП(Стр.Примечание), "");

	// Все интервалы работы идут в одну серию и не пересекаются между собой,
	// поэтому ложатся на одну строку диаграммы: сначала сама работа,
	// следом - хвост просрочки, начинающийся ровно на сроке исполнения.
	// Текст интервала не заполняем: он рисуется внутри полосы и увеличивает
	// ее высоту. Вся информация - в подсказке и в подписи точки слева
	ЗначениеРабот = ДиаграммаГанта.ПолучитьЗначение(Точка, ПараметрыПостроения.СерияРабот);

	// Основной бар - от даты начала до срока исполнения. Цвет по состоянию:
	//   ДатаИсполнения заполнена                  - исполнено;
	//   не заполнена, срок наступил (просрочено)  - не исполнено;
	//   не заполнена, срок не наступил            - в стадии исполнения
	Если ЗначениеЗаполнено(Стр.ДатаИсполнения) Тогда
		ЦветОсновного = ПараметрыПостроения.ЦветИсполнено;
	ИначеЕсли ГраницыЗадачи.Просрочено Тогда
		ЦветОсновного = ПараметрыПостроения.ЦветНеИсполнено;
	Иначе
		ЦветОсновного = ПараметрыПостроения.ЦветВРаботе;
	КонецЕсли;

	ДобавитьИнтервалДиаграммыГанта(ЗначениеРабот, Начало, Срок, "", Подсказка, ЦветОсновного);

	Если ГраницыЗадачи.Просрочено Тогда

		// Просрочка - от срока до даты исполнения либо до текущей даты.
		// Начало сдвинуто на секунду за Срок: интервалы с общей границей
		// диаграмма считает пересекающимися и разносит по разным полосам,
		// из-за чего строка точки становится выше одной строки
		НачалоПросрочки = Срок + 1;

		Если НачалоПросрочки < ГраницыЗадачи.Конец Тогда
			// Цвет хвоста просрочки зависит от реквизита Н строки ТЧ
			ЦветХвоста = ?(Стр.Н = Истина,
				ПараметрыПостроения.ЦветПросрочкаН, ПараметрыПостроения.ЦветПросрочка);

			ДобавитьИнтервалДиаграммыГанта(ЗначениеРабот, НачалоПросрочки, ГраницыЗадачи.Конец,
				"", Подсказка, ЦветХвоста);
		КонецЕсли;

	КонецЕсли;

	Возврат ДанныеТочки.Ключ;

КонецФункции

///////////////////////////////////////////////////////////////////////
// Создание точки диаграммы.                                          //
// Значение точки - сквозной номер: одинаковые по тексту работы        //
// не должны сливаться в одну строку диаграммы.                       //
// Уровень вложенности задается родительской точкой, поэтому отступы   //
// в тексте не нужны - дерево рисует сама диаграмма                    //
///////////////////////////////////////////////////////////////////////

&НаСервере
Функция ДобавитьТочкуГанта(ПараметрыПостроения, Текст, КлючРодителя, Договор, ИмяТЧ, КлючСтроки)

	ПараметрыПостроения.СчетчикТочек = ПараметрыПостроения.СчетчикТочек + 1;

	// Ключ точки обязан быть глобально уникальным по всей диаграмме,
	// поэтому берем сквозной номер. Родитель задает уровень вложенности:
	// Точка1 (Договор) -> Точка2 (Тип записи) -> строки работ.
	// Иерархия точек и дает возможность сворачивать группировки
	КлючТочки = Формат(ПараметрыПостроения.СчетчикТочек, "ЧГ=0");

	Если ПустаяСтрока(КлючРодителя) Тогда
		Точка = ДиаграммаГанта.УстановитьТочку(КлючТочки);
	Иначе
		Точка = ДиаграммаГанта.УстановитьТочку(КлючТочки, КлючРодителя);
	КонецЕсли;

	Точка.Текст = Текст;

	// В расшифровку кладем ссылку на договор - так же, как в диаграмме формы
	// списка договоров. Клик по бару в области диаграммы обрабатывается
	// стандартной расшифровкой платформы и открывает форму договора.
	// Номер точки при этом не теряется: он лежит в значении точки
	// (ключ вида "1", "2", ...), откуда его и берет ПолучитьНомерТочкиГанта
	Если ЗначениеЗаполнено(Договор) Тогда
		Точка.Расшифровка = Договор;
	Иначе
		Точка.Расшифровка = ПараметрыПостроения.СчетчикТочек;
	КонецЕсли;

	// Данные для перехода в форму договора
	СтрокаПерехода = СоответствиеТочекГанта.Добавить();
	СтрокаПерехода.НомерТочки = ПараметрыПостроения.СчетчикТочек;
	СтрокаПерехода.Договор    = ?(ЗначениеЗаполнено(Договор), Договор, Справочники.Договора.ПустаяСсылка());
	СтрокаПерехода.ИмяТЧ      = ИмяТЧ;
	СтрокаПерехода.КлючСтроки = КлючСтроки;

	// Текст точки запоминаем здесь, на сервере. На клиенте Точка.Текст
	// недоступен, а в событии выбора приходит именно отображаемый текст
	СтрокаПерехода.ТекстТочки = Текст;

	Возврат Новый Структура("Точка, Ключ", Точка, КлючТочки);

КонецФункции

///////////////////////////////////////////////////////////////////////
// Имя табличной части справочника Договора по тексту типа записи.    //
// Правило то же, что в ТаблицаДетализацияВыбор                       //
///////////////////////////////////////////////////////////////////////

&НаСервере
Функция ПолучитьИмяТЧПоТипуЗаписи(ТипЗаписи)

	ТекстТипа = ВРег(СокрЛП(Строка(ТипЗаписи)));

	Если Найти(ТекстТипа, "РАСПОРЯЖЕНИЕ") > 0 Тогда
		Возврат "Распоряжение";
	ИначеЕсли Найти(ТекстТипа, "ПЛАН") > 0 Или Найти(ТекстТипа, "ГРАФИК") > 0 Тогда
		Возврат "ПланГрафик";
	КонецЕсли;

	Возврат "";

КонецФункции

///////////////////////////////////////////////////////////////////////
// Отбор строк диаграммы - тот же, что задан                          //
// для Элементы.ДетализацияДоговоров.ОтборСтрок                       //
///////////////////////////////////////////////////////////////////////

&НаСервере
Функция СтрокаПроходитОтборДиаграммыГанта(Стр)

	Если Не ЗначениеЗаполнено(СтрокаПоискаДетализации) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СокрЛП(Стр.Изделие) = СокрЛП(СтрокаПоискаДетализации);

КонецФункции

///////////////////////////////////////////////////////////////////////
// Границы одной работы:                                              //
//  Начало     - ДатаНачала, если заполнена, иначе день срока;         //
//  Срок       - конец планового интервала;                            //
//  Конец      - правая граница с учетом факта и просрочки;            //
//  Просрочено - признак нарушения срока                               //
///////////////////////////////////////////////////////////////////////

&НаСервере
Функция ПолучитьГраницыЗадачиГанта(Стр, ТекущаяДата)

	// Границы дня срока: с 00:01 до 23:59, а не НачалоДня/КонецДня.
	// При незаполненной ДатаНачала бар занимает ровно этот интервал
	Срок   = ВремяКонцаДня(Стр.СрокИсполнения);
	Начало = ?(ЗначениеЗаполнено(Стр.ДатаНачала),
		НачалоДня(Стр.ДатаНачала), ВремяНачалаДня(Стр.СрокИсполнения));

	Если Начало > Срок Тогда
		Начало = ВремяНачалаДня(Стр.СрокИсполнения);
	КонецЕсли;

	Конец      = Срок;
	Просрочено = Ложь;

	Если ЗначениеЗаполнено(Стр.ДатаИсполнения) Тогда
		Если ВремяКонцаДня(Стр.ДатаИсполнения) > Конец Тогда
			Конец = ВремяКонцаДня(Стр.ДатаИсполнения);
		КонецЕсли;
		Просрочено = НачалоДня(Стр.ДатаИсполнения) > НачалоДня(Стр.СрокИсполнения);
	ИначеЕсли НачалоДня(Стр.СрокИсполнения) < ТекущаяДата Тогда
		Если ВремяКонцаДня(ТекущаяДата) > Конец Тогда
			Конец = ВремяКонцаДня(ТекущаяДата);
		КонецЕсли;
		Просрочено = Истина;
	КонецЕсли;

	Возврат Новый Структура("Начало, Срок, Конец, Просрочено", Начало, Срок, Конец, Просрочено);

КонецФункции

///////////////////////////////////////////////////////////////////////
// Границы дня для интервалов диаграммы: 00:01 и 23:59.               //
// Секунды не используем - так же построены интервалы в диаграмме      //
// формы списка договоров                                             //
///////////////////////////////////////////////////////////////////////

&НаСервере
Функция ВремяНачалаДня(ЗначениеДаты)

	Возврат Дата(Год(ЗначениеДаты), Месяц(ЗначениеДаты), День(ЗначениеДаты), 0, 1, 0);

КонецФункции

&НаСервере
Функция ВремяКонцаДня(ЗначениеДаты)

	Возврат Дата(Год(ЗначениеДаты), Месяц(ЗначениеДаты), День(ЗначениеДаты), 23, 59, 0);

КонецФункции

///////////////////////////////////////////////////////////////////////
// Добавление интервала в значение диаграммы.                         //
// ЗначениеДиаграммыГанта.Добавить() вызывается без параметров,        //
// границы интервала задаются свойствами Начало и Конец.              //
// Текст и подсказка - оформление, ошибка в них не должна ломать       //
// построение диаграммы                                               //
///////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////
// Выбор строки в таблице диаграммы - переход в форму договора        //
// с позиционированием на строке табличной части.                     //
// Параметры открытия те же, что в ТаблицаДетализацияВыбор:           //
// Ключ, ИмяActiveТЧ, КлючСтрокиДляПерехода                           //
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ДиаграммаГантаТаблицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь; // Отключаем стандартное открытие 1С

	НомерТочки = 0;

	// ВыбраннаяСтрока приходит как ИдентификаторЗначенияДиаграммыГанта,
	// но у него не читается ни одно свойство - разбирать его бесполезно.
	// Точку берем из самого элемента: колонки таблицы диаграммы привязаны
	// к ДиаграммаГанта.Point, то есть строка моделируется как данные с полем Point
	// Основной путь: ВыбраннаяСтрока - ИдентификаторЗначенияДиаграммыГанта,
	// а у каждого значения диаграммы есть свойство Идентификатор того же типа.
	// Перебираем значения и находим то, чей идентификатор совпал: это дает
	// точную точку без сопоставления по тексту
	НомерТочки = НайтиНомерТочкиГантаПоИдентификатору(ВыбраннаяСтрока);

	ТочкаДиаграммы = Неопределено;

	Если НомерТочки = 0 Тогда

		Попытка
			ТочкаДиаграммы = Элемент.ТекущиеДанные.Point;
		Исключение
			ТочкаДиаграммы = Неопределено;
		КонецПопытки;

		// ТекущиеДанные.Point отдает не объект точки, а ее текст.
		// Запасной путь на случай, если идентификатор не совпал ни с одним
		// значением - например у точки-группировки интервалов нет
		Если ТипЗнч(ТочкаДиаграммы) = Тип("Строка") Тогда
			НомерТочки = НайтиНомерТочкиГантаПоТексту(ТочкаДиаграммы);
		Иначе
			НомерТочки = ПолучитьНомерТочкиГанта(ТочкаДиаграммы);
		КонецЕсли;

	КонецЕсли;

	Если НомерТочки = -1 Тогда
		Сообщить("Диаграмма Ганта: несколько строк с одинаковым текстом """
			+ Строка(ТочкаДиаграммы) + """, выбранная строка определяется неоднозначно.");
		Возврат;
	КонецЕсли;

	Если НомерТочки = 0 Тогда
		Сообщить("Диаграмма Ганта: не удалось определить выбранную точку."
			+ " Точка " + ?(ТочкаДиаграммы = Неопределено, "не получена", "получена, но номер не определен")
			+ "." + Символы.ПС + ОписаниеИдентификатораГанта(ВыбраннаяСтрока, Элемент));
		Возврат;
	КонецЕсли;

	ДанныеПерехода = НайтиДанныеПереходаГанта(НомерТочки);

	Если ДанныеПерехода = Неопределено Тогда
		Сообщить("Диаграмма Ганта: точка " + Формат(НомерТочки, "ЧГ=0") + " не найдена в соответствии.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДанныеПерехода.Договор) Тогда
		Сообщить("Диаграмма Ганта: для выбранной строки не задан договор.");
		Возврат;
	КонецЕсли;

	Пар = Новый Структура;
	Пар.Вставить("Ключ", ДанныеПерехода.Договор);

	Если ЗначениеЗаполнено(ДанныеПерехода.ИмяТЧ) Тогда
		Пар.Вставить("ИмяActiveТЧ", ДанныеПерехода.ИмяТЧ);
	КонецЕсли;

	// Передаем Уникальный Идентификатор для позиционирования
	Если ЗначениеЗаполнено(ДанныеПерехода.КлючСтроки) Тогда
		Пар.Вставить("КлючСтрокиДляПерехода", ДанныеПерехода.КлючСтроки);
	КонецЕсли;

	ОткрытьФорму("Справочник.Договора.ФормаОбъекта", Пар, Элемент);

КонецПроцедуры

///////////////////////////////////////////////////////////////////////
// ВРЕМЕННАЯ ДИАГНОСТИКА.                                             //
// Показывает, какие свойства читаются у идентификатора значения       //
// диаграммы Ганта и доступна ли коллекция точек. Нужна ровно один     //
// запуск, чтобы дописать разбор под фактический состав свойств,       //
// после чего эту функцию и ее вызов надо удалить                      //
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Функция ОписаниеИдентификатораГанта(Идентификатор, Элемент)

	// Обращение по имени через [] у платформенных объектов не работает,
	// поэтому каждое свойство читается явно и под своей Попыткой:
	// отсутствующее просто не попадет в описание
	Описание = "Тип: " + Строка(ТипЗнч(Идентификатор));

	Попытка Описание = Описание + ОписаниеСвойстваГанта("Точка",       Идентификатор.Точка);       Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Серия",       Идентификатор.Серия);       Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("ИндексТочки", Идентификатор.ИндексТочки); Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("ИндексСерии", Идентификатор.ИндексСерии); Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("НомерТочки",  Идентификатор.НомерТочки);  Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("НомерСерии",  Идентификатор.НомерСерии);  Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Значение",    Идентификатор.Значение);    Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Расшифровка", Идентификатор.Расшифровка); Исключение КонецПопытки;

	Попытка
		Описание = Описание + Символы.ПС + "ДиаграммаГанта.Точки: "
			+ Строка(ДиаграммаГанта.Точки.Количество()) + " шт.";
	Исключение
		Описание = Описание + Символы.ПС + "ДиаграммаГанта.Точки недоступна";
	КонецПопытки;

	// Источники точки помимо идентификатора
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Элемент.ТекущаяСтрока",    Элемент.ТекущаяСтрока);    Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Элемент.ТекущиеДанные",    Элемент.ТекущиеДанные);    Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("ТекущиеДанные.Point",      Элемент.ТекущиеДанные.Point); Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("ДиаграммаГанта.ТекущаяТочка", ДиаграммаГанта.ТекущаяТочка); Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Точки[0]",                 ДиаграммаГанта.Точки[0]);  Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Точки[0].Значение",        ДиаграммаГанта.Точки[0].Значение); Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Точки[0].Расшифровка",     ДиаграммаГанта.Точки[0].Расшифровка); Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Точки[0].Текст",           ДиаграммаГанта.Точки[0].Текст); Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Серии.Количество",         ДиаграммаГанта.Серии.Количество()); Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("СоответствиеТочек",        СоответствиеТочекГанта.Количество()); Исключение КонецПопытки;
	Попытка Описание = Описание + ОписаниеСвойстваГанта("Соответствие[0].ТекстТочки", СоответствиеТочекГанта[0].ТекстТочки); Исключение КонецПопытки;

	Возврат Описание;

КонецФункции

// Вызывается и из клиентской, и из серверной диагностики,
// поэтому директива внеконтекстная
&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеСвойстваГанта(Имя, Значение)

	Возврат Символы.ПС + Имя + " = " + Строка(Значение) + " (" + Строка(ТипЗнч(Значение)) + ")";

КонецФункции

///////////////////////////////////////////////////////////////////////
// Номер точки диаграммы. При построении он кладется и в расшифровку,  //
// и в значение точки (значение - это ключ вида "1", "2", ...),        //
// поэтому берем то, что окажется доступным                            //
///////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////
// Поиск номера точки по идентификатору значения диаграммы.           //
// Значение диаграммы Ганта отдает свой Идентификатор того же типа,    //
// что приходит в событии выбора, поэтому сравниваем их и получаем     //
// точку однозначно. Сравнение через Строка(): равенство объектов      //
// идентификаторов не гарантировано                                    //
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Функция НайтиНомерТочкиГантаПоИдентификатору(ИдентификаторЗначения)

	ИскомыйИдентификатор = Строка(ИдентификаторЗначения);

	Если ПустаяСтрока(ИскомыйИдентификатор) Тогда
		Возврат 0;
	КонецЕсли;

	Для ИндексТочки = 0 По ДиаграммаГанта.Точки.Количество() - 1 Цикл

		Точка = ДиаграммаГанта.Точки[ИндексТочки];

		Для ИндексСерии = 0 По ДиаграммаГанта.Серии.Количество() - 1 Цикл

			Попытка
				ЗначениеДиаграммы = ДиаграммаГанта.ПолучитьЗначение(Точка, ДиаграммаГанта.Серии[ИндексСерии]);
				Если Строка(ЗначениеДиаграммы.Идентификатор) = ИскомыйИдентификатор Тогда
					Возврат ПолучитьНомерТочкиГанта(Точка);
				КонецЕсли;
			Исключение
				// Значения для этой пары нет - идем дальше
			КонецПопытки;

		КонецЦикла;

	КонецЦикла;

	Возврат 0;

КонецФункции

///////////////////////////////////////////////////////////////////////
// Поиск номера точки по ее тексту.                                   //
// Возвращает 0 - не найдено, -1 - найдено несколько разных строк      //
// с одинаковым текстом (открывать наугад нельзя)                      //
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Функция НайтиНомерТочкиГантаПоТексту(ТекстТочки)

	// Ищем по сохраненному на сервере тексту, а не по Точка.Текст:
	// на клиенте текст точки недоступен
	ИскомыйТекст = СокрЛП(ТекстТочки);

	Если ПустаяСтрока(ИскомыйТекст) Тогда
		Возврат 0;
	КонецЕсли;

	НайденныйНомер = 0;

	Для Каждого СтрокаСоответствия Из СоответствиеТочекГанта Цикл

		Если СокрЛП(СтрокаСоответствия.ТекстТочки) <> ИскомыйТекст Тогда
			Продолжить;
		КонецЕсли;

		Номер = СтрокаСоответствия.НомерТочки;

		Если НайденныйНомер = 0 Тогда
			НайденныйНомер = Номер;
		ИначеЕсли НайденныйНомер <> Номер
			И Не ОдинаковыйПереходГанта(НайденныйНомер, Номер) Тогда
			// Разные строки с одинаковым текстом ведут в разные места
			Возврат -1;
		КонецЕсли;

	КонецЦикла;

	Возврат НайденныйНомер;

КонецФункции

///////////////////////////////////////////////////////////////////////
// Две точки ведут в одно и то же место - тогда совпадение текстов     //
// безопасно и переход однозначен                                      //
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Функция ОдинаковыйПереходГанта(НомерПервой, НомерВторой)

	ПерваяСтрока  = НайтиДанныеПереходаГанта(НомерПервой);
	ВтораяСтрока  = НайтиДанныеПереходаГанта(НомерВторой);

	Если ПерваяСтрока = Неопределено Или ВтораяСтрока = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПерваяСтрока.Договор = ВтораяСтрока.Договор
		И ПерваяСтрока.ИмяТЧ = ВтораяСтрока.ИмяТЧ
		И ПерваяСтрока.КлючСтроки = ВтораяСтрока.КлючСтроки;

КонецФункции

&НаКлиенте
Функция НайтиДанныеПереходаГанта(НомерТочки)

	Для Каждого СтрокаСоответствия Из СоответствиеТочекГанта Цикл
		Если СтрокаСоответствия.НомерТочки = НомерТочки Тогда
			Возврат СтрокаСоответствия;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция ПолучитьНомерТочкиГанта(ТочкаДиаграммы)

	Если ТочкаДиаграммы = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Результат = 0;

	Попытка
		Результат = Число(ТочкаДиаграммы.Расшифровка);
	Исключение
		Результат = 0;
	КонецПопытки;

	Если Результат = 0 Тогда
		Попытка
			Результат = Число(ТочкаДиаграммы.Значение);
		Исключение
			Результат = 0;
		КонецПопытки;
	КонецЕсли;

	// Значение точки могло прийти напрямую - это ключ вида "1", "2", ...
	Если Результат = 0 Тогда
		Попытка
			Результат = Число(ТочкаДиаграммы);
		Исключение
			Результат = 0;
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ДобавитьИнтервалДиаграммыГанта(ЗначениеГанта, Начало, Конец, Текст, Подсказка, Цвет)

	Интервал = ЗначениеГанта.Добавить();
	Интервал.Начало = Начало;
	Интервал.Конец  = Конец;

	Попытка Интервал.Текст = Текст; Исключение КонецПопытки;
	Попытка Интервал.Подсказка = Подсказка; Исключение КонецПопытки;
	Попытка Интервал.Цвет = Цвет; Исключение КонецПопытки;

	Возврат Интервал;

КонецФункции



&НаКлиенте
Процедура ДетализацияДоговоровНПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДетализацияДоговоров.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

// Сохраняем позицию прокрутки
СохранитьПозициюПрокрутки();
	
	// 1. Ищем договор вверх по иерархии
	СсылкаНаДоговор = ТекущиеДанные.Договор;
	
	// Если в текущей строке договора нет, ищем у родителя
	ТекущийРодитель = ТекущиеДанные.ПолучитьРодителя();
	Пока ТекущийРодитель <> Неопределено И Не ЗначениеЗаполнено(СсылкаНаДоговор) Цикл
		СсылкаНаДоговор = ТекущийРодитель.Договор;
		ТекущийРодитель = ТекущийРодитель.ПолучитьРодителя();
	КонецЦикла;
	
	// 2. Если договор так и не нашли, выходим
	Если Не ЗначениеЗаполнено(СсылкаНаДоговор) Тогда
		Возврат;
	КонецЕсли;
	
	// 3. Собираем данные для сервера
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Договор",        СсылкаНаДоговор);
	СтруктураДанных.Вставить("КлючСтроки",     ТекущиеДанные.КлючСтроки);
	СтруктураДанных.Вставить("Н",              ТекущиеДанные.Н);
	СтруктураДанных.Вставить("ДатаИсполнения", ТекущиеДанные.ДатаИсполнения);
	СтруктураДанных.Вставить("Примечание",     ТекущиеДанные.Примечание);
	
	РезультатЗаписи = ПринудительноЗаписатьВБазу(СтруктураДанных);
	
	Если РезультатЗаписи Тогда
		ПоказатьОповещениеПользователя("Сохранено", 
			ПолучитьНавигационнуюСсылку(СсылкаНаДоговор), 
			"Данные в справочнике обновлены");
//	ПоказатьОповещениеПользователя("✓", , "Сохранено", БиблиотекаКартинок.Информация);

		// Обновляем таблицу анализа после изменения
//		ОбновитьТаблицуАнализаПослеИзмененияДанных();
// Обновляем только таблицу анализа, без перезагрузки дерева
ОбновитьТаблицуАнализаБезПерезагрузкиДерева();
// Восстанавливаем позицию прокрутки
ВосстановитьПозициюПрокрутки();

	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьТаблицуАнализаБезПерезагрузкиДерева()
	
	// Сохраняем текущий выбор сотрудников
	СохраненныйВыбор = СохранитьВыборСотрудников();
	
	// Обновляем только таблицу анализа
	ОбновитьТолькоТаблицуАнализа();
	
	// Восстанавливаем выбор сотрудников
	ВосстановитьВыборСотрудников(СохраненныйВыбор);
	
	// Обновляем список сотрудников
	ОбновитьСписокПоТаблицеАнализа();
	
// Обновляем индикаторы //////////////////////////////////////////
	ОбновитьИндикаторы();
 	
//--------------------------------------------------------------------------
ОтсортироватьИОтфильтроватьТаблицуАнализа();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПозициюПрокрутки()
	
	Попытка
		// Сохраняем позицию прокрутки дерева
		СохраненнаяПозиция = Элементы.ДетализацияДоговоров.ВертикальнаяПрокрутка.Позиция;
	Исключение
		СохраненнаяПозиция = 0;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьПозициюПрокрутки()
	
	Попытка
		Элементы.ДетализацияДоговоров.ВертикальнаяПрокрутка.Позиция = СохраненнаяПозиция;
	Исключение
		// Игнорируем ошибки
	КонецПопытки;
	
КонецПроцедуры









///////////////////////////////////////////////////////////////////////
// СохранитьСостояниеДерева до ввода значений реквизитов ДатаИсполнения/Н/Примечание
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура СохранитьСостояниеДерева()
	
	// Создаем массив для хранения идентификаторов развернутых строк
	РазвернутыеСтроки = Новый Массив;
	
	// Получаем все строки верхнего уровня
	ВерхниеСтроки = ТаблицаДетализация.ПолучитьЭлементы();
	
	// Собираем все строки (они все будут развернуты)
	СобратьВсеСтроки(ВерхниеСтроки, РазвернутыеСтроки);
	
	// Сохраняем в реквизит формы
	РазвернутыеСтрокиДерева = РазвернутыеСтроки;
	
КонецПроцедуры

&НаКлиенте
Процедура СобратьВсеСтроки(СтрокиДерева, ВсеСтроки)
	
	Для Каждого Стр Из СтрокиДерева Цикл
		
		// Добавляем текущую строку
		ВсеСтроки.Добавить(Стр.ПолучитьИдентификатор());
		
		// Рекурсивно обрабатываем подчиненные строки
		Подчиненные = Стр.ПолучитьЭлементы();
		Если Подчиненные.Количество() > 0 Тогда
			СобратьВсеСтроки(Подчиненные, ВсеСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьСостояниеДерева()
	
	Если РазвернутыеСтрокиДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Устанавливаем флаг программного раскрытия
	ПрограммноеРаскрытие = Истина;
	
	// Разворачиваем все сохраненные строки
	Для Каждого Ид Из РазвернутыеСтрокиДерева Цикл
		Попытка
			// Используем существующий метод Развернуть
			Элементы.ДетализацияДоговоров.Развернуть(Ид, Ложь);
		Исключение
			// Игнорируем ошибки
		КонецПопытки;
	КонецЦикла;
	
	// Сбрасываем флаг программного раскрытия
	ПрограммноеРаскрытие = Ложь;
	
КонецПроцедуры



///////////////////////////////////////////////////////////////////////
// НАВИГАЦИЯ Переход к ТЧ + сторка // Не работает
///////////////////////////////////////////////////////////////////////

// Переход к ТЧ + сторка (строка не работает)
&НаКлиенте
Процедура ТаблицаДетализацияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;

	СтандартнаяОбработка = Ложь; // Отключаем стандартное открытие 1С

	// 1. Определяем Имя ТЧ и КлючСтроки
	ИмяТЧ = "";
	КлючСтрокиПоиска = ТекущиеДанные.КлючСтроки; // Берем ID из текущей строки

	// Поднимаемся по дереву, чтобы определить, к какой ТЧ относится строка
	ПроверяемаяСтрока = ТекущиеДанные;
	Пока ПроверяемаяСтрока <> Неопределено Цикл
		ТекстТипа = ВРег(СокрЛП(Строка(ПроверяемаяСтрока.ТипЗаписи)));
		Если Найти(ТекстТипа, "РАСПОРЯЖЕНИЕ") > 0 Тогда
			ИмяТЧ = "Распоряжение"; Прервать;
		ИначеЕсли Найти(ТекстТипа, "ПЛАН") > 0 Или Найти(ТекстТипа, "ГРАФИК") > 0 Тогда
			ИмяТЧ = "ПланГрафик"; Прервать;
		КонецЕсли;
		ПроверяемаяСтрока = ПроверяемаяСтрока.ПолучитьРодителя();
	КонецЦикла;

	// 2. Ищем ссылку на Договор (самый верхний уровень)
	СсылкаДоговора = Неопределено;
	ПроверяемаяСтрока = ТекущиеДанные;
	Пока ПроверяемаяСтрока <> Неопределено Цикл
		Если ЗначениеЗаполнено(ПроверяемаяСтрока.Договор) Тогда
			СсылкаДоговора = ПроверяемаяСтрока.Договор; Прервать;
		КонецЕсли;
		ПроверяемаяСтрока = ПроверяемаяСтрока.ПолучитьРодителя();
	КонецЦикла;

	// 3. Открываем форму с расширенными параметрами
	Если ЗначениеЗаполнено(СсылкаДоговора) Тогда
		Пар = Новый Структура;
		Пар.Вставить("Ключ", СсылкаДоговора);
		
		Если ЗначениеЗаполнено(ИмяТЧ) Тогда
			Пар.Вставить("ИмяActiveТЧ", ИмяТЧ);
		КонецЕсли;
		
		// Передаем Уникальный Идентификатор для позиционирования
		Если ЗначениеЗаполнено(КлючСтрокиПоиска) Тогда
			Пар.Вставить("КлючСтрокиДляПерехода", КлючСтрокиПоиска);
		КонецЕсли;
		
		ОткрытьФорму("Справочник.Договора.ФормаОбъекта", Пар, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

// (Общая форма - ОтчетИД) обработчик события ОбработкаОповещения   // Обновление в ОтчетеИД количества задач Справочника Договора ///////////////
///////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////
 &НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
    Если ИмяСобытия = "ЗаписанДоговор" Тогда
        // Если отчет открыт, он сам пересчитает цифры
        	
	ОбновитьДанныеПоВыборуТаблиц();
	///////////////////////////////////////////////////////////////////////;
        
        // Если в детализации был выбран сотрудник, обновляем и его дерево
        ДанныеАнализа = Элементы.ТаблицаАнализа.ТекущиеДанные;
        Если ДанныеАнализа <> Неопределено Тогда
            ЗаполнитьДетализациюНаСервере(ДанныеАнализа.Сотрудник);
            // Разворачиваем дерево заново
            Для Каждого Стр Из ТаблицаДетализация.ПолучитьЭлементы() Цикл
                Элементы.ДетализацияДоговоров.Развернуть(Стр.ПолучитьИдентификатор(), Ложь); 
            КонецЦикла;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры
