///////////////////////////////////////////////////////////////////////
// Обновленная процедура ОбновитьДетализациюПоВыбранным
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ОбновитьДетализациюПоВыбранным()
	
	СписокСотрудников = Новый Массив;
	
	// Собираем всех отмеченных галочкой сотрудников
	Для Каждого Стр Из ТаблицаАнализа Цикл
		Если Стр.Выбран Тогда
			СписокСотрудников.Добавить(Стр.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	
	// Обновляем дерево договоров (ДетализацияДоговоров) // Передаем массив на сервер для перестроения дерева
	ЗаполнитьДетализациюНаСервере(СписокСотрудников);
	
	// Обновляем таблицы документов // Заполнение таблиц документов
	ЗаполнитьДетализациюДокументовНаСервере(СписокСотрудников);
	
	// Обновляем таблицы распоряжений // Заполнение таблиц распоряжений
	ЗаполнитьДетализациюРаспоряженийНаСервере(СписокСотрудников);
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////
// Модифицируем обработчик выбора в таблице анализа
///////////////////////////////////////////////////////////////////////













&НаКлиенте
Процедура ОбновитьТаблицуАнализаПоСписку()
	
	Если ВыбранныеИсполнители = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Создаем соответствие выбранных ссылок
	ВыбранныеСсылки = Новый Соответствие;
	
	Для Номер = 0 По ВыбранныеИсполнители.Количество() - 1 Цикл
		Если Не ВыбранныеИсполнители[Номер].Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Ссылка = ВыбранныеИсполнители[Номер].Значение;
		
		// Пропускаем опцию "Все"
		Если Ссылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ВыбранныеСсылки.Вставить(Ссылка, Истина);
	КонецЦикла;
	
	// Обновляем таблицу анализа
	Для Каждого Стр Из ТаблицаАнализа Цикл
		Стр.Выбран = (ВыбранныеСсылки.Получить(Стр.Сотрудник) <> Неопределено);
	КонецЦикла;
	
КонецПроцедуры


