// Пузырьковая сортировка массива по полю Процент по убыванию
&НаКлиенте
Процедура ОтсортироватьМассивПоПроценту(МассивДанных)
	Для Индекс = 0 По МассивДанных.Количество() - 2 Цикл
		Для ВнутрИндекс = 0 По МассивДанных.Количество() - 2 - Индекс Цикл
			Если МассивДанных[ВнутрИндекс].Процент < МассивДанных[ВнутрИндекс + 1].Процент Тогда
				Временный                        = МассивДанных[ВнутрИндекс];
				МассивДанных[ВнутрИндекс]        = МассивДанных[ВнутрИндекс + 1];
				МассивДанных[ВнутрИндекс + 1]   = Временный;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Записывает отсортированный массив в ТаблицаАнализа
&НаКлиенте
Процедура ЗаписатьМассивВТаблицуАнализа(МассивДанных)
	ТаблицаАнализа.Очистить();
	Для Каждого Элемент Из МассивДанных Цикл
		НоваяСтрока = ТаблицаАнализа.Добавить();
		СкопироватьСтруктуруВСтроку(НоваяСтрока, Элемент.Строка);
	КонецЦикла;
	Элементы.ТаблицаАнализа.Обновить();
КонецПроцедуры

///////////////////////////////////////////////////////////////////////
// СОРТИРОВКА // ТаблицаАнализа // (вызывается на клиенте после загрузки)
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ОтсортироватьИОтфильтроватьТаблицуАнализа()
	
	// Сохраняем полный набор в реквизит формы
МассивДанных = Новый Массив;	
	
	Для Индекс = 0 По ТаблицаАнализа.Количество() - 1 Цикл
		Строка = ТаблицаАнализа[Индекс];
		
		ОбщееКоличество = 0;
		Попытка
			ОбщееКоличество = Число(Строка.ОбщееКоличество);
		Исключение
			ОбщееКоличество = 0;
		КонецПопытки;
		
		ВсегоН = 0;
		Попытка
			ВсегоН = Число(Строка.ВсегоН);
		Исключение
			ВсегоН = 0;
		КонецПопытки;
		
		// ИСПРАВЛЕНО (баг 2): единое условие ВсегоН > 1 вместо смешанных > 1 / >= 1
		Если ОбщееКоличество > 0 ИЛИ ВсегоН >= 1 Тогда
			
			ПроцентЧисло = 0;
			Попытка
				ПроцентЧисло = Число(Строка.ПроцентНеИсполненноКОбщее);
			Исключение
				ПроцентЧисло = 0;
			КонецПопытки;
			
			// Строки без задач (ОК = 0, но есть Н) сортируем в конец
			ПроцентДляСортировки = ?(ОбщееКоличество = 0, -1, ПроцентЧисло);
			
			МассивДанных.Добавить(Новый Структура("Строка, Процент", СкопироватьСтрокуВСтруктуру(Строка), ПроцентДляСортировки));
		КонецЕсли;
	КонецЦикла;
	
	ОтсортироватьМассивПоПроценту(МассивДанных);
	
	// Сохраняем полный набор в реквизит формы (СписокЗначений)
	МассивВсехДанных.Очистить();
	Для Каждого Эл Из МассивДанных Цикл
		МассивВсехДанных.Добавить(Эл.Строка);
	КонецЦикла;
	
	
	ЗаписатьМассивВТаблицуАнализа(МассивДанных);
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////
// ФИЛЬТР // ТаблицуАнализа // Отображение записей с ОбщееКоличество > 0, ВсегоН > 1, % =|< 100%
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ОтсортироватьТаблицуАнализаНаКлиенте()
	
	// ИСПРАВЛЕНО (баг 1): читаем из сохранённого полного набора, не из уже отфильтрованной таблицы
	Если МассивВсехДанных.Количество() = 0  Тогда
		Возврат;
	КонецЕсли;
	
	МассивДанных = Новый Массив;
	
	Для Индекс = 0 По МассивВсехДанных.Количество() - 1 Цикл
		Строка = МассивВсехДанных[Индекс].Значение;

		ОбщееКоличество = 0;
		Попытка
			ОбщееКоличество = Число(Строка.ОбщееКоличество);
		Исключение
			ОбщееКоличество = 0;
		КонецПопытки;
		
		ВсегоН = 0;
		Попытка
			ВсегоН = Число(Строка.ВсегоН);
		Исключение
			ВсегоН = 0;
		КонецПопытки;
		
		ПроцентЧисло = 0;
		Попытка
			ЗначениеПроцента = Строка.ПроцентНеИсполненноКОбщее;
			Если ТипЗнч(ЗначениеПроцента) = Тип("Строка") Тогда
				ЗначениеПроцента = СтрЗаменить(ЗначениеПроцента, " %", "");
				ЗначениеПроцента = СтрЗаменить(ЗначениеПроцента, "%", "");
				ЗначениеПроцента = СокрЛП(ЗначениеПроцента);
			КонецЕсли;
			ПроцентЧисло = Число(ЗначениеПроцента);
		Исключение
			ПроцентЧисло = 0;
		КонецПопытки;
		
		// Условие фильтрации по проценту: Ложь - не показывать 100%, Истина - показывать все (включая 100%)
		Если ФильтрПоПроценту Тогда
			ВключатьСтроку = Истина;
		Иначе
			ВключатьСтроку = (ПроцентЧисло < 100);
		КонецЕсли;
		
		Если ВключатьСтроку Тогда
			// Строки без задач (ОК = 0, но есть Н) сортируем в конец
			ПроцентДляСортировки = ?(ОбщееКоличество = 0 И ВсегоН >= 1, -1, ПроцентЧисло);
			МассивДанных.Добавить(Новый Структура("Строка, Процент", Строка, ПроцентДляСортировки));
		КонецЕсли;
	КонецЦикла;
	
	ОтсортироватьМассивПоПроценту(МассивДанных);
	ЗаписатьМассивВТаблицуАнализа(МассивДанных);
	
КонецПроцедуры

