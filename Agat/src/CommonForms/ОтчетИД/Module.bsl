	// --- ПРАВИЛО: Светло-зеленый фон для ТаблицаАнализаСотрудник при ПроцентНеИсполненноКОбщее = 100 ---
	ЭлементИсполнитель100 = УсловноеОформление.Элементы.Добавить();
