// 	ЭлементШапка.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина));
	
	// УСЛОВИЕ: НомерРаспоряжения заполнен (не пустая строка)
	ОтборШапка = ЭлементШапка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборШапка.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТаблицаДетализация.НомерРаспоряжения");
	ОтборШапка.ВидСравнения   = ВидСравненияКомпоновкиДанных.Заполнено;
	
