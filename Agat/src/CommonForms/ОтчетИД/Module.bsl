// Выгрузка реквизита справочника Договора: Изделие
///////////////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция НайтиСтрокуТЧДоговора(Договор, НаименованиеРабот)

	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	НайденнаяСтрока = Неопределено;
	Попытка
		КлючПоиска = СокрЛП(НаименованиеРабот);

		Если Договор.Распоряжение.Количество() > 0 Тогда
			Для Каждого СтрТЧ Из Договор.Распоряжение Цикл
				Если СокрЛП(СтрТЧ.НаименованиеРабот) = КлючПоиска Тогда
					НайденнаяСтрока = СтрТЧ;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если НайденнаяСтрока = Неопределено И Договор.ПланГрафик.Количество() > 0 Тогда
			Для Каждого СтрТЧ Из Договор.ПланГрафик Цикл
				Если СокрЛП(СтрТЧ.НаименованиеРабот) = КлючПоиска Тогда
					НайденнаяСтрока = СтрТЧ;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		НайденнаяСтрока = Неопределено;
	КонецПопытки;

	Возврат НайденнаяСтрока;

КонецФункции












