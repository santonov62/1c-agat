///////////////////////////////////////////////////////////////////////

&НаСервере
Функция ПолучитьСписокСотрудниковИзТаблицы()
	
	Список = Новый СписокЗначений;
	
	// Добавляем исполнителей из таблицы анализа (без дубликатов)
	Добавленные = Новый Соответствие;
	
	Для Каждого Стр Из ТаблицаАнализа Цикл
		Если ЗначениеЗаполнено(Стр.Сотрудник) Тогда
			Ссылка = Стр.Сотрудник;
			Ключ = Строка(Ссылка.УникальныйИдентификатор());
			
			Если Добавленные.Получить(Ключ) = Неопределено Тогда
				Добавленные.Вставить(Ключ, Истина);
				
				// По умолчанию все сотрудники выбраны
				Список.Добавить(
					Ссылка,
					Строка(Ссылка),
					Ложь  // // По умолчанию false, клиент установит // Истина - Все выбраны по умолчанию ///////////////////////////////////////////
				);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСписокСотрудниковИзТаблицы()
	
	// Получаем список с сервера
	СписокССервера = ПолучитьСписокСотрудниковИзТаблицы();
	
	// Сохраняем текущий выбор для восстановления
	СохраненныйВыбор = СохранитьВыборСотрудников();
	
	// Создаем новый список
	НовыйСписок = Новый СписокЗначений;
	
	Для Индекс = 0 По СписокССервера.Количество() - 1 Цикл
		Элемент = СписокССервера[Индекс];
		
		// Восстанавливаем выбор если был
		Если Элемент.Значение <> Неопределено Тогда
			Ключ = Строка(Элемент.Значение.УникальныйИдентификатор());
			БылВыбран = СохраненныйВыбор.Получить(Ключ);
			Если БылВыбран <> Неопределено Тогда
				Элемент.Пометка = БылВыбран;  
				
				 Иначе
				// Если нет сохраненного выбора, используем ФлагВсехСотрудников
				Элемент.Пометка = ФлагВсехСотрудников;
				
			КонецЕсли;
		КонецЕсли;
		
		НовыйСписок.Добавить(
			Элемент.Значение, 
			Элемент.Представление, 
			Элемент.Пометка
		);
	КонецЦикла;
	
	// Присваиваем реквизиту
	ВыбранныеСотрудники = НовыйСписок;
	
КонецПроцедуры

// Синхронизация ВыбранныеСотрудники -> ТаблицаАнализа: /////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////
&НаКлиенте
Процедура ВыбранныеСотрудникиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	// Отключаем стандартную обработку
	СтандартнаяОбработка = Ложь;
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Обновляем реквизит выбранными значениями
	ВыбранныеСотрудники = ВыбранноеЗначение;
	
	// Обновляем таблицу анализа в соответствии с выбранными сотрудниками
	ОбновитьТаблицуАнализаПоСпискуСотрудников();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуАнализаПоСпискуСотрудников()
	
	Если ВыбранныеСотрудники = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Создаем соответствие выбранных ссылок
	ВыбранныеСсылки = Новый Соответствие;
	
	Для Номер = 0 По ВыбранныеСотрудники.Количество() - 1 Цикл
		Если Не ВыбранныеСотрудники[Номер].Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Ссылка = ВыбранныеСотрудники[Номер].Значение;
		
		Если Ссылка <> Неопределено Тогда
			ВыбранныеСсылки.Вставить(Ссылка, Истина);
		КонецЕсли;
	КонецЦикла;
	
	// Обновляем таблицу анализа
	Для Каждого Стр Из ТаблицаАнализа Цикл
		Стр.Выбран = (ВыбранныеСсылки.Получить(Стр.Сотрудник) <> Неопределено);
	КонецЦикла;
	
	// Обновляем флаг "Все сотрудники"
	ОбновитьФлагВсехСотрудников();
	
	// Обновляем детализацию
	ОбновитьДетализациюПоВыбранным();
	
КонецПроцедуры






