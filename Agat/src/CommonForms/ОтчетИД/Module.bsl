// Общая процедура подсчета показателей (Всего/НеИсполнено/Н) по справочнику с табличной частью "СоставИсполнителей".
// Если ИспользоватьОтветственногоИсполнителя - считаем по реквизиту ОтветственныйИсполнитель,
// иначе - по каждому сотруднику из табличной части СоставИсполнителей.
&НаСервере
Процедура СобратьДанныеИзСправочникаСИсполнителями(ПоСотрудникам, ПарамДатаС, ПарамДатаПо, ПустаяДата, ИмяСправочника, ПрефиксПоказателя)
	
	УсловиеПоН = ПолучитьУсловиеФильтраПоН("Спр");
	
	Если ИспользоватьОтветственногоИсполнителя Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Спр.ОтветственныйИсполнитель КАК Сотрудник,
		|	Спр.СрокИсполнения КАК Срок,
		|	Спр.ДатаИсполнения КАК ДатаИсп,
		|	Спр.Н КАК Н
		|ИЗ Справочник." + ИмяСправочника + " КАК Спр
		|ГДЕ Спр.ОтветственныйИсполнитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|	И (Спр.СрокИсполнения МЕЖДУ &ДатаС И &ДатаПо
		|		ИЛИ Спр.ДатаИсполнения МЕЖДУ &ДатаС И &ДатаПо
		|		ИЛИ (Спр.ДатаИсполнения = &ПустаяДата
		|			И Спр.СрокИсполнения <= &ДатаПо))
		|	" + УсловиеПоН;
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Состав.Исполнитель КАК Сотрудник,
		|	Спр.СрокИсполнения КАК Срок,
		|	Спр.ДатаИсполнения КАК ДатаИсп,
		|	Спр.Н КАК Н
		|ИЗ Справочник." + ИмяСправочника + " КАК Спр
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник." + ИмяСправочника + ".СоставИсполнителей КАК Состав
		|	ПО Спр.Ссылка = Состав.Ссылка
		|ГДЕ Состав.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|	И (Спр.СрокИсполнения МЕЖДУ &ДатаС И &ДатаПо
		|		ИЛИ Спр.ДатаИсполнения МЕЖДУ &ДатаС И &ДатаПо
		|		ИЛИ (Спр.ДатаИсполнения = &ПустаяДата
		|			И Спр.СрокИсполнения <= &ДатаПо))
		|	" + УсловиеПоН;
	КонецЕсли;
	
	Если ФильтрТолькоКонтроль Тогда
		ТекстЗапроса = ТекстЗапроса + " И Спр.Контроль = ИСТИНА";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаС",      ПарамДатаС);
	Запрос.УстановитьПараметр("ДатаПо",     ПарамДатаПо);
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);
	
	ИмяН           = ПрефиксПоказателя + "Н";
	ИмяВсего       = ПрефиксПоказателя + "Всего";
	ИмяНеИсполнено = ПрефиксПоказателя + "НеИсполнено";
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДанныеСотрудника = ПолучитьДанныеСотрудника(ПоСотрудникам, Выборка.Сотрудник);
			Если Выборка.Н > 0 Тогда
				Если Выборка.ДатаИсп = ПустаяДата И Выборка.Срок <= ПарамДатаПо Тогда
					ДанныеСотрудника[ИмяН] = ДанныеСотрудника[ИмяН] + 1;
				КонецЕсли;
			Иначе
				Если Выборка.Срок <= ПарамДатаПо Тогда
					ДанныеСотрудника[ИмяВсего] = ДанныеСотрудника[ИмяВсего] + 1;
				КонецЕсли;
				Если Выборка.ДатаИсп = ПустаяДата И Выборка.Срок <= ПарамДатаПо Тогда
					ДанныеСотрудника[ИмяНеИсполнено] = ДанныеСотрудника[ИмяНеИсполнено] + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Ошибка при загрузке " + ИмяСправочника + ": " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

