&НаКлиенте
Функция ПолучитьСписокТаблицАнализа()
    Массив = Новый Массив;
    Массив.Добавить("Договора");
    Массив.Добавить("РаспоряженияГД");
    Массив.Добавить("РаспоряженияТД");
    Массив.Добавить("ВнутренниеДокументы");
    Массив.Добавить("ВходящиеДокументы");
    Массив.Добавить("ИсходящиеДокументы");
    Возврат Массив;
КонецФункции

&НаКлиенте
Процедура НакопитьПоказателиТаблицы(Результат, Стр, Таблица)

    // Для "Договора" исходные имена полей строки таблицы анализа отличаются от шаблона "Таблица"+"Суффикс"
    Если Таблица = "Договора" Тогда
        ПолеВсего = "ВсегоДоговора";
        ПолеНеИсполнено = "ВсегоДоговораНеИсполнено";
    Иначе
        ПолеВсего = Таблица + "Всего";
        ПолеНеИсполнено = Таблица + "НеИсполнено";
    КонецЕсли;
    ПолеН = Таблица + "Н";

    Результат[Таблица + "Всего"] = Результат[Таблица + "Всего"] + Стр[ПолеВсего];
    Результат[Таблица + "НеИсполнено"] = Результат[Таблица + "НеИсполнено"] + Стр[ПолеНеИсполнено];
    Результат[Таблица + "Н"] = Результат[Таблица + "Н"] + Стр[ПолеН];

КонецПроцедуры

///////////////////////////////////////////////////////////////////////
// Функция получения данных из ТаблицаАнализа для индикаторов % (процентов)
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Функция ПолучитьДанныеДляИндикаторов()

    МассивТаблиц = ПолучитьСписокТаблицАнализа();

    Данные = Новый Структура;

    // Инициализация
    Данные.Вставить("ОбщееКоличество", 0);
    Данные.Вставить("НеИсполнено", 0);
    Данные.Вставить("ВсегоН", 0);
    Данные.Вставить("ПроцентОбщий", 0);

    Для Каждого Таблица Из МассивТаблиц Цикл
        Данные.Вставить(Таблица + "Всего", 0);
        Данные.Вставить(Таблица + "НеИсполнено", 0);
        Данные.Вставить(Таблица + "Н", 0);
        Данные.Вставить(Таблица + "Процент", 0);
    КонецЦикла;

       // Суммируем по выбранным строкам ТаблицаАнализа
    Для Каждого Стр Из ТаблицаАнализа Цикл

        Если Стр.Выбран Тогда

            Если Стр.ОбщееКоличество > 0 Тогда
                // Штатный случай: накапливаем все показатели
                Данные.ОбщееКоличество = Данные.ОбщееКоличество + Стр.ОбщееКоличество;
                Данные.НеИсполнено = Данные.НеИсполнено + Стр.НеИсполнено;
                Данные.ВсегоН = Данные.ВсегоН + Стр.ВсегоН;
                Для Каждого Таблица Из МассивТаблиц Цикл
                    НакопитьПоказателиТаблицы(Данные, Стр, Таблица);
                КонецЦикла;

            ИначеЕсли Стр.ВсегоН > 0 Тогда
                // ОбщееКоличество = 0, но есть Н — накапливаем ВсегоН и Н по таблицам
                Данные.ВсегоН = Данные.ВсегоН + Стр.ВсегоН;
                Для Каждого Таблица Из МассивТаблиц Цикл
                    НакопитьПоказателиТаблицы(Данные, Стр, Таблица);
                КонецЦикла;

            КонецЕсли;

        КонецЕсли;
	КонецЦикла;
	
    // Рассчитываем проценты
    Если Данные.ОбщееКоличество > 0 Тогда
        Выполнено = Данные.ОбщееКоличество - Данные.НеИсполнено;
        Данные.ПроцентОбщий = (Выполнено / Данные.ОбщееКоличество) * 100;
    КонецЕсли;

    Для Каждого Таблица Из МассивТаблиц Цикл
        Если Данные[Таблица + "Всего"] > 0 Тогда
            Выполнено = Данные[Таблица + "Всего"] - Данные[Таблица + "НеИсполнено"];
            Данные[Таблица + "Процент"] = (Выполнено / Данные[Таблица + "Всего"]) * 100;
        КонецЕсли;
    КонецЦикла;

    Возврат Данные;

КонецФункции

