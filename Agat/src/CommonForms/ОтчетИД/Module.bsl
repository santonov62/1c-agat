&НаКлиенте
Процедура ВыгрузитьВсеВСЗ(Команда)

	МассивСотрудников = ПолучитьМассивВыбранныхСотрудников();
	
	Если МассивСотрудников.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбран ни один исполнитель — отметьте галочкой строку в таблице анализа.");
		Возврат;
	КонецЕсли;
		ДвоичныеДанные = СформироватьФайлВыгрузкиВсегоНаСервере(МассивСотрудников);
		
		
	Если ДвоичныеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Нет записей за указанный период, либо не удалось определить текущего сотрудника.");
		Возврат;
	КонецЕсли;

	ДиалогФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогФайла.Фильтр         = "Excel файл (*.xlsx)|*.xlsx";
	ДиалогФайла.ПолноеИмяФайла = "Отчет_" + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ".xlsx";
	Если Не ДиалогФайла.Выбрать() Тогда Возврат; КонецЕсли;

	ДвоичныеДанные.Записать(ДиалогФайла.ПолноеИмяФайла);
	ЗапуститьПриложение(ДиалогФайла.ПолноеИмяФайла);

КонецПроцедуры
