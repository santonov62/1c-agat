//	ДатаС = Дата('00010101'); // Пустая дата

	// Фильтр по контролю по умолчанию включен
	ФильтрТолькоКонтроль = Истина;
	
	// Флаг "Выбраны все таблицы" по умолчанию включен
	ВыбраныВсеТаблицы = Истина; 
	// Устанавливаем начальные значения (все таблицы включены)
	ИспользоватьДоговора = Истина;
	ИспользоватьРаспоряженияГД = Истина;
	ИспользоватьРаспоряженияТД = Истина;
	ИспользоватьВнутренниеДокументы = Истина;
	ИспользоватьИсходящиеДокументы = Истина;
	ИспользоватьВходящиеДокументы = Истина;
	
	// Отображать только с не заполненной датой исполнения
	ЗаписиОтображениеСостав = Истина;
	
	// Флаг "Все сотрудники" по умолчанию снят
	ФлагВсехСотрудников = Ложь;

	// Обновляем соответствующие элементы
	Попытка Элементы.ВыбраныВсеТаблицы.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ЗаписиОтображениеСостав.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ФлагВсехСотрудников.Обновить(); Исключение КонецПопытки;
	
КонецПроцедуры                   

// ПРИНУДИТЕЛЬНО УСТАНАВЛИВАЕМ ВЫБОР ВСЕХ СОТРУДНИКОВ
/////////////////////////////////////////////////////////////////////
