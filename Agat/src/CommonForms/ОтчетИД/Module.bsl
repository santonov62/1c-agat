// КомандаПереключитьРежимРасчета // Исполнитель(соисполнитель) / Ответственный исполнитель // ОТКЛЮЧЕНА (только "Ответственный исполнитель")
////////////////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура КомандаПереключитьРежимРасчета(Команда)
    
    // --------------------------------------------------------------
    // 1. ПЕРЕКЛЮЧАЕМ РЕЖИМ
    // --------------------------------------------------------------
     ИспользоватьОтветственногоИсполнителя = Не ИспользоватьОтветственногоИсполнителя;
    
    // --------------------------------------------------------------
    // 2. МЕНЯЕМ КАРТИНКУ КНОПКИ И ПОДСКАЗКУ
    // --------------------------------------------------------------
    Попытка
        Если ИспользоватьОтветственногоИсполнителя Тогда
            // Режим "Ответственный исполнитель" - картинка 6
            Элементы.ПереключитьРежимРасчета.Картинка = БиблиотекаКартинок.картинка_6;
        Иначе
            // Режим "Исполнители" - картинка 5
            Элементы.ПереключитьРежимРасчета.Картинка = БиблиотекаКартинок.картинка_5;
        КонецЕсли;
    Исключение
        Сообщить("Ошибка при смене картинки: " + ОписаниеОшибки());
    КонецПопытки;
    
    // --------------------------------------------------------------
    // 3. СОХРАНЯЕМ ТЕКУЩЕЕ СОСТОЯНИЕ
    // --------------------------------------------------------------
    СохраненныйВыбор = СохранитьВыборСотрудников();
    СохранитьСостояниеДерева();
    
    // --------------------------------------------------------------
    // 4. ОБНОВЛЯЕМ ДАННЫЕ С НОВЫМ РЕЖИМОМ
    // --------------------------------------------------------------
    ОбновитьДанныеНаСервере();

    // Пересобираем кеш МассивВсехДанных и применяем фильтр по % к актуальным данным
    ОтсортироватьИОтфильтроватьТаблицуАнализа();
    ОтсортироватьТаблицуАнализаНаКлиенте();

    // --------------------------------------------------------------
    // 5. ВОССТАНАВЛИВАЕМ СОСТОЯНИЕ
    // --------------------------------------------------------------
    ВосстановитьВыборСотрудников(СохраненныйВыбор);
    ОбновитьСписокПоТаблицеАнализа();
    ОбновитьДетализациюДоговоровПоТекущемуВыбору();
    ОбновитьОтображениеТаблиц();
    ОбновитьИндикаторы();
    ЗаполнитьДиаграммуИтогов();
    ВосстановитьСостояниеДерева();
    
    // --------------------------------------------------------------
    // 6. ДИАГНОСТИКА
    // --------------------------------------------------------------
//    Сообщить("Режим расчета изменен на: " + ?(ИспользоватьОтветственногоИсполнителя, 
 //            "Ответственный исполнитель", "Исполнители (из ТЧ)"));
    
КонецПроцедуры

