&НаСервереБезКонтекста
Функция ПолучитьСписокТаблицДляВыбора()
	
	Список = Новый СписокЗначений;
	
	// Добавляем опцию "Выбрать все"
	Список.Добавить("Все", "✓ Выбрать все");
	
	// Добавляем все таблицы
	Список.Добавить("Договора", "Договора");
	Список.Добавить("РаспоряженияГД", "Распоряжения ГД");
	Список.Добавить("РаспоряженияТД", "Распоряжения ТД");
	Список.Добавить("ВнутренниеДокументы", "Внутренние документы");
	Список.Добавить("ВходящиеДокументы", "Входящие документы");
	Список.Добавить("ИсходящиеДокументы", "Исходящие документы");
	
	Возврат Список;
	
КонецФункции




   







