//КнопкаПереключитьВид
&НаКлиенте
Процедура ОбновитьОтображениеПоРежиму()
	
	
	// --------------------------------------------------------------
    // 1. ПРОВЕРКА ТЕКУЩЕГО СОСТОЯНИЯ КНОПОК
    // --------------------------------------------------------------
    // Сохраняем текущие значения для диагностики
    ТекущийРежимПанелей = Не РежимПанелей;
    ТекущийРежимОтображения = РежимОтображения; 
	
	/////////////////////////////////////////////////////////////////////////////////////
//	    Сообщить(">>> ОбновитьОтображениеПоРежиму: РежимПанелей=" + ТекущийРежимПанелей + 
//             ", РежимОтображения=" + ТекущийРежимОтображения);
	/////////////////////////////////////////////////////////////////////////////////////
	
	// --------------------------------------------------------------
	// 1. УПРАВЛЕНИЕ ВИДИМОСТЬЮ ГРУПП
	// --------------------------------------------------------------
Если Не РежимПанелей Тогда
	// Мы в режиме основных панелей, применяем логику РежимОтображения
	
	Если РежимОтображения = 1 Тогда
		// Режим 1: ГруппаОтчет видна, Критерии скрыта
		Элементы.НастройкиОтчета.Видимость = Истина;
		Элементы.ГруппаОтчет.Видимость = Истина;
		Элементы.Критерии.Видимость = Ложь;
		Элементы.ШкалаТЧ.Видимость = Ложь; 
		Иначе
		// Режим 2: ГруппаОтчет скрыта, Критерии видна
		Элементы.ГруппаОтчет.Видимость = Ложь;
		Элементы.НастройкиОтчета.Видимость = Истина;
		Элементы.Критерии.Видимость = Истина;
		Элементы.ШкалаТЧ.Видимость = Ложь;
	КонецЕсли;

// В режиме основных панелей ШкалаТЧ всегда скрыта
		Элементы.ШкалаТЧ.Видимость = Ложь;
	Иначе
		// Мы в режиме шкал - здесь видимость управляется процедурой ОбновитьВидимостьПанелей
		// В этой процедуре ничего не меняем
КонецЕсли;
	
	// --------------------------------------------------------------
	// 2. СМЕНА КАРТИНКИ КНОПКИ
	// --------------------------------------------------------------
	Попытка
		Если РежимОтображения = 1 Тогда
			// Для режима 1 показываем картинку ОтчетИД_1  / Измерение
			Элементы.КнопкаПереключитьВид.Картинка = БиблиотекаКартинок.Шестеренка_4;
		Иначе
			// Для режима 2 показываем картинку ОтчетИД_2
			Элементы.КнопкаПереключитьВид.Картинка = БиблиотекаКартинок.ОтчетИД_2;
		КонецЕсли;
	Исключение
		// Если картинки не найдены, игнорируем
	КонецПопытки;
	
	// --------------------------------------------------------------
	// 3. ДИАГНОСТИКА (можно удалить после отладки)
	// --------------------------------------------------------------
//	Сообщить("Режим отображения: " + РежимОтображения + 
//	         ", ГруппаОтчет: " + Элементы.ГруппаОтчет.Видимость + 
//	         ", Критерии: " + Элементы.Критерии.Видимость);
	
КонецПроцедуры
