///////////////////////////////////////////////////////////////////////
// СЕРВЕРНАЯ ФУНКЦИЯ ЗАПИСИ ИЗМЕНЕНИЙ В СПРАВОЧНИК  // Распоряжения ГД / Распоряжения ТД
///////////////////////////////////////////////////////////////////////

&НаСервере
Функция ЗаписатьИзмененияРаспоряженияВБазу(Данные)
	
	// 1. Проверка распоряжения
	Если Не ЗначениеЗаполнено(Данные.Распоряжение) Тогда
		Сообщить("Диагностика: В строке не заполнена ссылка на распоряжение!");
		Возврат Ложь;
	КонецЕсли;

	// 2. Получаем объект справочника
	ОбъектСправочника = Данные.Распоряжение.ПолучитьОбъект();
	Если ОбъектСправочника = Неопределено Тогда 
		Сообщить("Диагностика: Не удалось получить объект справочника!");
		Возврат Ложь; 
	КонецЕсли;

	// 3. Записываем изменения (только редактируемые реквизиты)
	БылиИзменения = Ложь;
	
	Если ОбъектСправочника.Н <> Данные.Н Тогда                                   // ДОБАВЛЕНО
		ОбъектСправочника.Н = Данные.Н;
		БылиИзменения = Истина;
	КонецЕсли;
	
	Если ОбъектСправочника.ДатаИсполнения <> Данные.ДатаИсполнения Тогда
		ОбъектСправочника.ДатаИсполнения = Данные.ДатаИсполнения;
		БылиИзменения = Истина;
	КонецЕсли;
	
	Если ОбъектСправочника.Примечание <> Данные.Примечание Тогда
		ОбъектСправочника.Примечание = Данные.Примечание;
		БылиИзменения = Истина;
	КонецЕсли;
	
	Если ОбъектСправочника.РеквизитыДокументаПодтверждающегоИсполнение <> Данные.РеквизитыДокументаПодтверждающегоИсполнение Тогда
		ОбъектСправочника.РеквизитыДокументаПодтверждающегоИсполнение = Данные.РеквизитыДокументаПодтверждающегоИсполнение;
		БылиИзменения = Истина;
	КонецЕсли;

	// 4. Результат
	Если БылиИзменения Тогда
		Попытка
			ОбъектСправочника.ОбменДанными.Загрузка = Истина; 
			ОбъектСправочника.Записать();
			
			// Обновляем данные в таблице формы
			ОбновитьДанныеРаспоряженияВФорме(Данные.Распоряжение, Данные.ТипРаспоряжения);
			
			Возврат Истина; 
		Исключение
			Сообщить("Ошибка записи: " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	Иначе
		// Изменений не было
		Возврат Истина;
	КонецЕсли;

КонецФункции

///////////////////////////////////////////////////////////////////////
// ОБНОВЛЕНИЕ ДАННЫХ В ТАБЛИЦАХ ФОРМЫ  // Распоряжения ГД / Распоряжения ТД
///////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ОбновитьДанныеРаспоряженияВФорме(СсылкаНаРаспоряжение, ТипРаспоряжения)
	
	Если Не ЗначениеЗаполнено(СсылкаНаРаспоряжение) Тогда
		Возврат;
	КонецЕсли;
	
	// Определяем, какую таблицу обновлять
	Если ТипРаспоряжения = "ГД" Тогда
		ТаблицаДляОбновления = ТаблицаРаспоряженияГД;
	ИначеЕсли ТипРаспоряжения = "ТД" Тогда
		ТаблицаДляОбновления = ТаблицаРаспоряженияТД;
	Иначе
		Возврат;
	КонецЕсли;
	
	// Ищем строку с этой ссылкой и обновляем данные
	Для Каждого Строка Из ТаблицаДляОбновления Цикл
		Если Строка.Ссылка = СсылкаНаРаспоряжение Тогда
			// Получаем актуальные данные из справочника
			ОбъектСпр = СсылкаНаРаспоряжение.ПолучитьОбъект();
			Если ОбъектСпр <> Неопределено Тогда
				Строка.Н = ОбъектСпр.Н;                                         
				Строка.ДатаИсполнения = ОбъектСпр.ДатаИсполнения;
				Строка.Примечание = ОбъектСпр.Примечание;
				Строка.РеквизитыДокументаПодтверждающегоИсполнение = ОбъектСпр.РеквизитыДокументаПодтверждающегоИсполнение;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

