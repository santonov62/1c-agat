///////////////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура СобратьЛистьяДереваРекурсивно(КоллекцияЭлементов, Результат, ТекНомерРасп, ТекДоговор, ТекТипЗаписи)

	Для Каждого Стр Из КоллекцияЭлементов Цикл
		НовНомерРасп = ТекНомерРасп;
		НовДоговор   = ТекДоговор;
		НовТипЗаписи = ТекТипЗаписи;
		
		Попытка Если НЕ ПустаяСтрока(Стр.НомерРаспоряжения) Тогда НовНомерРасп = Стр.НомерРаспоряжения; КонецЕсли; Исключение КонецПопытки;
		Попытка Если ЗначениеЗаполнено(Стр.Договор)          Тогда НовДоговор   = Стр.Договор;           КонецЕсли; Исключение КонецПопытки;
		Попытка Если НЕ ПустаяСтрока(Стр.ТипЗаписи)          Тогда НовТипЗаписи = Стр.ТипЗаписи;         КонецЕсли; Исключение КонецПопытки;
		
		ЕстьФлаг = Ложь;
		Попытка ЕстьФлаг = (Стр.ВыгрузкаСЗ = Истина); Исключение КонецПопытки;
		Если ЕстьФлаг Тогда
			Лист = Новый Структура("НомерРаспоряжения, Договор, ТипЗаписи, НаименованиеРабот, СрокИсполнения, ДатаИсполнения, Примечание ",
				НовНомерРасп, НовДоговор, НовТипЗаписи, "", Дата(1,1,1), Дата(1,1,1), "");
			Попытка Лист.НаименованиеРабот = Стр.НаименованиеРабот; Исключение КонецПопытки;
			Попытка Лист.СрокИсполнения    = Стр.СрокИсполнения;    Исключение КонецПопытки;
			Попытка Лист.ДатаИсполнения    = Стр.ДатаИсполнения;    Исключение КонецПопытки;
			Попытка Лист.Примечание        = Стр.Примечание;        Исключение КонецПопытки;
			Результат.Добавить(Лист);
		КонецЕсли;
		ДочерниеЭлементы = Стр.ПолучитьЭлементы();
		Если ДочерниеЭлементы.Количество() > 0 Тогда
			СобратьЛистьяДереваРекурсивно(ДочерниеЭлементы, Результат, НовНомерРасп, НовДоговор, НовТипЗаписи);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СформироватьСтрокиДерева(ЛистьяМассив)

	МассивДанных  = Новый Массив;
	ПредНомерРасп = "";
	ПредТипЗаписи = "";

	Для Каждого Лист Из ЛистьяМассив Цикл
		НовНомерРасп = Лист.НомерРаспоряжения;
		НомерНов     = (НовНомерРасп <> ПредНомерРасп);
		НовТипЗаписи = Лист.ТипЗаписи;

		Если НомерНов Тогда
			Стр = НоваяСтрокаВыгрузки("НомерРасп");
			Стр.НомерДокумента = НовНомерРасп;
			Стр.Наименование   = Строка(Лист.Договор);			
//////////////////////////			
			Попытка Стр.ДатаДокумента = Лист.Договор.РаспоряжениеДата; Исключение КонецПопытки; //////////////////////////
			Попытка Стр.СрокИсполнения = Лист.Договор.СрокИсполнения;   Исключение КонецПопытки;  //////////////////////////
//////////////////////////			
			МассивДанных.Добавить(Стр);
			ПредНомерРасп = НовНомерРасп;
			ПредТипЗаписи = "";		
		КонецЕсли;

		Если НЕ ПустаяСтрока(НовТипЗаписи) И НовТипЗаписи <> ПредТипЗаписи Тогда
			Стр = НоваяСтрокаВыгрузки("ТипЗаписи");
			Стр.Наименование = НовТипЗаписи;		
			
			МассивДанных.Добавить(Стр);
			ПредТипЗаписи = НовТипЗаписи;
		КонецЕсли;

		Стр = НоваяСтрокаВыгрузки("Данные");
		Стр.Наименование   = Лист.НаименованиеРабот;
		Стр.СрокИсполнения = Лист.СрокИсполнения;
		Стр.ДатаИсполнения = Лист.ДатаИсполнения;
		Стр.Примечание     = Лист.Примечание;  
		
//		Стр.Исполнитель    = ПолучитьИсполнителейДоговора(Лист.Договор, Лист.НаименованиеРабот); 
		
		НайденнаяСтрокаТЧ = НайтиСтрокуТЧДоговора(Лист.Договор, Лист.НаименованиеРабот);
		Если НайденнаяСтрокаТЧ <> Неопределено Тогда
			Попытка
				Если ЗначениеЗаполнено(НайденнаяСтрокаТЧ.Исполнитель) Тогда
					Стр.Исполнитель = Строка(НайденнаяСтрокаТЧ.Исполнитель);
				КонецЕсли;
			Исключение КонецПопытки;
			Попытка Стр.Изделие = Строка(НайденнаяСтрокаТЧ.Изделие); Исключение КонецПопытки;
			Попытка
				Если НайденнаяСтрокаТЧ.Н = Истина Тогда
					Стр.Исключен = "Исключен";
				КонецЕсли;
			Исключение КонецПопытки;
		КонецЕсли;		
		
		
		
		МассивДанных.Добавить(Стр);
	КонецЦикла;

	Возврат МассивДанных;

КонецФункции

