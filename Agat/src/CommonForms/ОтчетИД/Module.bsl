///////////////////////////////////////////////////////////////////////
// Серверная процедура с учетом выбранных таблиц
///////////////////////////////////////////////////////////////////////

// Накопление показателей (Всего/НеИсполнено/Н) для одного сотрудника по одной строке данных таблицы анализа
&НаСервере
Процедура НакопитьПоказательСотрудника(ДанныеСотрудника, Стр, ПарамДатаПо, ПустаяДата, ПрефиксПоказателя)
	
	Если Стр.Н > 0 Тогда
		// Для Н важно: неисполненные и срок в периоде
		Если Стр.ДатаИсп = ПустаяДата И (Стр.Срок <= ПарамДатаПо) Тогда
			ДанныеСотрудника[ПрефиксПоказателя + "Н"] = ДанныеСотрудника[ПрефиксПоказателя + "Н"] + 1;
		КонецЕсли;
	Иначе
		Если Стр.Срок <= ПарамДатаПо Тогда
			// Всего: если срок или дата исполнения в периоде
			ДанныеСотрудника[ПрефиксПоказателя + "Всего"] = ДанныеСотрудника[ПрефиксПоказателя + "Всего"] + 1;
		КонецЕсли;
		// Неисполнено: срок в периоде И дата пустая
		Если Стр.ДатаИсп = ПустаяДата Тогда
			Если (Стр.Срок <= ПарамДатаПо) Тогда
				ДанныеСотрудника[ПрефиксПоказателя + "НеИсполнено"] = ДанныеСотрудника[ПрефиксПоказателя + "НеИсполнено"] + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ОбновитьДанныеНаСервереСВыборомТаблиц(МассивИменТаблиц)
	
	ТаблицаАнализа.Очистить();
	ТаблицаДетализация.ПолучитьЭлементы().Очистить();
	
	// Подготовка параметров дат
	ПарамДатаС = ?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), '00010101');
	ПарамДатаПо = ?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), '39991231');
	
	// Пустая дата для сравнения
	ПустаяДата = '00010101';
	
	// Если строка пустая - все таблицы исключены
	Если ПустаяСтрока(МассивИменТаблиц) Тогда
		// Создаем пустую таблицу и выходим
		СоздатьПустуюТаблицуАнализа();
		Возврат;
	КонецЕсли;
	
	// Разбираем строку с именами таблиц
	МассивВыбранных = СтрРазделить(МассивИменТаблиц, ",");
	
	// Создаем соответствие для быстрого доступа
	Выбранные = Новый Соответствие;
	Для Каждого Имя Из МассивВыбранных Цикл
		Выбранные.Вставить(Имя, Истина);
	КонецЦикла;
	
	// Создаем соответствие для хранения данных по сотрудникам
	ПоСотрудникам = Новый Соответствие;
	
	// Получаем условие фильтра по Н 
	///////////////////////////////////////////////////////////////////////
	// Получаем условие фильтра по Н для таблицы Распоряжение
	УсловиеПоН_Распоряжение = ПолучитьУсловиеФильтраПоН("Распоряжение");
	// Получаем условие фильтра по Н для таблицы ПланГрафик
	УсловиеПоН_ПланГрафик = ПолучитьУсловиеФильтраПоН("ПланГрафик");
	// Получаем условие фильтра по Н для таблицы Спр
    УсловиеПоН = ПолучитьУсловиеФильтраПоН("Спр");	
	
	
	///////////////////////////////////////////////////////////////////////
	// 1. Сбор данных из таблицы Распоряжение + ПланГрафик справочника Договора
	///////////////////////////////////////////////////////////////////////
	Если Выбранные.Получить("Договора") <> Неопределено Тогда

		Попытка
// Распоряжение
			ЗапросРаспоряжение = Новый Запрос;
			ЗапросРаспоряжение.Текст = 
			"ВЫБРАТЬ
			|	Распоряжение.Исполнитель КАК Сотрудник,
			|	Распоряжение.СрокИсполнения КАК Срок,
			|	Распоряжение.ДатаИсполнения КАК ДатаИсп,
			|	Распоряжение.Н КАК Н
			|ИЗ Справочник.Договора.Распоряжение КАК Распоряжение
			|ГДЕ Распоряжение.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			|	" + УсловиеПоН_Распоряжение;
			
			РезультатРаспоряжение = ЗапросРаспоряжение.Выполнить();
			ТаблицаРаспоряжениеДанные = РезультатРаспоряжение.Выгрузить();
			
			// Обрабатываем данные из Распоряжения
			Для Каждого Стр Из ТаблицаРаспоряжениеДанные Цикл
				Если (Стр.Срок >= ПарамДатаС) И (Стр.Срок <= ПарамДатаПо) 
					ИЛИ (Стр.ДатаИсп >= ПарамДатаС И Стр.ДатаИсп <= ПарамДатаПо) 
					ИЛИ (Стр.Срок >= ПарамДатаС И  Стр.ДатаИсп <= ПарамДатаПо)
					ИЛИ (Стр.ДатаИсп = ПустаяДата)
					
					Тогда
					Сотрудник = Стр.Сотрудник;
					ДанныеСотрудника = ПолучитьДанныеСотрудника(ПоСотрудникам, Сотрудник);
