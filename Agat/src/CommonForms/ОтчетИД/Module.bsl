	ОтборСрок.ПравоеЗначение = НачалоДня(ТекущаяДата());
	
		 // Дополнительное условие, чтобы не красить пустые ячейки (важно!)
		ОтборЗаполнено = ЭлементСрок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
