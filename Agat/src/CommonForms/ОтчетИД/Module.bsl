// ПОИСК // в ТаблицаДетализация // НЕ используется ////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////
&НаКлиенте
Процедура СтрокаПоискаДетализацииПриИзменении(Элемент)
	
	// Настройка отбора в таблице на форме
	Фильтр = Новый Структура;
	Если ЗначениеЗаполнено(СтрокаПоискаДетализации) Тогда
		// используем встроенный механизм поиска платформы для строк
		Элементы.ДетализацияДоговоров.ОтборСтрок = Новый ФиксированнаяСтруктура("Изделие", СтрокаПоискаДетализации);
	Иначе
		Элементы.ДетализацияДоговоров.ОтборСтрок = Неопределено;
	КонецЕсли;

	// Диаграмма ганта строится по тем же строкам - пересобираем с учетом отбора
	ЗаполнитьДиаграммуГантаНаСервере();

КонецПроцедуры



///////////////////////////////////////////////////////////////////////
// Запись ввденных данных в Общей форме (ДатаИсполнения; Н; Примечание) в Справочник Договора 
// идентификатор строки - КлючСтроки (тип: УникальныйИдентификатор)
///////////////////////////////////////////////////////////////////////
 
&НаКлиенте
Процедура ДетализацияДоговоровПриИзменении(Элемент)  
	
//============================================================	
	Если Элемент.ТекущийЭлемент <> Неопределено
		И СтрНайти(Элемент.ТекущийЭлемент.Имя, "ВыгрузкаСЗ") > 0 Тогда
		Возврат;
	КонецЕсли;
//============================================================	
	
	ТекущиеДанные = Элементы.ДетализацияДоговоров.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// 1. Ищем договор вверх по иерархии
	СсылкаНаДоговор = ТекущиеДанные.Договор;
	
	// Если в текущей строке договора нет, ищем у родителя
	ТекущийРодитель = ТекущиеДанные.ПолучитьРодителя();
	Пока ТекущийРодитель <> Неопределено И Не ЗначениеЗаполнено(СсылкаНаДоговор) Цикл
		СсылкаНаДоговор = ТекущийРодитель.Договор;
		ТекущийРодитель = ТекущийРодитель.ПолучитьРодителя();
	КонецЦикла;
	
	// 2. Если договор так и не нашли, выходим
	Если Не ЗначениеЗаполнено(СсылкаНаДоговор) Тогда
		// Сообщить("Не удалось определить договор для этой строки.");
		Возврат;
	КонецЕсли;
	
	// 3. Собираем данные для сервера
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Договор",        СсылкаНаДоговор); // Ссылка от родителя
	СтруктураДанных.Вставить("КлючСтроки",     ТекущиеДанные.КлючСтроки);
	СтруктураДанных.Вставить("Н",              ТекущиеДанные.Н);
	СтруктураДанных.Вставить("ДатаИсполнения", ТекущиеДанные.ДатаИсполнения);
	СтруктураДанных.Вставить("Примечание",     ТекущиеДанные.Примечание);
	
	РезультатЗаписи = ПринудительноЗаписатьВБазу(СтруктураДанных);
	
	Если РезультатЗаписи Тогда
		ПоказатьОповещениеПользователя("Сохранено", 
			ПолучитьНавигационнуюСсылку(СсылкаНаДоговор), 
			"Данные в справочнике обновлены");
		
// Обновляем таблицу анализа после изменения
ОбновитьТаблицуАнализаПослеИзмененияДанных();	
	КонецЕсли;


КонецПроцедуры
 
&НаСервере
Функция ПринудительноЗаписатьВБазу(Данные)
	
	// 1. Проверка договора
	Если Не ЗначениеЗаполнено(Данные.Договор) Тогда
		Сообщить("Диагностика: В строке не заполнен Договор!");
		Возврат Ложь;
	КонецЕсли;

	// 2. Проверка ключа
	Если Не ЗначениеЗаполнено(Данные.КлючСтроки) Тогда
		Сообщить("Диагностика: В строке пустой КлючСтроки!");
		Возврат Ложь;
	КонецЕсли;

	ОбъектСправочника = Данные.Договор.ПолучитьОбъект();
	Если ОбъектСправочника = Неопределено Тогда 
		Возврат Ложь; 
	КонецЕсли;

	БылиИзменения = Ложь;
	ИскомыйКлюч   = Данные.КлючСтроки;

	СписокТЧ = Новый Массив;
	СписокТЧ.Добавить("Распоряжение");
	СписокТЧ.Добавить("ПланГрафик");

	Для Каждого ИмяТЧ Из СписокТЧ Цикл
		ТекущаяТЧ = ОбъектСправочника[ИмяТЧ];
		Для Каждого СтрОбъекта Из ТекущаяТЧ Цикл
			
			// СРАВНЕНИЕ
			Если СтрОбъекта.КлючСтроки = ИскомыйКлюч Тогда
				СтрОбъекта.Н              = Данные.Н;
				СтрОбъекта.ДатаИсполнения = Данные.ДатаИсполнения;
				СтрОбъекта.Примечание     = Данные.Примечание;
				БылиИзменения = Истина;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;

	// 3. Результат
	Если БылиИзменения Тогда
		Попытка
			ОбъектСправочника.ОбменДанными.Загрузка = Истина; 
			ОбъектСправочника.Записать();
			Возврат Истина; 
		Исключение
			Сообщить("Ошибка записи: " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	Иначе
		Сообщить("Диагностика: Ключ " + Строка(ИскомыйКлюч) + " не найден в ТЧ справочника!");
		Возврат Ложь;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура СохранитьИзмененияВДоговорахНаСервере()
	
	// Для дерева значений нужно начинать обход с коллекции верхнего уровня
	ОбходСтрокДерева(ТаблицаДетализация.ПолучитьЭлементы());
	
	Сообщить("Данные в договорах успешно обновлены.");
	
КонецПроцедуры

&НаСервере
Процедура ОбходСтрокДерева(СтрокиДерева)
	
	Для Каждого СтрокаТЧ Из СтрокиДерева Цикл
		
		// 1. Пытаемся обработать текущую строку
		Если ЗначениеЗаполнено(СтрокаТЧ.Договор) И ЗначениеЗаполнено(СтрокаТЧ.Сотрудник) Тогда
			
			ДоговорОбъект = СтрокаТЧ.Договор.ПолучитьОбъект();
			
			Если ДоговорОбъект <> Неопределено Тогда
				
				Изменено = Ложь;
				ПараметрыОтбора = Новый Структура("Сотрудник", СтрокаТЧ.Сотрудник);
				
				// Обновляем ТЧ Распоряжение
				СтрокиРаспоряжение = ДоговорОбъект.Распоряжение.НайтиСтроки(ПараметрыОтбора);
				Для Каждого СтрРасп Из СтрокиРаспоряжение Цикл
					СтрРасп.Н              = СтрокаТЧ.Н;
					СтрРасп.ДатаИсполнения = СтрокаТЧ.ДатаИсполнения;
					СтрРасп.Примечание     = СтрокаТЧ.Примечание;
					Изменено = Истина;
				КонецЦикла;
				
				// Обновляем ТЧ ПланГрафик
				СтрокиПлан = ДоговорОбъект.ПланГрафик.НайтиСтроки(ПараметрыОтбора);
				Для Каждого СтрПлан Из СтрокиПлан Цикл
					СтрПлан.Н              = СтрокаТЧ.Н;
					СтрПлан.ДатаИсполнения = СтрокаТЧ.ДатаИсполнения;
					СтрПлан.Примечание     = СтрокаТЧ.Примечание;
					Изменено = Истина;
				КонецЦикла;
				
				Если Изменено Тогда
					ДоговорОбъект.Записать();
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		// 2. РЕКУРСИЯ: идем глубже, если у строки есть подчиненные строки
		ПодчиненныеЭлементы = СтрокаТЧ.ПолучитьЭлементы();
		Если ПодчиненныеЭлементы.Количество() > 0 Тогда
			ОбходСтрокДерева(ПодчиненныеЭлементы);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
