//          ОбластьДанные.Параметры.ВходящийНомер  = Стр.ВходящийНомер;

            ТД.Вывести(ОбластьДанные);
            
        КонецЕсли;
        
    КонецЦикла;
    
    ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
    ТД.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
