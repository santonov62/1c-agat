&НаКлиенте
Процедура ВыбранныеТаблицыПриИзменении(Элемент)
	
// Обрабатываем изменение списка
	ОбработатьИзменениеСпискаТаблиц();
	
	// Обновляем отдельные флажки в соответствии с выбранными таблицами
//	ОбновитьОтдельныеФлажкиПоСписку();  ////////////////////////////////
	
	// Сохраняем выбор сотрудников
	СохраненныйВыбор = СохранитьВыборСотрудников();
	
	// Обновляем данные
	ОбновитьДанныеПоВыборуТаблицССохранениемВыбора(СохраненныйВыбор);
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработатьИзменениеСпискаТаблиц()
	
	Если ВыбранныеТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем, выбрана ли опция "Все"
	ВыбранаОпцияВсе = Ложь;
	
	Для Индекс = 0 По ВыбранныеТаблицы.Количество() - 1 Цикл
		Если ВыбранныеТаблицы[Индекс].Значение = "Все" И ВыбранныеТаблицы[Индекс].Пометка Тогда
			ВыбранаОпцияВсе = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Если выбрана опция "Все", устанавливаем все остальные опции
	Если ВыбранаОпцияВсе Тогда
		Для Индекс = 0 По ВыбранныеТаблицы.Количество() - 1 Цикл
			Если ВыбранныеТаблицы[Индекс].Значение <> "Все" Тогда
				ВыбранныеТаблицы[Индекс].Пометка = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Обновляем отдельные флажки в соответствии с выбранными таблицами
	ОбновитьФлажкиПоСпискуТаблиц();
	
КонецПроцедуры


 &НаКлиенте
Процедура ОбновитьФлажкиПоСпискуТаблиц()
	
	Если ВыбранныеТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Сбрасываем флажки
	ИспользоватьДоговора = Ложь;
	ИспользоватьРаспоряженияГД = Ложь;
	ИспользоватьРаспоряженияТД = Ложь;
	ИспользоватьВнутренниеДокументы = Ложь;
	ИспользоватьВходящиеДокументы = Ложь;
	ИспользоватьИсходящиеДокументы = Ложь;
	
	// Устанавливаем флажки на основе выбранных элементов списка
	Для Индекс = 0 По ВыбранныеТаблицы.Количество() - 1 Цикл
		Если Не ВыбранныеТаблицы[Индекс].Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяТаблицы = ВыбранныеТаблицы[Индекс].Значение;
		
		Если ИмяТаблицы = "Договора" Тогда
			ИспользоватьДоговора = Истина;
		ИначеЕсли ИмяТаблицы = "РаспоряженияГД" Тогда
			ИспользоватьРаспоряженияГД = Истина;
		ИначеЕсли ИмяТаблицы = "РаспоряженияТД" Тогда
			ИспользоватьРаспоряженияТД = Истина;
		ИначеЕсли ИмяТаблицы = "ВнутренниеДокументы" Тогда
			ИспользоватьВнутренниеДокументы = Истина;
		ИначеЕсли ИмяТаблицы = "ВходящиеДокументы" Тогда
			ИспользоватьВходящиеДокументы = Истина;
		ИначеЕсли ИмяТаблицы = "ИсходящиеДокументы" Тогда
			ИспользоватьИсходящиеДокументы = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

