 &НаКлиенте
Процедура ИспользоватьОтветственногоИсполнителяПриИзменении(Элемент)
    
    // Сохраняем текущий выбор сотрудников
    СохраненныйВыбор = СохранитьВыборСотрудников();
    
    // Сохраняем состояние дерева
    СохранитьСостояниеДерева();
    
    // Обновляем данные на сервере с новым режимом отбора
    ОбновитьДанныеНаСервере();

    // Пересобираем кеш МассивВсехДанных и применяем фильтр по % к актуальным данным
    ОтсортироватьИОтфильтроватьТаблицуАнализа();
    ОтсортироватьТаблицуАнализаНаКлиенте();

    // Восстанавливаем выбор сотрудников
    ВосстановитьВыборСотрудников(СохраненныйВыбор);

    // Обновляем список сотрудников в выпадающем списке
    ОбновитьСписокПоТаблицеАнализа();
    
    // Обновляем дерево договоров с текущим выбором сотрудников
    ОбновитьДетализациюДоговоровПоТекущемуВыбору();
    
    // Обновляем таблицы распоряжений и документов
    ОбновитьОтображениеТаблиц();
    
    // Обновляем индикаторы и диаграмму
    ОбновитьИндикаторы();
    ЗаполнитьДиаграммуИтогов();
    
    // Восстанавливаем состояние дерева
    ВосстановитьСостояниеДерева();
    
    // Диагностика
//    Сообщить("Режим отбора изменен: " + ?(ИспользоватьОтветственногоИсполнителя, "Ответственный исполнитель", "Исполнители (из ТЧ)"));
    
КонецПроцедуры 


