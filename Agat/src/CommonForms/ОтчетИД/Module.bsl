&НаКлиенте
Процедура ОбновитьВсеШкалы()
    
    // --------------------------------------------------------------
    // Получаем общее итоговое количество для масштабирования
    // --------------------------------------------------------------
    НЧисло=0 ;
	Попытка НЧисло = Число(ТабНВсего); Исключение НЧисло = 0; КонецПопытки;
	   
   ИтоговоеВсего = 0;
    Попытка ИтоговоеВсего = Число(ТабОбщееКоличество); Исключение ИтоговоеВсего = 0; КонецПопытки;
    
    // Фиксированная длина итоговой шкалы
    ДлинаИтоговойШкалы = 25;
    
    // Устанавливаем шрифт для всех шкал
    УстановитьШрифтДляВсехШкал();
    
    // Если нет итоговых данных, скрываем все шкалы
    Если ИтоговоеВсего = 0 И НЧисло=0 Тогда  ///////////////////////////////////// + НЧисло=0
        СкрытьВсеШкалы();
        Возврат;
    КонецЕсли;
    
    // --------------------------------------------------------------
    // 1. ОБЩАЯ ШКАЛА (ИТОГО) - эталонная
    // --------------------------------------------------------------
    ОбновитьИтоговуюШкалу(
        ТабОбщееКоличество,
        ТабИсполненоВсего,
        ТабНеИсполненоВсего,
        ТабНВсего,
        Элементы.ШкалаИсполнено,
        Элементы.ШкалаНеИсполнено,
        Элементы.ШкалаН,
        ДлинаИтоговойШкалы
    );
    
    // --------------------------------------------------------------
    // 2-7. ШКАЛЫ ПО ТАБЛИЦАМ - как часть итоговой
    // --------------------------------------------------------------
    МассивТаблицШкал = ПолучитьСписокТаблицАнализа();
    МассивСуффиксовШкал = ПолучитьСуффиксыШкал(Ложь);
    
    Для Индекс = 0 По МассивТаблицШкал.Количество() - 1 Цикл
        Таблица = МассивТаблицШкал[Индекс];
        Суффикс = МассивСуффиксовШкал[Индекс];
        ОбновитьШкалуКакЧастьИтога(
            Таблица,
            ЭтаФорма["Таб" + Таблица + "Всего"],
            ЭтаФорма["Таб" + Таблица + "Исполнено"],
            ЭтаФорма["Таб" + Таблица + "НеИсполнено"],
            ЭтаФорма["Таб" + Таблица + "Н"],
            Элементы["Шкала" + Суффикс + "Исполнено"],
            Элементы["Шкала" + Суффикс + "НеИсполнено"],
            Элементы["Шкала" + Суффикс + "Н"],
            ИтоговоеВсего,
            ДлинаИтоговойШкалы,
            НЧисло
        );
    КонецЦикла;
    
КонецПроцедуры

// Возвращает суффиксы шкал (общая "" + по таблицам анализа), используемые для доступа к Элементы["Шкала"+Суффикс+...]
&НаКлиенте
Функция ПолучитьСуффиксыШкал(СВключениемИтого = Истина)
    Массив = Новый Массив;
    Если СВключениемИтого Тогда
        Массив.Добавить("");
    КонецЕсли;
    Массив.Добавить("Договора");
    Массив.Добавить("РаспГД");
    Массив.Добавить("РаспТД");
    Массив.Добавить("Внутр");
    Массив.Добавить("Вх");
    Массив.Добавить("Исх");
    Возврат Массив;
КонецФункции

&НаКлиенте
Процедура УстановитьШрифтДляВсехШкал()

    // Создаем шрифт размером 9
    Шрифт9 = Новый Шрифт(, 7.5);

    // Для каждой шкалы (общая + по таблицам) устанавливаем шрифт сегментов
    Для Каждого Суффикс Из ПолучитьСуффиксыШкал() Цикл
        Попытка
            Элементы["Шкала" + Суффикс + "Исполнено"].Шрифт = Шрифт9;
            Элементы["Шкала" + Суффикс + "НеИсполнено"].Шрифт = Шрифт9;
            Элементы["Шкала" + Суффикс + "Н"].Шрифт = Шрифт9;
        Исключение
            // Игнорируем ошибки
        КонецПопытки;
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СкрытьВсеШкалы()

    // Скрываем все сегменты всех шкал (общая + по таблицам)
    Для Каждого Суффикс Из ПолучитьСуффиксыШкал() Цикл
        Элементы["Шкала" + Суффикс + "Исполнено"].Видимость = Ложь;
        Элементы["Шкала" + Суффикс + "НеИсполнено"].Видимость = Ложь;
        Элементы["Шкала" + Суффикс + "Н"].Видимость = Ложь;
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтоговуюШкалу(Всего, Исполнено, НеИсполнено, Н, ЭлИсп, ЭлНеИсп, ЭлН, ДлинаШкалы)
    
    // --------------------------------------------------------------
    // Получаем числовые значения
    // --------------------------------------------------------------
    ВсегоЧисло = 0;
    ИсполненоЧисло = 0;
    НеИсполненоЧисло = 0;
    НЧисло = 0;
    
    Попытка ВсегоЧисло = Число(Всего); Исключение ВсегоЧисло = 0; КонецПопытки;
    Попытка ИсполненоЧисло = Число(Исполнено); Исключение ИсполненоЧисло = 0; КонецПопытки;
    Попытка НеИсполненоЧисло = Число(НеИсполнено); Исключение НеИсполненоЧисло = 0; КонецПопытки;
    Попытка НЧисло = Число(Н); Исключение НЧисло = 0; КонецПопытки;
    
    // --------------------------------------------------------------
    // Установка цветов
    // --------------------------------------------------------------
    УстановитьЦветаШкалы(ЭлИсп, ЭлНеИсп, ЭлН);
    
    // --------------------------------------------------------------
    // Расчет ширины сегментов
    // --------------------------------------------------------------
    База = ВсегоЧисло+ НЧисло;   //   
    
    ШиринаИсп = 0;
    ШиринаНеИсп = 0;
    ШиринаН = 0;
    
    Если База > 0 Тогда
        ШиринаИсп = (ИсполненоЧисло / База) * ДлинаШкалы;
        ШиринаНеИсп = (НеИсполненоЧисло / База) * ДлинаШкалы;
        ШиринаН = (НЧисло / База) * ДлинаШкалы;
    КонецЕсли;
    
    // --------------------------------------------------------------
    // Управление видимостью
    // --------------------------------------------------------------
    Если ВсегоЧисло = 0 И НЧисло = 0 Тогда
        ЭлИсп.Видимость = Ложь;
        ЭлНеИсп.Видимость = Ложь;
        ЭлН.Видимость = Ложь;
    Иначе
        ЭлИсп.Видимость = (ШиринаИсп > 0);
        ЭлНеИсп.Видимость = (ШиринаНеИсп > 0);
        ЭлН.Видимость = (НЧисло > 0);
        
        // Устанавливаем минимальную ширину
        МинимальнаяШирина = 0.5;
        Если ЭлИсп.Видимость И ШиринаИсп < МинимальнаяШирина Тогда
            ШиринаИсп = МинимальнаяШирина;
        КонецЕсли;
        Если ЭлНеИсп.Видимость И ШиринаНеИсп < МинимальнаяШирина Тогда
            ШиринаНеИсп = МинимальнаяШирина;
        КонецЕсли;
        Если ЭлН.Видимость И ШиринаН < МинимальнаяШирина Тогда
            ШиринаН = МинимальнаяШирина;
        КонецЕсли;
        
        УстановитьШиринуСегментов(ЭлИсп, ЭлНеИсп, ЭлН, ШиринаИсп, ШиринаНеИсп, ШиринаН);
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьШкалуКакЧастьИтога(
    ИмяТаблицы,
    Всего,
    Исполнено,
    НеИсполнено,
    Н,
    ЭлИсп,
    ЭлНеИсп,
    ЭлН,
    ИтоговоеВсего,
    ДлинаИтоговойШкалы,
    ИтоговоеН = 0)
    
    // --------------------------------------------------------------
    // Получаем числовые значения
    // --------------------------------------------------------------
    ВсегоЧисло = 0;
    ИсполненоЧисло = 0;
    НеИсполненоЧисло = 0;
    НЧисло = 0;
    ИтогЧисло = 0;
    
    Попытка ВсегоЧисло = Число(Всего); Исключение ВсегоЧисло = 0; КонецПопытки;
    Попытка ИсполненоЧисло = Число(Исполнено); Исключение ИсполненоЧисло = 0; КонецПопытки;
    Попытка НеИсполненоЧисло = Число(НеИсполнено); Исключение НеИсполненоЧисло = 0; КонецПопытки;
    Попытка НЧисло = Число(Н); Исключение НЧисло = 0; КонецПопытки;
    Попытка ИтогЧисло = Число(ИтоговоеВсего); Исключение ИтогЧисло = 0; КонецПопытки;
    
    // --------------------------------------------------------------
    // Установка цветов
    // --------------------------------------------------------------
    УстановитьЦветаШкалы(ЭлИсп, ЭлНеИсп, ЭлН);
    
    // --------------------------------------------------------------
    // Если нет данных в таблице или в итоге - скрываем шкалу
    // --------------------------------------------------------------
    Если ИтогЧисло = 0 И НЧисло = 0 Тогда  //Или ВсегоЧисло = 0
        ЭлИсп.Видимость = Ложь;
        ЭлНеИсп.Видимость = Ложь;
        ЭлН.Видимость = Ложь;
        Возврат;
    КонецЕсли;

    // --------------------------------------------------------------
    // Общая длина шкалы таблицы = (Всего в таблице / Итоговое всего) * Длина итоговой шкалы
    // Если ОбщееКоличество = 0 (ИтогЧисло = 0), но есть Н — масштабируем по ИтоговоеН
    // --------------------------------------------------------------
    ИтоговоеНЧисло = 0;
    Попытка ИтоговоеНЧисло = Число(ИтоговоеН); Исключение ИтоговоеНЧисло = 0; КонецПопытки;

    Если ИтогЧисло > 0 Тогда
        ОбщаяДлинаШкалы = (ВсегоЧисло / ИтогЧисло) * ДлинаИтоговойШкалы;
    ИначеЕсли ИтоговоеНЧисло > 0 Тогда
        // ОбщееКоличество = 0, шкала Н пропорциональна ВсегоН
        ОбщаяДлинаШкалы = (НЧисло / ИтоговоеНЧисло) * ДлинаИтоговойШкалы;
    Иначе
        ОбщаяДлинаШкалы = ДлинаИтоговойШкалы;
    КонецЕсли;
    
    // Минимальная длина для видимости
    МинимальнаяДлина = 0.5;
    Если ОбщаяДлинаШкалы < МинимальнаяДлина Тогда
        ОбщаяДлинаШкалы = МинимальнаяДлина;
    КонецЕсли;
    
    // --------------------------------------------------------------
    // База для расчета сегментов внутри шкалы таблицы
    // --------------------------------------------------------------
    БазаТаблицы = ВсегоЧисло + НЧисло;     // + НЧисло
    
    ШиринаИсп = 0;
    ШиринаНеИсп = 0;
    ШиринаН = 0;
    
    Если БазаТаблицы > 0 Тогда
        ШиринаИсп = (ИсполненоЧисло / БазаТаблицы) * ОбщаяДлинаШкалы;
        ШиринаНеИсп = (НеИсполненоЧисло / БазаТаблицы) * ОбщаяДлинаШкалы;
        ШиринаН = (НЧисло / БазаТаблицы) * ОбщаяДлинаШкалы;
    КонецЕсли;
    
    // --------------------------------------------------------------
    // Управление видимостью сегментов
    // --------------------------------------------------------------
    ЭлИсп.Видимость = (ШиринаИсп > 0);
    ЭлНеИсп.Видимость = (ШиринаНеИсп > 0);
    ЭлН.Видимость = (НЧисло > 0);
    
    // Устанавливаем минимальную ширину для видимых сегментов
    Если ЭлИсп.Видимость И ШиринаИсп < МинимальнаяДлина Тогда
        ШиринаИсп = МинимальнаяДлина;
    КонецЕсли;
    Если ЭлНеИсп.Видимость И ШиринаНеИсп < МинимальнаяДлина Тогда
        ШиринаНеИсп = МинимальнаяДлина;
    КонецЕсли;
    Если ЭлН.Видимость И ШиринаН < МинимальнаяДлина Тогда
        ШиринаН = МинимальнаяДлина;
    КонецЕсли;
    
    УстановитьШиринуСегментов(ЭлИсп, ЭлНеИсп, ЭлН, ШиринаИсп, ШиринаНеИсп, ШиринаН);
    
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЦветаШкалы(ЭлИсп, ЭлНеИсп, ЭлН)
    
    // Цвета для исполненных (зеленоватые)
    ЦветФонаИсп = Новый Цвет(217, 255, 225);
    ЦветРамкиИсп = Новый Цвет(80, 241, 87);
    
    // Цвета для неисполненных (розоватые)
    ЦветФонаНеИсп = Новый Цвет(255, 228, 228);
    ЦветРамкиНеИсп = Новый Цвет(255, 183, 192);
    
    // Цвета для Н (голубоватые)
    ЦветФонаН = Новый Цвет(217, 232, 242);
    ЦветРамкиН = Новый Цвет(181, 184, 255);
    
    Попытка
        ЭлИсп.ЦветФона = ЦветФонаИсп;
        ЭлИсп.ЦветРамки = ЦветРамкиИсп;
    Исключение
        // Если свойства не найдены, игнорируем
    КонецПопытки;
    
    Попытка
        ЭлНеИсп.ЦветФона = ЦветФонаНеИсп;
        ЭлНеИсп.ЦветРамки = ЦветРамкиНеИсп;
    Исключение
        // Если свойства не найдены, игнорируем
    КонецПопытки;
    
    Попытка
        ЭлН.ЦветФона = ЦветФонаН;
        ЭлН.ЦветРамки = ЦветРамкиН;
    Исключение
        // Если свойства не найдены, игнорируем
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура УстановитьШиринуСегментов(ЭлИсп, ЭлНеИсп, ЭлН, ШиринаИсп, ШиринаНеИсп, ШиринаН)
    
    Попытка
        ЭлИсп.Ширина = ШиринаИсп;
    Исключение
        // Игнорируем ошибки
    КонецПопытки;
    
    Попытка
        ЭлНеИсп.Ширина = ШиринаНеИсп;
    Исключение
        // Игнорируем ошибки
    КонецПопытки;
    
    Попытка
        ЭлН.Ширина = ШиринаН;
    Исключение
        // Игнорируем ошибки
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЧисловойРеквизитИзСтруктуры(ИмяРеквизита, Структура, ИмяПоля)
    Попытка
        ЭтаФорма[ИмяРеквизита] = Число(Структура[ИмяПоля]);
    Исключение
        ЭтаФорма[ИмяРеквизита] = 0;
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПреобразоватьЧислоВТекстДляОтображения(ИмяРеквизита)
    Попытка
        Значение = Число(ЭтаФорма[ИмяРеквизита]);
        ЭтаФорма[ИмяРеквизита] = ?(Значение > 0, Строка(Значение), "");
    Исключение
        ЭтаФорма[ИмяРеквизита] = "";
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПроцентПоТаблице(ИмяРеквизитаПроцента, ДанныеПоТаблицам, ИмяТаблицы)
    Попытка
        Если ДанныеПоТаблицам = Неопределено Или Число(ДанныеПоТаблицам[ИмяТаблицы + "Всего"]) = 0 Тогда
            ЭтаФорма[ИмяРеквизитаПроцента] = "";
        Иначе
            Процент = (Число(ДанныеПоТаблицам[ИмяТаблицы + "Исполнено"]) / Число(ДанныеПоТаблицам[ИмяТаблицы + "Всего"])) * 100;
            ЭтаФорма[ИмяРеквизитаПроцента] = ?(Процент > 0, Формат(Процент, "ЧДЦ=0") + " %", "0 %");
        КонецЕсли;
    Исключение
        ЭтаФорма[ИмяРеквизитаПроцента] = "";
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИндикаторы()

    // --------------------------------------------------------------
    // 1. ПОЛУЧАЕМ ДАННЫЕ
    // --------------------------------------------------------------
    Данные = ПолучитьДанныеДляИндикаторов();        // Общие итоги
    ДанныеПоТаблицам = ПолучитьДанныеПоТаблицам();  // Итоги по каждой таблице

    МассивТаблиц = ПолучитьСписокТаблицАнализа();

    МассивСуффиксов = Новый Массив;
    МассивСуффиксов.Добавить("Всего");
    МассивСуффиксов.Добавить("Исполнено");
    МассивСуффиксов.Добавить("НеИсполнено");
    МассивСуффиксов.Добавить("Н");

    // --------------------------------------------------------------
    // 2. ПРИСВОЕНИЕ ЗНАЧЕНИЙ ОБЩИМ РЕКВИЗИТАМ
    // --------------------------------------------------------------
    Если Данные <> Неопределено Тогда
        ЗаполнитьЧисловойРеквизитИзСтруктуры("ТабОбщееКоличество", Данные, "ОбщееКоличество");
        ЗаполнитьЧисловойРеквизитИзСтруктуры("ТабНеИсполненоВсего", Данные, "НеИсполнено");
        ЗаполнитьЧисловойРеквизитИзСтруктуры("ТабНВсего", Данные, "ВсегоН");
    Иначе
        ТабОбщееКоличество = 0;
        ТабНеИсполненоВсего = 0;
        ТабНВсего = 0;
    КонецЕсли;

    ТабИсполненоВсего = ТабОбщееКоличество - ТабНеИсполненоВсего;

    // --------------------------------------------------------------
    // 3. ПРИСВОЕНИЕ ЗНАЧЕНИЙ РЕКВИЗИТАМ ПО ТАБЛИЦАМ
    // --------------------------------------------------------------
    Для Каждого Таблица Из МассивТаблиц Цикл
        Для Каждого Суффикс Из МассивСуффиксов Цикл
            Если ДанныеПоТаблицам <> Неопределено Тогда
                ЗаполнитьЧисловойРеквизитИзСтруктуры("Таб" + Таблица + Суффикс, ДанныеПоТаблицам, Таблица + Суффикс);
            Иначе
                ЭтаФорма["Таб" + Таблица + Суффикс] = 0;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    // --------------------------------------------------------------
    // 4. ЗАПОЛНЕНИЕ ТЕКСТОВЫХ ПРЕДСТАВЛЕНИЙ
    // --------------------------------------------------------------
    ПреобразоватьЧислоВТекстДляОтображения("ТабОбщееКоличество");
    ПреобразоватьЧислоВТекстДляОтображения("ТабИсполненоВсего");
    ПреобразоватьЧислоВТекстДляОтображения("ТабНеИсполненоВсего");
    ПреобразоватьЧислоВТекстДляОтображения("ТабНВсего");

    Для Каждого Таблица Из МассивТаблиц Цикл
        Для Каждого Суффикс Из МассивСуффиксов Цикл
            ПреобразоватьЧислоВТекстДляОтображения("Таб" + Таблица + Суффикс);
        КонецЦикла;
    КонецЦикла;

    // --------------------------------------------------------------
    // 5. ОБНОВЛЕНИЕ ВСЕХ ШКАЛ
    // --------------------------------------------------------------
    ОбновитьВсеШкалы();

    // --------------------------------------------------------------
    // 6. ТЕКСТОВЫЕ ПРОЦЕНТЫ
    // --------------------------------------------------------------
    // Общий процент
    Попытка
        Если Данные <> Неопределено И Данные.ПроцентОбщий <> Неопределено Тогда
            ЗначениеПроцента = Число(Данные.ПроцентОбщий);
            ОбщийПроцентТекст = ?(ЗначениеПроцента > 0, Формат(ЗначениеПроцента, "ЧДЦ=0") + "%", "0 %");
        Иначе
            ОбщийПроцентТекст = "";
        КонецЕсли;
    Исключение
        ОбщийПроцентТекст = "";
    КонецПопытки;

    // Проценты по таблицам
    Для Каждого Таблица Из МассивТаблиц Цикл
        ЗаполнитьПроцентПоТаблице("ОбщийПроцентТекст" + Таблица, ДанныеПоТаблицам, Таблица);
    КонецЦикла;

    ОбновитьВидимостьПанелей();

КонецПроцедуры



&НаКлиенте
Функция ПолучитьДанныеПоТаблицам()

    МассивТаблиц = ПолучитьСписокТаблицАнализа();

    Результат = Новый Структура;

    Для Каждого Таблица Из МассивТаблиц Цикл
        Результат.Вставить(Таблица + "Всего", 0);
        Результат.Вставить(Таблица + "Исполнено", 0);
        Результат.Вставить(Таблица + "НеИсполнено", 0);
        Результат.Вставить(Таблица + "Н", 0);
    КонецЦикла;

    // Суммируем по выбранным строкам ТаблицаАнализа
    Для Каждого Стр Из ТаблицаАнализа Цикл
        Если Стр.Выбран Тогда
            Для Каждого Таблица Из МассивТаблиц Цикл
                НакопитьПоказателиТаблицы(Результат, Стр, Таблица);
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;

    // Рассчитываем исполнено = Всего - НеИсполнено
    Для Каждого Таблица Из МассивТаблиц Цикл
        Результат[Таблица + "Исполнено"] = Результат[Таблица + "Всего"] - Результат[Таблица + "НеИсполнено"];
    КонецЦикла;

    Возврат Результат;

КонецФункции



