	МассивПолейТипа.Добавить("ДетализацияДоговоровСрокИсполнения");	
	
	МассивПолейТипа.Добавить("ТаблицаДетализацияИсполнителиСтрокой");
	
//	МассивПолейТипа.Добавить("ДетализацияДоговоровН");
//	МассивПолейТипа.Добавить("ДетализацияДоговоровДатаИсполнения");
//	МассивПолейТипа.Добавить("ДетализацияДоговоровПримечание");
	
	Для Каждого ИмяПоля Из МассивПолейТипа Цикл
		ПолеСерыйТип = ЭлементСерыйТип.Поля.Элементы.Добавить();
		ПолеСерыйТип.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;
	
	
	
///////////////////////////////////////////////////////////////////////	
// СЕРЫЙ ФОН ДЛЯ ПУСТЫХ ЯЧЕЕК ТИПА ЗАПИСИ (Распряжение , План-график) (ИСКЛЮЧАЯ ШАПКУ)
///////////////////////////////////////////////////////////////////////	

	ЭлементСерыйТипПусто = УсловноеОформление.Элементы.Добавить();
	ЭлементСерыйТипПусто.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(220, 220, 220));
	
	// УСЛОВИЕ 1: Тип записи не заполнен
	ОтборТип = ЭлементСерыйТипПусто.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
