&НаКлиенте
Процедура ОткрытьСсылкуИзТекущихДанных(ИмяЭлементаДетализации)

	ТекущиеДанные = Элементы[ИмяЭлементаДетализации].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.Свойство("Ссылка") И ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьАктивизациюЯчейки(Элемент, ИмяЭлементаДетализации, МассивРедактируемыхКолонок)

	ТекущаяКолонка = Элемент.ТекущийЭлемент;
	Если ТекущаяКолонка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Не открываем форму при клике на редактируемые поля
	Если МассивРедактируемыхКолонок.Найти(ТекущаяКолонка.Имя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОткрытьСсылкуИзТекущихДанных(ИмяЭлементаДетализации);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеРаспоряжения(Элемент, ИмяЭлементаДетализации, ТипРаспоряжения, ТекстСообщения)
	
//===============================================================	
	Если Элемент.ТекущийЭлемент <> Неопределено
		И СтрНайти(Элемент.ТекущийЭлемент.Имя, "ВыгрузкаСЗ") > 0 Тогда
		Возврат;
	КонецЕсли;
//===============================================================	
	
	ТекущиеДанные = Элементы[ИмяЭлементаДетализации].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СсылкаНаРаспоряжение = ТекущиеДанные.Ссылка;
	Если Не ЗначениеЗаполнено(СсылкаНаРаспоряжение) Тогда
		Возврат;
	КонецЕсли;

	// Собираем данные для сервера (только редактируемые реквизиты)
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Распоряжение", СсылкаНаРаспоряжение);
	СтруктураДанных.Вставить("Н", ТекущиеДанные.Н);
	СтруктураДанных.Вставить("ДатаИсполнения", ТекущиеДанные.ДатаИсполнения);
	СтруктураДанных.Вставить("Примечание", ТекущиеДанные.Примечание);
	СтруктураДанных.Вставить("РеквизитыДокументаПодтверждающегоИсполнение", ТекущиеДанные.РеквизитыДокументаПодтверждающегоИсполнение);
	СтруктураДанных.Вставить("ТипРаспоряжения", ТипРаспоряжения);

	РезультатЗаписи = ЗаписатьИзмененияРаспоряженияВБазу(СтруктураДанных);

	Если РезультатЗаписи Тогда
		ПоказатьОповещениеПользователя("Сохранено",
			ПолучитьНавигационнуюСсылку(СсылкаНаРаспоряжение),
			ТекстСообщения);

		// После успешной записи обновляем таблицу анализа
		ОбновитьТаблицуАнализаПослеИзмененияДанных();
	КонецЕсли;

КонецПроцедуры

