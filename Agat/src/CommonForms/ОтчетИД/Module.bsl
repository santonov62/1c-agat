// Процедура для простой круговой диаграммы
&НаКлиенте
Функция ЧислоБезопасно(Параметр)
    Попытка
        Возврат Число(Параметр);
    Исключение
        Возврат 0;
    КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДиаграммуИтогов()
    
    // --------------------------------------------------------------
    // 1. ПОЛУЧАЕМ ЗНАЧЕНИЯ (с защитой)
    // --------------------------------------------------------------
    
    // Общие итоги
    ОбщКол = ЧислоБезопасно(ТабОбщееКоличество);
    ИспКол = ЧислоБезопасно(ТабИсполненоВсего);
    НеИспКол = ЧислоБезопасно(ТабНеИсполненоВсего);
    НКол = ЧислоБезопасно(ТабНВсего);
    
    МассивТаблицДиаграммы = ПолучитьСписокТаблицАнализа();
    
    // --------------------------------------------------------------
    // 2. ОЧИСТКА И НАСТРОЙКА ДИАГРАММЫ
    // --------------------------------------------------------------
    ДиаграммаИтогоВсего.Очистить();
    ДиаграммаИтогоВсего.ТипДиаграммы = ТипДиаграммы.Гистограмма;
    
    // --------------------------------------------------------------
    // 3. ДОБАВЛЕНИЕ СЕРИЙ С НАЗВАНИЯМИ
    // --------------------------------------------------------------
    ДиаграммаИтогоВсего.Серии.Очистить();
    
    СерияВсего = ДиаграммаИтогоВсего.Серии.Добавить();
    СерияВсего.Цвет = Новый Цвет(100, 100, 255); // Синий
    СерияВсего.Текст = "Всего";
    
    СерияИсп = ДиаграммаИтогоВсего.Серии.Добавить();
    СерияИсп.Цвет = Новый Цвет(0, 150, 0); // Зеленый
    СерияИсп.Текст = "Исполнено";
    
    СерияНеИсп = ДиаграммаИтогоВсего.Серии.Добавить();
    СерияНеИсп.Цвет = Новый Цвет(255, 100, 100); // Красный
    СерияНеИсп.Текст = "Не исполнено";
    
    СерияН = ДиаграммаИтогоВсего.Серии.Добавить();
    СерияН.Цвет = Новый Цвет(255, 150, 0); // Оранжевый
    СерияН.Текст = "Н";
    
    // --------------------------------------------------------------
    // 4. ДОБАВЛЕНИЕ ТОЧЕК (категорий)
    // --------------------------------------------------------------
    ДиаграммаИтогоВсего.Точки.Очистить();
    
    ДиаграммаИтогоВсего.Точки.Добавить("Итоги");
    ДиаграммаИтогоВсего.Точки.Добавить("Договора");
    ДиаграммаИтогоВсего.Точки.Добавить("Расп. ГД");
    ДиаграммаИтогоВсего.Точки.Добавить("Расп. ТД");
    ДиаграммаИтогоВсего.Точки.Добавить("Внутренние");
    ДиаграммаИтогоВсего.Точки.Добавить("Входящие");
    ДиаграммаИтогоВсего.Точки.Добавить("Исходящие");
    
    // --------------------------------------------------------------
    // 5. УСТАНОВКА ЗНАЧЕНИЙ
    // --------------------------------------------------------------
    ДиаграммаИтогоВсего.УстановитьЗначение(0, 0, ОбщКол);
    ДиаграммаИтогоВсего.УстановитьЗначение(0, 1, ИспКол);
    ДиаграммаИтогоВсего.УстановитьЗначение(0, 2, НеИспКол);
    ДиаграммаИтогоВсего.УстановитьЗначение(0, 3, НКол);
    
    Для ИндексТаблицы = 0 По МассивТаблицДиаграммы.Количество() - 1 Цикл
        Таблица = МассивТаблицДиаграммы[ИндексТаблицы];
        ИндексТочки = ИндексТаблицы + 1;
        ДиаграммаИтогоВсего.УстановитьЗначение(ИндексТочки, 0, ЧислоБезопасно(ЭтаФорма["Таб" + Таблица + "Всего"]));
        ДиаграммаИтогоВсего.УстановитьЗначение(ИндексТочки, 1, ЧислоБезопасно(ЭтаФорма["Таб" + Таблица + "Исполнено"]));
        ДиаграммаИтогоВсего.УстановитьЗначение(ИндексТочки, 2, ЧислоБезопасно(ЭтаФорма["Таб" + Таблица + "НеИсполнено"]));
        ДиаграммаИтогоВсего.УстановитьЗначение(ИндексТочки, 3, ЧислоБезопасно(ЭтаФорма["Таб" + Таблица + "Н"]));
    КонецЦикла;
    
    // --------------------------------------------------------------
    // 6. СКРЫТИЕ ЛЕГЕНДЫ (ДОБАВЛЕННЫЙ КОД)
    // --------------------------------------------------------------
    Попытка
        ДиаграммаИтогоВсего.ОбластьПостроения.Легенда.Отображать = Ложь;
    Исключение
//        Сообщить("Не удалось скрыть легенду программно");
    КонецПопытки;
    
    // --------------------------------------------------------------
    // 7. ДИАГНОСТИКА
    // --------------------------------------------------------------
//    Сообщить("Диаграмма заполнена: серий=" + ДиаграммаИтогоВсего.Серии.Количество() + 
//             ", точек=" + ДиаграммаИтогоВсего.Точки.Количество());
    
КонецПроцедуры
