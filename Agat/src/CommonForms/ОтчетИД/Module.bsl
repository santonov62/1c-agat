///////////////////////////////////////////////////////////////////////
// Заполнение списка всех сотрудников из справочника "Сотрудники"
// (вызывается один раз при открытии формы)
///////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ЗаполнитьСписокВсехСотрудников()
	
	// --------------------------------------------------------------
	// Создаем новый список для хранения всех сотрудников
	// --------------------------------------------------------------
	ВсеСотрудники = Новый СписокЗначений;
	
	// --------------------------------------------------------------
	// Запрос к справочнику Сотрудники
	// --------------------------------------------------------------
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка,           // Ссылка на сотрудника
	|	Сотрудники.Наименование      // ФИО сотрудника
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления  // Исключаем помеченных на удаление
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";                 // Сортировка по ФИО
	
	// --------------------------------------------------------------
	// Выполняем запрос и заполняем список
	// --------------------------------------------------------------
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// Добавляем сотрудника в список
		// Параметры: Значение, Представление
		ВсеСотрудники.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;
	
КонецПроцедуры



// ПРИНУДИТЕЛЬНО УСТАНАВЛИВАЕМ ФЛАГИ ПОСЛЕ ЗАГРУЗКИ 
