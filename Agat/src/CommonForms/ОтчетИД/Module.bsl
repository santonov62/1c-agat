 	// Обновляем таблицы распоряжений и документов с новым фильтром
	ОбновитьОтображениеТаблиц();
	
    // Обновляем список сотрудников
	ОбновитьСписокПоТаблицеАнализа();

// Восстанавливаем выбор сотрудников
	ВосстановитьВыборСотрудников(СохраненныйВыбор);	
	
	// Обновляем дерево договоров с текущим выбором сотрудников
	ОбновитьДетализациюДоговоровПоТекущемуВыбору();	// Обновляем дерево договоров с новым условием отбора
	
	
//	ВосстановитьВыборСотрудников(СохраненныйВыбор); // Восстанавливаем выбор сотрудников
	
