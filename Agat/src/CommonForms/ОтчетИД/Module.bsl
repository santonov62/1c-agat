&НаКлиенте
Процедура ПереключитьПанели(Команда)
    
    // --------------------------------------------------------------
    // 1. ЕСЛИ КОМАНДА ПереключитьВид БЫЛА ВКЛЮЧЕНА - ВЫКЛЮЧАЕМ ЕЕ
    // --------------------------------------------------------------
    Если РежимОтображения = 1 Тогда
        // Возвращаем ПереключитьВид в исходное состояние
        РежимОтображения = 2;
        ОбновитьОтображениеПоРежиму();
        
        // Возвращаем исходную иконку для ПереключитьВид
        Попытка
            Элементы.КнопкаПереключитьВид.Картинка = БиблиотекаКартинок.ОтчетИД_2;
  //          Элементы.КнопкаПереключитьВид.Подсказка = "Переключить вид (режим 1)";
        Исключение
        КонецПопытки;
    КонецЕсли;
    
    // --------------------------------------------------------------
    // 2. ПЕРЕКЛЮЧАЕМ РЕЖИМ ПАНЕЛЕЙ
    // --------------------------------------------------------------
    РежимПанелей = Не РежимПанелей;
    
    // --------------------------------------------------------------
    // 3. ОБНОВЛЯЕМ ВИДИМОСТЬ ПАНЕЛЕЙ
    // --------------------------------------------------------------
    ОбновитьВидимостьПанелей();
    
    // --------------------------------------------------------------
    // 4. ПЕРЕКЛЮЧАЕМ ИКОНКУ И ПОДСКАЗКУ КНОПКИ
    // --------------------------------------------------------------
    ПереключитьИконкуКнопкиПанелей();
    
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьВид(Команда)
    
    // --------------------------------------------------------------
    // 1. ЕСЛИ КОМАНДА ПереключитьПанели БЫЛА ВКЛЮЧЕНА - ВЫКЛЮЧАЕМ ЕЕ
    // --------------------------------------------------------------
    Если РежимПанелей Тогда
        // Возвращаем ПереключитьПанели в исходное состояние
        РежимПанелей = Ложь;
        ОбновитьВидимостьПанелей();
        
        // Возвращаем исходную иконку для ПереключитьПанели
        Попытка
            Элементы.КнопкаПереключитьПанели.Картинка = БиблиотекаКартинок.ОтчетИД_1;
 //           Элементы.КнопкаПереключитьПанели.Подсказка = "Показать шкалы";
        Исключение
        КонецПопытки;
    КонецЕсли;
    
    // --------------------------------------------------------------
    // 2. ПЕРЕКЛЮЧАЕМ РЕЖИМ ОТОБРАЖЕНИЯ
    // --------------------------------------------------------------
    Если РежимОтображения = 1 Тогда
        РежимОтображения = 2;
    Иначе
        РежимОтображения = 1;
    КонецЕсли;
    
    // --------------------------------------------------------------
    // 3. ОБНОВЛЯЕМ ОТОБРАЖЕНИЕ ПО РЕЖИМУ
    // --------------------------------------------------------------
    ОбновитьОтображениеПоРежиму();
    
    // --------------------------------------------------------------
    // 4. ПЕРЕКЛЮЧАЕМ ИКОНКУ И ПОДСКАЗКУ КНОПКИ ПереключитьВид
    // --------------------------------------------------------------
    ПереключитьИконкуКнопкиВида();
    
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьИконкуКнопкиПанелей()
    
    Попытка
        Если РежимПанелей Тогда
            // Режим "Шкалы" - устанавливаем стандартную иконку "Измерение"
            Элементы.КнопкаПереключитьПанели.Картинка = БиблиотекаКартинок.Шестеренка_4;
 //           Элементы.КнопкаПереключитьПанели.Подсказка = "Показать основные панели";
        Иначе
            // Режим "Основные панели" - устанавливаем предустановленную иконку
            Элементы.КнопкаПереключитьПанели.Картинка = БиблиотекаКартинок.ОтчетИД_1;
 //           Элементы.КнопкаПереключитьПанели.Подсказка = "Показать шкалы";
        КонецЕсли;
    Исключение
        Сообщить("Ошибка при переключении иконки панелей: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьИконкуКнопкиВида()
    
    Попытка
        Если РежимОтображения = 1 Тогда
            // Режим 1 - исходная иконка
            Элементы.КнопкаПереключитьВид.Картинка = БиблиотекаКартинок.Шестеренка_4;
  //          Элементы.КнопкаПереключитьВид.Подсказка = "Переключить вид (режим 1)";
        Иначе
            // Режим 2 - измененная иконка
            Элементы.КнопкаПереключитьВид.Картинка = БиблиотекаКартинок.ОтчетИД_2;
  //          Элементы.КнопкаПереключитьВид.Подсказка = "Переключить вид (режим 2)";
        КонецЕсли;
    Исключение
        Сообщить("Ошибка при переключении иконки вида: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

//КнопкаПереключитьПанели
&НаКлиенте
Процедура ОбновитьВидимостьПанелей()   
    
    Если РежимПанелей Тогда
        // РЕЖИМ 2: Только ШкалаТЧ видна // РЕЖИМ "ШКАЛЫ": скрываем все основные панели, показываем только ШкалаТЧ
        Элементы.Критерии.Видимость = Ложь;
        Элементы.НастройкиОтчета.Видимость = Ложь;
        Элементы.ГруппаОтчет.Видимость = Ложь;
