///////////////////////////////////////////////////////////////////////
// Процедура обновления флага "Все сотрудники".
// Флаг взведен, только когда отмечены ВСЕ строки таблицы анализа:
// снятие хотя бы одной галочки сбрасывает его в Ложь
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ОбновитьФлагВсехСотрудников()

	Всего = ТаблицаАнализа.Количество();

	Если Всего = 0 Тогда
		ФлагВсехСотрудников = Ложь;
		Возврат;
	КонецЕсли;

	Для Каждого Стр Из ТаблицаАнализа Цикл
		Если Не Стр.Выбран Тогда
			// Нашли снятую галочку - дальше проверять нечего
			ФлагВсехСотрудников = Ложь;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ФлагВсехСотрудников = Истина;

КонецПроцедуры


///////////////////////////////////////////////////////////////////////
// Обработчик изменения флага "Все сотрудники"
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ФлагВсехСотрудниковПриИзменении(Элемент)
	
	// Взвели флаг - выбираем всех, сняли - снимаем выбор со всех
	Для Каждого Стр Из ТаблицаАнализа Цикл
		Стр.Выбран = ФлагВсехСотрудников;
	КонецЦикла;
	
	// Обновляем список сотрудников
	ОбновитьСписокПоТаблицеАнализа();
	// Обновляем детализацию
	ОбновитьДетализациюПоВыбранным();
///////////////////////////////////////////////////////////////////////	
	ОбновитьИндикаторы() ;
    ОбновитьОтображениеПоРежиму();

КонецПроцедуры

///////////////////////////////////////////////////////////////////////
// Функция для сохранения текущего выбора сотрудников
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Функция СохранитьВыборСотрудников()
	
	Результат = Новый Соответствие;
	
	Для Каждого Стр Из ТаблицаАнализа Цикл
		Если ЗначениеЗаполнено(Стр.Сотрудник) Тогда
			Ключ = Строка(Стр.Сотрудник.УникальныйИдентификатор());
			Результат.Вставить(Ключ, Стр.Выбран);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

///////////////////////////////////////////////////////////////////////
// Процедура восстановления выбора сотрудников
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ВосстановитьВыборСотрудников(СохраненныйВыбор)

	Если СохраненныйВыбор = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Запоминаем состояние флага "Все сотрудники" до обновления данных
	БылиВыбраныВсе = ФлагВсехСотрудников И (Не ТолькоМоиЗадачи);

	// Сбрасываем все галочки
	Для Каждого Стр Из ТаблицаАнализа Цикл
		Стр.Выбран = Ложь;
	КонецЦикла;

	Если БылиВыбраныВсе Тогда
		// Если ранее были выбраны все сотрудники - выбираем все отображенные сотрудники
		Для Каждого Стр Из ТаблицаАнализа Цикл
			Если ЗначениеЗаполнено(Стр.Сотрудник) Тогда
				Стр.Выбран = Истина;
			КонецЕсли;
		КонецЦикла;
	Иначе
		// Восстанавливаем выбор
		Для Каждого Стр Из ТаблицаАнализа Цикл
			Если ЗначениеЗаполнено(Стр.Сотрудник) Тогда
				Ключ = Строка(Стр.Сотрудник.УникальныйИдентификатор());
				БылВыбран = СохраненныйВыбор.Получить(Ключ);
				Если БылВыбран <> Неопределено И БылВыбран Тогда
					Стр.Выбран = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Обновляем флаг "Все сотрудники"
	ОбновитьФлагВсехСотрудников();

	// Обновляем список
	ОбновитьСписокПоТаблицеАнализа();

КонецПроцедуры


&НаКлиенте
Процедура ОбновитьСписокСотрудниковПоТаблицеАнализа()
	
	Если ВыбранныеСотрудники = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Создаем соответствие выбранных из таблицы
	ВыбранныеВТаблице = Новый Соответствие;
	
	Для Каждого Стр Из ТаблицаАнализа Цикл
		Если Стр.Выбран И ЗначениеЗаполнено(Стр.Сотрудник) Тогда
			ВыбранныеВТаблице.Вставить(Стр.Сотрудник, Истина);
		КонецЕсли;
	КонецЦикла;
	
	// Обновляем пометки в списке
	Для Номер = 0 По ВыбранныеСотрудники.Количество() - 1 Цикл
		Ссылка = ВыбранныеСотрудники[Номер].Значение;
		
		Если Ссылка <> Неопределено Тогда
			ВыбранныеСотрудники[Номер].Пометка = (ВыбранныеВТаблице.Получить(Ссылка) <> Неопределено);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры



///////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////
// Команды для выбора/снятия выбора всех таблиц (опционально):
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ВыбратьВсеТаблицы(Команда)
	
	// Устанавливаем флаг "Выбраны все таблицы"
	ВыбраныВсеТаблицы = Истина;
	
	// Вызываем обработчик изменения
	ВыбраныВсеТаблицыПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыборВсехТаблиц(Команда)
	
	// Снимаем флаг "Выбраны все таблицы"
	ВыбраныВсеТаблицы = Ложь;
	
	// Вызываем обработчик изменения
	ВыбраныВсеТаблицыПриИзменении(Неопределено);
	
КонецПроцедуры
