
  

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// 1. Инициализация периода (текущий месяц)
	ДатаС  = НачалоМесяца(ТекущаяДата()); //	ДатаС = '00010101'; // Пустая дата    // Устанавливаем пустую дату "С" - пустая дата '00010101'
	ДатаПо = КонецМесяца(ТекущаяДата());  // Дата "По" - конец текущего месяца ДатаПо = КонецМесяца(ТекущаяДата());

	
	
// Устанавливаем флаги по умолчанию на сервере
	ЗаписиОтображениеСостав = Истина;
	
	// 2. Инициализация списка таблиц (все включены)
	ИнициализироватьСписокТаблицНаСервере();
	
	// 3. Настройка Условного оформления (подсветка просрочки)
	УстановитьУсловноеОформлениеНаСервере();
	
	// 4. Обновление данных
// НЕ вызываем ОбновитьДанныеНаСервере() здесь!
// Данные загрузятся на клиенте после установки всех фильтров
//	ОбновитьДанныеНаСервере();
	
	
КонецПроцедуры

