&НаСервере
Функция ПолучитьУсловиеФильтраПоН(ПсевдонимТаблицы)
    
    Условие = "";
    
    Если ФильтрПоН = 0 Тогда
        // Пусто - только записи с Н = Ложь (не отмечено)
        Условие = "И (" + ПсевдонимТаблицы + ".Н = ЛОЖЬ ИЛИ " + ПсевдонимТаблицы + ".Н IS NULL)";
    ИначеЕсли ФильтрПоН = 1 Тогда
        // Галочка - только записи с Н = Истина (отмечено)
        Условие = "И " + ПсевдонимТаблицы + ".Н = ИСТИНА";
    ИначеЕсли ФильтрПоН = 2 Тогда
        // Серый квадрат - все записи (без условия)
        Условие = "";
    КонецЕсли;
    
    Возврат Условие;
    
КонецФункции


 &НаКлиенте
Процедура ФильтрПоНПриИзменении(Элемент)
    
    // --------------------------------------------------------------
    // 1. СОХРАНЯЕМ ТЕКУЩИЙ ВЫБОР И СОСТОЯНИЕ
    // --------------------------------------------------------------
    СохраненныйВыбор = СохранитьВыборСотрудников();
    СохранитьСостояниеДерева();
    
    // --------------------------------------------------------------
    // 2. ОПРЕДЕЛЯЕМ ТЕКСТОВОЕ ОПИСАНИЕ РЕЖИМА ДЛЯ ИНФОРМИРОВАНИЯ
    // --------------------------------------------------------------
    РежимТекст = "?";
    Если ФильтрПоН = 0 Тогда
        РежимТекст = "только без Н";
    ИначеЕсли ФильтрПоН = 1 Тогда
        РежимТекст = "только с Н";
    ИначеЕсли ФильтрПоН = 2 Тогда
        РежимТекст = "все записи";
    КонецЕсли;
    
    // --------------------------------------------------------------
    // 3. ОБНОВЛЯЕМ ТАБЛИЦЫ С УЧЕТОМ НОВОГО ФИЛЬТРА
    // --------------------------------------------------------------
    ОбновитьОтображениеТаблиц();
    
    // --------------------------------------------------------------
    // 4. ОБНОВЛЯЕМ ТАБЛИЦУ АНАЛИЗА (ЕСЛИ НУЖНО)
    // --------------------------------------------------------------
    ОбновитьДанныеНаСервереССохранениемВыбора(СохраненныйВыбор);
	
///////////////////////////////////////////////////////////////////////	
		// --------------------------------------------------------------
		//  Обновление ТаблицаАнализа (для отображения Индикаторов) 
		// --------------------------------------------------------------
		// Обновляем данные на сервере с учетом новой даты
		ОбновитьДанныеНаСервере();
	
		// Пересобираем кеш МассивВсехДанных из обновлённой ТаблицаАнализа
		ОтсортироватьИОтфильтроватьТаблицуАнализа();
		// Применяем фильтр по % к актуальным данным
//		ОтсортироватьТаблицуАнализаНаКлиенте();
 ///////////////////////////////////////////////////////////////////////
	
    // --------------------------------------------------------------
    // 5. ВОССТАНАВЛИВАЕМ ВЫБОР И СОСТОЯНИЕ
    // --------------------------------------------------------------
    ВосстановитьВыборСотрудников(СохраненныйВыбор);
    ВосстановитьСостояниеДерева();
	
///////////////////////////////////////////////////////////////////////
//	ОбновитьСписокСотрудниковИзТаблицы();
//	ОбновитьОтображениеВсехТаблиц();

	// ВАЖНО: После восстановления выбора в таблице анализа,
	// нужно обновить дерево договоров с текущим выбором сотрудников
	ОбновитьДетализациюДоговоровПоТекущемуВыбору();
///////////////////////////////////////////////////////////////////////	



    // --------------------------------------------------------------
    // 6. ОБНОВЛЯЕМ ОТОБРАЖЕНИЕ
    // -------------------------------------------------------------- 
    ОбновитьОтображениеПоРежиму();
    ОбновитьИндикаторы();
 	
		

	 
    
//    Сообщить("Фильтр по Н: " + РежимТекст);
    
КонецПроцедуры















