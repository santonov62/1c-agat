&НаКлиенте
Функция СкопироватьСтрокуВСтруктуру(Строка)
	Стр = Новый Структура(
		"Сотрудник, " +
		"ВсегоДоговора, ВсегоДоговораНеИсполнено, ДоговораН, ДоговораПроцент, " +
		"РаспоряженияГДВсего, РаспоряженияГДНеИсполнено, РаспоряженияГДН, РаспоряженияГДПроцент, " +
		"РаспоряженияТДВсего, РаспоряженияТДНеИсполнено, РаспоряженияТДН, РаспоряженияТДПроцент, " +
		"ВнутренниеДокументыВсего, ВнутренниеДокументыНеИсполнено, ВнутренниеДокументыН, ВнутренниеДокументыПроцент, " +
		"ИсходящиеДокументыВсего, ИсходящиеДокументыНеИсполнено, ИсходящиеДокументыН, ИсходящиеДокументыПроцент, " +
		"ВходящиеДокументыВсего, ВходящиеДокументыНеИсполнено, ВходящиеДокументыН, ВходящиеДокументыПроцент, " +
		"ОбщееКоличество, НеИсполнено, ПроцентНеИсполненноКОбщее, ВсегоН, Выбран");
	
	Стр.Сотрудник                      = Строка.Сотрудник;
	Стр.ВсегоДоговора                  = Строка.ВсегоДоговора;
	Стр.ВсегоДоговораНеИсполнено       = Строка.ВсегоДоговораНеИсполнено;
	Стр.ДоговораН                      = Строка.ДоговораН;
	Стр.ДоговораПроцент                = Строка.ДоговораПроцент;
	Стр.РаспоряженияГДВсего            = Строка.РаспоряженияГДВсего;
	Стр.РаспоряженияГДНеИсполнено      = Строка.РаспоряженияГДНеИсполнено;
	Стр.РаспоряженияГДН                = Строка.РаспоряженияГДН;
	Стр.РаспоряженияГДПроцент          = Строка.РаспоряженияГДПроцент;
	Стр.РаспоряженияТДВсего            = Строка.РаспоряженияТДВсего;
	Стр.РаспоряженияТДНеИсполнено      = Строка.РаспоряженияТДНеИсполнено;
	Стр.РаспоряженияТДН                = Строка.РаспоряженияТДН;
	Стр.РаспоряженияТДПроцент          = Строка.РаспоряженияТДПроцент;
	Стр.ВнутренниеДокументыВсего       = Строка.ВнутренниеДокументыВсего;
	Стр.ВнутренниеДокументыНеИсполнено = Строка.ВнутренниеДокументыНеИсполнено;
	Стр.ВнутренниеДокументыН           = Строка.ВнутренниеДокументыН;
	Стр.ВнутренниеДокументыПроцент     = Строка.ВнутренниеДокументыПроцент;
	Стр.ИсходящиеДокументыВсего        = Строка.ИсходящиеДокументыВсего;
	Стр.ИсходящиеДокументыНеИсполнено  = Строка.ИсходящиеДокументыНеИсполнено;
	Стр.ИсходящиеДокументыН            = Строка.ИсходящиеДокументыН;
	Стр.ИсходящиеДокументыПроцент      = Строка.ИсходящиеДокументыПроцент;
	Стр.ВходящиеДокументыВсего         = Строка.ВходящиеДокументыВсего;
	Стр.ВходящиеДокументыНеИсполнено   = Строка.ВходящиеДокументыНеИсполнено;
	Стр.ВходящиеДокументыН             = Строка.ВходящиеДокументыН;
	Стр.ВходящиеДокументыПроцент       = Строка.ВходящиеДокументыПроцент;
	Стр.ОбщееКоличество                = Строка.ОбщееКоличество;
	Стр.НеИсполнено                    = Строка.НеИсполнено;
	Стр.ПроцентНеИсполненноКОбщее      = Строка.ПроцентНеИсполненноКОбщее;
	Стр.ВсегоН                         = Строка.ВсегоН;
	Стр.Выбран                         = Строка.Выбран;
	
	Возврат Стр;
КонецФункции

