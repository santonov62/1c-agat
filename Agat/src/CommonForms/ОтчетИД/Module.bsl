&НаКлиенте
Процедура ВыгрузитьВыбранныеВСЗ(Команда)

	ДвоичныеДанные = СформироватьФайлВыгрузкиНаСервере();

	Если ДвоичныеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Нет строк с установленным флагом «Формирование СЗ».");
		Возврат;
	КонецЕсли;

	ДиалогФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогФайла.Фильтр         = "Excel файл (*.xlsx)|*.xlsx";
	ДиалогФайла.ПолноеИмяФайла = "СЗ_" + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ".xlsx";
	Если Не ДиалогФайла.Выбрать() Тогда Возврат; КонецЕсли;

	ДвоичныеДанные.Записать(ДиалогФайла.ПолноеИмяФайла);
	ЗапуститьПриложение(ДиалогФайла.ПолноеИмяФайла);

КонецПроцедуры

// Безопасный формат даты — только ДД.ММ.ГГГГ, без времени
&НаСервере
Функция ФорматДатыБезВремени(ЗначениеДаты)
	Если ТипЗнч(ЗначениеДаты) <> Тип("Дата") Тогда Возврат ""; КонецЕсли;
	Если ЗначениеДаты = Дата(1, 1, 1)         Тогда Возврат ""; КонецЕсли;
	Возврат Формат(НачалоДня(ЗначениеДаты), "ДФ=dd.MM.yyyy");
КонецФункции

&НаСервере
Функция НоваяСтрокаВыгрузки(ТипСтроки = "Данные")
	Возврат Новый Структура(
        "ТипСтроки, НомерДокумента, ДатаДокумента, ДатаПоступления, ВходящийНомер, Наименование, СрокИсполнения, ДатаИсполнения, Примечание, Исполнитель, ИсполнителиМН, СодержаниеДокумента, Изделие, Исключен",
        ТипСтроки, "", Дата(1,1,1), Дата(1,1,1), "", "", Дата(1,1,1), Дата(1,1,1), "", "", "", "", "", "");
	КонецФункции
	
// ПолучитьИсполнителейДоговора  //выхов был в Функция СформироватьСтрокиДерева(ЛистьяМассив)// - НЕ ИСПОЛЬЗУЕТСЯ
&НаСервере
Функция ПолучитьИсполнителейДоговора(Договор,НаименованиеРабот)

	Результат = "";
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		СписокИсполнителей = Новый Массив;
        КлючПоиска = СокрЛП(НаименованиеРабот);
		
		Если Договор.Распоряжение.Количество() > 0 Тогда
			Для Каждого СтрТЧ Из Договор.Распоряжение Цикл
				Если СокрЛП(СтрТЧ.НаименованиеРабот) = КлючПоиска  Тогда
					НайденнаяСтрока = СтрТЧ; 
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если НайденнаяСтрока = Неопределено И Договор.ПланГрафик.Количество() > 0 Тогда
			Для Каждого СтрТЧ Из Договор.ПланГрафик Цикл
				Если СокрЛП(СтрТЧ.НаименованиеРабот) = КлючПоиска Тогда
					НайденнаяСтрока = СтрТЧ;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если НайденнаяСтрока <> Неопределено И ЗначениеЗаполнено(НайденнаяСтрока.Исполнитель) Тогда
			Результат = Строка(НайденнаяСтрока.Исполнитель);
		КонецЕсли;
	Исключение
		Результат = "";
	КонецПопытки;

	Возврат Результат;

КонецФункции

