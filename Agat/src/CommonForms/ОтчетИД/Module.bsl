		Элементы.ТабИсполненоВсегоКопия.Заголовок = ТабИсполненоВсего;
		Элементы.ТабНеИсполненоВсегоКопия.Заголовок = ТабНеИсполненоВсего;
		Элементы.ТабНВсегоКопия.Заголовок = ТабНВсего;
//////////////////////////////////////////////////////////////////////////////////////		
		
    Иначе
        // РЕЖИМ 1: Основные панели видны, ШкалаТЧ скрыта // РЕЖИМ "ОСНОВНЫЕ ПАНЕЛИ": показываем панели в зависимости от РежимОтображения
        Элементы.Критерии.Видимость = Истина;
        Элементы.НастройкиОтчета.Видимость = Истина;
 //       Элементы.ГруппаОтчет.Видимость = Ложь;
        Элементы.ШкалаТЧ.Видимость = Ложь;
	                            
//////////////////////////////////////////////////////////////////////////////////////	
	    // ГруппаОтчет показываем только если РежимОтображения = 1
        Элементы.ГруппаОтчет.Видимость = (РежимОтображения = 1);
 //////////////////////////////////////////////////////////////////////////////////////
 
    КонецЕсли;
	
