&НаСервере
Функция СформироватьФайлВыгрузкиНаСервере(ВидСЗ = "Служебная записка")
    
    МассивДанных = Новый Массив;
    
    // Блок: Договоры (дерево)
    ЛистьяДерева = Новый Массив;
    СобратьЛистьяДереваРекурсивно(ТаблицаДетализация.ПолучитьЭлементы(), ЛистьяДерева, "", Неопределено, "");
    Если ЛистьяДерева.Количество() > 0 Тогда
        СтрЗаг = НоваяСтрокаВыгрузки("Заголовок"); СтрЗаг.Наименование = "Договоры";
        МассивДанных.Добавить(СтрЗаг);
        Для Каждого С Из СформироватьСтрокиДерева(ЛистьяДерева) Цикл МассивДанных.Добавить(С); КонецЦикла;
    КонецЕсли;
    
    // Блоки плоских таблиц
    ДобавитьБлокТаблицы(ТаблицаРаспоряженияГД,      МассивДанных, "Распоряжения ГД");
    ДобавитьБлокТаблицы(ТаблицаРаспоряженияТД,      МассивДанных, "Распоряжения ТД");
    ДобавитьБлокТаблицы(ТаблицаВнутренниеДокументы, МассивДанных, "Внутренние документы");
    ДобавитьБлокТаблицы(ТаблицаВходящиеДокументы,   МассивДанных, "Входящие документы");
    ДобавитьБлокТаблицы(ТаблицаИсходящиеДокументы,  МассивДанных, "Исходящие документы");
    
    Если МассивДанных.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли;
    
    // --- Загружаем макет ---
    Макет = ПолучитьОбщийМакет("МакетВыгрузкаСЗ");
    
    ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
    ОбластьЗаголовок    = Макет.ПолучитьОбласть("БлокЗаголовок");
    ОбластьНомерРасп    = Макет.ПолучитьОбласть("НомерРасп");
    ОбластьТипЗаписи    = Макет.ПолучитьОбласть("ТипЗаписи");
//    ОбластьСодержание   = Макет.ПолучитьОбласть("Содержание");
    ОбластьДанные       = Макет.ПолучитьОбласть("Данные");
	
	ОбластьОРД   = Макет.ПолучитьОбласть("ОРД");

	ОбластьШапка.Параметры.ВидСЗ        = ВидСЗ;
    ОбластьШапка.Параметры.Пользователь = ПолучитьИмяТекущегоПользователяНаСервере();
	ОбластьШапка.Параметры.ДатаС        = ФорматДатыБезВремени(ДатаС);
    ОбластьШапка.Параметры.ДатаПо       = ФорматДатыБезВремени(ДатаПо);
	
    ТД = Новый ТабличныйДокумент;
    ТД.Вывести(ОбластьШапка);
    
    Для Каждого Стр Из МассивДанных Цикл
        
        Если Стр.ТипСтроки = "Заголовок" Тогда
           ОбластьЗаголовок.Параметры.Наименование = Стр.Наименование;
            ТД.Вывести(ОбластьЗаголовок);
            
        ИначеЕсли Стр.ТипСтроки = "НомерРасп" Тогда
            ОбластьНомерРасп.Параметры.НомерДокумента = Стр.НомерДокумента;
            ОбластьНомерРасп.Параметры.ДатаДокумента  = ФорматДатыБезВремени(Стр.ДатаДокумента);
            ОбластьНомерРасп.Параметры.СрокИсполнения   = ФорматДатыБезВремени(Стр.СрокИсполнения);
            ОбластьНомерРасп.Параметры.Наименование   = Стр.Наименование;
            ТД.Вывести(ОбластьНомерРасп);
            
        ИначеЕсли Стр.ТипСтроки = "ТипЗаписи" Тогда
            ОбластьТипЗаписи.Параметры.Наименование = Стр.Наименование;
            ТД.Вывести(ОбластьТипЗаписи);
            
//       ИначеЕсли Стр.ТипСтроки = "Содержание" Тогда
//          ОбластьСодержание.Параметры.СодержаниеДокумента = Стр.СодержаниеДокумента;			
//			ОбластьСодержание.Параметры.ДатаПоступления  = Стр.ДатаПоступления;
//          ОбластьСодержание.Параметры.ВходящийНомер  = Стр.ВходящийНомер;
//            ТД.Вывести(ОбластьСодержание);  
//////////////////////////////////////////////////////////////////////////////////////////////////
		ИначеЕсли Стр.ТипСтроки = "ОРД" Тогда  
            ОбластьОРД.Параметры.НомерДокумента  = Стр.НомерДокумента;
            ОбластьОРД.Параметры.ДатаДокумента   = ФорматДатыБезВремени(Стр.ДатаДокумента);
            ОбластьОРД.Параметры.Наименование    = Стр.Наименование;
            ОбластьОРД.Параметры.СрокИсполнения  = ФорматДатыБезВремени(Стр.СрокИсполнения);
			ОбластьОРД.Параметры.ДатаИсполнения  = ФорматДатыБезВремени(Стр.ДатаИсполнения);
			ОбластьОРД.Параметры.Примечание  = Стр.Примечание;
