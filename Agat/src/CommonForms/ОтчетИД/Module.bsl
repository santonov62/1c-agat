// Требует оптимизации запроса - устаовит в запросе срок исполнения


&НаСервере
Процедура СобратьДанныеИзДоговоровДляАнализа(ПоСотрудникам, МассивСотрудников, ПарамДатаС, ПарамДатаПо, ПустаяДата)
	
	Если МассивСотрудников.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СобратьДанныеИзТабличнойЧастиДоговоровДляАнализа(ПоСотрудникам, МассивСотрудников, ПарамДатаС, ПарамДатаПо, ПустаяДата, "Распоряжение");
	СобратьДанныеИзТабличнойЧастиДоговоровДляАнализа(ПоСотрудникам, МассивСотрудников, ПарамДатаС, ПарамДатаПо, ПустаяДата, "ПланГрафик");
	
КонецПроцедуры

&НаСервере
Процедура СобратьДанныеИзТабличнойЧастиДоговоровДляАнализа(ПоСотрудникам, МассивСотрудников, ПарамДатаС, ПарамДатаПо, ПустаяДата, ИмяТабличнойЧасти)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	" + ИмяТабличнойЧасти + ".Исполнитель КАК Сотрудник,
	|	" + ИмяТабличнойЧасти + ".СрокИсполнения КАК Срок,
	|	" + ИмяТабличнойЧасти + ".ДатаИсполнения КАК ДатаИсп,
	|	" + ИмяТабличнойЧасти + ".Н КАК Н
	|ИЗ Справочник.Договора." + ИмяТабличнойЧасти + " КАК " + ИмяТабличнойЧасти + "
	|ГДЕ " + ИмяТабличнойЧасти + ".Исполнитель В (&МассивСотрудников)
	|	И (" + ИмяТабличнойЧасти + ".СрокИсполнения МЕЖДУ &ДатаС И &ДатаПо
	|		ИЛИ " + ИмяТабличнойЧасти + ".ДатаИсполнения МЕЖДУ &ДатаС И &ДатаПо
	|		ИЛИ (" + ИмяТабличнойЧасти + ".ДатаИсполнения = &ПустаяДата
	|			И " + ИмяТабличнойЧасти + ".СрокИсполнения <= &ДатаПо))";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	Запрос.УстановитьПараметр("ДатаС",      ПарамДатаС);
	Запрос.УстановитьПараметр("ДатаПо",     ПарамДатаПо);
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДанныеСотрудника = ПолучитьДанныеСотрудника(ПоСотрудникам, Выборка.Сотрудник);
			Если Выборка.Н > 0 Тогда
				Если Выборка.ДатаИсп = ПустаяДата И Выборка.Срок <= ПарамДатаПо Тогда
					ДанныеСотрудника.ДоговораН = ДанныеСотрудника.ДоговораН + 1;
				КонецЕсли;
			Иначе
				Если Выборка.Срок <= ПарамДатаПо Тогда
					ДанныеСотрудника.ДоговораВсего = ДанныеСотрудника.ДоговораВсего + 1;
				КонецЕсли;
				Если Выборка.ДатаИсп = ПустаяДата И Выборка.Срок <= ПарамДатаПо Тогда
					ДанныеСотрудника.ДоговораНеИсполнено = ДанныеСотрудника.ДоговораНеИсполнено + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Ошибка при загрузке " + ИмяТабличнойЧасти + ": " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

