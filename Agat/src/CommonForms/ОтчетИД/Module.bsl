//"Флажок" ТолькоМоиЗадачи 
///////////////////////////////////////////////////////////////////////////////////////////  

&НаКлиенте
Процедура ТолькоМоиЗадачиПриИзменении(Элемент)
    
    Если ТолькоМоиЗадачи Тогда
        // Включаем фильтр - показываем только текущего пользователя
        ВыполнитьОтборПоТекущемуПользователю();
//        Сообщить("Отображаются задачи только для текущего пользователя");
    Иначе
        // Выключаем фильтр - показываем всех сотрудников
        УстановитьВыборВсехСотрудников();
        
        ОбновитьФлагВсехСотрудников();
        ОбновитьСписокПоТаблицеАнализа();
        ОбновитьДетализациюПоВыбранным();
        ОбновитьИндикаторы();
        ЗаполнитьДиаграммуИтогов();
        
//        Сообщить("Отображаются задачи для всех сотрудников");
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяТекущегоПользователяНаСервере()
    
    // Получаем текущего пользователя на сервере
    ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    
    Возврат ТекущийПользователь.Имя;
    
КонецФункции

&НаСервере
Функция ПолучитьСотрудникаПоИмениПользователяНаСервере(ИмяПользователя)
    
    Если ПустаяСтрока(ИмяПользователя) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    // Ищем сотрудника по имени пользователя
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	Сотрудники.Ссылка
    |ИЗ
    |	Справочник.Сотрудники КАК Сотрудники
    |ГДЕ
    |	Сотрудники.Наименование = &ИмяПользователя
    |	И НЕ Сотрудники.ПометкаУдаления";
    
    Запрос.УстановитьПараметр("ИмяПользователя", ИмяПользователя);
    
    Результат = Запрос.Выполнить();
    
    Если Результат.Пустой() Тогда
        // Если не нашли по имени, пробуем по полному имени
        Запрос.Текст = 
        "ВЫБРАТЬ
        |	Сотрудники.Ссылка
        |ИЗ
        |	Справочник.Сотрудники КАК Сотрудники
        |ГДЕ
        |	Сотрудники.ПолноеИмя = &ИмяПользователя
        |	И НЕ Сотрудники.ПометкаУдаления";
        Результат = Запрос.Выполнить();
    КонецЕсли;
    
    Если Результат.Пустой() Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    
    Возврат Выборка.Ссылка;
    
КонецФункции
///////////////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ВыполнитьОтборПоТекущемуПользователю()
    
    // Получаем имя текущего пользователя
    ИмяПользователя = ПолучитьИмяТекущегоПользователяНаСервере();
    
    Если ПустаяСтрока(ИмяПользователя) Тогда
        Сообщить("Не удалось определить текущего пользователя!");
        ТолькоМоиЗадачи = Ложь;
        Возврат;
    КонецЕсли;
    
    // Получаем сотрудника на сервере
    ТекущийСотрудник = ПолучитьСотрудникаПоИмениПользователяНаСервере(ИмяПользователя);
    
    Если ТекущийСотрудник = Неопределено Тогда
        Сообщить("Не удалось определить сотрудника для пользователя: " + ИмяПользователя);
        ТолькоМоиЗадачи = Ложь;
        Возврат;
    КонецЕсли;
    
    // Сбрасываем все галочки
    Для Каждого Стр Из ТаблицаАнализа Цикл
        Стр.Выбран = Ложь;
    КонецЦикла;
    
    // Устанавливаем галочку для текущего сотрудника
    Найден = Ложь;
    Для Каждого Стр Из ТаблицаАнализа Цикл
        Если Стр.Сотрудник = ТекущийСотрудник Тогда
            Стр.Выбран = Истина;
            Найден = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    
    Если Не Найден Тогда
        Сообщить("Текущий пользователь '" + ИмяПользователя + "' не найден в списке сотрудников!");
        ТолькоМоиЗадачи = Ложь;
        Возврат;
    КонецЕсли;
    
    // Обновляем флаг "Все сотрудники"
    ОбновитьФлагВсехСотрудников();
    
    // Обновляем список сотрудников
    ОбновитьСписокПоТаблицеАнализа();
    
    // Обновляем детализацию
    ОбновитьДетализациюПоВыбранным();
    
    // Обновляем индикаторы
    ОбновитьИндикаторы();
    
    // Обновляем диаграмму
    ЗаполнитьДиаграммуИтогов();
    
КонецПроцедуры
