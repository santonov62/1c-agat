&НаКлиенте
Процедура ВыбраныВсеТаблицыПриИзменении(Элемент)
	
	Если ВыбраныВсеТаблицы Тогда
		// Устанавливаем все отдельные флажки
		ИспользоватьДоговора = Истина;
		ИспользоватьРаспоряженияГД = Истина;
		ИспользоватьРаспоряженияТД = Истина;
		ИспользоватьВнутренниеДокументы = Истина;
		ИспользоватьИсходящиеДокументы = Истина;
		ИспользоватьВходящиеДокументы = Истина;
	Иначе
		// Снимаем все отдельные флажки
		ИспользоватьДоговора = Ложь;
		ИспользоватьРаспоряженияГД = Ложь;
		ИспользоватьРаспоряженияТД = Ложь;
		ИспользоватьВнутренниеДокументы = Ложь;
		ИспользоватьИсходящиеДокументы = Ложь;
		ИспользоватьВходящиеДокументы = Ложь;
	КонецЕсли;
	
///////////////////////////////////////////////////////////////////////
// Обновляем отображение флажков
	ОбновитьОтображениеФлажковТаблиц();
///////////////////////////////////////////////////////////////////////

	// Сохраняем выбор сотрудников и обновляем данные
	СохраненныйВыбор = СохранитьВыборСотрудников();
	ОбновитьДанныеНаСервереССохранениемВыбора(СохраненныйВыбор);

///////////////////////////////////////////////////////////////////////	
// Обновляем данные на сервере (таблица анализа и таблицы документов/распоряжений)
	ОбновитьДанныеНаСервере();	
// Восстанавливаем выбор сотрудников
	ВосстановитьВыборСотрудников(СохраненныйВыбор);	
// ВАЖНО: Обновляем дерево договоров с текущим выбором сотрудников
	ОбновитьДетализациюДоговоровПоТекущемуВыбору();
///////////////////////////////////////////////////////////////////////	
    ОбновитьОтображениеПоРежиму(); 	
КонецПроцедуры


