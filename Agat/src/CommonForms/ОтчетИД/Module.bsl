///////////////////////////////////////////////////////////////////////
// Функция для получения пометки из списка (ИСПРАВЛЕНО - добавлена)
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Функция ПолучитьПометкуИзСписка(ИмяТаблицы)
	
	Если ВыбранныеТаблицы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 0 По ВыбранныеТаблицы.Количество() - 1 Цикл
		Если ВыбранныеТаблицы[Индекс].Значение = ИмяТаблицы Тогда
			Возврат ВыбранныеТаблицы[Индекс].Пометка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции





///////////////////////////////////////////////////////////////////////
// Процедура обновления данных по выбору таблиц
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ОбновитьДанныеПоВыборуТаблиц()
	
	// Формируем строку с именами выбранных таблиц для сервера
	МассивИменТаблиц = "";
	
	Если ВыбранныеТаблицы = Неопределено Тогда
		// Используем значения из отдельных флажков
		МассивИменТаблиц = СформироватьСтрокуИзФлажков();
	Иначе
		// Используем пометки из списка
		Для Индекс = 0 По ВыбранныеТаблицы.Количество() - 1 Цикл
			Если ВыбранныеТаблицы[Индекс].Пометка Тогда
				Если Не ПустаяСтрока(МассивИменТаблиц) Тогда
					МассивИменТаблиц = МассивИменТаблиц + ",";
				КонецЕсли;
				МассивИменТаблиц = МассивИменТаблиц + ВыбранныеТаблицы[Индекс].Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Обновляем заголовок списка
//	ОбновитьЗаголовокСписка();
	
	// Вызываем серверную процедуру для обновления данных
	ОбновитьДанныеНаСервереСВыборомТаблиц(МассивИменТаблиц);
	
	// Модифицированная процедура ОбновитьДанныеПоВыборуТаблиц
	///////////////////////////////////////////////////////////////////////
		// Сохраняем текущий выбор сотрудников
	СохраненныйВыбор = СохранитьВыборСотрудников();
		// Вызываем процедуру с сохранением
	ОбновитьДанныеПоВыборуТаблицССохранениемВыбора(СохраненныйВыбор);
	
КонецПроцедуры




