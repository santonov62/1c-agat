// Заполнение Таблиц // ВнутренниеДокументы / ВходящиеДокументы / ИсходящиеДокументы
///////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ЗаполнитьДетализациюДокументовНаСервере(МассивСотрудников)
	
	// 1. Очищаем таблицы перед заполнением
	ТаблицаВнутренниеДокументы.Очистить();
	ТаблицаИсходящиеДокументы.Очистить();
	ТаблицаВходящиеДокументы.Очистить();
	
	// 2. Проверка наличия сотрудников
	Если МассивСотрудников = Неопределено ИЛИ МассивСотрудников.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// 3. Подготовка параметров дат
	ПарамДатаС = ?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), '00010101');
	ПарамДатаПо = ?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), '39991231');
	
	// 4. Формируем условие отбора по дате исполнения в зависимости от переключателя
	УсловиеПоДатеИсполнения = "";
	Если ЗаписиОтображениеСостав Тогда
		УсловиеПоДатеИсполнения = "И Спр.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1)";
	Иначе
		УсловиеПоДатеИсполнения = "";
	КонецЕсли;
	
	// 5. Формируем условие отбора по контролю
	УсловиеПоКонтролю = "";
	Если ФильтрТолькоКонтроль Тогда
		УсловиеПоКонтролю = "И Спр.Контроль = ИСТИНА";
	Иначе
		УсловиеПоКонтролю = "";
	КонецЕсли; 
	
	
	// Получаем условие фильтра по Н для Спр
	УсловиеПоН = ПолучитьУсловиеФильтраПоН("Спр");
	/////////////////////////////////////////////////////////////////	
	
///////////////////////////////////////////////////////////////////////	
	  // Формируем условие по датам (СрокИсполнения ИЛИ ДатаИсполнения в диапазоне ИЛИ ДатаИсполнения пустая)
	Если ЗначениеЗаполнено(ДатаС) И ЗначениеЗаполнено(ДатаПо) Тогда
		УсловиеПоДатам = 
			"И ((Спр.СрокИсполнения МЕЖДУ &ДатаС И &ДатаПо)	ИЛИ (Спр.ДатаИсполнения МЕЖДУ &ДатаС И &ДатаПо)	ИЛИ (Спр.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1) И Спр.СрокИсполнения <= &ДатаПо))"; 
	ИначеЕсли ЗначениеЗаполнено(ДатаС) И Не ЗначениеЗаполнено(ДатаПо) Тогда
		УсловиеПоДатам = 
			"И ((Спр.СрокИсполнения >= &ДатаС) ИЛИ (Спр.ДатаИсполнения >= &ДатаС)	ИЛИ (Спр.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1) И Спр.СрокИсполнения <= &ДатаПо))";           			
	ИначеЕсли Не ЗначениеЗаполнено(ДатаС) И ЗначениеЗаполнено(ДатаПо) Тогда
		УсловиеПоДатам = 
			"И ((Спр.СрокИсполнения <= &ДатаПо)	ИЛИ (Спр.ДатаИсполнения <= &ДатаПо) ИЛИ (Спр.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1) И Спр.СрокИсполнения <= &ДатаПо))";
		
	Иначе
		УсловиеПоДатам = "";
		УсловиеПоДатам = "";
	КонецЕсли;
 ///////////////////////////////////////////////////////////////////////
	
	
	
	// 6. Запрос для внутренних документов
	ЗапросВнутренние = Новый Запрос;
	ЗапросВнутренние.Текст = 
	"ВЫБРАТЬ
	|	Спр.Ссылка,
	|	Спр.Контроль,
	|	Спр.Наименование,
	|	Спр.НомерДокумента КАК НомерДокумента,
	|	Спр.ДатаДокумента КАК ДатаДокумента,
	|	Спр.СодержаниеДокумента,
	|	Спр.ОтветственныйИсполнитель,
	|	Спр.Исполнители,
	|	Спр.СрокИсполнения,
	|	Спр.ДатаИсполнения,
	|	Спр.Примечание,
	|	Спр.Н,
	|	Спр.РеквизитыДокументаПодтверждающегоИсполнение КАК РеквизитыДокументаПодтверждающегоИсполнение
	|ИЗ Справочник.ВнутренниеДокументы КАК Спр
	|ГДЕ
	|	Спр.ОтветственныйИсполнитель В (&МассивСотрудников)
	|	" + УсловиеПоДатеИсполнения + "
	|	" + УсловиеПоКонтролю + "
	|	" + УсловиеПоН + "
	|	" + УсловиеПоДатам + "

//	|	И Спр.СрокИсполнения МЕЖДУ &ДатаС И &ДатаПо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Спр.СрокИсполнения";
	
	ЗапросВнутренние.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	ЗапросВнутренние.УстановитьПараметр("ДатаС", ПарамДатаС);
	ЗапросВнутренние.УстановитьПараметр("ДатаПо", ПарамДатаПо);
	
	// 7. Запрос для исходящих документов
	ЗапросИсходящие = Новый Запрос;
	ЗапросИсходящие.Текст = 
	"ВЫБРАТЬ
	|	Спр.Ссылка,
	|	Спр.Контроль,
	|	Спр.Наименование,
	|	Спр.НомерДокумента КАК НомерДокумента,
	|	Спр.ДатаДокумента КАК ДатаДокумента,
	|	Спр.СодержаниеДокумента,
	|	Спр.Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(Спр.Контрагент) КАК КонтрагентНаименование,
	|	Спр.ВходящийНомер,
	|	Спр.ОтветственныйИсполнитель,
	|	Спр.Исполнители,
	|	Спр.СрокИсполнения,
	|	Спр.ДатаИсполнения,
	|	Спр.Примечание,
	|	Спр.Н,
	|	Спр.РеквизитыДокументаПодтверждающегоИсполнение КАК РеквизитыДокументаПодтверждающегоИсполнение
	|ИЗ Справочник.ИсходящиеДокументы КАК Спр
	|ГДЕ
	|	Спр.ОтветственныйИсполнитель В (&МассивСотрудников)
	|	" + УсловиеПоДатеИсполнения + "
	|	" + УсловиеПоКонтролю + "
	|	" + УсловиеПоН + "
	|	" + УсловиеПоДатам + "

//	|	И Спр.СрокИсполнения МЕЖДУ &ДатаС И &ДатаПо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Спр.СрокИсполнения";
	
	ЗапросИсходящие.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	ЗапросИсходящие.УстановитьПараметр("ДатаС", ПарамДатаС);
	ЗапросИсходящие.УстановитьПараметр("ДатаПо", ПарамДатаПо);
	
	// 8. Запрос для входящих документов
	ЗапросВходящие = Новый Запрос;
	ЗапросВходящие.Текст = 
	"ВЫБРАТЬ
	|	Спр.Ссылка,
	|	Спр.Контроль,
	|	Спр.Наименование,
	|	Спр.НомерДокумента КАК НомерДокумента,
	|	Спр.ДатаДокумента КАК ДатаДокумента,
	|	Спр.ДатаПоступления КАК ДатаПоступления,
	|	Спр.СодержаниеДокумента,
	|	Спр.Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(Спр.Контрагент) КАК КонтрагентНаименование,
	|	Спр.ВходящийНомер,
	|	Спр.ОтветственныйИсполнитель,
	|	Спр.Исполнители,
	|	Спр.СрокИсполнения,
	|	Спр.ДатаИсполнения,
	|	Спр.Примечание,
	|	Спр.Н,
	|	Спр.РеквизитыДокументаПодтверждающегоИсполнение КАК РеквизитыДокументаПодтверждающегоИсполнение
	|ИЗ Справочник.ВходящиеДокументы КАК Спр
	|ГДЕ
	|	Спр.ОтветственныйИсполнитель В (&МассивСотрудников)
	|	" + УсловиеПоДатеИсполнения + "
	|	" + УсловиеПоКонтролю + "
	|	" + УсловиеПоН + "
	|	" + УсловиеПоДатам + "

//	|	И Спр.СрокИсполнения МЕЖДУ &ДатаС И &ДатаПо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Спр.СрокИсполнения";
	
	ЗапросВходящие.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	ЗапросВходящие.УстановитьПараметр("ДатаС", ПарамДатаС);
	ЗапросВходящие.УстановитьПараметр("ДатаПо", ПарамДатаПо);
	
	// 9. Выполняем запросы и загружаем результаты
	Попытка
		ТаблицаВнутренниеДокументы.Загрузить(ЗапросВнутренние.Выполнить().Выгрузить());
	Исключение
		Сообщить("Ошибка при загрузке внутренних документов: " + ОписаниеОшибки());
	КонецПопытки;
	
	Попытка
		ТаблицаИсходящиеДокументы.Загрузить(ЗапросИсходящие.Выполнить().Выгрузить());
	Исключение
		Сообщить("Ошибка при загрузке исходящих документов: " + ОписаниеОшибки());
	КонецПопытки;
	
	Попытка
		ТаблицаВходящиеДокументы.Загрузить(ЗапросВходящие.Выполнить().Выгрузить());
	Исключение
		Сообщить("Ошибка при загрузке входящих документов: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры
