/////////////////////////////////////////////////////////////////////

// ПРИНУДИТЕЛЬНО обновляем все таблицы
/////////////////////////////////////////////////////////////////////
&НаКлиенте
Процедура ОбновитьОтображениеВсехТаблиц()
	
	// Получаем текущий выбор сотрудников
	СписокСотрудников = ПолучитьМассивВыбранныхСотрудников();
	
	// Обновляем дерево договоров
	ЗаполнитьДетализациюНаСервере(СписокСотрудников);
	
	// Обновляем таблицы распоряжений
	ЗаполнитьДетализациюРаспоряженийНаСервере(СписокСотрудников);
	
	// Обновляем таблицы документов
	ЗаполнитьДетализациюДокументовНаСервере(СписокСотрудников);
	
	// Принудительно обновляем элементы таблиц на форме
	Попытка Элементы.ДетализацияДоговоров.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ДетализацияРаспоряженияГД.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ДетализацияРаспоряженияТД.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ДетализацияВнутренниеДокументы.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ДетализацияИсходящиеДокументы.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ДетализацияВходящиеДокументы.Обновить(); Исключение КонецПопытки;
	
// Обновляем индикаторы
	ОбновитьИндикаторы();
	
	
КонецПроцедуры
/////////////////////////////////////////////////////////////////////


// Принудительно обновляем элементы формы /////////////////////////////////////////////////////////////////////
 &НаКлиенте
Процедура ОбновитьОтображениеЭлементов()
	
	// Обновляем отображение флажков таблиц
	Попытка Элементы.ИспользоватьДоговора.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ИспользоватьРаспоряженияГД.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ИспользоватьРаспоряженияТД.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ИспользоватьВнутренниеДокументы.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ИспользоватьИсходящиеДокументы.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ИспользоватьВходящиеДокументы.Обновить(); Исключение КонецПопытки;
	
	// Обновляем флаги
	Попытка Элементы.ВыбраныВсеТаблицы.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ФильтрТолькоКонтроль.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ЗаписиОтображениеСостав.Обновить(); Исключение КонецПопытки;
	Попытка Элементы.ФлагВсехСотрудников.Обновить(); Исключение КонецПопытки;
	
	// Обновляем поле с датой С
	Попытка Элементы.ДатаС.Обновить(); Исключение КонецПопытки;
	
// Обновляем индикаторы
	ОбновитьИндикаторы();

	
КонецПроцедуры



///////////////////////////////////////////////////////////////////////
// Фильтр "Н"  //  Условие если для Н // Не используется                     
///////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ПрименитьФильтрНКРеквизитам()
    
    // --------------------------------------------------------------
    // Проверяем условие фильтра "Н"
    // --------------------------------------------------------------
    Если ФильтрПоН = 0 Тогда
        // Режим "только без Н" - нужно оставить только записи, где Н = Ложь
        // Но так как у нас нет отдельных реквизитов для отфильтрованных значений,
        // мы не можем просто обнулить реквизиты. Вместо этого нужно пересчитать данные
        // с учетом фильтра. Это делается в процедурах сбора данных.
//        Сообщить("Фильтр по Н: только без Н");
        
    ИначеЕсли ФильтрПоН = 1 Тогда
        // Режим "только с Н" - нужно оставить только записи, где Н = Истина
//        Сообщить("Фильтр по Н: только с Н");
        
    ИначеЕсли ФильтрПоН = 2 Тогда
        // Режим "все записи" - без фильтра
 //       Сообщить("Фильтр по Н: все записи");
        
    КонецЕсли;
    
    // Важно: сам фильтр применяется в запросах при сборе данных
    // Эта процедура может использоваться для дополнительной обработки,
    // но основная фильтрация происходит в СобратьДанныеИз...
    
КонецПроцедуры

