///////////////////////////////////////////////////////////////////////
// Разворачивание уровней групировки                                 //
// Событие ДетализацияДоговоров - ПередРазворачиванием               //
///////////////////////////////////////////////////////////////////////
 
&НаКлиенте
Процедура ДетализацияДоговоровПриРазворачивании(Элемент, СтрокаИдентификатор, Отказ)
	
	// 1. Обращаемся к реквизиту формы
	Если ПрограммноеРаскрытие Тогда
		Возврат;
	КонецЕсли;
	
	РазвернутаяСтрока = ТаблицаДетализация.НайтиПоИдентификатору(СтрокаИдентификатор);
	Если РазвернутаяСтрока = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	// 2. Устанавливаем флаг в Истина
	ПрограммноеРаскрытие = Истина;
	
	Попытка
		Подчиненные = РазвернутаяСтрока.ПолучитьЭлементы();
		Для Каждого Стр Из Подчиненные Цикл
			// Разворачиваем вложенные элементы (Истина - рекурсивно до низа)
			Элементы.ДетализацияДоговоров.Развернуть(Стр.ПолучитьИдентификатор(), Истина);
		КонецЦикла;
	Исключение
		// Ошибка может возникнуть при быстром клике или перестроении дерева
	КонецПопытки;
	
	// 3. Сбрасываем флаг
	ПрограммноеРаскрытие = Ложь;
	
КонецПроцедуры
