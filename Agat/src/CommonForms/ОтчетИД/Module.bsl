   	ПолеЖелтый3 = ЭлементЖелтый.Поля.Элементы.Добавить();
	ПолеЖелтый3.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДетализацияИсполнителиСтрокой");

///////////////////////////////////////////////////////////////////////
