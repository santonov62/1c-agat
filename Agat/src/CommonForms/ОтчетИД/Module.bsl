			ОбластьОРД.Параметры.ДатаПоступления  = ФорматДатыБезВремени(Стр.ДатаПоступления);
            ОбластьОРД.Параметры.ВходящийНомер  = Стр.ВходящийНомер;			
			ОбластьОРД.Параметры.Исключен = Стр.Исключен;
			
			ТД.Вывести(ОбластьОРД);
//////////////////////////////////////////////////////////////////////////////////////////////////	

            
        Иначе // "Данные"
            ОбластьДанные.Параметры.Наименование    = Стр.Наименование;
			ОбластьДанные.Параметры.Исполнитель     = Стр.Исполнитель;
			ОбластьДанные.Параметры.Примечание  = Стр.Примечание;
            ОбластьДанные.Параметры.СрокИсполнения  = ФорматДатыБезВремени(Стр.СрокИсполнения);
			ОбластьДанные.Параметры.ДатаИсполнения  = ФорматДатыБезВремени(Стр.ДатаИсполнения);
			
			ОбластьДанные.Параметры.Изделие         = Стр.Изделие;
			ОбластьДанные.Параметры.Исключен        = Стр.Исключен;
			
			
//			ОбластьДанные.Параметры.НомерДокумента  = Стр.НомерДокумента;
//          ОбластьДанные.Параметры.ДатаДокумента   = ФорматДатыБезВремени(Стр.ДатаДокумента);
