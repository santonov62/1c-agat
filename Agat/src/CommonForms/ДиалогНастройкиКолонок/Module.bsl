 // В начале модуля формы, после объявления формы
 &НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    // Очищаем таблицу, чтобы там не было "старых" или "автоматических" полей
    ТаблицаНастройки.Очистить();
	
	СтартоваяСтрока = 1; // Устанавливаем значение по умолчанию
//	КонечнаяСтрока = 0;   // 0 означает до конца         // // //
	
    // Заполняем СТРОГО из пришедшего параметра СписокПолей
    Если Параметры.Свойство("СписокПолей") Тогда
        Для Каждого Элемент Из Параметры.СписокПолей Цикл
            НоваяСтрока = ТаблицаНастройки.Добавить(); 
			// ИСПРАВЛЕНО: Ключ - это имя реквизита, Значение - заголовок
            НоваяСтрока.ИмяРеквизита = Элемент.Значение;    	// Программное имя Ключ //Значение // Например: "Наименование"
            НоваяСтрока.Заголовок    = Элемент.Представление; 	// Отображаемый заголовок Значение // Например: "Название документа"			
//			НоваяСтрока.НомерКолонки = 0;                  		// По умолчанию не выбран   // // //
        КонецЦикла;
    КонецЕсли;
    
    // Листы
    Если Параметры.Свойство("СписокЛистов") Тогда
        Элементы.ИмяЛиста.СписокВыбора.ЗагрузитьЗначения(Параметры.СписокЛистов);
		Если Параметры.СписокЛистов.Количество() > 0 Тогда
        	ИмяЛиста = Параметры.СписокЛистов[0];
		КонецЕсли;
    КонецЕсли;
    
    // Запоминаем имя справочника для возврата
//    Параметры.Свойство("ИмяСправочника", ИмяСправочникаДляЗагрузки);
// Запоминаем имя справочника
Если Параметры.Свойство("ИмяСправочника") Тогда
        ИмяСправочникаДляЗагрузки = Параметры.ИмяСправочника;
	КонецЕсли;
//================================================================	
 	// ЗАПОМИНАЕМ ИМЯ ТАБЛИЧНОЙ ЧАСТИ (ОБЯЗАТЕЛЬНО)
    Если Параметры.Свойство("ИмяТЧ") Тогда
        ИмяТабличнойЧасти = Параметры.ИмяТЧ;
    КонецЕсли;
    
    // ЗАПОМИНАЕМ ПУТЬ К ФАЙЛУ (ОБЯЗАТЕЛЬНО)
    Если Параметры.Свойство("ПутьКФайлу") Тогда
        ПутьКФайлу = Параметры.ПутьКФайлу;
    КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОК(Команда)
    
    СписокНастроек = Новый СписокЗначений;
    
    Для Каждого Стр Из ТаблицаНастройки Цикл
        // Номер колонки должен быть больше 0, а техническое имя — заполнено
        Если Стр.НомерКолонки > 0 Тогда
			// ПРОВЕРЬТЕ: ИмяРеквизита должно содержать программное имя (Наименование, а не Синоним)
			// ПЕРЕДАЕМ СКРЫТОЕ ИМЯ (Наименование), а не Заголовок (Наименование документа)
 //           Настройка = Новый Структура("ИмяРеквизита, НомерКолонки", Стр.ИмяРеквизита, Стр.НомерКолонки);
 //           СписокНастроек.Добавить(Настройка);
			
			// Добавляем пару: ИмяРеквизита -> Номер колонки в Excel
            СписокНастроек.Добавить(Стр.ИмяРеквизита, Стр.НомерКолонки);			
        КонецЕсли;
    КонецЦикла;
    
    Результат = Новый Структура;
    Результат.Вставить("НастройкиКолонок", СписокНастроек);
    Результат.Вставить("СтартоваяСтрока",  СтартоваяСтрока);
    Результат.Вставить("КонечнаяСтрока",   КонечнаяСтрока);
    Результат.Вставить("ИмяЛиста",         ИмяЛиста);
    // ИмяСправочникаДляЗагрузки — это реквизит формы, заполненный при создании
    Результат.Вставить("ИмяСправочника",   ИмяСправочникаДляЗагрузки);	
	Результат.Вставить("ИмяТЧ",            ИмяТабличнойЧасти);
	Результат.Вставить("ПутьКФайлу",       ПутьКФайлу); 
	  
    Закрыть(Результат);
КонецПроцедуры


// В модуле формы ДиалогНастройкиКолонок
&НаСервере
Процедура СохранитьНастройкиНаСервере(НастройкаДляСохранения)
	
	КлючОбъекта = "НастройкиЗагрузкиExcel";
	
	// Безопасное получение имени справочника
	ТекИмяСправочника = "Общий"; 
	Если Параметры.Свойство("ИмяСправочника") Тогда
		ТекИмяСправочника = Параметры.ИмяСправочника;
	КонецЕсли;
	
	КлючНастроек = "Справочник_" + ТекИмяСправочника;
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, НастройкаДляСохранения);
	
КонецПроцедуры
