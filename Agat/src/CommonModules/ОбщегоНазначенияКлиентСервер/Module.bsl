#Область РаботаСJSON

// Сериализация JSON
Функция ЗначениеВJSON(Значение, ПараметрыЗаписиJSON = Неопределено, НастройкиСериализации = Неопределено) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	Если ПараметрыЗаписиJSON <> Неопределено Тогда
		ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	Иначе
		ЗаписьJSON.УстановитьСтроку();
	КонецЕсли;
	Если НастройкиСериализации <> Неопределено Тогда
		ЗаписатьJSON(ЗаписьJSON, Значение, НастройкиСериализации);
	Иначе
		ЗаписатьJSON(ЗаписьJSON, Значение);
	КонецЕсли;
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ЗначениеВСтрокуJSON(Значение, ПараметрыЗаписиJSON = Неопределено, НастройкиСериализации = Неопределено) Экспорт
	Возврат ЗначениеВJSON(Значение, ПараметрыЗаписиJSON, НастройкиСериализации);
КонецФункции

// Десериализация JSON
Функция ЗначениеИзJSON(Знач СтрокаJSON, ПараметрыЧтенияJSON = Неопределено, НастройкиСериализации = Неопределено) Экспорт
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		Если ПараметрыЧтенияJSON <> Неопределено Тогда
			ЧтениеJSON.УстановитьСтроку(СтрокаJSON, ПараметрыЧтенияJSON);
		Иначе
			ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		КонецЕсли;
		Если НастройкиСериализации <> Неопределено Тогда
			Значение = ПрочитатьJSON(ЧтениеJSON, , , НастройкиСериализации);
		Иначе
			Значение = ПрочитатьJSON(ЧтениеJSON);
		КонецЕсли;
		ЧтениеJSON.Закрыть();
		Возврат Значение;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ЗначениеИзСтрокиJSON(Знач СтрокаJSON, ПараметрыЧтенияJSON = Неопределено, НастройкиСериализации = Неопределено) Экспорт
	Возврат ЗначениеИзJSON(СтрокаJSON, ПараметрыЧтенияJSON, НастройкиСериализации);
КонецФункции

