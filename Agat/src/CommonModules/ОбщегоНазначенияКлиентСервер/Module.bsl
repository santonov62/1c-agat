#Область РаботаСКоллекциями

// Копирование структуры
Функция СкопироватьСтруктуру(СтруктураИсточника) Экспорт
	
	Результат = Новый Структура;
	Если ТипЗнч(СтруктураИсточника) <> Тип("Структура") И ТипЗнч(СтруктураИсточника) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Элемент Из СтруктураИсточника Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Вставка элементов структуры в другую структуру
Процедура ВставитьСтруктуруВСтруктуру(Приемник, Источник, Перезаписывать = Истина) Экспорт
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Элемент Из Источник Цикл
		Если Перезаписывать ИЛИ НЕ Приемник.Свойство(Элемент.Ключ) Тогда
			Приемник.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Получение свойства структуры с дефолтным значением
Функция Свойство(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	Значение = Неопределено;
	Если ТипЗнч(Структура) = Тип("Структура") ИЛИ ТипЗнч(Структура) = Тип("ФиксированнаяСтруктура") ИЛИ ТипЗнч(Структура) = Тип("Соответствие") Тогда
		Если Структура.Свойство(Ключ, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

// Сворачивание массива (удаление дубликатов)
Функция СвернутьМассив(Массив) Экспорт
	Соответствие = Новый Соответствие;
	Для Каждого Элемент Из Массив Цикл
		Соответствие.Вставить(Элемент, Истина);
	КонецЦикла;
	
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из Соответствие Цикл
		Результат.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Дополнение одного массива элементами другого
Процедура ДополнитьМассив(Приемник, Источник, ТолькоУникальные = Ложь) Экспорт
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Источник Цикл
		Если ТолькоУникальные Тогда
			Если Приемник.Найти(Элемент) = Неопределено Тогда
				Приемник.Добавить(Элемент);
			КонецЕсли;
		Иначе
			Приемник.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Проверка наличия значения в массиве
Функция МассивСодержитЗначение(Массив, Значение) Экспорт
	Если Массив = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Массив.Найти(Значение) <> Неопределено;
КонецФункции

// Проверка наличия реквизита или свойства
Функция ЕстьРеквизитИлиСвойство(Объект, Имя) Экспорт
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Объект) = Тип("Структура") ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Возврат Объект.Свойство(Имя);
	КонецЕсли;
	Попытка
		Возврат Объект[Имя] <> Неопределено ИЛИ Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

