// Общий модуль: ДлительныеОперацииКлиент
// Свойства: Клиент (управляемое приложение), Клиент (обычное приложение)

#Область ОжиданиеДлительнойОперации

// Конструктор параметров ожидания длительной операции
Функция ПараметрыОжидания(Форма = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Форма", Форма);
	Параметры.Вставить("Интервал", 1);
	Параметры.Вставить("ТекстСообщения", "Выполняется запрос к ИИ...");
	Параметры.Вставить("ВыводитьОкноОжидания", Истина);
	Параметры.Вставить("ВыводитьПрогрессВыполнения", Ложь);
	Параметры.Вставить("ОповещениеОПрогрессе", Неопределено);
	Параметры.Вставить("ОповещениеПриЗавершении", Неопределено);
	Параметры.Вставить("Таймаут", 0);
	Параметры.Вставить("БезОповещения", Ложь);
	Параметры.Вставить("ПотоковыйВывод", Ложь);
	Параметры.Вставить("ПоказатьПредупреждениеПоОкончании", Ложь);
	Возврат Параметры;
КонецФункции

Функция ПараметрыОповещения(Оповещение) Экспорт
	Возврат Оповещение;
КонецФункции

Функция ИнициализироватьПараметрыОповещения(Оповещение) Экспорт
	Возврат Оповещение;
КонецФункции

// Асинхронное ожидание завершения длительной операции
Асинх Процедура ОжидатьЗавершение(ДлительнаяОперация, ОповещениеПриЗавершении = Неопределено, ПараметрыОжидания = Неопределено) Экспорт
	
	Если ДлительнаяОперация = Неопределено Тогда
		Если ОповещениеПриЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ДлительнаяОперация.Статус = "Выполнено" ИЛИ ДлительнаяОперация.Статус = "Ошибка" ИЛИ ДлительнаяОперация.Статус = "Отменено" Тогда
		Если ОповещениеПриЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, ДлительнаяОперация);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// Цикл ожидания фонового задания
	Интервал = 1;
	Если ПараметрыОжидания <> Неопределено И ПараметрыОжидания.Свойство("Интервал") И ПараметрыОжидания.Интервал > 0 Тогда
		Интервал = ПараметрыОжидания.Интервал;
	КонецЕсли;
	
	Пока ДлительнаяОперация.Статус = "Выполняется" Цикл
		Ждать Интервал;
		
		СтатусОперации = ДлительныеОперации.ОперацияЗавершена(ДлительнаяОперация.ИдентификаторЗадания);
		ДлительнаяОперация.Статус = СтатусОперации.Статус;
		ДлительнаяОперация.КраткоеОписаниеОшибки = СтатусОперации.КраткоеОписаниеОшибки;
		ДлительнаяОперация.ПодробноеОписаниеОшибки = СтатусОперации.ПодробноеОписаниеОшибки;
		
		Если ДлительнаяОперация.Статус <> "Выполняется" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОповещениеПриЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, ДлительнаяОперация);
	КонецЕсли;
	
КонецПроцедуры

// Открыть форму ожидания (заглушка)
Процедура ОткрытьФормуОжидания(ПараметрыОжидания) Экспорт
КонецПроцедуры

// Показать форму ожидания (заглушка)
Процедура ПоказатьФормуОжидания(ПараметрыОжидания) Экспорт
КонецПроцедуры

// Закрыть форму ожидания (заглушка)
Процедура ЗакрытьФормуОжидания(ПараметрыОжидания) Экспорт
КонецПроцедуры

// Остановка выполнения
Процедура ОстановитьВыполнение(ДлительнаяОперация) Экспорт
	Если ДлительнаяОперация <> Неопределено И ДлительнаяОперация.Свойство("ИдентификаторЗадания") Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(ДлительнаяОперация.ИдентификаторЗадания);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
