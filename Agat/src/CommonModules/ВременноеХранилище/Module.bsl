// Общий модуль: ВременноеХранилище
// Свойства модуля: 
// - Клиент (управляемое приложение) - ДА
// - Сервер - НЕТ

Функция Поместить(ПутьКФайлу) Экспорт
    
    Попытка
        ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
        Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
    Исключение
        // На клиенте используем Сообщить или ПоказатьОповещениеПользователя
        ПоказатьОповещениеПользователя("Ошибка", , "Не удалось поместить файл во временное хранилище: " + ОписаниеОшибки());
        Возврат "";
    КонецПопытки;
    
КонецФункции

Процедура Получить(Адрес, ПутьНазначения) Экспорт
    
    Попытка
        ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
        ДвоичныеДанные.Записать(ПутьНазначения);
    Исключение
        ПоказатьОповещениеПользователя("Ошибка", , "Не удалось получить файл из временного хранилища: " + ОписаниеОшибки());
        ВызватьИсключение;
    КонецПопытки;
    
КонецПроцедуры