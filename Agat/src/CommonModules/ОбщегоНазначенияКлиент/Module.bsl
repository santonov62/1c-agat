// Общий модуль: ОбщегоНазначенияКлиент
// Свойства: Клиент (управляемое приложение), Клиент (обычное приложение)

#Область Оповещения

// Вывод сообщения пользователю на клиенте
Процедура СообщитьПользователю(
	Знач ТекстСообщенияПользователю,
	Знач КлючДанных = Неопределено,
	Знач Поле = "",
	Знач ПутьКДанным = "",
	Отказ = Ложь,
	Знач ДополнительныеПараметры = Неопределено) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщенияПользователю;
	Сообщение.Поле = Поле;
	Сообщение.ПутьКДанным = ПутьКДанным;
	Если КлючДанных <> Неопределено Тогда
		Сообщение.КлючДанных = КлючДанных;
	КонецЕсли;
	Сообщение.Сообщить();
	
	Если ТипЗнч(Отказ) = Тип("Булево") Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура СообщениеПользователю(Знач ТекстСообщения, Знач КлючДанных = Неопределено, Знач Поле = "", Знач ПутьКДанным = "", Отказ = Ложь, Знач ДополнительныеПараметры = Неопределено) Экспорт
	СообщитьПользователю(ТекстСообщения, КлючДанных, Поле, ПутьКДанным, Отказ, ДополнительныеПараметры);
КонецПроцедуры

// Показать предупреждение пользователю
Процедура ПоказатьПредупреждение(Оповещение, ТекстПредупреждения, Таймаут = 0, Заголовок = "") Экспорт
	ПоказатьПредупреждениеПользователю = Новый ОписаниеОповещения;
	ПоказатьПредупреждение(Оповещение, ТекстПредупреждения, Таймаут, Заголовок);
КонецПроцедуры

#КонецОбласти

#Область РаботаСИнтерфейсом

// Получение структуры реквизитов формы
Функция СтруктураРеквизитовФормы(Форма) Экспорт
	Результат = Новый Структура;
	Для Каждого Реквизит Из Форма.ПолучитьРеквизиты() Цикл
		Результат.Вставить(Реквизит.Имя, Форма[Реквизит.Имя]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Проверка наличия свойства у формы/элемента
Функция ЕстьСвойство(Объект, ИмяСвойства) Экспорт
	Попытка
		Возврат Объект[ИмяСвойства] <> Неопределено ИЛИ Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область РаботаСJSON

