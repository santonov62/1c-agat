// Общий модуль: СтроковыеФункцииКлиентСервер
// Свойства: Клиент (управляемое приложение), Сервер, Внешнее соединение, Клиент (обычное приложение)

#Область СтроковыеФункции

// Разделение строки в массив
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Истина) Экспорт
	Возврат СтрРазделить(Строка, Разделитель, Не ПропускатьПустыеСтроки);
КонецФункции

Функция РазделитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Истина) Экспорт
	Возврат СтрРазделить(Строка, Разделитель, Не ПропускатьПустыеСтроки);
КонецФункции

// Подстановка параметров в строку (Шаблон "%1 ... %2")
Функция ПодставитьПараметрыВСтроку(Знач Шаблон,
	Знач Параметр1 = Неопределено, Знач Параметр2 = Неопределено,
	Знач Параметр3 = Неопределено, Знач Параметр4 = Неопределено,
	Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
	Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено,
	Знач Параметр9 = Неопределено) Экспорт
	
	Возврат СтрШаблон(Шаблон, Параметр1, Параметр2, Параметр3, Параметр4, Параметр5, Параметр6, Параметр7, Параметр8, Параметр9);
КонецФункции

// Удаление недопустимых символов XML
Функция УдалитьНедопустимыеСимволыXML(Знач Строка) Экспорт
	Если ПустаяСтрока(Строка) Тогда
		Возврат "";
	КонецЕсли;
	
	// Удаляем управляющие непечатаемые символы
	Результат = "";
	Для Поз = 1 По СтрДлина(Строка) Цикл
		Симв = Сред(Строка, Поз, 1);
		Код = КодСимвола(Симв);
		Если Код = 9 ИЛИ Код = 10 ИЛИ Код = 13 ИЛИ (Код >= 32 И Код <= 55295) ИЛИ (Код >= 57344 И Код <= 65533) Тогда
			Результат = Результат + Симв;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Сокращение текста до максимальной длины с добавлением многоточия
Функция СократитьТекст(Знач Текст, Знач МаксДлина, Знач Многоточие = "...") Экспорт
	Если СтрДлина(Текст) <= МаксДлина Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, МаксДлина - СтрДлина(Многоточие)) + Многоточие;
КонецФункции

// Транслитерация кириллицы в латиницу
Функция СтрокаЛатиницей(Знач Текст) Экспорт
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	РусскиеБуквы = "абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
	Латинские = "a,b,v,g,d,e,yo,zh,z,i,y,k,l,m,n,o,p,r,s,t,u,f,kh,ts,ch,sh,sch,,y,,e,yu,ya,A,B,V,G,D,E,Yo,Zh,Z,I,Y,K,L,M,N,O,P,R,S,T,U,F,Kh,Ts,Ch,Sh,Sch,,Y,,E,Yu,Ya";
	МассивЛатиницы = СтрРазделить(Латинские, ",");
	
	Результат = "";
	Для Поз = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Поз, 1);
		Индекс = СтрНайти(РусскиеБуквы, Символ);
		Если Индекс > 0 И Индекс <= МассивЛатиницы.Количество() Тогда
			Результат = Результат + МассивЛатиницы[Индекс - 1];
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти
