// Общий модуль: ФайловаяСистемаКлиент
// Свойства: Клиент (управляемое приложение), Клиент (обычное приложение)

#Область ПараметрыИДиалоги

// Параметры диалога выбора файлов
Функция ПараметрыДиалогаВыбораФайлов() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Заголовок", "Выберите файл");
	Параметры.Вставить("Фильтр", "Все файлы (*.*)|*.*");
	Параметры.Вставить("МножественныйВыбор", Ложь);
	Параметры.Вставить("Режим", РежимДиалогаВыбораФайла.Открытие);
	Параметры.Вставить("ПолноеИмяФайла", "");
	Параметры.Вставить("Каталог", "");
	Возврат Параметры;
КонецФункции

// Параметры помещения файлов во временное хранилище
Функция ПараметрыПомещенияФайлов() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Интерактивно", Истина);
	Параметры.Вставить("Заголовок", "Выберите файл");
	Параметры.Вставить("Фильтр", "Все файлы (*.*)|*.*");
	Параметры.Вставить("МножественныйВыбор", Ложь);
	Параметры.Вставить("УникальныйИдентификатор", Неопределено);
	Возврат Параметры;
КонецФункции

// Параметры сохранения файла
Функция ПараметрыСохраненияФайла() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Заголовок", "Сохранить файл как");
	Параметры.Вставить("Фильтр", "Все файлы (*.*)|*.*");
	Параметры.Вставить("ИмяФайла", "");
	Параметры.Вставить("Каталог", "");
	Возврат Параметры;
КонецФункции

// Параметры открытия файла
Функция ПараметрыОткрытияФайла() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("ОткрытьВнешнимПриложением", Истина);
	Возврат Параметры;
КонецФункции

#КонецОбласти

#Область РаботаСФайламиКлиент

// Асинхронное помещение одного файла во временное хранилище
Асинх Процедура ПоместитьФайл(Оповещение, ПараметрыПомещения = Неопределено, АдресХранилища = "") Экспорт
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Если ПараметрыПомещения <> Неопределено Тогда
		Если ПараметрыПомещения.Свойство("Заголовок") Тогда
			Диалог.Заголовок = ПараметрыПомещения.Заголовок;
		КонецЕсли;
		Если ПараметрыПомещения.Свойство("Фильтр") Тогда
			Диалог.Фильтр = ПараметрыПомещения.Фильтр;
		КонецЕсли;
	КонецЕсли;
	
	ВыбранныеФайлы = Ждать Диалог.ВыбратьАсинх();
	Если ВыбранныеФайлы = Неопределено ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Если Оповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ВыбранныйФайл = ВыбранныеФайлы[0];
	РезультатПомещения = Ждать ПоместитьФайлВХранилищеАсинх(АдресХранилища, ВыбранныйФайл);
	
	Если Оповещение <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(Оповещение, РезультатПомещения);
	КонецЕсли;
	
КонецПроцедуры

// Асинхронное открытие файла в ассоциированном приложении
Асинх Процедура ОткрытьФайл(ПолноеИмяФайла, Оповещение = Неопределено) Экспорт
	Попытка
		ЗапуститьПриложениеАсинх(ПолноеИмяФайла);
		Если Оповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(Оповещение, Истина);
		КонецЕсли;
	Исключение
		Если Оповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(Оповещение, Ложь);
		КонецЕсли;
	КонецПопытки;
КонецПроцедуры

// Асинхронное открытие каталога в проводнике
Асинх Процедура ОткрытьПроводник(ПутьККаталогу, Оповещение = Неопределено) Экспорт
	Попытка
		ЗапуститьПриложениеАсинх("explorer.exe """ + ПутьККаталогу + """");
		Если Оповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(Оповещение, Истина);
		КонецЕсли;
	Исключение
		Если Оповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(Оповещение, Ложь);
		КонецЕсли;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеФункции

Функция ВременныйКаталог() Экспорт
	Возврат КаталогВременныхФайлов();
КонецФункции

Функция ИмяФайла(ПолноеИмяФайла) Экспорт
	Ф = Новый Файл(ПолноеИмяФайла);
	Возврат Ф.Имя;
КонецФункции

Функция ИмяФайлаБезРасширения(ПолноеИмяФайла) Экспорт
	Ф = Новый Файл(ПолноеИмяФайла);
	Возврат Ф.ИмяБезРасширения;
КонецФункции

Функция РасширениеФайла(ПолноеИмяФайла) Экспорт
	Ф = Новый Файл(ПолноеИмяФайла);
	Возврат Ф.Расширение;
КонецФункции

Функция ОбъединитьПути(Путь1, Путь2, Путь3 = "", Путь4 = "") Экспорт
	Результат = Путь1;
	Массив = Новый Массив;
	Если Не ПустаяСтрока(Путь2) Тогда Массив.Добавить(Путь2); КонецЕсли;
	Если Не ПустаяСтрока(Путь3) Тогда Массив.Добавить(Путь3); КонецЕсли;
	Если Не ПустаяСтрока(Путь4) Тогда Массив.Добавить(Путь4); КонецЕсли;
	
	Для Каждого Часть Из Массив Цикл
		Если Не Прав(Результат, 1) = "\" И Не Прав(Результат, 1) = "/" Тогда
			Результат = Результат + "\";
		КонецЕсли;
		Результат = Результат + Часть;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЭтоКорректноеИмяФайла(Знач ИмяФайла) Экспорт
	Недопустимые = "\/:*?""<>|";
	Для Поз = 1 По СтрДлина(Недопустимые) Цикл
		Если СтрНайти(ИмяФайла, Сред(Недопустимые, Поз, 1)) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Не ПустаяСтрока(ИмяФайла);
КонецФункции

Функция УдалитьНедопустимыеСимволыИмениФайла(Знач ИмяФайла, Знач СимволЗамены = "_") Экспорт
	Недопустимые = "\/:*?""<>|";
	Результат = ИмяФайла;
	Для Поз = 1 По СтрДлина(Недопустимые) Цикл
		Результат = СтрЗаменить(Результат, Сред(Недопустимые, Поз, 1), СимволЗамены);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
