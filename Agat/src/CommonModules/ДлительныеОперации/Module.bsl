// Общий модуль: ДлительныеОперации
// Свойства: Сервер, Внешнее соединение, Вызов сервера, Клиент (обычное приложение)

#Область ФоновыеЗадания

// Параметры выполнения процедуры в фоне
Функция ПараметрыВыполненияВФоне(УникальныйИдентификатор = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("УникальныйИдентификатор", ?(УникальныйИдентификатор <> Неопределено, УникальныйИдентификатор, Новый УникальныйИдентификатор));
	Параметры.Вставить("ФоновоеЗадание", Неопределено);
	Параметры.Вставить("НаименованиеФоновогоЗадания", "Длительная операция");
	Параметры.Вставить("КлючФоновогоЗадания", "");
	Параметры.Вставить("ЗапуститьВФоне", Истина);
	Параметры.Вставить("ОжидатьЗавершение", 0);
	Параметры.Вставить("БезОповещения", Ложь);
	Параметры.Вставить("ПотоковыйВывод", Ложь);
	Возврат Параметры;
КонецФункции

Функция ПараметрыВыполненияФункцииВФоне(УникальныйИдентификатор = Неопределено) Экспорт
	Возврат ПараметрыВыполненияВФоне(УникальныйИдентификатор);
КонецФункции

// Запуск процедуры или функции в фоновом задании
Функция ВыполнитьВФоне(ИмяЭкспортнойПроцедуры, ПараметрыПроцедуры, ПараметрыВыполнения = Неопределено) Экспорт
	
	ДлительнаяОперация = Новый Структура;
	ДлительнаяОперация.Вставить("Статус", "Выполняется");
	ДлительнаяОперация.Вставить("ИдентификаторЗадания", Неопределено);
	ДлительнаяОперация.Вставить("АдресРезультата", "");
	ДлительнаяОперация.Вставить("АдресПрогресса", "");
	ДлительнаяОперация.Вставить("КраткоеОписаниеОшибки", "");
	ДлительнаяОперация.Вставить("ПодробноеОписаниеОшибки", "");
	ДлительнаяОперация.Вставить("Сообщения", Неопределено);
	
	ИдентификаторФормы = Новый УникальныйИдентификатор;
	Если ПараметрыВыполнения <> Неопределено И ПараметрыВыполнения.Свойство("УникальныйИдентификатор") И ЗначениеЗаполнено(ПараметрыВыполнения.УникальныйИдентификатор) Тогда
		ИдентификаторФормы = ПараметрыВыполнения.УникальныйИдентификатор;
	КонецЕсли;
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
	ДлительнаяОперация.АдресРезультата = АдресРезультата;
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ПараметрыПроцедуры);
	МассивПараметров.Добавить(АдресРезультата);
	
	ЗапуститьВФоне = Истина;
	Если ПараметрыВыполнения <> Неопределено И ПараметрыВыполнения.Свойство("ЗапуститьВФоне") Тогда
		ЗапуститьВФоне = ПараметрыВыполнения.ЗапуститьВФоне;
	КонецЕсли;
	
	Если ЗапуститьВФоне Тогда
		Попытка
			КлючЗадания = "";
			Если ПараметрыВыполнения <> Неопределено И ПараметрыВыполнения.Свойство("КлючФоновогоЗадания") Тогда
				КлючЗадания = ПараметрыВыполнения.КлючФоновогоЗадания;
			КонецЕсли;
			
			Наименование = "Длительная операция: " + ИмяЭкспортнойПроцедуры;
			Если ПараметрыВыполнения <> Неопределено И ПараметрыВыполнения.Свойство("НаименованиеФоновогоЗадания") И ЗначениеЗаполнено(ПараметрыВыполнения.НаименованиеФоновогоЗадания) Тогда
				Наименование = ПараметрыВыполнения.НаименованиеФоновогоЗадания;
			КонецЕсли;
			
			ФЗ = ФоновыеЗадания.Выполнить(ИмяЭкспортнойПроцедуры, МассивПараметров, КлючЗадания, Наименование);
			ДлительнаяОперация.ИдентификаторЗадания = ФЗ.УникальныйИдентификатор;
			Возврат ДлительнаяОперация;
		Исключение
			// В случае сбоя запуска ФЗ выполняем напрямую
		КонецПопытки;
	КонецЕсли;
	
	// Прямой синхронный запуск
	Попытка
		Части = СтрРазделить(ИмяЭкспортнойПроцедуры, ".");
		Если Части.Количество() = 2 Тогда
			Модуль = Вычислить(Части[0]);
			Модуль[Части[1]](ПараметрыПроцедуры, АдресРезультата);
		КонецЕсли;
		ДлительнаяОперация.Статус = "Выполнено";
	Исключение
		Инфо = ИнформацияОбОшибке();
		ДлительнаяОперация.Статус = "Ошибка";
		ДлительнаяОперация.КраткоеОписаниеОшибки = КраткоеПредставлениеОшибки(Инфо);
		ДлительнаяОперация.ПодробноеОписаниеОшибки = ПодробноеПредставлениеОшибки(Инфо);
	КонецПопытки;
	
	Возврат ДлительнаяОперация;
КонецФункции

Функция ВыполнитьПроцедуру(ПараметрыВыполнения, ПараметрыПроцедуры) Экспорт
	Возврат ВыполнитьВФоне(ПараметрыВыполнения.ИмяМетода, ПараметрыПроцедуры, ПараметрыВыполнения);
КонецФункции

Функция ВыполнитьФункцию(ПараметрыВыполнения, ПараметрыФункции) Экспорт
	Возврат ВыполнитьВФоне(ПараметрыВыполнения.ИмяМетода, ПараметрыФункции, ПараметрыВыполнения);
КонецФункции

// Проверка завершения операции
Функция ОперацияЗавершена(ИдентификаторЗадания) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Статус", "Выполняется");
	Результат.Вставить("КраткоеОписаниеОшибки", "");
	Результат.Вставить("ПодробноеОписаниеОшибки", "");
	Результат.Вставить("Сообщения", Новый Массив);
	
	Если ИдентификаторЗадания = Неопределено Тогда
		Результат.Статус = "Выполнено";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ФЗ = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
		Если ФЗ = Неопределено Тогда
			Результат.Статус = "Выполнено";
			Возврат Результат;
		КонецЕсли;
		
		Если ФЗ.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			Результат.Статус = "Выполнено";
		ИначеЕсли ФЗ.Состояние = СостояниеФоновогоЗадания.АварийноЗавершено Тогда
			Результат.Статус = "Ошибка";
			Если ФЗ.ИнформацияОбОшибке <> Неопределено Тогда
				Результат.КраткоеОписаниеОшибки = КраткоеПредставлениеОшибки(ФЗ.ИнформацияОбОшибке);
				Результат.ПодробноеОписаниеОшибки = ПодробноеПредставлениеОшибки(ФЗ.ИнформацияОбОшибке);
			КонецЕсли;
		ИначеЕсли ФЗ.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
			Результат.Статус = "Отменено";
		КонецЕсли;
	Исключение
		Результат.Статус = "Выполнено";
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Проверка выполнения задания
Функция ЗаданиеВыполнено(ИдентификаторЗадания) Экспорт
	Если ИдентификаторЗадания = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		ФЗ = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
		Возврат ФЗ = Неопределено ИЛИ ФЗ.Состояние = СостояниеФоновогоЗадания.Завершено;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

// Чтение результата длительной операции
Функция ПрочитатьРезультат(ДлительнаяОперацияИлиАдрес) Экспорт
	Адрес = ?(ТипЗнч(ДлительнаяОперацияИлиАдрес) = Тип("Структура"), ДлительнаяОперацияИлиАдрес.АдресРезультата, ДлительнаяОперацияИлиАдрес);
	Если ПустаяСтрока(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПолучитьИзВременногоХранилища(Адрес);
КонецФункции

// Отмена фонового задания
Процедура ОтменитьВыполнениеЗадания(ДлительнаяОперацияИлиИдентификатор) Экспорт
	Идентификатор = ?(ТипЗнч(ДлительнаяОперацияИлиИдентификатор) = Тип("Структура"), ДлительнаяОперацияИлиИдентификатор.ИдентификаторЗадания, ДлительнаяОперацияИлиИдентификатор);
	Если Идентификатор <> Неопределено Тогда
		Попытка
			ФЗ = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Идентификатор);
			Если ФЗ <> Неопределено И ФЗ.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				ФЗ.Отменить();
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
