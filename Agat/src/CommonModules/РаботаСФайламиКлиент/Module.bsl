///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Открытие удаленного файла из регистра сведений РегистрУдаленияФайлов
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Процедура ОткрытьФайлИзРегистра(СтрокаРегистра) Экспорт
	
	// Определяем путь к файлу
	ПутьКФайлу = СтрокаРегистра.ПутьАрхива;
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		ПутьКФайлу = СтрокаРегистра.ПутьКФайлу;
	КонецЕсли;
	
	// Проверяем существование файла
	Файл = Новый Файл(ПутьКФайлу);
	Если Не Файл.Существует() Тогда
		Сообщить("Файл не найден!");
		Возврат;
	КонецЕсли;
	
	// Открываем файл
	Попытка
		ЗапуститьПриложение(ПутьКФайлу);
	Исключение
		Сообщить("Ошибка открытия файла: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Асинх Процедура ВосстановитьФайлИзРегистра(СтрокаРегистра) Экспорт
	
	// Определяем путь к файлу в архиве
	ПутьКФайлу = СтрокаРегистра.ПутьАрхива;
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		ПутьКФайлу = СтрокаРегистра.ПутьКФайлу;
	КонецЕсли;
	
	// Проверяем существование файла
	Файл = Новый Файл(ПутьКФайлу);
	Если Не Файл.Существует() Тогда
		Сообщить("Файл в архиве не найден!");
		Возврат;
	КонецЕсли;
	
	// Выбираем куда восстановить файл (диалог на клиенте)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.ПолноеИмяФайла = СтрокаРегистра.ИмяФайла;
	Результат = Ждать Диалог.ВыбратьАсинх(); //Диалог.Выбрать();
	
	Если Результат = Неопределено ИЛИ ПустаяСтрока(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	// Копируем файл (через сервер, если нужно)
	Попытка
		КопироватьФайл(ПутьКФайлу, Результат);
		Сообщить("Файл восстановлен в: " + Результат);
	Исключение
		Сообщить("Ошибка восстановления файла: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ОткрытьОбъектПоСсылкеИзРегистра(СтрокаРегистра) Экспорт
	
	Если ПустаяСтрока(СтрокаРегистра.СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		// Получаем GUID из строки
		СтрокаСсылки = СтрокаРегистра.СсылкаНаОбъект;
		ГУИДСтрока = Прав(СтрокаСсылки, 36);
		ГУИД = Новый УникальныйИдентификатор(ГУИДСтрока);
		
		// Получаем ссылку на объект через сервер
		Ссылка = РаботаСФайламиСервер.ПолучитьСсылкуПоГУИД(СтрокаРегистра.ИмяСправочника, ГУИД);
		
		Если Ссылка <> Неопределено Тогда
			ОткрытьЗначение(Ссылка);
		КонецЕсли;
	Исключение
		Сообщить("Не удалось открыть объект: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры




