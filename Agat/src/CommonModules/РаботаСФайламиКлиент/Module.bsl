// Формирует красивое имя для временного файла
Функция СформироватьИмяФайлаИзДанных(ТекущиеДанные) Экспорт
	
	Назв = ""; 
	Попытка Назв = ТекущиеДанные.НаименованиеДокумента; Исключение Назв = "Документ"; КонецПопытки;
	
	Ном = "";
	Попытка Ном = ТекущиеДанные.НомерДокумента; Исключение Ном = "б-н"; КонецПопытки;
	
	Дат = "";
	Попытка Дат = Формат(ТекущиеДанные.ДатаДокумента, "ДФ=dd.MM.yyyy"); Исключение Дат = ""; КонецПопытки;
	
	СтрКонтрагент = "";
	Попытка СтрКонтрагент = ТекущиеДанные.Контрагент; Исключение СтрКонтрагент = ""; КонецПопытки;

	
	Результат = СтрШаблон("%1_№ %2_от %3_%4%5", Назв, Ном, Дат, СтрКонтрагент, ТекущиеДанные.РасширениеФайла);
	
	// Очистка от запрещенных символов Windows
	ЗапрещенныеСимволы = "/\:*?""<>|";
	Для Поз = 1 По СтрДлина(ЗапрещенныеСимволы) Цикл
		Результат = СтрЗаменить(Результат, Сред(ЗапрещенныеСимволы, Поз, 1), "-");
	КонецЦикла;
	
	Возврат Результат;
КонецФункции


// Обновляет интерфейс кнопок
Процедура ОбновитьИнтерфейсКнопок(Форма, ТекущиеДанные, ИмяТЧ) Экспорт
	
	// 1. Четко определяем состояние: файл есть или нет
	ФайлПриложен = (ТекущиеДанные <> Неопределено И НЕ ПустаяСтрока(ТекущиеДанные.РасширениеФайла));
	
	// 2. Обновляем Кнопку Действие
	КнДействие = Форма.Элементы.Найти(ИмяТЧ + "КнопкаДействие");
	Если КнДействие <> Неопределено Тогда
		КнДействие.Картинка  = ?(ФайлПриложен, БиблиотекаКартинок.картинка_2, БиблиотекаКартинок.картинка_1);
		КнДействие.Заголовок = ?(ФайлПриложен, "Просмотреть", "Приложить");
	КонецЕсли;
	
	// 3. Обновляем Кнопку Удалить
	КнУдалить = Форма.Элементы.Найти(ИмяТЧ + "КнопкаУдалить");
	Если КнУдалить <> Неопределено Тогда
		// ВНИМАНИЕ: Видимость должна быть равна ФайлПриложен. 
		// Если файла НЕТ (Ложь) -> Видимость ЛОЖЬ (кнопка скрыта).
		КнУдалить.Видимость = ФайлПриложен;
		
		// Дополнительно для надежности управляем доступностью
		КнУдалить.Доступность = ФайлПриложен;
	КонецЕсли;
	
КонецПроцедуры


// =============================================================================
// ОСНОВНЫЕ АСИНХРОННЫЕ ФУНКЦИИ (БЕЗ ДУБЛЕЙ)
// =============================================================================  

Асинх Функция ВыполнитьДействиеСФайлом(Форма, ТекущиеДанные, ИмяТЧ, ИмяСправочника = "", НаименованиеЭлемента = "", СсылкаНаОбъект = "", ИмяПользователя = "") Экспорт
    
    Если ПустаяСтрока(ТекущиеДанные.РасширениеФайла) Тогда
        // --- ЗАГРУЗКА ---
        Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
        РезультатВыбора = Ждать Диалог.ВыбратьАсинх();
        
        Если РезультатВыбора <> Неопределено И РезультатВыбора.Количество() > 0 Тогда
            ВыбранныйПуть = РезультатВыбора[0];
            ФайлИнфо = Новый Файл(ВыбранныйПуть);
            
            // Проверка и создание уникального идентификатора
            Если НЕ ЗначениеЗаполнено(ТекущиеДанные.УникальныйИдентификатор) ИЛИ
               Строка(ТекущиеДанные.УникальныйИдентификатор) = "00000000-0000-0000-0000-000000000000" Тогда
                ТекущиеДанные.УникальныйИдентификатор = Новый УникальныйИдентификатор;
            КонецЕсли;
            
            ТекущиеДанные.РасширениеФайла = ФайлИнфо.Расширение;
            
            // Помещаем файл во временное хранилище (синхронно)
            АдресВременногоХранилища = ВременноеХранилище.Поместить(ВыбранныйПуть);
            
            Если ПустаяСтрока(АдресВременногоХранилища) Тогда
                ПоказатьОповещениеПользователя("Ошибка", , "Не удалось загрузить файл");
                ТекущиеДанные.РасширениеФайла = "";
                ТекущиеДанные.УникальныйИдентификатор = Неопределено;
			Иначе 
				
// После получения АдресВременногоХранилища
// ПоказатьОповещениеПользователя("Отладка", , "Адрес временного хранилища: " + АдресВременногоХранилища);				
// В клиентском модуле, перед сохранением файла
РезультатПроверки = РаботаСФайламиСервер.ПроверитьПутьХранилища();
// ПоказатьОповещениеПользователя("Проверка пути", , РезультатПроверки);			
				
				
                // Вызываем серверную функцию для сохранения файла
                Результат = РаботаСФайламиСервер.СохранитьФайлИзВременногоХранилища(
                    АдресВременногоХранилища,
                    ТекущиеДанные.УникальныйИдентификатор,
                    ТекущиеДанные.РасширениеФайла
                );
				
				
ПоказатьОповещениеПользователя("Отладка", , "Результат сохранения: " + Результат);
				
                Если Результат Тогда
                    ПоказатьОповещениеПользователя("Успех", , "Файл приложен");
                Иначе
                    ПоказатьОповещениеПользователя("Ошибка", , "Не удалось сохранить файл на сервере");
                    ТекущиеДанные.РасширениеФайла = "";
                    ТекущиеДанные.УникальныйИдентификатор = Неопределено;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    Иначе
        // --- ПРОСМОТР ---
        // Получаем адрес файла во временном хранилище с сервера
        АдресВременногоХранилища = РаботаСФайламиСервер.ПолучитьФайлИзХранилища(
            ТекущиеДанные.УникальныйИдентификатор,
            ТекущиеДанные.РасширениеФайла
        );
        
        Если ПустаяСтрока(АдресВременногоХранилища) Тогда
            Ждать ВопросАсинх("Файл не найден в архиве!", РежимДиалогаВопрос.ОК);
            ТекущиеДанные.РасширениеФайла = "";
            ТекущиеДанные.УникальныйИдентификатор = Неопределено;
        Иначе
            // Получаем файл из временного хранилища
            ИмяФайла = СформироватьИмяФайлаИзДанных(ТекущиеДанные);
            ПутьОткрытия = КаталогВременныхФайлов() + ИмяФайла;
            
            ВременноеХранилище.Получить(АдресВременногоХранилища, ПутьОткрытия);
            
            // Открываем файл
            Ждать ЗапуститьПриложениеАсинх(ПутьОткрытия);
        КонецЕсли;
    КонецЕсли;
    
    // Обновление интерфейса
    ОбновитьИнтерфейсКнопок(Форма, ТекущиеДанные, ИмяТЧ);
    Возврат Истина;
    
КонецФункции

Асинх Функция УдалитьФайл(Форма, ТекущиеДанные, ИмяТЧ, ИмяСправочника = "", НаименованиеЭлемента = "", СсылкаНаОбъект = "", ИмяПользователя = "") Экспорт
    
    // Проверяем, есть ли файл для удаления
    Если ПустаяСтрока(ТекущиеДанные.РасширениеФайла) ИЛИ
       НЕ ЗначениеЗаполнено(ТекущиеДанные.УникальныйИдентификатор) Тогда
        Ждать ВопросАсинх("Нет файла для удаления!", РежимДиалогаВопрос.ОК);
        Возврат Ложь;
    КонецЕсли;
    
    Ответ = Ждать ВопросАсинх("Удалить файл в архив?", РежимДиалогаВопрос.ДаНет);
    Если Ответ = КодВозвратаДиалога.Да Тогда
        
        // Если имя пользователя не передано, используем значение по умолчанию
        Если ПустаяСтрока(ИмяПользователя) Тогда
            ИмяПользователя = "Пользователь";
        КонецЕсли;
        
        // Вызываем серверную функцию для удаления файла
        Результат = РаботаСФайламиСервер.УдалитьФайлВАрхив(
            ТекущиеДанные.УникальныйИдентификатор,
            ТекущиеДанные.РасширениеФайла,
            ИмяСправочника,
            НаименованиеЭлемента,
            СсылкаНаОбъект,
            ИмяПользователя
        );
        
        Если Результат Тогда
            ТекущиеДанные.РасширениеФайла = "";
            ТекущиеДанные.УникальныйИдентификатор = Неопределено;
            ПоказатьОповещениеПользователя("Файл удален в архив");
        Иначе
            Ждать ВопросАсинх("Ошибка при удалении файла!", РежимДиалогаВопрос.ОК);
        КонецЕсли;
        
    КонецЕсли;
    
    // Обновление интерфейса
    ОбновитьИнтерфейсКнопок(Форма, ТекущиеДанные, ИмяТЧ);
    Возврат Истина;
    
КонецФункции
