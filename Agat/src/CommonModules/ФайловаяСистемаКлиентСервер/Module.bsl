// Общий модуль: ФайловаяСистемаКлиентСервер
// Свойства: Клиент (управляемое приложение), Сервер, Внешнее соединение, Клиент (обычное приложение)

#Область ВспомогательныеФункции

Функция ИмяФайла(ПолноеИмяФайла) Экспорт
	Ф = Новый Файл(ПолноеИмяФайла);
	Возврат Ф.Имя;
КонецФункции

Функция ИмяФайлаБезРасширения(ПолноеИмяФайла) Экспорт
	Ф = Новый Файл(ПолноеИмяФайла);
	Возврат Ф.ИмяБезРасширения;
КонецФункции

Функция РасширениеФайла(ПолноеИмяФайла) Экспорт
	Ф = Новый Файл(ПолноеИмяФайла);
	Возврат Ф.Расширение;
КонецФункции

Функция ОбъединитьПути(Путь1, Путь2, Путь3 = "", Путь4 = "") Экспорт
	Результат = Путь1;
	Массив = Новый Массив;
	Если Не ПустаяСтрока(Путь2) Тогда Массив.Добавить(Путь2); КонецЕсли;
	Если Не ПустаяСтрока(Путь3) Тогда Массив.Добавить(Путь3); КонецЕсли;
	Если Не ПустаяСтрока(Путь4) Тогда Массив.Добавить(Путь4); КонецЕсли;
	
	Для Каждого Часть Из Массив Цикл
		Если Не Прав(Результат, 1) = "\" И Не Прав(Результат, 1) = "/" Тогда
			Результат = Результат + "\";
		КонецЕсли;
		Результат = Результат + Часть;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЭтоКорректноеИмяФайла(Знач ИмяФайла) Экспорт
	Недопустимые = "\/:*?""<>|";
	Для Поз = 1 По СтрДлина(Недопустимые) Цикл
		Если СтрНайти(ИмяФайла, Сред(Недопустимые, Поз, 1)) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Не ПустаяСтрока(ИмяФайла);
КонецФункции

Функция УдалитьНедопустимыеСимволыИмениФайла(Знач ИмяФайла, Знач СимволЗамены = "_") Экспорт
	Недопустимые = "\/:*?""<>|";
	Результат = ИмяФайла;
	Для Поз = 1 По СтрДлина(Недопустимые) Цикл
		Результат = СтрЗаменить(Результат, Сред(Недопустимые, Поз, 1), СимволЗамены);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
