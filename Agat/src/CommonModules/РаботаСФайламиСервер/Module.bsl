// Функция получения ссылки по GUID
Функция ПолучитьСсылкуПоГУИД(ИмяСправочника, ГУИД) Экспорт
	
	Попытка
		МетаСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
		Если МетаСправочника = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Ссылка = Справочники[МетаСправочника.Имя].ПолучитьСсылку(ГУИД);
		Возврат Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

