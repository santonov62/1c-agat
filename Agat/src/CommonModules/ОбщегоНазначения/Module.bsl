// Проверка наличия реквизита у объекта или структуры
Функция ЕстьРеквизитИлиСвойство(Объект, Имя) Экспорт
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Объект) = Тип("Структура") ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Возврат Объект.Свойство(Имя);
	КонецЕсли;
	
	Попытка
		Мета = Объект.Метаданные();
		Возврат (Мета.Реквизиты.Найти(Имя) <> Неопределено 
			ИЛИ Мета.СтандартныеРеквизиты.Найти(Имя) <> Неопределено
			ИЛИ Мета.ТабличныеЧасти.Найти(Имя) <> Неопределено);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Проверка наличия подсистемы
Функция ПодсистемаСуществует(ИмяПодсистемы) Экспорт
	Части = СтрРазделить(ИмяПодсистемы, ".");
	ТекПодсистема = Метаданные;
	Для Каждого Часть Из Части Цикл
		Если ТекПодсистема = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		ТекПодсистема = ТекПодсистема.Подсистемы.Найти(Часть);
	КонецЦикла;
	Возврат ТекПодсистема <> Неопределено;
КонецФункции

