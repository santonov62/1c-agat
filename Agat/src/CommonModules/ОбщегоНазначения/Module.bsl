#Область МетаданныеИСистема

// Менеджер объекта по ссылке
Функция МенеджерОбъектаПоСсылке(Ссылка) Экспорт
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Мета = Ссылка.Метаданные();
		Возврат Вычислить(Мета.Родитель().Имя + "." + Мета.Имя);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Менеджер объекта по полному имени метаданных
Функция МенеджерОбъектаПоПолномуИмени(ПолноеИмя) Экспорт
	Попытка
		Части = СтрРазделить(ПолноеИмя, ".");
		Если Части.Количество() < 2 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Вычислить(Части[0] + "." + Части[1]);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

