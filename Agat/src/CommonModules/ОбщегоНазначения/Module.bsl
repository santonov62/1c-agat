// Общий модуль: ОбщегоНазначения
// Свойства: Сервер, Внешнее соединение, Клиент (обычное приложение), Вызов сервера

#Область ЯзыкиИЛокализация

// Код основного языка конфигурации (например, "ru")
Функция КодОсновногоЯзыка() Экспорт
	Попытка
		Если Метаданные.ОсновнойЯзык <> Неопределено Тогда
			Возврат Метаданные.ОсновнойЯзык.КодЯзыка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "ru";
КонецФункции

// Код языка по умолчанию
Функция КодЯзыкаПоУмолчанию() Экспорт
	Возврат КодОсновногоЯзыка();
КонецФункции

// Коды всех языков конфигурации
Функция КодыЯзыковКонфигурации() Экспорт
	Результат = Новый Массив;
	Для Каждого Язык Из Метаданные.Языки Цикл
		Результат.Добавить(Язык.КодЯзыка);
	КонецЦикла;
	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("ru");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Основной язык метаданных
Функция ОсновнойЯзык() Экспорт
	Возврат Метаданные.ОсновнойЯзык;
КонецФункции

// Текущий язык интерфейса
Функция ТекущийЯзыкИнтерфейса() Экспорт
	Возврат ТекущийЯзык();
КонецФункции

#КонецОбласти

#Область ЧтениеДанныхОбъектов

// Получение значения одного реквизита по ссылке
Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита, ВыбратьЗаблокированные = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Мета = Ссылка.Метаданные();
		Если Мета = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Таблица." + ИмяРеквизита + " КАК ЗначениеРеквизита
			|ИЗ
			|	" + Мета.ПолноеИмя() + " КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка = &Ссылка";
			
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ЗначениеРеквизита;
		КонецЕсли;
	Исключение
		Попытка
			Возврат Ссылка[ИмяРеквизита];
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецПопытки;
	
	Возврат Неопределено;
КонецФункции

// Получение структуры нескольких реквизитов объекта
Функция ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты, ВыбратьЗаблокированные = Ложь) Экспорт
	
	Результат = Новый Структура;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивРеквизитов = Новый Массив;
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		МассивРеквизитов = СтрРазделить(Реквизиты, ",", Ложь);
	ИначеЕсли ТипЗнч(Реквизиты) = Тип("Массив") ИЛИ ТипЗнч(Реквизиты) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Элемент Из Реквизиты Цикл
			МассивРеквизитов.Добавить(Строка(Элемент));
		КонецЦикла;
	КонецЕсли;
	
	Если МассивРеквизитов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПоляЗапроса = "";
	Для Каждого Имя Из МассивРеквизитов Цикл
		Имя = СокрЛП(Имя);
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		ПоляЗапроса = ПоляЗапроса + ?(ПустаяСтрока(ПоляЗапроса), "", ", ") + "Таблица." + Имя + " КАК " + СтрЗаменить(Имя, ".", "_");
		Результат.Вставить(Имя, Неопределено);
	КонецЦикла;
	
	Попытка
		Мета = Ссылка.Метаданные();
		Если Мета <> Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	" + ПоляЗапроса + "
				|ИЗ
				|	" + Мета.ПолноеИмя() + " КАК Таблица
				|ГДЕ
				|	Таблица.Ссылка = &Ссылка";
				
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				ЗаполнитьЗначенияСвойств(Результат, Выборка);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Для Каждого КлючИЗначение Из Результат Цикл
			Попытка
				Результат[КлючИЗначение.Ключ] = Ссылка[КлючИЗначение.Ключ];
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Получение значений реквизитов для массива ссылок
Функция ЗначенияРеквизитовОбъектов(МассивСсылок, Реквизиты, ВыбратьЗаблокированные = Ложь) Экспорт
	
	Результат = Новый Соответствие;
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Ссылка Из МассивСсылок Цикл
		Результат.Вставить(Ссылка, ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты, ВыбратьЗаблокированные));
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

