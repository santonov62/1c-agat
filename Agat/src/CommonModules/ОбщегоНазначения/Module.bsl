#Область КоллекцииИПреобразования

// Копирование структуры
Функция СкопироватьСтруктуру(СтруктураИсточника) Экспорт
	
	Результат = Новый Структура;
	Если ТипЗнч(СтруктураИсточника) <> Тип("Структура") И ТипЗнч(СтруктураИсточника) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Элемент Из СтруктураИсточника Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Разделитель строк
Функция РазделитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Истина) Экспорт
	Возврат СтрРазделить(Строка, Разделитель, Не ПропускатьПустыеСтроки);
КонецФункции

// Преобразование строки таблицы значений в структуру
Функция СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицыЗначений) Экспорт
	Результат = Новый Структура;
	Таблица = СтрокаТаблицыЗначений.Владелец();
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Результат.Вставить(Колонка.Имя, СтрокаТаблицыЗначений[Колонка.Имя]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Преобразование таблицы значений в массив структур
Функция ТаблицаЗначенийВМассив(ТаблицаЗначений) Экспорт
	Массив = Новый Массив;
	Если ТаблицаЗначений = Неопределено Тогда
		Возврат Массив;
	КонецЕсли;
	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		Массив.Добавить(СтрокаТаблицыЗначенийВСтруктуру(Стр));
	КонецЦикла;
	Возврат Массив;
КонецФункции

// Преобразование массива структур в таблицу значений
Функция МассивВТаблицуЗначений(МассивСтруктур) Экспорт
	Таблица = Новый ТаблицаЗначений;
	Если МассивСтруктур = Неопределено ИЛИ МассивСтруктур.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Первая = МассивСтруктур[0];
	Для Каждого КлючИЗначение Из Первая Цикл
		Таблица.Колонки.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Для Каждого Стр Из МассивСтруктур Цикл
		НоваяСтр = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
	КонецЦикла;
	
	Возврат Таблица;
КонецФункции

// Сериализация JSON
Функция ЗначениеВJSON(Значение, ПараметрыЗаписиJSON = Неопределено, НастройкиСериализации = Неопределено) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	Если ПараметрыЗаписиJSON <> Неопределено Тогда
		ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	Иначе
		ЗаписьJSON.УстановитьСтроку();
	КонецЕсли;
	Если НастройкиСериализации <> Неопределено Тогда
		ЗаписатьJSON(ЗаписьJSON, Значение, НастройкиСериализации);
	Иначе
		ЗаписатьJSON(ЗаписьJSON, Значение);
	КонецЕсли;
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ЗначениеВСтрокуJSON(Значение, ПараметрыЗаписиJSON = Неопределено, НастройкиСериализации = Неопределено) Экспорт
	Возврат ЗначениеВJSON(Значение, ПараметрыЗаписиJSON, НастройкиСериализации);
КонецФункции

// Десериализация JSON (БСП)
Функция ЗначениеИзJSON(Знач СтрокаJSON, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено, Знач Параметр4 = Неопределено) Экспорт
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Определяем ЧитатьВФорматеJSON (Булево)
	ЧитатьВФорматеJSON = Ложь;
	Если ТипЗнч(Параметр2) = Тип("Булево") Тогда
		ЧитатьВФорматеJSON = Параметр2;
	ИначеЕсли ТипЗнч(Параметр3) = Тип("Булево") Тогда
		ЧитатьВФорматеJSON = Параметр3;
	КонецЕсли;
	
	// Определяем ИменаСвойствСДатами (Массив)
	ИменаСвойствСДатами = Неопределено;
	Если ТипЗнч(Параметр2) = Тип("Массив") Тогда
		ИменаСвойствСДатами = Параметр2;
	ИначеЕсли ТипЗнч(Параметр3) = Тип("Массив") Тогда
		ИменаСвойствСДатами = Параметр3;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Значение = ПрочитатьJSON(ЧтениеJSON, ЧитатьВФорматеJSON, ИменаСвойствСДатами);
		ЧтениеJSON.Закрыть();
		Возврат Значение;
	Исключение
		Попытка
			ЧтениеJSON.Закрыть();
		Исключение
		КонецПопытки;
		
		Попытка
			ЧтениеJSON2 = Новый ЧтениеJSON;
			ЧтениеJSON2.УстановитьСтроку(СтрокаJSON);
			Значение = ПрочитатьJSON(ЧтениеJSON2);
			ЧтениеJSON2.Закрыть();
			Возврат Значение;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецПопытки;
КонецФункции

Функция ЗначениеИзСтрокиJSON(Знач СтрокаJSON, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено, Знач Параметр4 = Неопределено) Экспорт
	Возврат ЗначениеИзJSON(СтрокаJSON, Параметр2, Параметр3, Параметр4);
КонецФункции

Функция JSONВЗначение(Знач СтрокаJSON, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено, Знач Параметр4 = Неопределено) Экспорт
	Возврат ЗначениеИзJSON(СтрокаJSON, Параметр2, Параметр3, Параметр4);
КонецФункции

Функция JSONВСтруктуру(Знач СтрокаJSON) Экспорт
