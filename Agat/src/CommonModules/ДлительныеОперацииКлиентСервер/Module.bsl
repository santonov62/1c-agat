// Общий модуль: ДлительныеОперацииКлиентСервер
// Свойства: Клиент (управляемое приложение), Сервер, Внешнее соединение, Клиент (обычное приложение)

#Область ДлительныеОперации

// Проверка, что операция завершена по статусу структуры
Функция ОперацияЗавершена(ДлительнаяОперация) Экспорт
	Если ТипЗнч(ДлительнаяОперация) = Тип("Структура") Тогда
		Возврат ДлительнаяОперация.Статус <> "Выполняется";
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ЗаданиеВыполнено(ДлительнаяОперация) Экспорт
	Если ТипЗнч(ДлительнаяОперация) = Тип("Структура") Тогда
		Возврат ДлительнаяОперация.Статус = "Выполнено";
	КонецЕсли;
	Возврат Истина;
КонецФункции

#КонецОбласти
