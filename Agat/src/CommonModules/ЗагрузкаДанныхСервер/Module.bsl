// Универсальная процедура загрузки данных из Excel
// ДанныеПриемник - может быть: ДанныеФормыСтруктура (Объект), 
//                               ДанныеФормыКоллекция (ТЧ), 
//                               Неопределено (для создания новых элементов)    

// Универсальная процедура загрузки
// Универсальная загрузка с логированием и ограничением строк

// Общий модуль: ЗагрузкаДанныхСервер (Сервер, Вызов сервера)


// Основная функция загрузки из Excel
// Универсальная загрузка с поддержкой поиска ссылок и выбора листов
// Универсальная функция загрузки с логированием и прогрессом
// Универсальная загрузка данных из Excel
// Приемник - объект или ТЧ, Путь - строка, Настройки - СписокЗначений
Функция ЗагрузитьДанные(Приемник, Путь, Настройки, Старт, Конец, ИмяСпр, ЛистИмя) Экспорт
	
	Лог = Новый Структура("Всего, Успешно, Ошибок, ПоследняяСсылка", 0, 0, 0);
	Excel = Неопределено;
	
	 
		 // Подключение к Excel
		Excel = Новый COMОбъект("Excel.Application");
	Попытка
		Книга = Excel.Workbooks.Open(Путь, 0, Истина);
		Лист  = Книга.Sheets(ЛистИмя);
		
		ВсегоСтрок = Лист.Cells.SpecialCells(11).Row;
		Макс = ?(Число(Конец) > 0 И Число(Конец) < ВсегоСтрок, Число(Конец), ВсегоСтрок);
		ТекСтарт = ?(Число(Старт) < 1, 1, Число(Старт)); 
		
// ---------------------------------------------------------		
	// Метаданные справочника для поиска ссылок
    Попытка
        МетаОбъекта = Метаданные.Справочники[ИмяСпр];
    Исключение
        Excel.Quit();
        ВызватьИсключение "Справочник '" + ИмяСпр + "' не найден в конфигурации!";
    КонецПопытки;
// ---------------------------------------------------------		
		Для НомерСтроки = ТекСтарт По Макс Цикл
			Лог.Всего = Лог.Всего + 1;
			
			Попытка
// --- 1. ОПРЕДЕЛЕНИЕ ОБЪЕКТА --- 
// Определяем, с чем работаем // Анализируем тип приемника  
   Если Приемник = Неопределено Тогда
        ТекОбъект = Справочники[ИмяСпр].СоздатьЭлемент();
    ИначеЕсли ТипЗнч(Приемник) = Тип("СправочникСсылка." + ИмяСпр) Тогда
        // ЕСЛИ ПРИШЛА ССЫЛКА — ОБЯЗАТЕЛЬНО ПОЛУЧАЕМ ОБЪЕКТ 
        ТекОбъект = Приемник.ПолучитьОбъект(); 
    Иначе
        ТекОбъект = Приемник;
    КонецЕсли;
//ТекОбъект = ?(Приемник <> Неопределено, Приемник, Справочники[ИмяСпр].СоздатьЭлемент());
                                                            		
СтрокиТЧ = Новый Структура;// Кэш для строк ТЧ (чтобы разные колонки одной строки Excel попадали в одну строку ТЧ) 
				
				
// --- 2. ЗАПОЛНЕНИЕ РЕКВИЗИТОВ ---	

Для Каждого Настройка Из Настройки Цикл
					
	// Настройка — это элемент СпискаЗначений. // Имя реквизита лежит в .Значение, а номер колонки — в .Представление
	ИмяПоля      = СокрЛП(Настройка.Значение);
	НомКол  = Число(Настройка.Представление);
 
					Если ПустаяСтрока(ИмяПоля) Или НомКол < 1 Тогда Продолжить; КонецЕсли;
					
	//получение значения из Excel (Используем НомКол, который определили выше) // через Лист.Cells(НомерСтроки, НомКол).Value;			
            		Значение = Лист.Cells(НомерСтроки, НомКол).Value;

// 1. Сначала подготавливаем значение (Даты, Строки)
					
				// Подготовка значения (Дата и Строка)
					Если ТипЗнч(Значение) = Тип("Строка") Тогда Значение = СокрЛП(Значение); КонецЕсли;
					Если (Найти(ВРег(ИмяПоля), "ДАТА") > 0) И (ТипЗнч(Значение) = Тип("Строка")) Тогда
						Попытка Значение = Дата(Значение); Исключение КонецПопытки;
					КонецЕсли;					
					
//					Если Значение = Неопределено Тогда Продолжить; КонецЕсли; ////////////////////////////////////////


// 2. Определяем КУДА писать (в ТЧ или Шапку)
// Определение обьекта для записи Справочник/ТЧ // 
////////////////////////////////////////////////////////////////////////////////					
Попытка
    ЧастиИмени = СтрРазделить(ИмяПоля, "."); 
    
    // Определяем объект один раз перед проверкой условий
    ОбъектДляЗаписи = ?(Приемник <> Неопределено, ТекОбъект, ТекОбъект);

    Если ЧастиИмени.Количество() > 1 Тогда
        // РАБОТА С ТАБЛИЧНОЙ ЧАСТЬЮ
        ТекИмяТЧ        = СокрЛП(ЧастиИмени[0]); 
        ТекИмяРеквизита = СокрЛП(ЧастиИмени[1]);
        
        // Получаем/создаем строку ТЧ из кэша
        Если Не СтрокиТЧ.Свойство(ТекИмяТЧ) Тогда
            // Добавляем новую строку в ТЧ объекта
            СтрокиТЧ.Вставить(ТекИмяТЧ, ОбъектДляЗаписи[ТекИмяТЧ].Добавить());
        КонецЕсли;
        
        ТекСтрокаТЧ = СтрокиТЧ[ТекИмяТЧ];
        
        // --- ПОИСК ССЫЛКИ ---
        Попытка
            МетаРеквизита = МетаОбъекта.ТабличныеЧасти[ТекИмяТЧ].Реквизиты[ТекИмяРеквизита];
            Если МетаРеквизита.Тип.СодержитТип(Тип("СправочникСсылка.Сотрудники")) Тогда
                Значение = НайтиСсылкуПоНаименованию(Значение, МетаРеквизита.Тип);
            КонецЕсли;
        Исключение
            // Если метаданные не найдены, оставляем значение как есть
        КонецПопытки;

        // ПРАВИЛЬНО: Пишем значение прямо в колонку строки ТЧ
        ТекСтрокаТЧ[ТекИмяРеквизита] = Значение;
        
    Иначе
        // РАБОТА С ШАПКОЙ
        ОбъектДляЗаписи[ИмяПоля] = Значение;
    КонецЕсли;					

Исключение
    Сообщить("Ошибка заполнения поля '" + ИмяПоля + "': " + ОписаниеОшибки());
	КонецПопытки;

КонецЦикла;
		
// 3. ЗАПИСЬ (Только если загружаем НЕ в открытую форму)
// Записываем только если создавали новый элемент в базе  
////////////////////////////////////////////////////////////////////////////////	
//            Если Приемник = Неопределено Тогда   
 			Если ТекОбъект.Модифицированность() Тогда
                ТекОбъект.Записать();        // Для формы Записать() вызывать НЕЛЬЗЯ
                Лог.ПоследняяСсылка = ТекОбъект.Ссылка;
            КонецЕсли;
            
            Лог.Успешно = Лог.Успешно + 1;
			
		Исключение
			Лог.Ошибок = Лог.Ошибок + 1;
            Сообщить("Строка " + НомерСтроки + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
////////////////////////////////////////////////////////////////////////////////                    		
		Книга.Close(Ложь);
		Excel.Quit();
	Исключение
		Если Excel <> Неопределено Тогда Excel.Quit(); КонецЕсли;
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Лог;
КонецФункции

Функция ПолучитьСписокЛистов(АдресХранилища) Экспорт
	Спис = Новый Массив;
	
	Попытка
		// Извлекаем двоичные данные файла из памяти сервера
		ДанныеФайла = ПолучитьИзВременногоХранилища(АдресХранилища);
		
		// Создаем временный файл во временной директории ОС сервера
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
		ДанныеФайла.Записать(ИмяВременногоФайла);
		
		// Нативно читаем листы силами самой 1С
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
		
		Для Каждого Л Из ТабДок.Листы Цикл 
			Спис.Добавить(Л.Имя); 
		КонецЦикла;
		
		// Заметаем следы на сервере
		УдалитьФайлы(ИмяВременногоФайла);
		
	Исключение 
		Сообщить("Ошибка чтения листов на сервере: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Спис;
КонецФункции


// Универсальный поиск ссылки по строке
Функция НайтиСсылкуПоНаименованию(ЗначениеСтрока, ОписаниеТипа) Экспорт
	Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
		Мета = Метаданные.НайтиПоТипу(Тип);
		Если Мета <> Неопределено И Метаданные.Справочники.Содержит(Мета) Тогда
			Ссылка = Справочники[Мета.Имя].НайтиПоНаименованию(ЗначениеСтрока, Истина);
			Если Не Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ЗначениеСтрока; // Если не нашли, вернется строка (может вызвать ошибку типа)
КонецФункции

